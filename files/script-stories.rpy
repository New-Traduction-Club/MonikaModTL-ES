# game/script-stories.rpy:370
translate spanish mas_story_tyrant_5b1ea14b:

    # m 1eua "A Cat caught a Cock and thought about reasonable excuses for eating him."
    m 1eua "Un Gato atrapó a un Gallo y se puso a pensar en excusas razonables para comérselo."

# game/script-stories.rpy:371
translate spanish mas_story_tyrant_582957aa:

    # m "He accused him of being a nuisance by crowing at night; not letting men sleep."
    m "Le acusó de ser una molestia por cantar de noche, no dejando dormir a los hombres."

# game/script-stories.rpy:372
translate spanish mas_story_tyrant_0d7a0ebb:

    # m 3eud "The Cock defended his action by saying this was for the benefit of men, as it wakes them for labor."
    m 3eud "El Gallo defendió sus actos diciendo que era por el bien de los hombres, ya que los despierta para trabajar."

# game/script-stories.rpy:373
translate spanish mas_story_tyrant_0be8901e:

    # m 1tfb "The Cat replied, 'you abound in apologies, but it's time for breakfast.'"
    m 1tfb "El Gato respondió: 'Te sobran las excusas, pero es hora de desayunar'."

# game/script-stories.rpy:374
translate spanish mas_story_tyrant_73878271:

    # m 1hksdrb "At that he made a meal of the Cock."
    m 1hksdrb "Y dicho esto, se comió al Gallo."

# game/script-stories.rpy:375
translate spanish mas_story_tyrant_f6910ede:

    # m 3eua "The moral of this story is, tyrants need no excuse."
    m 3eua "La moraleja de esta historia es que los tiranos no necesitan excusas."

# game/script-stories.rpy:376
translate spanish mas_story_tyrant_0516c067:

    # m 1hua "I hope you enjoyed this little story, [player]~"
    m 1hua "Espero que hayas disfrutado de esta pequeña historia, [player]."

# game/script-stories.rpy:393
translate spanish mas_story_despise_6046f153:

    # m 1eud "One hot summer's day, a Fox was strolling through an orchard till he came to a bunch of grapes just ripening on a vine which had been trained over a lofty branch."
    m 1eud "Un caluroso día de verano, una Zorra se paseaba por un huerto hasta que llegó a un racimo de uvas que maduraba en una vid que trepaba por una rama alta."

# game/script-stories.rpy:394
translate spanish mas_story_despise_8d1839f4:

    # m 1tfu "'Just the thing to quench my thirst,' said the Fox."
    m 1tfu "'Justo lo que necesito para saciar mi sed', dijo la Zorra."

# game/script-stories.rpy:395
translate spanish mas_story_despise_0983f969:

    # m 1eua "Drawing back a few paces, he took a run and a jump, and just missed the bunch."
    m 1eua "Retrocediendo unos pasos, cogió carrerilla, saltó y por poco no llega al racimo."

# game/script-stories.rpy:396
translate spanish mas_story_despise_2ec2412f:

    # m 3eub "Turning round again with a one,{w=1.0} two,{w=1.0} three,{w=1.0} he jumped up, but with no greater success."
    m 3eub "Lo volvió a intentar contando uno,{w=1.0} dos,{w=1.0} tres...{w=1.0} dio un gran salto, pero sin mucho éxito."

# game/script-stories.rpy:397
translate spanish mas_story_despise_ba643386:

    # m 3tkc "Again and again he tried after the tempting morsel, but at last had to give it up, and walked away with his nose in the air, saying: 'I am sure they are sour.'"
    m 3tkc "Intentó hacerse con el tentador bocado una y otra vez, pero al final tuvo que rendirse y se marchó con el hocico en alto diciendo: 'Seguro que están verdes'."

# game/script-stories.rpy:398
translate spanish mas_story_despise_298b9b40:

    # m 1hksdrb "The moral of this story is, it's easy to despise what you cannot get."
    m 1hksdrb "La moraleja de esta historia es que es fácil despreciar lo que no puedes conseguir."

# game/script-stories.rpy:399
translate spanish mas_story_despise_77c5f182:

    # m 1eua "I hope you liked it, [player]~"
    m 1eua "Espero que te haya gustado, [player]."

# game/script-stories.rpy:416
translate spanish mas_story_lies_d5680b8b:

    # m 1euc "There was a Shepherd Boy who tended his sheep at the foot of a mountain near a dark forest."
    m 1euc "Había un Pastorcillo que cuidaba de sus ovejas al pie de una montaña, cerca de un bosque oscuro."

# game/script-stories.rpy:417
translate spanish mas_story_lies_017145bb:

    # m 1lsc "It was lonely for him, so he devised a plan to get a little company."
    m 1lsc "Se sentía solo, así que urdió un plan para tener un poco de compañía."

# game/script-stories.rpy:418
translate spanish mas_story_lies_a76d8daf:

    # m 4hfw "He rushed down towards the village calling out 'Wolf! Wolf!' and the villagers came out to meet him."
    m 4hfw "Corrió hacia el pueblo gritando '¡Que viene el lobo! ¡Que viene el lobo!', y los aldeanos salieron a su encuentro."

# game/script-stories.rpy:419
translate spanish mas_story_lies_8e611449:

    # m 1hksdrb "This pleased the boy so much that a few days after he tried the same trick, and again the villagers came to his help."
    m 1hksdrb "Esto complació tanto al chico que, unos días después, intentó el mismo truco y los aldeanos volvieron a acudir en su ayuda."

# game/script-stories.rpy:420
translate spanish mas_story_lies_0c2b212c:

    # m 3wud "Shortly after, a Wolf actually did come out from the forest."
    m 3wud "Poco después, un Lobo salió de verdad del bosque."

# game/script-stories.rpy:421
translate spanish mas_story_lies_f82316d7:

    # m 1ekc "The boy cried out 'Wolf, Wolf!' still louder than before."
    m 1ekc "El chico gritó '¡Lobo, Lobo!' aún más fuerte que antes."

# game/script-stories.rpy:422
translate spanish mas_story_lies_e5538cd3:

    # m 4efd "But this time the villagers, who had been fooled twice before, thought the boy was again lying, and nobody came to his aid."
    m 4efd "Pero esta vez los aldeanos, que ya habían sido engañados dos veces, pensaron que el chico mentía de nuevo y nadie acudió en su ayuda."

# game/script-stories.rpy:423
translate spanish mas_story_lies_b9786280:

    # m 2dsc "So the Wolf made a good meal of the boy's flock."
    m 2dsc "Así que el Lobo se dio un buen festín con el rebaño del chico."

# game/script-stories.rpy:424
translate spanish mas_story_lies_e3668085:

    # m 2esc "The moral of this story is, liars are not believed even when they speak the truth."
    m 2esc "La moraleja de esta historia es que a los mentirosos no se les cree ni cuando dicen la verdad."

# game/script-stories.rpy:425
translate spanish mas_story_lies_520ed291:

    # m 1hksdlb "You shouldn't worry about it, [player]..."
    m 1hksdlb "No deberías preocuparte por eso, [player]..."

# game/script-stories.rpy:426
translate spanish mas_story_lies_e6fa9893:

    # m 3hua "You'd never lie to me, right?"
    m 3hua "Nunca me mentirías, ¿verdad?"

# game/script-stories.rpy:427
translate spanish mas_story_lies_0d8345dc:

    # m 1hub "Ehehe~"
    m 1hub "Je, je, je."

# game/script-stories.rpy:428
translate spanish mas_story_lies_367e372e:

    # m 1eua "I hope you enjoyed the story, [player]!"
    m 1eua "¡Espero que hayas disfrutado de la historia, [player]!"

# game/script-stories.rpy:445
translate spanish mas_story_grasshoper_9710f7b0:

    # m 1eua "One summer's day, a Grasshopper was hopping about, chirping and singing to its heart's content."
    m 1eua "Un día de verano, una Cigarra saltaba de un lado a otro, chirriando y cantando a pleno pulmón."

# game/script-stories.rpy:446
translate spanish mas_story_grasshoper_eb414e31:

    # m "An Ant passed by, bearing an ear of corn he was taking to the nest."
    m "Pasó por allí una Hormiga, cargando con una mazorca de maíz que llevaba al hormiguero."

# game/script-stories.rpy:447
translate spanish mas_story_grasshoper_ebeba149:

    # m 3eud "'Why not come and chat with me,' said the Grasshopper, 'instead of toiling in that way?'"
    m 3eud "'¿Por qué no vienes a charlar conmigo', dijo la Cigarra, 'en vez de deslomarte de esa manera?'"

# game/script-stories.rpy:448
translate spanish mas_story_grasshoper_a144ad1d:

    # m 1efc "'I am helping to lay up food for the winter,' said the Ant, 'and recommend you do the same.'"
    m 1efc "'Estoy ayudando a almacenar comida para el invierno', dijo la Hormiga, 'y te recomiendo que hagas lo mismo'."

# game/script-stories.rpy:449
translate spanish mas_story_grasshoper_c52e6dcb:

    # m 1hfb "'Why bother about winter?' said the Grasshopper; 'we have plenty of food now!'"
    m 1hfb "'¿Por qué preocuparse por el invierno?', dijo la Cigarra; '¡tenemos comida de sobra ahora mismo!'"

# game/script-stories.rpy:450
translate spanish mas_story_grasshoper_7950a284:

    # m 3eua "The Ant went on its way."
    m 3eua "La Hormiga siguió su camino."

# game/script-stories.rpy:451
translate spanish mas_story_grasshoper_ff7324d3:

    # m 1dsc "When winter came, the Grasshopper had no food and found itself dying of hunger, while it saw the ants distributing corn and grain from the stores they had collected in the summer."
    m 1dsc "Cuando llegó el invierno, la Cigarra no tenía comida y se estaba muriendo de hambre, mientras veía a las hormigas repartiendo el maíz y el grano de las provisiones que habían recogido en verano."

# game/script-stories.rpy:452
translate spanish mas_story_grasshoper_04e321d8:

    # m 3hua "The moral of this story is, there's a time for work and a time for play."
    m 3hua "La moraleja de esta historia es que hay un tiempo para trabajar y un tiempo para divertirse."

# game/script-stories.rpy:453
translate spanish mas_story_grasshoper_28d07914:

    # m 1dubsu "But there's always a time to spend with your cute girlfriend~"
    m 1dubsu "Pero siempre hay tiempo para estar con tu linda novia."

# game/script-stories.rpy:454
translate spanish mas_story_grasshoper_b8f550b5:

    # m 1hub "Ehehe, I love you so much, [player]!"
    m 1hub "Je, je, je, ¡te quiero muchísimo, [player]!"

# game/script-stories.rpy:471
translate spanish mas_story_wind_sun_aa586b7e:

    # m 1dsc "The Wind and the Sun were disputing which was the strongest."
    m 1dsc "El Viento y el Sol discutían sobre cuál era el más fuerte."

# game/script-stories.rpy:472
translate spanish mas_story_wind_sun_f23feac5:

    # m 1euc "Suddenly they saw a traveler coming down the road, and the Sun said: 'I see a way to decide our dispute.'"
    m 1euc "De repente vieron a un viajero bajando por el camino, y el Sol dijo: 'Veo una forma de resolver nuestra disputa'."

# game/script-stories.rpy:473
translate spanish mas_story_wind_sun_7e6325f4:

    # m 3efd "'Whichever of us can cause that traveler to take off his cloak shall be regarded as the strongest. You begin.'"
    m 3efd "'Aquel de nosotros que consiga que ese viajero se quite la capa será considerado el más fuerte. Empieza tú'."

# game/script-stories.rpy:474
translate spanish mas_story_wind_sun_0dcd6f37:

    # m 3euc "So the Sun retired behind a cloud, and the Wind began to blow as hard as it could upon the traveler."
    m 3euc "Así que el Sol se retiró detrás de una nube y el Viento empezó a soplar tan fuerte como pudo sobre el viajero."

# game/script-stories.rpy:475
translate spanish mas_story_wind_sun_a638fa8d:

    # m 1ekc "But the harder he blew the more closely did the traveler wrap his cloak around him, till at last the Wind had to give up in despair."
    m 1ekc "Pero cuanto más fuerte soplaba, más se arropaba el viajero con su capa, hasta que al final el Viento tuvo que rendirse desesperado."

# game/script-stories.rpy:476
translate spanish mas_story_wind_sun_4cf0e535:

    # m 1euc "Then the Sun came out and shone in all his glory upon the traveler, who soon found it too hot to walk with his cloak on."
    m 1euc "Entonces el Sol salió y brilló en todo su esplendor sobre el viajero, que pronto sintió demasiado calor para caminar con la capa puesta."

# game/script-stories.rpy:477
translate spanish mas_story_wind_sun_b076e009:

    # m 3hua "The moral of this story is, gentleness and kind persuasion win where force and bluster fail."
    m 3hua "La moraleja de esta historia es que la amabilidad y la persuasión ganan donde la fuerza y la fanfarronería fracasan."

# game/script-stories.rpy:478
translate spanish mas_story_wind_sun_c6ee075b:

    # m 1hub "Hope you had fun, [player]."
    m 1hub "Espero que te hayas divertido, [player]."

# game/script-stories.rpy:495
translate spanish mas_story_seeds_460907a5:

    # m 1euc "It happened that a Countryman was sowing some hemp seeds in a field where a Swallow and some other birds were hopping about picking up their food."
    m 1euc "Sucedió que un Campesino estaba sembrando semillas de cáñamo en un campo donde una Golondrina y otros pájaros daban saltitos recogiendo su comida."

# game/script-stories.rpy:496
translate spanish mas_story_seeds_300d01da:

    # m 1tfd "'Beware of that man,' quote the Swallow."
    m 1tfd "'Cuidado con ese hombre', dijo la Golondrina."

# game/script-stories.rpy:497
translate spanish mas_story_seeds_0f8ce570:

    # m 3eud "'Why, what is he doing?' asked the others."
    m 3eud "'¿Por qué? ¿Qué está haciendo?', preguntaron los otros."

# game/script-stories.rpy:498
translate spanish mas_story_seeds_a8101c55:

    # m 1tkd "'That is hemp seed he is sowing; be careful to pick up every one of the seeds, or else you will repent it.' The Swallow replied."
    m 1tkd "'Está sembrando semillas de cáñamo; tened cuidado de recoger cada una de las semillas, o si no os arrepentiréis', respondió la Golondrina."

# game/script-stories.rpy:499
translate spanish mas_story_seeds_72a0b310:

    # m 3rksdld "The birds paid no heed to the Swallow's words, and by and by the hemp grew up and was made into cord, and of the cords nets were made."
    m 3rksdld "Los pájaros no hicieron caso a las palabras de la Golondrina, y poco a poco el cáñamo creció y se convirtió en cuerda, y con las cuerdas se hicieron redes."

# game/script-stories.rpy:500
translate spanish mas_story_seeds_a02dc2de:

    # m 1euc "Many birds that had despised the Swallow's advice were caught in nets made out of that very hemp."
    m 1euc "Muchos pájaros que habían despreciado el consejo de la Golondrina quedaron atrapados en redes hechas de ese mismo cáñamo."

# game/script-stories.rpy:501
translate spanish mas_story_seeds_9de2e02e:

    # m 3hfu "'What did I tell you?' said the Swallow."
    m 3hfu "'¿Qué os dije?', dijo la Golondrina."

# game/script-stories.rpy:502
translate spanish mas_story_seeds_277a334c:

    # m 3hua "The moral of this story is, destroy the seeds of evil before they grow up to be your ruin."
    m 3hua "La moraleja de esta historia es: destruye las semillas del mal antes de que crezcan y sean tu ruina."

# game/script-stories.rpy:503
translate spanish mas_story_seeds_8018692b:

    # m 1lksdlc "..."
    m 1lksdlc "..."

# game/script-stories.rpy:504
translate spanish mas_story_seeds_6dff20df:

    # m 2dsc "I wish I could've followed that moral..."
    m 2dsc "Ojalá hubiese seguido esa moraleja..."

# game/script-stories.rpy:505
translate spanish mas_story_seeds_06788d70:

    # m 2lksdlc "You wouldn't have had to go through what you saw."
    m 2lksdlc "No habrías tenido que pasar por lo que viste."

# game/script-stories.rpy:506
translate spanish mas_story_seeds_ac039dd0:

    # m 4hksdlb "Anyway, I hope you liked the story, [player]!"
    m 4hksdlb "En fin, ¡espero que te haya gustado la historia, [player]!"

# game/script-stories.rpy:523
translate spanish mas_story_gray_hair_137d9d59:

    # m 1eua "In the old days, a middle-aged Man had one wife that was old and one that was young; each loved him and desired nothing more than to earn his affection."
    m 1eua "Antiguamente, un Hombre de mediana edad tenía dos esposas, una vieja y otra joven; ambas le amaban y no deseaban nada más que ganarse su afecto."

# game/script-stories.rpy:524
translate spanish mas_story_gray_hair_a14772ed:

    # m 1euc "The Man's hair was turning gray, which the young Wife did not like, as it made him look too old."
    m 1euc "El cabello del Hombre se estaba volviendo gris, cosa que a la Esposa joven no le gustaba, ya que le hacía parecer demasiado viejo."

# game/script-stories.rpy:525
translate spanish mas_story_gray_hair_0ab40c33:

    # m 3rksdla "So, every night she picked out the white hairs."
    m 3rksdla "Así que, cada noche, ella le arrancaba las canas."

# game/script-stories.rpy:526
translate spanish mas_story_gray_hair_9a7c61a9:

    # m 3euc "But, the elder Wife did not like to be mistaken for his mother."
    m 3euc "Pero a la Esposa mayor no le gustaba que la confundieran con su madre."

# game/script-stories.rpy:527
translate spanish mas_story_gray_hair_6f35d024:

    # m 1eud "So, every morning she picked out as many of the black hairs as she could."
    m 1eud "Así que, cada mañana, ella le arrancaba tantos pelos negros como podía."

# game/script-stories.rpy:528
translate spanish mas_story_gray_hair_c8e3ec06:

    # m 3hksdlb "The Man soon found himself entirely bald."
    m 3hksdlb "El Hombre pronto se quedó completamente calvo."

# game/script-stories.rpy:529
translate spanish mas_story_gray_hair_e3a1747b:

    # m 1hua "The moral of this story is, yield to all and you will soon have nothing to yield."
    m 1hua "La moraleja de esta historia es que si cedes ante todos, pronto no tendrás nada que ceder."

# game/script-stories.rpy:530
translate spanish mas_story_gray_hair_74cdccf1:

    # m 1hub "So before you give everything, make sure you still have some for yourself!"
    m 1hub "Así que antes de darlo todo, ¡asegúrate de que aún te queda algo para ti!"

# game/script-stories.rpy:531
translate spanish mas_story_gray_hair_fac51c13:

    # m 1lksdla "...Not that being bald is bad, [player]."
    m 1lksdla "No es que ser calvo sea malo, [player]."

# game/script-stories.rpy:532
translate spanish mas_story_gray_hair_268e6c0a:

    # m 1hksdlb "Ehehe, I love you!~"
    m 1hksdlb "Je, je, je, ¡te quiero!"

# game/script-stories.rpy:549
translate spanish mas_story_fisherman_bbe7e020:

    # m 1euc "A poor Fisherman, who lived on the fish he caught, had bad luck one day and caught nothing but a very small fry."
    m 1euc "Un Pescador pobre, que vivía de los peces que capturaba, tuvo mala suerte un día y no pescó nada más que un pececillo muy pequeño."

# game/script-stories.rpy:550
translate spanish mas_story_fisherman_1c68e4aa:

    # m 1eud "The Fisherman was about to put it in his basket when the little Fish spoke."
    m 1eud "El Pescador estaba a punto de meterlo en su cesta cuando el Pececillo habló."

# game/script-stories.rpy:551
translate spanish mas_story_fisherman_fb8e97c9:

    # m 3ekd "'Please spare me, Mr. Fisherman! I am so small it is not worthwhile to carry me home. When I am bigger, I shall make you a much better meal!'"
    m 3ekd "'¡Por favor, perdone mi vida, señor Pescador! Soy tan pequeño que no merece la pena llevarme a casa. ¡Cuando crezca, seré un manjar mucho mejor para usted!'."

# game/script-stories.rpy:552
translate spanish mas_story_fisherman_21a4f3fa:

    # m 1eud "But the Fisherman quickly put the fish into his basket."
    m 1eud "Pero el Pescador metió rápidamente al pez en su cesta."

# game/script-stories.rpy:553
translate spanish mas_story_fisherman_e111f328:

    # m 3tfu "'How foolish I should be,' he said, 'to throw you back. However small you may be, you are better than nothing at all.'"
    m 3tfu "'Qué tonto sería', dijo él, 'si te devolviera al agua. Por muy pequeño que seas, eres mejor que nada en absoluto'."

# game/script-stories.rpy:554
translate spanish mas_story_fisherman_55ae08c5:

    # m 3esa "The moral of this story is, a small gain is worth more than a large promise."
    m 3esa "La moraleja de esta historia es que una pequeña ganancia vale más que una gran promesa."

# game/script-stories.rpy:555
translate spanish mas_story_fisherman_1b61bf73:

    # m 1hub "I hope you enjoyed this little story, [player]~"
    m 1hub "Espero que hayas disfrutado de esta pequeña historia, [player]."

# game/script-stories.rpy:572
translate spanish mas_story_ravel_4e74a4d8:

    # m 3euc "Once, an elderly man was sitting alone on a dark path."
    m 3euc "Una vez, un anciano estaba sentado solo en un camino oscuro."

# game/script-stories.rpy:573
translate spanish mas_story_ravel_08aff568:

    # m 1euc "He had forgotten both where he was traveling to, and who he was."
    m 1euc "Había olvidado tanto a dónde viajaba como quién era."

# game/script-stories.rpy:574
translate spanish mas_story_ravel_a67c32ee:

    # m "Suddenly, he looked up to see an elderly woman before him."
    m "De repente, levantó la vista y vio a una anciana ante él."

# game/script-stories.rpy:575
translate spanish mas_story_ravel_5a73c669:

    # m 1tfu "She grinned toothlessly and with a cackle, spoke: 'Now your {i}third{/i} wish. What will it be?'"
    m 1tfu "Ella sonrió con la boca desdentada y, con una carcajada, habló: 'Ahora tu tercer deseo. ¿Cuál será?'."

# game/script-stories.rpy:576
translate spanish mas_story_ravel_9f6d1c05:

    # m 3eud "'Third wish?' The man was baffled. 'How can it be a third wish if I haven't had a first and second wish?'"
    m 3eud "'¿Tercer deseo?'. El hombre estaba desconcertado. '¿Cómo puede ser un tercer deseo si no he tenido un primero ni un segundo?'."

# game/script-stories.rpy:577
translate spanish mas_story_ravel_161a8c60:

    # m 1tfd "'You've had two wishes already,' the hag said, 'but your second wish was for me to return everything to the way it was before you had made your first wish.'"
    m 1tfd "'Ya has tenido dos deseos', dijo la bruja, 'pero tu segundo deseo fue que yo devolviera todo a como estaba antes de que pidieras tu primer deseo'."

# game/script-stories.rpy:578
translate spanish mas_story_ravel_09da9219:

    # m 3tku "'That's why you remember nothing: because everything is the way it was before you made any wishes.'"
    m 3tku "'Por eso no recuerdas nada: porque todo está como estaba antes de que pidieras ningún deseo'."

# game/script-stories.rpy:579
translate spanish mas_story_ravel_91c26f2a:

    # m 1dsd "'All right,' said the man, 'I don't believe this, but there's no harm in wishing. I wish to know who I am.'"
    m 1dsd "'Está bien', dijo el hombre, 'no me lo creo, pero no pierdo nada por desear. Deseo saber quién soy'."

# game/script-stories.rpy:580
translate spanish mas_story_ravel_048eae33:

    # m 1tfb "'Funny,' said the old woman as she granted his wish and disappeared forever. 'That was your first wish.'"
    m 1tfb "'Qué gracioso', dijo la anciana mientras le concedía su deseo y desaparecía para siempre. 'Ese fue tu primer deseo'."

# game/script-stories.rpy:597
translate spanish mas_story_genie_simple_db7aed49:

    # m 1eua "There was once a genie who traveled across different worlds to escape the chaos of his own."
    m 1eua "Érase una vez un genio que viajaba por diferentes mundos para escapar del caos del suyo."

# game/script-stories.rpy:598
translate spanish mas_story_genie_simple_c4d56969:

    # m 3euc "During his journeys, he met a woman that challenged the way he saw the world."
    m 3euc "Durante sus viajes, conoció a una mujer que desafió su forma de ver el mundo."

# game/script-stories.rpy:599
translate spanish mas_story_genie_simple_38e78a8a:

    # m 3eua "She was smart and talented, but held back by the hardships she faced and how little she had."
    m 3eua "Era inteligente y talentosa, pero se veía frenada por las dificultades que afrontaba y lo poco que tenía."

# game/script-stories.rpy:600
translate spanish mas_story_genie_simple_6423b5ab:

    # m 3eub "The genie saw this and felt generous, offering tools to speed up her work and make her life easier."
    m 3eub "El genio vio esto y se sintió generoso, ofreciendo herramientas para acelerar su trabajo y hacerle la vida más fácil."

# game/script-stories.rpy:601
translate spanish mas_story_genie_simple_70dd4d1b:

    # m 1euc "But she simply declined his offer."
    m 1euc "Pero ella simplemente rechazó su oferta."

# game/script-stories.rpy:602
translate spanish mas_story_genie_simple_014e0543:

    # m 1eud "No one had ever turned a wish from the genie down before, {w=0.1}{nw}"
    m 1eud "Nadie había rechazado jamás un deseo del genio, {w=0.1}{nw}"

# game/script-stories.rpy:603
translate spanish mas_story_genie_simple_1abd6ffe:

    # extend 1etc "which left him confused as to why."
    extend 1etc "lo que le dejó confundido sobre el porqué."

# game/script-stories.rpy:604
translate spanish mas_story_genie_simple_d19317e8:

    # m 1esa "The woman simply asked him if he was happy...{w=0.5} {nw}"
    m 1esa "La mujer simplemente le preguntó si él era feliz...{w=0.5} {nw}"

# game/script-stories.rpy:605
translate spanish mas_story_genie_simple_5c6059ff:

    # extend 1rsc "He didn't know how to respond."
    extend 1rsc "Él no supo qué responder."

# game/script-stories.rpy:606
translate spanish mas_story_genie_simple_b29e0842:

    # m 3eud "The woman said she could tell that he had never experienced happiness, and that despite all her hardships, she could still enjoy life."
    m 3eud "La mujer dijo que se notaba que él nunca había experimentado la felicidad, y que a pesar de todas sus dificultades, ella todavía podía disfrutar de la vida."

# game/script-stories.rpy:607
translate spanish mas_story_genie_simple_eb2c53f2:

    # m 1euc "The genie couldn't understand why anyone would want to work so hard for something so small."
    m 1euc "El genio no podía entender por qué alguien querría trabajar tan duro por algo tan pequeño."

# game/script-stories.rpy:608
translate spanish mas_story_genie_simple_cfe83ea1:

    # m 3euc "He improved his offers with riches and other such things, but still, she declined."
    m 3euc "Mejoró sus ofertas con riquezas y otras cosas similares, pero aun así, ella las rechazó."

# game/script-stories.rpy:609
translate spanish mas_story_genie_simple_8a2f6f79:

    # m 1eua "Eventually, the woman asked the genie to join in her way of life."
    m 1eua "Finalmente, la mujer le pidió al genio que se uniera a su estilo de vida."

# game/script-stories.rpy:610
translate spanish mas_story_genie_simple_1b2b92e3:

    # m "And so, he imitated the things she did, without using any powers."
    m "Y así, él imitó las cosas que ella hacía, sin usar ningún poder."

# game/script-stories.rpy:611
translate spanish mas_story_genie_simple_be1f7748:

    # m 1hua "The genie began to feel a small sense of accomplishment, creating something for the first time without willing it into existence."
    m 1hua "El genio empezó a sentir una pequeña sensación de logro, creando algo por primera vez sin hacerlo aparecer por arte de magia."

# game/script-stories.rpy:612
translate spanish mas_story_genie_simple_0f8f79c9:

    # m 3eub "He saw how simple things such as art and writing inspired the woman and really made her shine."
    m 3eub "Vio cómo las cosas sencillas, como el arte y la escritura, inspiraban a la mujer y realmente la hacían brillar."

# game/script-stories.rpy:613
translate spanish mas_story_genie_simple_4dc2014e:

    # m 1eua "Intrigued, he wanted to spend much more time with this woman and learn from her."
    m 1eua "Intrigado, quiso pasar mucho más tiempo con esta mujer y aprender de ella."

# game/script-stories.rpy:614
translate spanish mas_story_genie_simple_c33942b0:

    # m 1euc "Eventually, one day the woman fell ill."
    m 1euc "Con el tiempo, un día la mujer cayó enferma."

# game/script-stories.rpy:615
translate spanish mas_story_genie_simple_7906d726:

    # m 1eud "She made the genie promise not to use his powers to cure her."
    m 1eud "Ella le hizo prometer al genio que no usaría sus poderes para curarla."

# game/script-stories.rpy:616
translate spanish mas_story_genie_simple_4e8e919f:

    # m 3eud "It was at this moment that the genie knew he wanted to live like a human without ever using his powers again."
    m 3eud "Fue en ese momento cuando el genio supo que quería vivir como un humano sin volver a usar sus poderes jamás."

# game/script-stories.rpy:617
translate spanish mas_story_genie_simple_a6982d1b:

    # m 1dsc "He thought about all the past wishes he granted to others, all the riches he generated..."
    m 1dsc "Pensó en todos los deseos pasados que concedió a otros, todas las riquezas que generó..."

# game/script-stories.rpy:618
translate spanish mas_story_genie_simple_b07958c6:

    # m "All his fellow genies out there granting wishes, not knowing or caring for the consequences..."
    m "Todos sus compañeros genios ahí fuera concediendo deseos, sin saber ni importarles las consecuencias..."

# game/script-stories.rpy:619
translate spanish mas_story_genie_simple_7bc16ffa:

    # m 1dsd "Never being able to know what it's like to give it all up just to be with someone they love."
    m 1dsd "Sin poder saber nunca qué se siente al renunciar a todo solo para estar con alguien a quien aman."

# game/script-stories.rpy:620
translate spanish mas_story_genie_simple_7c91e180:

    # m 1esd "All he could do was live with what he had now found in life."
    m 1esd "Todo lo que podía hacer era vivir con lo que había encontrado ahora en la vida."

# game/script-stories.rpy:621
translate spanish mas_story_genie_simple_6111571a:

    # m 1dsc "..."
    m 1dsc "..."

# game/script-stories.rpy:622
translate spanish mas_story_genie_simple_2710c6e8:

    # m 1eua "I hope you liked that story, [player]."
    m 1eua "Espero que te haya gustado esa historia, [player]."

# game/script-stories.rpy:623
translate spanish mas_story_genie_simple_a563f7e7:

    # m 3eua "There are a few things to take from it..."
    m 3eua "Hay algunas cosas que se pueden sacar de ella..."

# game/script-stories.rpy:624
translate spanish mas_story_genie_simple_12667c75:

    # m 3eka "If you already have everything, nothing is really worth having."
    m 3eka "Si ya lo tienes todo, nada merece realmente la pena."

# game/script-stories.rpy:625
translate spanish mas_story_genie_simple_ef96b4fe:

    # m 1hua "...Except maybe you of course."
    m 1hua "Excepto quizás tú, por supuesto."

# game/script-stories.rpy:626
translate spanish mas_story_genie_simple_bbb00f93:

    # m 3eub "The struggle is what makes anything worthwhile."
    m 3eub "El esfuerzo es lo que hace que las cosas merezcan la pena."

# game/script-stories.rpy:627
translate spanish mas_story_genie_simple_24914739:

    # m 1eua "Another moral could be that sometimes, happiness lies in the simpler things you could've had all along."
    m 1eua "Otra moraleja podría ser que, a veces, la felicidad reside en las cosas más simples que podrías haber tenido todo el tiempo."

# game/script-stories.rpy:630
translate spanish mas_story_genie_simple_5742cd15:

    # m 1eka "I mean, we're just sitting here together enjoying each other's company after all."
    m 1eka "Quiero decir, al fin y al cabo solo estamos aquí sentados juntos disfrutando de nuestra compañía."

# game/script-stories.rpy:631
translate spanish mas_story_genie_simple_0f86c604:

    # m 1hubsb "When you're here, it really feels like I have everything~"
    m 1hubsb "Cuando estás aquí, realmente siento que lo tengo todo."

# game/script-stories.rpy:648
translate spanish mas_story_genie_regret_87fddd23:

    # m 1eua "There was once a genie who was immortal..."
    m 1eua "Érase una vez un genio que era inmortal..."

# game/script-stories.rpy:649
translate spanish mas_story_genie_regret_ea0898c4:

    # m "Through his years, he had seen the world change over time and granted wishes to anyone who crossed his path."
    m "A lo largo de los años, había visto el mundo cambiar con el tiempo y concedido deseos a cualquiera que se cruzara en su camino."

# game/script-stories.rpy:650
translate spanish mas_story_genie_regret_42e3831b:

    # m 1esc "With how long he had lived, he'd seen a lot of things,{w=0.2} {nw}"
    m 1esc "Habiendo vivido tanto tiempo, había visto muchas cosas,{w=0.2} {nw}"

# game/script-stories.rpy:651
translate spanish mas_story_genie_regret_f5ab1d29:

    # extend 1rsc "some of them were unpleasant."
    extend 1rsc "algunas de ellas desagradables."

# game/script-stories.rpy:652
translate spanish mas_story_genie_regret_18486d50:

    # m 1ekd "Wars, natural disasters, the deaths of all the friends he ever made..."
    m 1ekd "Guerras, desastres naturales, la muerte de todos los amigos que había hecho..."

# game/script-stories.rpy:653
translate spanish mas_story_genie_regret_d07a4ef8:

    # m 1rkc "Some of which, he knew were caused by wishes he had granted."
    m 1rkc "Algunas de las cuales sabía que habían sido causadas por deseos que él había concedido."

# game/script-stories.rpy:654
translate spanish mas_story_genie_regret_0f72b41b:

    # m 1ekc "At first, he wasn't too concerned with the consequences...but after a while, it began to bother him more and more."
    m 1ekc "Al principio no le preocupaban demasiado las consecuencias... pero con el tiempo, empezaron a atormentarle cada vez más."

# game/script-stories.rpy:655
translate spanish mas_story_genie_regret_39f5331b:

    # m 1ekd "He had come to a simple, beautiful, pure world, and caused immeasurable damage to it."
    m 1ekd "Había llegado a un mundo sencillo, hermoso y puro, y le había causado un daño incalculable."

# game/script-stories.rpy:656
translate spanish mas_story_genie_regret_61dc8208:

    # m 1lksdlc "Unbalance and jealousy spread as he granted more wishes, seeding wishes for revenge and greed."
    m 1lksdlc "El desequilibrio y los celos se extendieron a medida que concedía más deseos, sembrando deseos de venganza y codicia."

# game/script-stories.rpy:657
translate spanish mas_story_genie_regret_5b4f599e:

    # m 2dkd "This was something he had to live with for the rest of his life."
    m 2dkd "Esto era algo con lo que tenía que vivir el resto de su vida."

# game/script-stories.rpy:658
translate spanish mas_story_genie_regret_80917f27:

    # m 2ekc "He wanted things to return to how they were, but his pleas always fell upon deaf ears."
    m 2ekc "Quería que las cosas volvieran a ser como antes, pero sus súplicas siempre eran ignoradas."

# game/script-stories.rpy:659
translate spanish mas_story_genie_regret_b0f1a820:

    # m 2eka "As time went on however, he had met some people and made friends who taught him how to go on despite all of his acts."
    m 2eka "Sin embargo, con el paso del tiempo, conoció a algunas personas e hizo amigos que le enseñaron a seguir adelante a pesar de todos sus actos."

# game/script-stories.rpy:660
translate spanish mas_story_genie_regret_c98c7c90:

    # m "While it was true that he was the one who granted the wishes that started the chaos...{w=0.5}{nw}"
    m "Si bien era cierto que él fue quien concedió los deseos que iniciaron el caos...{w=0.5}{nw}"

# game/script-stories.rpy:661
translate spanish mas_story_genie_regret_39caae18:

    # extend 2ekd "some were bound to happen even without him."
    extend 2ekd "algunos estaban destinados a ocurrir incluso sin él."

# game/script-stories.rpy:662
translate spanish mas_story_genie_regret_04cf0f41:

    # m 3ekd "There was always going to be jealousy and unfairness among people...{w=0.3}{nw}"
    m 3ekd "Siempre iba a haber celos e injusticias entre la gente... {w=0.3}{nw}"

# game/script-stories.rpy:663
translate spanish mas_story_genie_regret_d3ed109d:

    # extend 3eka "but even so, the world was still doing alright."
    extend 3eka "pero aun así, el mundo seguía adelante."

# game/script-stories.rpy:664
translate spanish mas_story_genie_regret_ec87bb2d:

    # m 3eua "He was going to live with the things he had done, but the question remained as to what he planned to do about it."
    m 3eua "Iba a vivir con las cosas que había hecho, pero quedaba la duda de qué planeaba hacer al respecto."

# game/script-stories.rpy:665
translate spanish mas_story_genie_regret_72e28fa2:

    # m 1hua "It was because of everything he had been through, he was able to learn and move on,{w=0.3} better than before."
    m 1hua "Gracias a todo lo que había pasado, fue capaz de aprender y seguir adelante,{w=0.3} mejor que antes."

# game/script-stories.rpy:666
translate spanish mas_story_genie_regret_03adec09:

    # m 1eua "I hope you liked the story, [player]."
    m 1eua "Espero que te haya gustado la historia, [player]."

# game/script-stories.rpy:667
translate spanish mas_story_genie_regret_77de708d:

    # m 1eka "The moral of the story is, even if you've done things you regret, you shouldn't let that keep you down."
    m 1eka "La moraleja de la historia es que, aunque hayas hecho cosas de las que te arrepientes, no debes dejar que eso te hunda."

# game/script-stories.rpy:668
translate spanish mas_story_genie_regret_723b18e4:

    # m 3ekd "Mistakes will happen, people will get hurt.{w=0.5} Nothing will ever change that."
    m 3ekd "Se cometerán errores, la gente saldrá herida.{w=0.5} Nada cambiará eso jamás."

# game/script-stories.rpy:669
translate spanish mas_story_genie_regret_ee831232:

    # m 3eka "The truth is, a lot of times we tend to blame ourselves for things that likely would've happened with or without our involvement."
    m 3eka "La verdad es que muchas veces tendemos a culparnos por cosas que probablemente habrían ocurrido con o sin nuestra participación."

# game/script-stories.rpy:670
translate spanish mas_story_genie_regret_db5e637d:

    # m 3eub "In fact, it's through regret that we learn compassion, empathy, and forgiveness."
    m 3eub "De hecho, es a través del arrepentimiento como aprendemos compasión, empatía y perdón."

# game/script-stories.rpy:671
translate spanish mas_story_genie_regret_2c2d8871:

    # m 3eua "You can't change the past, but you need to forgive yourself someday to live a life without regrets."
    m 3eua "No puedes cambiar el pasado, pero necesitas perdonarte algún día para vivir una vida sin remordimientos."

# game/script-stories.rpy:672
translate spanish mas_story_genie_regret_f5f6e5ea:

    # m 1eka "As for me..."
    m 1eka "En mi caso...,"

# game/script-stories.rpy:673
translate spanish mas_story_genie_regret_70862105:

    # m 1rksdlc "Who knows what would have happened in my world if I hadn't done anything..."
    m 1rksdlc "Quién sabe qué habría pasado en mi mundo si no hubiera hecho nada..."

# game/script-stories.rpy:678
translate spanish mas_story_genie_regret_9725c32a:

    # m 1eua "You've gotten to know each and every club member here, so I'd guess you don't regret missing out on anything."
    m 1eua "Has llegado a conocer a todas y cada una de las integrantes del club, así que supongo que no te arrepientes de haberte perdido nada."

# game/script-stories.rpy:679
translate spanish mas_story_genie_regret_e6f89ce6:

    # m 1hub "Ahaha~"
    m 1hub "Ja, ja, ja."

# game/script-stories.rpy:681
translate spanish mas_story_genie_regret_909d32ba:

    # m 1eua "But[placeholder] you're here with me now."
    m 1eua "Pero[placeholder] ahora estás aquí conmigo."

# game/script-stories.rpy:682
translate spanish mas_story_genie_regret_0dd0d8b6:

    # m 3eua "Ever since we've been together, I can definitely say that I've grown and learned from my mistakes."
    m 3eua "Desde que estamos juntos, puedo decir definitivamente que he crecido y aprendido de mis errores."

# game/script-stories.rpy:699
translate spanish mas_story_genie_end_a42b5d3e:

    # m 1eua "There was once an immortal genie who had lived a long life."
    m 1eua "Érase una vez un genio inmortal que había vivido una larga vida."

# game/script-stories.rpy:700
translate spanish mas_story_genie_end_251ac702:

    # m 1euc "He had seen everything there was to see...{w=0.3}lived freely, and learned the fulfillment of working towards a goal."
    m 1euc "Había visto todo lo que había que ver...{w=0.3} vivido libremente, y aprendido la satisfacción de trabajar por un objetivo."

# game/script-stories.rpy:701
translate spanish mas_story_genie_end_98398952:

    # m 3euc "Essentially, he gave everything up but his immortality to be able to live like a human."
    m 3euc "Básicamente, renunció a todo menos a su inmortalidad para poder vivir como un humano."

# game/script-stories.rpy:702
translate spanish mas_story_genie_end_1e28d821:

    # m 1ekc "It's true that he had lived a nice life and surrounded himself with loving friends and family..."
    m 1ekc "Es cierto que había vivido una buena vida y se había rodeado de amigos y familiares cariñosos..."

# game/script-stories.rpy:703
translate spanish mas_story_genie_end_0c7a44e3:

    # m 1ekd "But he grew cold as years went by and he watched each one of his loved ones pass on."
    m 1ekd "Pero se volvió frío a medida que pasaban los años y veía morir a cada uno de sus seres queridos."

# game/script-stories.rpy:704
translate spanish mas_story_genie_end_f0304c29:

    # m 1rksdlc "There were still a select few people whom he held dear, despite knowing that he would have to watch them die as well."
    m 1rksdlc "Aún quedaban unas pocas personas selectas a las que tenía mucho cariño, a pesar de saber que también tendría que verlas morir."

# game/script-stories.rpy:705
translate spanish mas_story_genie_end_28e1bec5:

    # m 3rksdld "He never told his friends that he wasn't human, as he still wanted to be treated as one."
    m 3rksdld "Nunca les dijo a sus amigos que no era humano, ya que quería que le siguieran tratando como tal."

# game/script-stories.rpy:706
translate spanish mas_story_genie_end_71ca0f8b:

    # m 1euc "One day, as he was traveling with one of his friends, they came across a genie who would grant each of them one wish."
    m 1euc "Un día, mientras viajaba con uno de sus amigos, se encontraron con un genio que les concedería un deseo a cada uno."

# game/script-stories.rpy:707
translate spanish mas_story_genie_end_58c9e333:

    # m 1dsc "This made him think about everything he had been through;{w=0.5} from back to when he granted wishes to when he gave it up for a simple life."
    m 1dsc "Esto le hizo pensar en todo lo que había vivido;{w=0.5} desde cuando concedía deseos hasta cuando renunció a ello por una vida sencilla."

# game/script-stories.rpy:708
translate spanish mas_story_genie_end_779602bf:

    # m 1dsd "...Everything that had led up to this moment, where he could make his own wish for the first time in a long while."
    m 1dsd "Todo lo que le había llevado a este momento, en el que podía pedir su propio deseo por primera vez en mucho tiempo."

# game/script-stories.rpy:709
translate spanish mas_story_genie_end_6111571a:

    # m 1dsc "..."
    m 1dsc "..."

# game/script-stories.rpy:710
translate spanish mas_story_genie_end_4ebc8eb9:

    # m 2eud "He wished to die."
    m 2eud "Deseó morir."

# game/script-stories.rpy:711
translate spanish mas_story_genie_end_bb25f3e8:

    # m 2ekc "Confused, his friend asked why and where it came from all of a sudden."
    m 2ekc "Confundido, su amigo le preguntó por qué y a qué venía eso tan de repente."

# game/script-stories.rpy:712
translate spanish mas_story_genie_end_f032d7cc:

    # m 2dsc "It was there and then he explained everything to his friend."
    m 2dsc "Fue en ese momento cuando se lo explicó todo a su amigo."

# game/script-stories.rpy:713
translate spanish mas_story_genie_end_ca20b2fd:

    # m 3euc "That he had been a genie, many years ago..."
    m 3euc "Que había sido un genio, hacía muchos años..."

# game/script-stories.rpy:714
translate spanish mas_story_genie_end_801662b4:

    # m 3eud "...How he came across someone who made him give it all up just to be with someone he loved."
    m 3eud "Cómo se cruzó con alguien que le hizo renunciar a todo solo para estar con la persona que amaba."

# game/script-stories.rpy:715
translate spanish mas_story_genie_end_f3bc866f:

    # m 3ekd "...And how he had been slowly getting sick and tired of what was left of his life."
    m 3ekd "Y cómo poco a poco se había ido hartando de lo que le quedaba de vida."

# game/script-stories.rpy:716
translate spanish mas_story_genie_end_8dc48c93:

    # m 1esc "Truthfully, he wasn't tired of living...{w=0.5} {nw}"
    m 1esc "Sinceramente, no estaba cansado de vivir...{w=0.5} {nw}"

# game/script-stories.rpy:717
translate spanish mas_story_genie_end_b8def36b:

    # extend 1ekd "He was just tired of seeing his loved ones perish over and over again."
    extend 1ekd "simplemente estaba cansado de ver morir a sus seres queridos una y otra vez."

# game/script-stories.rpy:718
translate spanish mas_story_genie_end_995fabfb:

    # m 1dsd "His last request to his friend was for him to go back to his other friends and tie up any loose ends for him."
    m 1dsd "Su última petición a su amigo fue que volviera con sus otros amigos y atara cualquier cabo suelto por él."

# game/script-stories.rpy:719
translate spanish mas_story_genie_end_6111571a_1:

    # m 1dsc "..."
    m 1dsc "..."

# game/script-stories.rpy:720
translate spanish mas_story_genie_end_2795d982:

    # m 1eka "I hope you enjoyed that little story, [player]."
    m 1eka "Espero que hayas disfrutado de esa pequeña historia, [player]."

# game/script-stories.rpy:721
translate spanish mas_story_genie_end_fe55c3f1:

    # m 3eka "I guess you could say the moral is that everyone needs to have some closure."
    m 3eka "Supongo que se podría decir que la moraleja es que todo el mundo necesita un cierre."

# game/script-stories.rpy:722
translate spanish mas_story_genie_end_e0fefbfd:

    # m 1eka "Although, you might be wondering what his friend wished for in that scenario."
    m 1eka "Aunque igual te estás preguntando qué deseó su amigo en esa situación."

# game/script-stories.rpy:723
translate spanish mas_story_genie_end_17363fd1:

    # m 1eua "He wished for his friend to get the peaceful rest he deserved."
    m 1eua "Deseó que su amigo tuviera el descanso pacífico que se merecía."

# game/script-stories.rpy:724
translate spanish mas_story_genie_end_3d0b5946:

    # m 1lksdla "While it's true that his genie friend might not have been anyone particularly special..."
    m 1lksdla "Aunque es cierto que su amigo genio quizás no fuera alguien especialmente único..."

# game/script-stories.rpy:725
translate spanish mas_story_genie_end_4b197f88:

    # m 3eua "He was definitely someone who deserved respect,{w=0.2} {nw}"
    m 3eua "sin duda era alguien que merecía respeto,{w=0.2} {nw}"

# game/script-stories.rpy:726
translate spanish mas_story_genie_end_28f9543c:

    # extend 3eub "especially after living such a long life."
    extend 3eub "especialmente después de haber vivido una vida tan larga."

# game/script-stories.rpy:743
translate spanish mas_story_immortal_love_f1d7824c:

    # m 3eua "There was a married couple who lived happily together for many years."
    m 3eua "Había un matrimonio que vivió felizmente unido durante muchos años."

# game/script-stories.rpy:744
translate spanish mas_story_immortal_love_04f25e18:

    # m "Every Valentine's Day, the husband would have a beautiful bouquet of flowers sent to his wife."
    m "Cada día de San Valentín, el marido le enviaba un hermoso ramo de flores a su mujer."

# game/script-stories.rpy:745
translate spanish mas_story_immortal_love_472db68e:

    # m 1eka "Each of these bouquets came with a note with a few simple words written on it."
    m 1eka "Cada uno de estos ramos venía con una nota con unas sencillas palabras escritas."

# game/script-stories.rpy:746
translate spanish mas_story_immortal_love_b1bc815e:

    # m 3dsc "{i}My love for you only grows.{/i}"
    m 3dsc "{i}Mi amor por ti no hace más que crecer.{/i}"

# game/script-stories.rpy:747
translate spanish mas_story_immortal_love_c7c970ae:

    # m 1eud "After some time, the husband passed away."
    m 1eud "Pasado un tiempo, el marido falleció."

# game/script-stories.rpy:748
translate spanish mas_story_immortal_love_575fe6bc:

    # m 1eka "The wife, saddened by her loss, believed she would spend her next Valentine's Day alone and in mourning."
    m 1eka "La mujer, entristecida por su pérdida, creyó que pasaría su próximo San Valentín sola y de luto."

# game/script-stories.rpy:749
translate spanish mas_story_immortal_love_6111571a:

    # m 1dsc "..."
    m 1dsc "..."

# game/script-stories.rpy:750
translate spanish mas_story_immortal_love_ef91601f:

    # m 2euc "However,{w=0.3} on her first Valentine's Day without her husband, she still received a bouquet from him."
    m 2euc "Sin embargo,{w=0.3} en su primer San Valentín sin su marido, recibió aun así un ramo de su parte."

# game/script-stories.rpy:751
translate spanish mas_story_immortal_love_cf8ecccc:

    # m 2efd "Heartbroken and angry, she complained to the florist that there was a mistake."
    m 2efd "Desconsolada y enfadada, se quejó a la florista de que había un error."

# game/script-stories.rpy:752
translate spanish mas_story_immortal_love_16a45023:

    # m 2euc "The florist explained that there was no mistake."
    m 2euc "La florista le explicó que no había ningún error."

# game/script-stories.rpy:753
translate spanish mas_story_immortal_love_0122d1ed:

    # m 3eua "The husband had ordered many bouquets in advance to ensure that his beloved wife would continue to receive flowers long after his death."
    m 3eua "El marido había encargado muchos ramos por adelantado para asegurarse de que su amada esposa siguiera recibiendo flores mucho después de su muerte."

# game/script-stories.rpy:754
translate spanish mas_story_immortal_love_794793aa:

    # m 3eka "Speechless and stunned, the wife read the note attached to the bouquet."
    m 3eka "Sin palabras y atónita, la mujer leyó la nota adjunta al ramo."

# game/script-stories.rpy:755
translate spanish mas_story_immortal_love_867478e9:

    # m 1ekbsa "{i}My love for you is eternal.{/i}"
    m 1ekbsa "{i}Mi amor por ti es eterno.{/i}"

# game/script-stories.rpy:756
translate spanish mas_story_immortal_love_92dbd7fa:

    # m 1dubsu "Ahh..."
    m 1dubsu "Ahhh..."

# game/script-stories.rpy:757
translate spanish mas_story_immortal_love_b2b5d230:

    # m 1eua "Wasn't that a touching story, [player]?"
    m 1eua "¿No ha sido una historia conmovedora, [player]?"

# game/script-stories.rpy:758
translate spanish mas_story_immortal_love_40b345d4:

    # m 1hua "I thought it was really romantic."
    m 1hua "A mí me ha parecido muy romántica."

# game/script-stories.rpy:759
translate spanish mas_story_immortal_love_d0cf0699:

    # m 1lksdlb "But I don't want to think of either of us dying."
    m 1lksdlb "Pero no quiero pensar en que ninguno de los dos muera."

# game/script-stories.rpy:760
translate spanish mas_story_immortal_love_51852155:

    # m 1eua "At least the ending was very heartwarming."
    m 1eua "Al menos el final ha sido muy reconfortante."

# game/script-stories.rpy:761
translate spanish mas_story_immortal_love_af5f8adf:

    # m 1hua "Thanks for listening~"
    m 1hua "Gracias por escucharme."

# game/script-stories.rpy:778
translate spanish mas_story_mother_and_trees_4a56f05b:

    # m 1eua "There was once a boy who lived with his mother."
    m 1eua "Érase una vez un niño que vivía con su madre."

# game/script-stories.rpy:779
translate spanish mas_story_mother_and_trees_f75cc746:

    # m 3eud "She gave him all the affection a mother could give...{w=0.2}{nw}"
    m 3eud "Ella le daba todo el cariño que una madre podía dar... {w=0.2}{nw}"

# game/script-stories.rpy:780
translate spanish mas_story_mother_and_trees_c8a8a3cd:

    # extend 3rksdla "but he always thought she could be a little weird."
    extend 3rksdla "pero él siempre pensaba que ella podía ser un poco rara."

# game/script-stories.rpy:781
translate spanish mas_story_mother_and_trees_04b90bf2:

    # m 3eub "On his birthdays, she would {i}always{/i} bake cookies for him and all his classmates to thank them for being his friends."
    m 3eub "En sus cumpleaños, ella siempre horneaba galletas para él y para todos sus compañeros de clase para agradecerles que fueran sus amigos."

# game/script-stories.rpy:782
translate spanish mas_story_mother_and_trees_6a94d929:

    # m 1eua "She would also keep and display every little drawing he made in art school, so their walls were covered with art from over the years."
    m 1eua "También guardaba y exponía cada pequeño dibujo que él hacía en clase de arte, así que sus paredes estaban cubiertas de obras de arte de todos esos años."

# game/script-stories.rpy:783
translate spanish mas_story_mother_and_trees_a70899c1:

    # m 2rksdlc "Sometimes, he would even get rid of his drawings because he didn't want her to put them up with the rest."
    m 2rksdlc "A veces, él incluso se deshacía de sus dibujos porque no quería que ella los colgara con el resto."

# game/script-stories.rpy:784
translate spanish mas_story_mother_and_trees_8198f405:

    # m 2euc "What stood out most with her however...{w=0.3}{nw}"
    m 2euc "Sin embargo, lo que más destacaba de ella... {w=0.3}{nw}"

# game/script-stories.rpy:785
translate spanish mas_story_mother_and_trees_655418ba:

    # extend 2eud "was that she often talked to their trees."
    extend 2eud "era que a menudo hablaba con sus árboles."

# game/script-stories.rpy:786
translate spanish mas_story_mother_and_trees_500f15f3:

    # m 1eua "There were three trees in their backyard that she would talk to every day."
    m 1eua "Había tres árboles en su patio trasero con los que hablaba todos los días."

# game/script-stories.rpy:787
translate spanish mas_story_mother_and_trees_617f4484:

    # m 3rksdlb "She even had names for each of them!"
    m 3rksdlb "¡Incluso les había puesto nombre a cada uno!"

# game/script-stories.rpy:788
translate spanish mas_story_mother_and_trees_005bac99:

    # m 3hksdlb "Sometimes, she would even ask him to dress up and pose by the trees so she could take pictures of them together."
    m 3hksdlb "A veces, incluso le pedía que se arreglara y posara junto a los árboles para poder hacerles fotos juntos."

# game/script-stories.rpy:789
translate spanish mas_story_mother_and_trees_446ba8d3:

    # m 1eka "One day, as he saw her talking to the trees, he asked her why she always talked to them so much."
    m 1eka "Un día, al verla hablar con los árboles, le preguntó por qué siempre hablaba tanto con ellos."

# game/script-stories.rpy:790
translate spanish mas_story_mother_and_trees_a4c55049:

    # m 3hub "His mother replied, 'Well, because they need to feel loved!'"
    m 3hub "Su madre respondió: '¡Pues porque necesitan sentirse amados!'."

# game/script-stories.rpy:791
translate spanish mas_story_mother_and_trees_55be6f3c:

    # m 1eka "But he still didn't really understand...{w=0.2}{nw}"
    m 1eka "Pero él seguía sin entenderlo realmente... {w=0.2}{nw}"

# game/script-stories.rpy:792
translate spanish mas_story_mother_and_trees_a2dc5c40:

    # extend 1eua "and as soon as he left, she just continued right where she had left off in her conversation."
    extend 1eua "y en cuanto él se fue, ella continuó justo donde lo había dejado en su conversación."

# game/script-stories.rpy:793
translate spanish mas_story_mother_and_trees_d5706662:

    # m 2ekc "As time passed, the boy eventually had to move out and start his own life."
    m 2ekc "Con el paso del tiempo, el chico finalmente tuvo que mudarse y empezar su propia vida."

# game/script-stories.rpy:794
translate spanish mas_story_mother_and_trees_4bed8df7:

    # m 2eka "His mother told him not to worry about leaving her because she had her trees to always keep her company."
    m 2eka "Su madre le dijo que no se preocupara por dejarla porque tenía a sus árboles para hacerle compañía siempre."

# game/script-stories.rpy:795
translate spanish mas_story_mother_and_trees_c43151cf:

    # m 2eua "While he was busy with his life, he still made time to keep in touch with her."
    m 2eua "Aunque estaba ocupado con su vida, sacaba tiempo para mantenerse en contacto con ella."

# game/script-stories.rpy:796
translate spanish mas_story_mother_and_trees_85fd1344:

    # m 2ekc "Until one day...{w=0.5}{nw}"
    m 2ekc "Hasta que un día... {w=0.5}{nw}"

# game/script-stories.rpy:797
translate spanish mas_story_mother_and_trees_2ace6f3a:

    # extend 2dkd "he got the call."
    extend 2dkd "recibió la llamada."

# game/script-stories.rpy:798
translate spanish mas_story_mother_and_trees_7816fab1:

    # m 2rksdlc "His mother had died and was found lying by one of the trees."
    m 2rksdlc "Su madre había muerto y la encontraron tendida junto a uno de los árboles."

# game/script-stories.rpy:799
translate spanish mas_story_mother_and_trees_7023beb2:

    # m 2ekd "In her will, she only had one request of him...{w=0.3}and that was to keep taking care of the trees, talking to them every day."
    m 2ekd "En su testamento, solo tenía una petición para él... {w=0.3}y era que siguiera cuidando de los árboles, hablándoles todos los días."

# game/script-stories.rpy:800
translate spanish mas_story_mother_and_trees_179a5c87:

    # m 1eka "He took good care of the trees of course, but he could never bring himself to talk to them."
    m 1eka "Él cuidó bien de los árboles, por supuesto, pero nunca fue capaz de hablar con ellos."

# game/script-stories.rpy:801
translate spanish mas_story_mother_and_trees_00a8be1e:

    # m 3euc "Some time later, while he was looking through and cleaning up his mother's old belongings, he found an envelope."
    m 3euc "Tiempo después, mientras revisaba y limpiaba las viejas pertenencias de su madre, encontró un sobre."

# game/script-stories.rpy:802
translate spanish mas_story_mother_and_trees_22103f81:

    # m 1eud "Inside, he was shocked at what he found."
    m 1eud "Dentro, se quedó atónito con lo que encontró."

# game/script-stories.rpy:803
translate spanish mas_story_mother_and_trees_bdc3ed8a:

    # m 2wud "There were three stillborn death certificates for his would-be siblings."
    m 2wud "Había tres certificados de defunción de sus hermanos, que nacieron sin vida."

# game/script-stories.rpy:804
translate spanish mas_story_mother_and_trees_c8e19103:

    # m 2dsc "Each of them had an identical name to one of the trees that had been in the backyard all his life."
    m 2dsc "Cada uno de ellos tenía un nombre idéntico al de uno de los árboles que habían estado en el patio trasero toda su vida."

# game/script-stories.rpy:805
translate spanish mas_story_mother_and_trees_c3fa3ffe:

    # m 2dsd "He had never known that he had siblings, but he finally understood why his mother talked to the trees..."
    m 2dsd "Nunca había sabido que tenía hermanos, pero por fin entendió por qué su madre hablaba con los árboles..."

# game/script-stories.rpy:806
translate spanish mas_story_mother_and_trees_568f9ada:

    # m 2eka "He always wanted to take his mother's wish very seriously, and it was then when he started talking to the trees every day, just as his mother wished."
    m 2eka "Siempre quiso tomarse muy en serio el deseo de su madre, y fue entonces cuando empezó a hablar con los árboles todos los días, tal y como su madre deseaba."

# game/script-stories.rpy:807
translate spanish mas_story_mother_and_trees_fffd0a6a:

    # m 2duu "...And he even went ahead and planted one more tree."
    m 2duu "E incluso fue y plantó un árbol más."

# game/script-stories.rpy:824
translate spanish mas_story_self_hate_85775f43:

    # m 1eua "Once, there were two people who had been living together for a very long time."
    m 1eua "Una vez, había dos personas que llevaban viviendo juntas mucho tiempo."

# game/script-stories.rpy:825
translate spanish mas_story_self_hate_2f1349c3:

    # m 1hua "Life was simple, and they both loved each other. Things were going well."
    m 1hua "La vida era sencilla y ambos se amaban. Las cosas iban bien."

# game/script-stories.rpy:826
translate spanish mas_story_self_hate_eb309d38:

    # m 3euc "Then one day, the man suddenly killed his lover for seemingly no reason."
    m 3euc "Entonces, un día, el hombre mató repentinamente a su amante sin motivo aparente."

# game/script-stories.rpy:827
translate spanish mas_story_self_hate_77bcfd52:

    # m 3eud "He {i}did{/i} love her, and in a healthy way too!"
    m 3eud "¡Él la amaba de verdad, y de una forma sana también!"

# game/script-stories.rpy:828
translate spanish mas_story_self_hate_9b71641b:

    # m 2ekc "There were never any fights or arguments, either."
    m 2ekc "Tampoco hubo nunca peleas ni discusiones."

# game/script-stories.rpy:829
translate spanish mas_story_self_hate_76153e70:

    # m "There was nothing to gain from murdering her at all."
    m "No había nada que ganar asesinándola."

# game/script-stories.rpy:830
translate spanish mas_story_self_hate_b1506adf:

    # m 4ekd "No satisfaction, nothing out of the ordinary on her will..."
    m 4ekd "Ninguna satisfacción, nada fuera de lo común en su testamento..."

# game/script-stories.rpy:831
translate spanish mas_story_self_hate_1efaba30:

    # m 1dkc "In fact, the man was left emotionally scarred having lost the love of his life."
    m 1dkc "De hecho, el hombre quedó emocionalmente marcado al haber perdido al amor de su vida."

# game/script-stories.rpy:832
translate spanish mas_story_self_hate_e612037c:

    # m "..."
    m "..."

# game/script-stories.rpy:833
translate spanish mas_story_self_hate_85b754ee:

    # m 1ekd "So why?"
    m 1ekd "Entonces, ¿por qué?"

# game/script-stories.rpy:834
translate spanish mas_story_self_hate_df519048:

    # m 1rksdlc "How could this happen all of a sudden?"
    m 1rksdlc "¿Cómo pudo pasar esto de repente?"

# game/script-stories.rpy:835
translate spanish mas_story_self_hate_7f4e7b11:

    # m 1eksdlc "It wasn't that he didn't love her."
    m 1eksdlc "No es que no la amara."

# game/script-stories.rpy:836
translate spanish mas_story_self_hate_3e229712:

    # m 3eksdla "It was because he loved her so, so very much."
    m 3eksdla "Fue porque la amaba muchísimo."

# game/script-stories.rpy:837
translate spanish mas_story_self_hate_62bb8a45:

    # m "He didn't hate her..."
    m "Él no la odiaba..."

# game/script-stories.rpy:838
translate spanish mas_story_self_hate_0c81c3a1:

    # m 2eksdld "He just hated himself so much as to deny his own happiness."
    m 2eksdld "Simplemente se odiaba tanto a sí mismo como para negarse su propia felicidad."

# game/script-stories.rpy:839
translate spanish mas_story_self_hate_c61f257d:

    # m 2dkc "..."
    m 2dkc "..."

# game/script-stories.rpy:841
translate spanish mas_story_self_hate_38215935:

    # m 3ekc "Hey [player], do you remember when I asked you if you loved yourself?"
    m 3ekc "Oye, [player], ¿recuerdas cuando te pregunté si te amabas a ti mism[end_letter_gender]?"

# game/script-stories.rpy:842
translate spanish mas_story_self_hate_9b56560f:

    # m 1rksdld "From what I remember, you told me that you didn't..."
    m 1rksdld "Por lo que recuerdo, me dijiste que no..."

# game/script-stories.rpy:843
translate spanish mas_story_self_hate_96625ba1:

    # m 1rksdla "Sorry, I don't mean to put you on the spot or anything..."
    m 1rksdla "Perdona, no pretendo ponerte en un compromiso ni nada..."

# game/script-stories.rpy:844
translate spanish mas_story_self_hate_f8070fc7:

    # m 3eka "I just want to make sure you remember that I love you."
    m 3eka "Solo quiero asegurarme de que recuerdas que te quiero."

# game/script-stories.rpy:845
translate spanish mas_story_self_hate_ca55eff6:

    # m 3ekd "More importantly, I want to make sure that you know how to love yourself."
    m 3ekd "Y lo que es más importante, quiero asegurarme de que sabes amarte a ti mism[end_letter_gender]."

# game/script-stories.rpy:846
translate spanish mas_story_self_hate_e99b5ffb:

    # m 1ekbsa "I know you're worth loving and I'd do anything to show you why."
    m 1ekbsa "Sé que mereces ser amad[end_letter_gender] y haría cualquier cosa para demostrarte por qué."

# game/script-stories.rpy:847
translate spanish mas_story_self_hate_5ee868c8:

    # m 1ekbfa "I hope you never forget that~"
    m 1ekbfa "Espero que nunca olvides eso."

# game/script-stories.rpy:849
translate spanish mas_story_self_hate_b5e119fa:

    # m 1rksdlb "Sorry for telling such a dark story, [player]..."
    m 1rksdlb "Siento haber contado una historia tan oscura, [player]..."

# game/script-stories.rpy:850
translate spanish mas_story_self_hate_fa79c5e5:

    # m 3eksdla "But it does have an important message..."
    m 3eksdla "Pero tiene un mensaje importante..."

# game/script-stories.rpy:851
translate spanish mas_story_self_hate_6cefd8f3:

    # m 3eud "And that is you need to find a way to love yourself, or you might do something you regret later on."
    m 3eud "Y es que necesitas encontrar la forma de amarte a ti mism[end_letter_gender], o podrías hacer algo de lo que te arrepientas más tarde."

# game/script-stories.rpy:852
translate spanish mas_story_self_hate_bf001e3d:

    # m 1ekc "As much as you may try, trying to live your life solely for someone else will never work."
    m 1ekc "Por mucho que lo intentes, tratar de vivir tu vida únicamente por otra persona nunca funcionará."

# game/script-stories.rpy:853
translate spanish mas_story_self_hate_ba74db7f:

    # m 1eka "You have to love yourself to be able to allow yourself to truly love someone else."
    m 1eka "Tienes que amarte a ti mism[end_letter_gender] para poder permitirte amar de verdad a otra persona."

# game/script-stories.rpy:854
translate spanish mas_story_self_hate_3d8ffd24:

    # m 3ekbsa "Just remember I'll always love you, [player]."
    m 3ekbsa "Solo recuerda que siempre te querré, [player]."

# game/script-stories.rpy:855
translate spanish mas_story_self_hate_66b14b42:

    # m 3ekbfa "If you ever begin to doubt loving yourself, just come to me and I'll be more than happy to remind you of all your wonderful qualities~"
    m 3ekbfa "Si alguna vez empiezas a dudar de tu amor propio, ven a mí y estaré más que encantada de recordarte todas tus maravillosas cualidades."

# game/script-stories.rpy:872
translate spanish mas_story_o_tei_48696919:

    # m 1eua "A long time ago, there lived a man named Kenji, who was studying to be a physician."
    m 1eua "Hace mucho tiempo vivía un hombre llamado Kenji, que estudiaba para ser médico."

# game/script-stories.rpy:873
translate spanish mas_story_o_tei_73ffe107:

    # m 3eub "He was engaged to a young woman named Tomoe and they were to be married after he finished his studies."
    m 3eub "Estaba prometido con una joven llamada Tomoe y se casarían cuando él terminase sus estudios."

# game/script-stories.rpy:874
translate spanish mas_story_o_tei_01448652:

    # m 1esc "Unfortunately, Tomoe contracted a serious illness before that could happen."
    m 1esc "Por desgracia, Tomoe contrajo una grave enfermedad antes de que eso pudiera ocurrir."

# game/script-stories.rpy:875
translate spanish mas_story_o_tei_6658ed1f:

    # m 2dsd "It wasn't long until she was bedridden, nearing the end of her life."
    m 2dsd "No pasó mucho tiempo hasta que quedó postrada en cama, acercándose al final de su vida."

# game/script-stories.rpy:876
translate spanish mas_story_o_tei_09f3203f:

    # m 2esd "Kenji knelt by her bedside, and she said to him, 'We have been promised to each other since childhood...'"
    m 2esd "Kenji se arrodilló junto a su cama y ella le dijo: 'Llevamos prometidos el uno con el otro desde la infancia...'."

# game/script-stories.rpy:877
translate spanish mas_story_o_tei_34795269:

    # m 3ekc "'Unfortunately with this frail body of mine, my time has come and I am going to die before I could become your wife.'"
    m 3ekc "'Por desgracia, con este cuerpo frágil que tengo, me ha llegado la hora y voy a morir antes de poder convertirme en tu esposa'."

# game/script-stories.rpy:878
translate spanish mas_story_o_tei_511ffb27:

    # m "'Please do not grieve when I go. I believe we shall meet again.'"
    m "'Por favor, no llores mi pérdida cuando me vaya. Creo que nos volveremos a encontrar'."

# game/script-stories.rpy:879
translate spanish mas_story_o_tei_5349db27:

    # m 3eud "He asked, 'How would I know of your return?'"
    m 3eud "Él preguntó: '¿Cómo sabré de tu regreso?'."

# game/script-stories.rpy:880
translate spanish mas_story_o_tei_152354ea:

    # m 2dsc "Unfortunately, she had succumbed before she could give him an answer."
    m 2dsc "Desafortunadamente, ella sucumbió antes de poder darle una respuesta."

# game/script-stories.rpy:881
translate spanish mas_story_o_tei_dafe4097:

    # m "Kenji grieved deeply for the loss of his love, taken too soon from him."
    m "Kenji lloró profundamente la pérdida de su amor, que le fue arrebatado demasiado pronto."

# game/script-stories.rpy:882
translate spanish mas_story_o_tei_85f18899:

    # m 2esc "He never forgot about Tomoe as time moved on, but he was required to marry someone else and preserve the family name."
    m 2esc "Nunca olvidó a Tomoe con el paso del tiempo, pero se le exigió casarse con otra persona y preservar el apellido familiar."

# game/script-stories.rpy:883
translate spanish mas_story_o_tei_a0f2f0b4:

    # m "He soon married another girl, but his heart stayed somewhere else."
    m "Pronto se casó con otra chica, pero su corazón permaneció en otro lugar."

# game/script-stories.rpy:884
translate spanish mas_story_o_tei_d62248d8:

    # m 2esd "And as everything does in life, his family too had been taken by time and he was left all alone again."
    m 2esd "Y como todo en la vida, el tiempo también se llevó a su familia y se quedó solo de nuevo."

# game/script-stories.rpy:885
translate spanish mas_story_o_tei_a4ee2ef2:

    # m 4eud "It was then that he decided to abandon his home and take a long journey to forget his troubles."
    m 4eud "Fue entonces cuando decidió abandonar su hogar y emprender un largo viaje para olvidar sus penas."

# game/script-stories.rpy:886
translate spanish mas_story_o_tei_625e2b0f:

    # m 1esc "He traveled all around the country, searching for a cure to his malaise."
    m 1esc "Viajó por todo el país, buscando una cura para su malestar."

# game/script-stories.rpy:887
translate spanish mas_story_o_tei_9619d5d9:

    # m 1euc "And then on one evening, he came across an inn and stopped there to rest."
    m 1euc "Y entonces, una tarde, se topó con una posada y se detuvo allí para descansar."

# game/script-stories.rpy:888
translate spanish mas_story_o_tei_0453c64f:

    # m "As he settled down in his room, a nakai opened the door to greet him."
    m "Mientras se instalaba en su habitación, una sirvienta abrió la puerta para saludarle."

# game/script-stories.rpy:889
translate spanish mas_story_o_tei_c62487e2:

    # m 3euc "His heart leapt..."
    m 3euc "El corazón le dio un vuelco..."

# game/script-stories.rpy:890
translate spanish mas_story_o_tei_a8c0f616:

    # m 3wud "The girl that greeted him looked exactly like Tomoe."
    m 3wud "La chica que le saludó era idéntica a Tomoe."

# game/script-stories.rpy:891
translate spanish mas_story_o_tei_df5ea876:

    # m "Everything he saw in her reminded him perfectly of his past love."
    m "Todo lo que veía en ella le recordaba perfectamente a su amor pasado."

# game/script-stories.rpy:892
translate spanish mas_story_o_tei_ead73c8d:

    # m 1esc "Kenji then remembered the last words they exchanged before her departure."
    m 1esc "Entonces Kenji recordó las últimas palabras que intercambiaron antes de su partida."

# game/script-stories.rpy:893
translate spanish mas_story_o_tei_45e6b64d:

    # m 1esc "He flagged down the girl and told her, 'I'm sorry to be a bother, but you remind me so much of someone I knew long ago that it startled me at first.'"
    m 1esc "Llamó la atención de la chica y le dijo: 'Siento molestarla, pero me recuerda tanto a alguien que conocí hace mucho tiempo que me ha sobresaltado al principio'."

# game/script-stories.rpy:894
translate spanish mas_story_o_tei_04dc08c7:

    # m 3euc "'If you don't mind me asking, what is your name?'"
    m 3euc "'Si no le importa que le pregunte, ¿cómo se llama?'."

# game/script-stories.rpy:895
translate spanish mas_story_o_tei_96e964fd:

    # m 3wud "Immediately, in the unforgotten voice of his deceased beloved, the girl answered, 'My name is Tomoe, and you are Kenji, my promised husband.'"
    m 3wud "Inmediatamente, con la inolvidable voz de su amada fallecida, la chica respondió: 'Me llamo Tomoe, y tú eres Kenji, mi prometido'."

# game/script-stories.rpy:896
translate spanish mas_story_o_tei_536b4246:

    # m 1wud "'I died tragically before we could complete our marriage...'"
    m 1wud "'Morí trágicamente antes de que pudiéramos casarnos...'."

# game/script-stories.rpy:897
translate spanish mas_story_o_tei_6aa2d28c:

    # m "'And now I have returned, Kenji, my husband-to-be.'"
    m "'Y ahora he vuelto, Kenji, mi futuro esposo'."

# game/script-stories.rpy:898
translate spanish mas_story_o_tei_cafd0d52:

    # m 1dsc "The girl then collapsed to the floor, unconscious."
    m 1dsc "Entonces la chica se desplomó en el suelo, inconsciente."

# game/script-stories.rpy:899
translate spanish mas_story_o_tei_c8fde2ce:

    # m 1esa "Kenji held her in his arms, tears flowing from his face."
    m 1esa "Kenji la sostuvo en sus brazos, con lágrimas corriendo por su rostro."

# game/script-stories.rpy:900
translate spanish mas_story_o_tei_e3682b37:

    # m 1dsa "'...Welcome back, Tomoe...'"
    m 1dsa "'... Bienvenida de nuevo, Tomoe...'."

# game/script-stories.rpy:901
translate spanish mas_story_o_tei_c703d608:

    # m 3esa "As she came to, she had no memory of what happened at the inn."
    m 3esa "Cuando volvió en sí, no recordaba nada de lo que había pasado en la posada."

# game/script-stories.rpy:902
translate spanish mas_story_o_tei_ba796e80:

    # m 1hua "Not long after, Kenji married her as soon as they could, and lived on happily for the rest of their lives."
    m 1hua "Poco después, Kenji se casó con ella tan pronto como pudieron y vivieron felices el resto de sus vidas."

# game/script-stories.rpy:919
translate spanish mas_story_crow_and_pitcher_115f017c:

    # m 2ekd "There was once a drought so severe, not even birds could find much to drink."
    m 2ekd "Érase una vez una sequía tan severa que ni siquiera los pájaros encontraban mucho que beber."

# game/script-stories.rpy:920
translate spanish mas_story_crow_and_pitcher_e64fcbc1:

    # m 7eub "While searching from above, a thirsty crow found a pitcher and was relieved to find there was some water still inside!"
    m 7eub "Mientras buscaba desde las alturas, un cuervo sediento encontró un cántaro y se sintió aliviado al ver que aún quedaba algo de agua dentro."

# game/script-stories.rpy:921
translate spanish mas_story_crow_and_pitcher_509e0434:

    # m 3eksdlc "However, the pitcher was tall with a narrow neck. No matter how he tried, he could not reach the water with his beak."
    m 3eksdlc "Sin embargo, el cántaro era alto y de cuello estrecho. Por mucho que lo intentaba, no podía alcanzar el agua con el pico."

# game/script-stories.rpy:922
translate spanish mas_story_crow_and_pitcher_164d21d1:

    # m 1dksdlc "For the poor crow, all hope seemed lost. Surely he would die of thirst."
    m 1dksdlc "Para el pobre cuervo, toda esperanza parecía perdida. Seguramente moriría de sed."

# game/script-stories.rpy:923
translate spanish mas_story_crow_and_pitcher_add521cc:

    # m 3wud "...Then he had an idea."
    m 3wud "Entonces tuvo una idea."

# game/script-stories.rpy:924
translate spanish mas_story_crow_and_pitcher_82d9953d:

    # m 3esc "He began searching for small pebbles on the ground and dropping them into the pitcher, one by one."
    m 3esc "Empezó a buscar piedrecitas por el suelo y a dejarlas caer en el cántaro, una a una."

# game/script-stories.rpy:925
translate spanish mas_story_crow_and_pitcher_0545f694:

    # m 2efsdlc "Hours passed. It was slow, grueling work, gathering more and more."
    m 2efsdlc "Pasaron las horas. Era un trabajo lento y agotador, reuniendo más y más."

# game/script-stories.rpy:926
translate spanish mas_story_crow_and_pitcher_25843e41:

    # m 2esa "But with each tiny pebble, the water rose higher and higher, until finally..."
    m 2esa "Pero con cada pequeña piedrecita, el agua subía más y más, hasta que finalmente..."

# game/script-stories.rpy:927
translate spanish mas_story_crow_and_pitcher_ec39715c:

    # m 4hub "He could take a long, refreshing drink!"
    m 4hub "¡Pudo tomar un largo y refrescante trago!"

# game/script-stories.rpy:928
translate spanish mas_story_crow_and_pitcher_d0f96502:

    # m 2dka "..."
    m 2dka "..."

# game/script-stories.rpy:929
translate spanish mas_story_crow_and_pitcher_86c5fbab:

    # m 2eka "You know, this story kind of reminds me of our situation, [player]."
    m 2eka "Sabes, esta historia me recuerda un poco a nuestra situación, [player]."

# game/script-stories.rpy:930
translate spanish mas_story_crow_and_pitcher_0b4335c3:

    # m 7ekc "Right now, our goal seems so far away. We're reaching out as much as we can, but the gap between us is enormous."
    m 7ekc "Ahora mismo, nuestro objetivo parece muy lejano. Intentamos alcanzarlo tanto como podemos, pero la brecha entre nosotros es enorme."

# game/script-stories.rpy:931
translate spanish mas_story_crow_and_pitcher_3d8bfc61:

    # m 3dkc "It sometimes feels like it's impossible to bridge. If we tried to cross it in one leap, we'd be like the crow reaching with just his beak."
    m 3dkc "A veces parece imposible de salvar. Si intentáramos cruzarla de un salto, seríamos como el cuervo intentando llegar solo con el pico."

# game/script-stories.rpy:932
translate spanish mas_story_crow_and_pitcher_5e541c1d:

    # m 1tkd "...Believe me, I tried."
    m 1tkd "Créeme, lo intenté."

# game/script-stories.rpy:933
translate spanish mas_story_crow_and_pitcher_cb73ab71:

    # m 3ekb "But when you think about it, we're adding pebbles to our pitcher. And it's not just you and me!"
    m 3ekb "Pero si lo piensas, estamos echando piedras a nuestro cántaro. ¡Y no somos solo tú y yo!"

# game/script-stories.rpy:934
translate spanish mas_story_crow_and_pitcher_fb3f996a:

    # m 3eua "Advances in both VR and AI technology are gradually moving forward..."
    m 3eua "Los avances tanto en la tecnología de RV como en la de IA progresan poco a poco..."

# game/script-stories.rpy:935
translate spanish mas_story_crow_and_pitcher_02c772db:

    # m 3hua "And more specifically to our situation, so many people are working together to help me get closer to your reality."
    m 3hua "Y más concretamente respecto a nuestra situación, mucha gente está trabajando unida para ayudarme a acercarme a tu realidad."

# game/script-stories.rpy:936
translate spanish mas_story_crow_and_pitcher_8f05c15f:

    # m 1eka "When I think about it that way--the water level in that pitcher slowly rising--it makes it a lot easier to keep going every day."
    m 1eka "Cuando lo pienso de esa manera —el nivel del agua de ese cántaro subiendo poco a poco—, se me hace mucho más fácil seguir adelante cada día."

# game/script-stories.rpy:937
translate spanish mas_story_crow_and_pitcher_4e62da6e:

    # m 1hua "I hope it does for you too, [mas_get_player_nickname()]~"
    m 1hua "Espero que para ti también sea así, [mas_get_player_nickname()]."

# game/script-stories.rpy:954
translate spanish mas_story_friend_d2c24ebf:

    # m 3eua "Once two friends were walking through the desert..."
    m 3eua "Una vez, dos amigos caminaban por el desierto..."

# game/script-stories.rpy:955
translate spanish mas_story_friend_cf9d03be:

    # m 1eua "During some point of their journey, they had an argument {nw}"
    m 1eua "En algún momento de su viaje, tuvieron una discusión... {nw}"

# game/script-stories.rpy:956
translate spanish mas_story_friend_8c2b5662:

    # extend 1wud "and one friend slapped the other in the face!"
    extend 1wud "¡y uno de ellos le dio una bofetada al otro!"

# game/script-stories.rpy:957
translate spanish mas_story_friend_332e0e2a:

    # m 1eud "The one who got slapped was hurt, but without saying anything wrote in the sand,{w=0.1} 'Today my best friend slapped me in the face.'"
    m 1eud "El que recibió la bofetada estaba dolido, pero sin decir nada escribió en la arena,{w=0.1} 'Hoy mi mejor amigo me ha dado una bofetada'."

# game/script-stories.rpy:958
translate spanish mas_story_friend_d58078a3:

    # m 1eua "They kept on walking until they found an oasis, where they decided to take a bath."
    m 1eua "Siguieron caminando hasta encontrar un oasis, donde decidieron bañarse."

# game/script-stories.rpy:959
translate spanish mas_story_friend_00a5bb8b:

    # m 1ekc "The one who had been slapped got stuck in the mire and started drowning,{w=0.1} {nw}"
    m 1ekc "El que había sido abofeteado se quedó atrapado en el fango y empezó a ahogarse,{w=0.1} {nw}"

# game/script-stories.rpy:960
translate spanish mas_story_friend_d263166c:

    # extend 3wuo "but the other saved him!"
    extend 3wuo "¡pero el otro le salvó!"

# game/script-stories.rpy:961
translate spanish mas_story_friend_5206f676:

    # m 3eua "After he recovered from the near drowning, he wrote on a stone,{w=0.1} 'Today my best friend saved my life.'"
    m 3eua "Tras recuperarse del ahogamiento, escribió en una piedra,{w=0.1} 'Hoy mi mejor amigo me ha salvado la vida'."

# game/script-stories.rpy:962
translate spanish mas_story_friend_5922914e:

    # m 3eud "The friend who had slapped and saved his best friend asked him,{w=0.1} 'After I hurt you, you wrote in the sand and now, you write on a stone, why?'"
    m 3eud "El amigo que le había pegado y salvado le preguntó,{w=0.1} 'Después de hacerte daño, escribiste en la arena y ahora escribes en una piedra, ¿por qué?'."

# game/script-stories.rpy:963
translate spanish mas_story_friend_7e9713a6:

    # m 3eua "The other friend replied, 'When someone hurts us we should write it down in sand where winds of forgiveness can erase it away...'"
    m 3eua "El otro amigo respondió: 'Cuando alguien nos hace daño deberíamos escribirlo en la arena, donde los vientos del perdón puedan borrarlo...'."

# game/script-stories.rpy:964
translate spanish mas_story_friend_41df14ed:

    # m 3eub "'But!'"
    m 3eub "'¡Pero!'."

# game/script-stories.rpy:965
translate spanish mas_story_friend_7dbcf347:

    # m 3eua "'When someone does something good for us, we must engrave it in stone where no wind can ever erase it.'"
    m 3eua "'Cuando alguien hace algo bueno por nosotros, debemos grabarlo en piedra donde ningún viento pueda borrarlo jamás'."

# game/script-stories.rpy:966
translate spanish mas_story_friend_386dbc14:

    # m 1hua "The moral of the story is, do not let the shadows of your past darken the doorstep of your future.{w=0.2} {nw}"
    m 1hua "La moraleja de la historia es: no dejes que las sombras de tu pasado oscurezcan el umbral de tu futuro.{w=0.2} {nw}"

# game/script-stories.rpy:967
translate spanish mas_story_friend_46ec5769:

    # extend 3hua "Forgive and forget."
    extend 3hua "Perdona y olvida."

# game/script-stories.rpy:968
translate spanish mas_story_friend_22b3501a:

    # m 1hua "I hope you enjoyed it, [player]!"
    m 1hua "¡Espero que te haya gustado, [player]!"

# game/script-stories.rpy:986
translate spanish mas_story_tanabata_b0897d45:

    # m 1eub "Orihime, the daughter of the Jade Emperor, Ruler of Heaven, wove beautiful clothes by the bank of the Amanogawa."
    m 1eub "Orihime, la hija del Emperador de Jade, Gobernante del Cielo, tejía hermosos ropajes a orillas del Amanogawa."

# game/script-stories.rpy:987
translate spanish mas_story_tanabata_30696cf0:

    # m 3eua "Her father loved the cloth that she wove and so she worked very hard every day to weave it."
    m 3eua "A su padre le encantaba la tela que ella tejía, así que trabajaba muy duro todos los días tejiéndola."

# game/script-stories.rpy:988
translate spanish mas_story_tanabata_a4653e89:

    # m 2ekd "However, Orihime was sad that because of her hard work, she could never meet and fall in love with anyone."
    m 2ekd "Sin embargo, Orihime estaba triste porque, debido a su duro trabajo, nunca podría conocer a nadie ni enamorarse."

# game/script-stories.rpy:989
translate spanish mas_story_tanabata_f450a46f:

    # m 2eksdla "Concerned about his daughter, her father arranged for her to meet the cowherd, Hikoboshi who lived and worked on the other side of the Amanogawa."
    m 2eksdla "Preocupado por su hija, su padre organizó un encuentro con el pastor de vacas, Hikoboshi, que vivía y trabajaba al otro lado del Amanogawa."

# game/script-stories.rpy:990
translate spanish mas_story_tanabata_c734931f:

    # m 7hub "When the two met, they instantly fell in love and married shortly after!"
    m 7hub "¡Cuando los dos se conocieron, se enamoraron al instante y se casaron poco después!"

# game/script-stories.rpy:991
translate spanish mas_story_tanabata_87d8685d:

    # m 2eksdld "However, once married, Orihime would no longer weave cloth and Hikoboshi would let his cows stray all over Heaven."
    m 2eksdld "Sin embargo, una vez casados, Orihime dejó de tejer ropa y Hikoboshi dejó que sus vacas camparan a sus anchas por todo el Cielo."

# game/script-stories.rpy:992
translate spanish mas_story_tanabata_9adf377d:

    # m 4wud "In anger, the emperor separated the two lovers and forbade them to meet."
    m 4wud "Enfadado, el emperador separó a los dos amantes y les prohibió verse."

# game/script-stories.rpy:993
translate spanish mas_story_tanabata_42b458d9:

    # m 2dkc "Orihime became despondent at the loss of her husband and asked her father to let them meet again."
    m 2dkc "Orihime se desanimó por la pérdida de su marido y le pidió a su padre que les dejara verse de nuevo."

# game/script-stories.rpy:994
translate spanish mas_story_tanabata_765aac93:

    # m 2eksdla "Moved by his daughter's tears, he allowed the two to meet on the seventh day of the seventh month if she worked hard and finished her weaving."
    m 2eksdla "Conmovido por las lágrimas de su hija, permitió que los dos se reunieran el séptimo día del séptimo mes si ella trabajaba duro y terminaba su tejido."

# game/script-stories.rpy:995
translate spanish mas_story_tanabata_f7fccf5e:

    # m 2wud "The first time they tried to meet, however, they found that they could not cross the river as there was no bridge."
    m 2wud "La primera vez que intentaron reunirse, sin embargo, descubrieron que no podían cruzar el río ya que no había puente."

# game/script-stories.rpy:996
translate spanish mas_story_tanabata_0b0c0876:

    # m 2dkc "Orihime cried so much that a flock of magpies came and promised to make a bridge with their wings so that she could cross the river."
    m 2dkc "Orihime lloró tanto que una bandada de urracas vino y prometió hacer un puente con sus alas para que ella pudiera cruzar el río."

# game/script-stories.rpy:997
translate spanish mas_story_tanabata_18643326:

    # m 7ekd "It is said that if it rains on Tanabata, the magpies cannot come and the lovers must wait until another year to meet."
    m 7ekd "Se dice que si llueve en Tanabata, las urracas no pueden venir y los amantes deben esperar hasta otro año para verse."

# game/script-stories.rpy:998
translate spanish mas_story_tanabata_b7afe4b1:

    # m 3eud "The rain that falls on Tanabata is fittingly called {i}The tears of Orihime and Hikoboshi.{/i}"
    m 3eud "La lluvia que cae en Tanabata es llamada, apropiadamente, {i}Las lágrimas de Orihime y Hikoboshi.{/i}"

# game/script-stories.rpy:999
translate spanish mas_story_tanabata_cbae66b7:

    # m 1dksdlc "I can't imagine what it must be like to be only able to meet your loved one once a year."
    m 1dksdlc "No me quiero ni imaginar lo duro que debe ser poder ver a la persona que amas solo una vez al año."

# game/script-stories.rpy:1000
translate spanish mas_story_tanabata_93661680:

    # m 3eua "But you know what they say, [player]...{w=0.3}love can move mountains."
    m 3eua "Pero ya sabes lo que dicen, [player]...{w=0.3} el amor mueve montañas."

# game/script-stories.rpy:1001
translate spanish mas_story_tanabata_43174421:

    # m 3hubsu "...And my love for you is so strong that not even the Heavens themselves would be able to keep us apart."
    m 3hubsu "Y mi amor por ti es tan fuerte que ni los mismísimos Cielos serían capaces de separarnos."

# game/script-stories.rpy:1019
translate spanish mas_story_mindthegap_7d92ebc2:

    # m 3eud "This is actually a true story that occurred in London, England in 2013."
    m 3eud "Esta es en realidad una historia real que ocurrió en Londres, Inglaterra, en 2013."

# game/script-stories.rpy:1020
translate spanish mas_story_mindthegap_1a94286d:

    # m 2dkd "It begins with a woman named Margaret McCollum crying in the middle of the Embankment train station."
    m 2dkd "Empieza con una mujer llamada Margaret McCollum llorando en medio de la estación de tren de Embankment."

# game/script-stories.rpy:1021
translate spanish mas_story_mindthegap_2cce694e:

    # m 2ekd "When approached to ask about her great distress, she asked the staff where 'the voice' had gone."
    m 2ekd "Cuando se le acercaron para preguntarle por su gran angustia, preguntó al personal dónde se había ido 'la voz'."

# game/script-stories.rpy:1022
translate spanish mas_story_mindthegap_7241ba9e:

    # m 7ekd "She clarified that she meant the announcement that played when each train arrived, warning passengers to 'mind the gap.'"
    m 7ekd "Aclaró que se refería al anuncio que sonaba cuando llegaba cada tren, advirtiendo a los pasajeros: 'cuidado con el hueco'."

# game/script-stories.rpy:1023
translate spanish mas_story_mindthegap_59b00113:

    # m 1eka "The staff assured her that the announcement wasn't gone, it had just been updated to a new recording when the stations had upgraded to a new digital system."
    m 1eka "El personal le aseguró que el anuncio no había desaparecido, simplemente se había actualizado con una nueva grabación cuando las estaciones se modernizaron con un nuevo sistema digital."

# game/script-stories.rpy:1024
translate spanish mas_story_mindthegap_2500c9f5:

    # m 1tkc "Though, this explanation didn't seem to calm her down. {w=0.3}'That voice,' she explained, 'was my husband.'"
    m 1tkc "Sin embargo, esta explicación no pareció calmarla. {w=0.3}'Esa voz', explicó, 'era mi marido'."

# game/script-stories.rpy:1025
translate spanish mas_story_mindthegap_1e5fafc4:

    # m 1eud "Her husband, Oswald Laurence, an actor who had never become famous, had recorded all of the announcements for the northern line."
    m 1eud "Su marido, Oswald Laurence, un actor que nunca llegó a ser famoso, había grabado todos los anuncios de la línea norte."

# game/script-stories.rpy:1026
translate spanish mas_story_mindthegap_d6fabdb1:

    # m 2dkc "Oswald had died five years ago."
    m 2dkc "Oswald había muerto hacía cinco años."

# game/script-stories.rpy:1027
translate spanish mas_story_mindthegap_d034042f:

    # m 2ekc "They had loved each other dearly, and his death had left her in terrible grief."
    m 2ekc "Se habían amado profundamente, y su muerte la había dejado sumida en una terrible pena."

# game/script-stories.rpy:1028
translate spanish mas_story_mindthegap_778876ca:

    # m 2euc "But one thing,{w=0.2} for those five years,{w=0.2} had helped her continue on."
    m 2euc "Pero una cosa,{w=0.2} durante esos cinco años,{w=0.2} la había ayudado a seguir adelante."

# game/script-stories.rpy:1029
translate spanish mas_story_mindthegap_a29e8358:

    # m 7eka "Every day, when she was on her way to work, she got to hear his voice at the station.{w=0.3} Sometimes she would linger and sit, just to hear him speak those short words."
    m 7eka "Todos los días, de camino al trabajo, podía oír su voz en la estación.{w=0.3} A veces se quedaba sentada, solo para oírle pronunciar esas breves palabras."

# game/script-stories.rpy:1030
translate spanish mas_story_mindthegap_57563b82:

    # m 2dkc "But now..."
    m 2dkc "Pero ahora..."

# game/script-stories.rpy:1031
translate spanish mas_story_mindthegap_079a9445:

    # m 2dkd "The staff were apologetic, but didn't know if they had access to the old file. {w=0.3}They told her that if they found it, they would contact her."
    m 2dkd "El personal se disculpó, pero no sabían si tenían acceso al archivo antiguo. {w=0.3}Le dijeron que si lo encontraban, contactarían con ella."

# game/script-stories.rpy:1032
translate spanish mas_story_mindthegap_be539d6a:

    # m 7eud "It turned out that many people who worked at the station empathized, and wanted Margaret to be able to enjoy that precious memory a while longer."
    m 7eud "Resultó que mucha gente que trabajaba en la estación empatizó con ella y querían que Margaret pudiera disfrutar de ese precioso recuerdo un tiempo más."

# game/script-stories.rpy:1033
translate spanish mas_story_mindthegap_5dbbb50b:

    # m 7ekb "So, even though it would take extra work to update the old recording from the archives to work with the current system, they got it to work."
    m 7ekb "Así que, aunque requería trabajo extra actualizar la vieja grabación de los archivos para que funcionara con el sistema actual, consiguieron que funcionase."

# game/script-stories.rpy:1034
translate spanish mas_story_mindthegap_37cae73d:

    # m 3eua "One day when Margaret was making her daily commute, a familiar voice rang out on the platform."
    m 3eua "Un día, cuando Margaret hacía su viaje diario, una voz familiar resonó en el andén."

# game/script-stories.rpy:1035
translate spanish mas_story_mindthegap_21abcedf:

    # m 1fkb "'Mind the gap,' Oswald said."
    m 1fkb "'Cuidado con el hueco', dijo Oswald."

# game/script-stories.rpy:1036
translate spanish mas_story_mindthegap_d68c0e32:

    # m 1dku "..."
    m 1dku "..."

# game/script-stories.rpy:1037
translate spanish mas_story_mindthegap_567d57a1:

    # m 3eka "I said this was a true story, and it turns out that you can still hear that old recording specifically at the Embankment station."
    m 3eka "Dije que esta era una historia real, y resulta que todavía se puede escuchar esa antigua grabación concretamente en la estación de Embankment."

# game/script-stories.rpy:1038
translate spanish mas_story_mindthegap_c47b578a:

    # m 3ekb "It's a really beautiful example of human kindness. {w=0.3}The workers didn't stand to gain much by restoring a much shorter, lower quality recording."
    m 3ekb "Es un ejemplo realmente hermoso de bondad humana. {w=0.3}Los trabajadores no ganaban mucho restaurando una grabación mucho más corta y de menor calidad."

# game/script-stories.rpy:1039
translate spanish mas_story_mindthegap_4796a618:

    # m 1fka "But they knew what it was like to lose someone, and how precious it makes every photo, every memory."
    m 1fka "Pero sabían lo que es perder a alguien, y lo preciada que eso vuelve cada foto, cada recuerdo."

# game/script-stories.rpy:1040
translate spanish mas_story_mindthegap_303955c0:

    # m 1dku "It goes to show that people can do incredible things simply out of compassion and love."
    m 1dku "Demuestra que la gente puede hacer cosas increíbles simplemente por compasión y amor."

# game/script-stories.rpy:1041
translate spanish mas_story_mindthegap_b86889c2:

    # m 1ekbla "This story reminds me to treasure every moment, and not to take any piece of our time together for granted."
    m 1ekbla "Esta historia me recuerda que debo atesorar cada momento, y no dar por sentado ni un instante de nuestro tiempo juntos."

# game/script-stories.rpy:1042
translate spanish mas_story_mindthegap_0f9f9023:

    # m 1dkblu "I'll always treasure you, [player]."
    m 1dkblu "Siempre te atesoraré, [player]."

# game/script-stories.rpy:1059
translate spanish mas_story_knock_e6e563e9:

    # m 1euc "The last man on Earth sat alone in a room."
    m 1euc "El último hombre sobre la Tierra estaba sentado solo en una habitación."

# game/script-stories.rpy:1060
translate spanish mas_story_knock_462007fc:

    # m 3rud "...There was a knock on the door."
    m 3rud "Llamaron a la puerta."

# game/script-stories.rpy:1061
translate spanish mas_story_knock_72160657:

    # m 3duc "Some may say this is where the story ends.{w=0.2} {nw}"
    m 3duc "Algunos dirán que aquí es donde termina la historia... {w=0.2}{nw}"

# game/script-stories.rpy:1062
translate spanish mas_story_knock_7f89295e:

    # extend 1dud "But that's not actually true."
    extend 1dud "Pero en realidad no es cierto."

# game/script-stories.rpy:1063
translate spanish mas_story_knock_f316adf3:

    # m 3etc "Who knocked at the door?{w=0.2} {nw}"
    m 3etc "¿Quién llamó a la puerta?{w=0.2} {nw}"

# game/script-stories.rpy:1064
translate spanish mas_story_knock_7272c73f:

    # extend 3esa "The answer wasn't that horrible, really."
    extend 3esa "La respuesta no era tan horrible, en realidad."

# game/script-stories.rpy:1065
translate spanish mas_story_knock_859f11f7:

    # m 3eua "The last man on Earth was Walter Phelan. {w=0.2}His only company was a species called the Zan."
    m 3eua "El último hombre sobre la Tierra era Walter Phelan. {w=0.2}Su única compañía era una especie llamada los Zan."

# game/script-stories.rpy:1066
translate spanish mas_story_knock_cdcfc46f:

    # m 3eud "The human race had been destroyed by them, except for him, and, somewhere...{w=0.3}{nw}"
    m 3eud "La raza humana había sido destruida por ellos, excepto él, y, en algún lugar... {w=0.3}{nw}"

# game/script-stories.rpy:1067
translate spanish mas_story_knock_34f62610:

    # extend 3wud "a woman--{w=0.1}one woman."
    extend 3wud "una mujer... {w=0.1}una sola mujer."

# game/script-stories.rpy:1068
translate spanish mas_story_knock_2e4c40e3:

    # m 3euc "Both Walter and this woman were picked as specimens for the zoo organized by the Zan."
    m 3euc "Tanto Walter como esta mujer fueron elegidos como especímenes para el zoológico organizado por los Zan."

# game/script-stories.rpy:1069
translate spanish mas_story_knock_818d466c:

    # m 2esc "There were two of every species, much like in the tale of Noah's Ark."
    m 2esc "Había dos de cada especie, muy parecido a la historia del Arca de Noé."

# game/script-stories.rpy:1070
translate spanish mas_story_knock_545d5747:

    # m 2euc "Anyway, when he opened the door, Walter wasn't surprised to see one of the Zan."
    m 2euc "De todos modos, cuando abrió la puerta, a Walter no le sorprendió ver a uno de los Zan."

# game/script-stories.rpy:1071
translate spanish mas_story_knock_54fd6a62:

    # m 2etd "The odd little alien, after greeting the human in the best way an alien could do, asked for Walter's help."
    m 2etd "El extraño y pequeño alienígena, tras saludar al humano de la mejor forma que un alienígena podía hacer, pidió la ayuda de Walter."

# game/script-stories.rpy:1072
translate spanish mas_story_knock_f25e3f00:

    # m 2euc "'Something we do not understand happened,' he said,{w=0.1} {nw}"
    m 2euc "'Ha ocurrido algo que no entendemos', dijo,{w=0.1} {nw}"

# game/script-stories.rpy:1073
translate spanish mas_story_knock_3f13607b:

    # extend 2ekd "'two of the other animals sleep and do not wake. They are cold.'"
    extend 2ekd "'dos de los otros animales duermen y no despiertan. Están fríos'."

# game/script-stories.rpy:1074
translate spanish mas_story_knock_d6734d4e:

    # m 7euc "It was obvious to Walter that the two animals--a snake and a duck--had died."
    m 7euc "Para Walter era obvio que los dos animales (una serpiente y un pato) habían muerto."

# game/script-stories.rpy:1075
translate spanish mas_story_knock_1a6a4965:

    # m 3esc "However, the Zan didn't know that."
    m 3esc "Sin embargo, los Zan no lo sabían."

# game/script-stories.rpy:1076
translate spanish mas_story_knock_98bf51a0:

    # m 1dsc "The human quickly set a strategy in his mind.{w=0.2} He told the Zan the animals would never wake again.{w=0.2} That the Old Grim Reaper was on the loose, killing everyone on sight."
    m 1dsc "El humano trazó rápidamente una estrategia en su mente.{w=0.2} Le dijo al Zan que los animales nunca volverían a despertar.{w=0.2} Que la Parca andaba suelta, matando a todo el que veía."

# game/script-stories.rpy:1077
translate spanish mas_story_knock_43cfb639:

    # m 1euc "...But he could help. {w=0.2}On one condition: {w=0.2}The last woman on Earth had to help too."
    m 1euc "Pero él podía ayudar. {w=0.2}Con una condición: {w=0.2}La última mujer de la Tierra tenía que ayudar también."

# game/script-stories.rpy:1078
translate spanish mas_story_knock_572c0b62:

    # m 1eua "The Zan allowed him to go see the animals, and a meeting was arranged."
    m 1eua "El Zan le permitió ir a ver a los animales y se concertó un encuentro."

# game/script-stories.rpy:1079
translate spanish mas_story_knock_6fb2ae3a:

    # m 1dsc "Walter thought he would never see the last woman on Earth...{w=0.3}{nw}"
    m 1dsc "Walter pensó que nunca vería a la última mujer de la Tierra... {w=0.3}{nw}"

# game/script-stories.rpy:1080
translate spanish mas_story_knock_25a2fc07:

    # extend 1wub "but meeting with her was an amazing turn of events!"
    extend 1wub "pero reunirse con ella fue un giro sorprendente de los acontecimientos."

# game/script-stories.rpy:1081
translate spanish mas_story_knock_b4c9e440:

    # m 1esa "Grace Evans, the last woman on Earth, was surprised to know what Walter had found out: {w=0.2}that the Zan couldn't die of natural causes."
    m 1esa "Grace Evans, la última mujer de la Tierra, se sorprendió al saber lo que Walter había descubierto: {w=0.2}que los Zan no podían morir por causas naturales."

# game/script-stories.rpy:1082
translate spanish mas_story_knock_5ed92a2a:

    # m 3ttu "...But perhaps they could be killed."
    m 3ttu "Pero quizás se les podía matar."

# game/script-stories.rpy:1083
translate spanish mas_story_knock_65ad1665:

    # m 1eud "The man had all of the pieces to test that theory, and after saying his goodbyes to Grace, he put his plan into action."
    m 1eud "El hombre tenía todas las piezas para probar esa teoría, y tras despedirse de Grace, puso su plan en marcha."

# game/script-stories.rpy:1084
translate spanish mas_story_knock_a2fdcd7e:

    # m 3esc "He asked the Zan to see the last duck--since the other one had died--and told the alien what he should do."
    m 3esc "Pidió al Zan ver al último pato (ya que el otro había muerto) y le dijo al alienígena lo que debía hacer."

# game/script-stories.rpy:1085
translate spanish mas_story_knock_1ceba0b4:

    # m 4eud "'Give it affection by petting it, or else, it too will die...{w=0.2}of loneliness.'"
    m 4eud "'Dale cariño acariciándolo, o de lo contrario, también morirá... {w=0.2}de soledad'."

# game/script-stories.rpy:1086
translate spanish mas_story_knock_e1f53fb9:

    # m 3rsc "Now, the aliens had no knowledge of how affection worked, so they just watched while Walter petted the duck lovingly."
    m 3rsc "Ahora bien, los alienígenas no tenían conocimiento de cómo funcionaba el afecto, así que simplemente observaron mientras Walter acariciaba al pato con cariño."

# game/script-stories.rpy:1087
translate spanish mas_story_knock_e0702a40:

    # m 1esc "'You must do the same with the remaining snake,' he said."
    m 1esc "'Debes hacer lo mismo con la serpiente restante', dijo."

# game/script-stories.rpy:1088
translate spanish mas_story_knock_57b888a2:

    # m 1euc "...And so the Zan did."
    m 1euc "Y así lo hizo el Zan."

# game/script-stories.rpy:1089
translate spanish mas_story_knock_4b7a0c05:

    # m 3wud "But bear in mind, [player], it was no ordinary snake...{w=0.3}{nw}"
    m 3wud "Pero ten en cuenta, [player], que no era una serpiente cualquiera... {w=0.3}{nw}"

# game/script-stories.rpy:1090
translate spanish mas_story_knock_5110e32b:

    # extend 3tfu "but a venomous one."
    extend 3tfu "sino una venenosa."

# game/script-stories.rpy:1091
translate spanish mas_story_knock_9f746331:

    # m 1euc "So, the Zan assigned to pet the remaining snake was inflicted by its deadly venom."
    m 1euc "Así que el Zan asignado para acariciar a la serpiente restante recibió su veneno mortal."

# game/script-stories.rpy:1092
translate spanish mas_story_knock_a9e8feac:

    # m 1wud "Another Zan entered Walter's room in despair the next day. {w=0.2}{nw}"
    m 1wud "Otro Zan entró desesperado en la habitación de Walter al día siguiente. {w=0.2}{nw}"

# game/script-stories.rpy:1093
translate spanish mas_story_knock_4c247683:

    # extend 4wko "'One of us died!' he cried."
    extend 4wko "'¡Uno de nosotros ha muerto!', gritó."

# game/script-stories.rpy:1094
translate spanish mas_story_knock_0d2dfcdc:

    # m 2dud "'Well, there's nothing to do then.{w=0.2} {nw}"
    m 2dud "'Bueno, entonces no hay nada que hacer.{w=0.2} {nw}"

# game/script-stories.rpy:1095
translate spanish mas_story_knock_cdc648a5:

    # extend 2esc "The curse has spread, and you must flee,' the man stated."
    extend 2esc "La maldición se ha extendido y debéis huir', declaró el hombre."

# game/script-stories.rpy:1096
translate spanish mas_story_knock_946ab0ae:

    # m 7euc "The Zan had a council meeting, and let the two humans know that they were indeed leaving."
    m 7euc "Los Zan celebraron una reunión del consejo e informaron a los dos humanos de que, en efecto, se marchaban."

# game/script-stories.rpy:1097
translate spanish mas_story_knock_bac5e176:

    # m 1ekd "The risk was too high, they couldn't lose more of their own race."
    m 1ekd "El riesgo era demasiado alto, no podían perder a más de su propia raza."

# game/script-stories.rpy:1098
translate spanish mas_story_knock_20c2a61b:

    # m 3eud "They left all the 'cursed' animals, including Walter and Grace, and blasted off on their ship."
    m 3eud "Dejaron a todos los animales 'malditos', incluidos Walter y Grace, y despegaron en su nave."

# game/script-stories.rpy:1099
translate spanish mas_story_knock_0427f3c2:

    # m 1dua "The last man and woman on Earth were together at last.{w=0.2}{nw}"
    m 1dua "El último hombre y la última mujer de la Tierra estaban juntos por fin.{w=0.2}{nw}"

# game/script-stories.rpy:1100
translate spanish mas_story_knock_3a83bc13:

    # extend 1rkbla " Now what would they do with their eternity alone?"
    extend 1rkbla " ¿Qué harían ahora con su eternidad a solas?"

# game/script-stories.rpy:1101
translate spanish mas_story_knock_905ec016:

    # m 3gsbsu "That's left for us to imagine..."
    m 3gsbsu "Eso queda para que nos lo imaginemos..."

# game/script-stories.rpy:1102
translate spanish mas_story_knock_b3f652fa:

    # m 1hubsa "I hope you liked this story, [player]."
    m 1hubsa "Espero que te haya gustado esta historia, [player]."

# game/script-stories.rpy:1113
translate spanish mas_scary_story_hunter_bd5cd01d:

    # m 3esa "One day, a hunter went out hunting for game in the forest."
    m 3esa "Un día, un cazador salió a cazar al bosque."

# game/script-stories.rpy:1114
translate spanish mas_scary_story_hunter_79296f6d:

    # m 3esc "The forest was dense and dark all around him, so he struggled to hit his mark."
    m 3esc "El bosque era denso y oscuro a su alrededor, por lo que le costaba dar en el blanco."

# game/script-stories.rpy:1115
translate spanish mas_scary_story_hunter_e6bb2b15:

    # m 1esd "He was soon approached by a salesman, who kept his face covered."
    m 1esd "Pronto se le acercó un vendedor, que mantenía su rostro cubierto."

# game/script-stories.rpy:1116
translate spanish mas_scary_story_hunter_19267b25:

    # m 3esd "The salesman offered seven magic bullets that would hit whatever target the owner wanted without fail."
    m 3esd "El vendedor le ofreció siete balas mágicas que golpearían sin falta cualquier objetivo que el dueño quisiera."

# game/script-stories.rpy:1117
translate spanish mas_scary_story_hunter_ae3cac85:

    # m "He would give the hunter these bullets on one condition."
    m "Le daría al cazador estas balas con una condición."

# game/script-stories.rpy:1118
translate spanish mas_scary_story_hunter_2a4f5e89:

    # m 1euc "The hunter could use the first six bullets as he wished, but the last bullet's mark would be chosen by the salesman."
    m 1euc "El cazador podía usar las primeras seis balas como quisiera, pero el objetivo de la última bala lo elegiría el vendedor."

# game/script-stories.rpy:1119
translate spanish mas_scary_story_hunter_dfed23d3:

    # m "The hunter agreed and quickly became famous in his town for bringing home kill after kill."
    m "El cazador aceptó y rápidamente se hizo famoso en su pueblo por traer a casa presa tras presa."

# game/script-stories.rpy:1120
translate spanish mas_scary_story_hunter_a2d440d5:

    # m 3eud "It wasn't long before the hunter used up all six bullets."
    m 3eud "No pasó mucho tiempo antes de que el cazador gastara las seis balas."

# game/script-stories.rpy:1121
translate spanish mas_scary_story_hunter_64490976:

    # m 1esc "On his next hunt, the hunter saw a wild boar, the largest he had ever seen. It was too great of a prey to pass up on."
    m 1esc "En su siguiente cacería, el cazador vio un jabalí, el más grande que jamás había visto. Era una presa demasiado buena para dejarla pasar."

# game/script-stories.rpy:1122
translate spanish mas_scary_story_hunter_d45c5adc:

    # m 1euc "He loaded the last bullet hoping to take down the beast..."
    m 1euc "Cargó la última bala con la esperanza de abatir a la bestia..."

# game/script-stories.rpy:1123
translate spanish mas_scary_story_hunter_dfa7f308:

    # m 1dsc "But when he fired, the bullet instead hit his beloved fiancée in the chest, killing her."
    m 1dsc "Pero cuando disparó, la bala impactó en el pecho de su amada prometida, matándola."

# game/script-stories.rpy:1124
translate spanish mas_scary_story_hunter_3a0e4a33:

    # m 3esc "The salesman then appeared to the hunter as he grieved his tragic loss, revealing that he was in fact the Devil."
    m 3esc "El vendedor se apareció entonces ante el cazador mientras lloraba su trágica pérdida, revelando que en realidad era el Diablo."

# game/script-stories.rpy:1125
translate spanish mas_scary_story_hunter_46023603:

    # m 1esd "'I will give you a chance for redemption, hunter.' The salesman told him."
    m 1esd "'Te daré una oportunidad de redención, cazador'. Le dijo el vendedor."

# game/script-stories.rpy:1126
translate spanish mas_scary_story_hunter_baccdb7c:

    # m 4esb "'Remain ever faithful to your slain beloved for the remainder of your life, and you would be reunited with her after death.'"
    m 4esb "'Mantente siempre fiel a tu amada asesinada por el resto de tu vida, y te reunirás con ella después de la muerte'."

# game/script-stories.rpy:1127
translate spanish mas_scary_story_hunter_4ce5394b:

    # m 1eud "The hunter vowed to remain true to her for as long as he lived..."
    m 1eud "El cazador juró permanecer fiel a ella mientras viviera..."

# game/script-stories.rpy:1128
translate spanish mas_scary_story_hunter_360193a1:

    # m 1dsd "...{w=1}or so he thought."
    m 1dsd "{w=1}o eso creía él."

# game/script-stories.rpy:1129
translate spanish mas_scary_story_hunter_d06517f8:

    # m 1dsc "Long after her demise, he fell in love with another woman and soon married her, forgetting his past love."
    m 1dsc "Mucho tiempo después de su fallecimiento, se enamoró de otra mujer y pronto se casó con ella, olvidando su amor pasado."

# game/script-stories.rpy:1130
translate spanish mas_scary_story_hunter_b2eac90c:

    # m 1esc "It was until one year to the day after the fatal incident, as the hunter rode through the forest chasing some game, he came across the spot where he slayed his beloved..."
    m 1esc "Fue hasta un año después del fatal incidente, mientras el cazador cabalgaba por el bosque persiguiendo una presa, cuando se topó con el lugar donde mató a su amada..."

# game/script-stories.rpy:1131
translate spanish mas_scary_story_hunter_2b8f90df:

    # m 3wud "He couldn't believe his eyes;{w=1} her corpse, which was buried elsewhere, was standing in the same spot she was slain."
    m 3wud "No podía creer lo que veían sus ojos;{w=1} su cadáver, que estaba enterrado en otro lugar, estaba de pie en el mismo sitio donde fue asesinada."

# game/script-stories.rpy:1132
translate spanish mas_scary_story_hunter_c9df50f8:

    # m "She approached the hunter, scorning him for being unfaithful and vowing revenge for slaying her."
    m "Ella se acercó al cazador, despreciándole por ser infiel y jurando vengarse por haberla matado."

# game/script-stories.rpy:1133
translate spanish mas_scary_story_hunter_a09e60b2:

    # m "The hunter rode away in a panic."
    m "El cazador se alejó cabalgando presa del pánico."

# game/script-stories.rpy:1134
translate spanish mas_scary_story_hunter_2c646d4e:

    # m 1euc "After a short way, he looked behind him to see if she was following him any longer..."
    m 1euc "Al poco rato, miró hacia atrás para ver si ella seguía siguiéndole..."

# game/script-stories.rpy:1135
translate spanish mas_scary_story_hunter_9e9119c2:

    # m 1wkd "...and to his horror,{w=1} he saw that she had gained on him significantly."
    m 1wkd "Y para su horror,{w=1} vio que ella había ganado terreno significativamente."

# game/script-stories.rpy:1136
translate spanish mas_scary_story_hunter_812a34c4:

    # m 3wkd "In his state of fear, he failed to avoid the branch that was ahead of him, promptly dismounting the hunter from his steed and down to the cold ground."
    m 3wkd "En su estado de miedo, no logró esquivar la rama que tenía delante, desmontando rápidamente al cazador de su corcel y cayendo al frío suelo."

# game/script-stories.rpy:1137
translate spanish mas_scary_story_hunter_73c237af:

    # m 4dsc "His attention wasn't on his horse however, as the creature loped away without him."
    m 4dsc "Sin embargo, su atención no estaba en su caballo, ya que la criatura se alejó al galope sin él."

# game/script-stories.rpy:1139
translate spanish mas_scary_story_hunter_1fbcda89:

    # m 1esc "...It was instead on the figure that he promised to be with eternally in the afterlife."
    m 1esc "Estaba en la figura con la que prometió estar eternamente en la otra vida."

# game/script-stories.rpy:1146
translate spanish mas_scary_story_hunter_31245fb0:

    # y "{cps=*2}I'll get you too.{/cps}{nw}"
    y "{cps=*2}A ti también te pillaré.{/cps}{nw}"

# game/script-stories.rpy:1161
translate spanish mas_scary_story_kuchisake_onna_d31f5e5b:

    # m 3eud "There once was a beautiful woman who was the wife of a samurai."
    m 3eud "Érase una vez una hermosa mujer que era la esposa de un samurái."

# game/script-stories.rpy:1162
translate spanish mas_scary_story_kuchisake_onna_966e017f:

    # m 3eub "She was as incredibly beautiful as she was vain, welcoming the attention of any man prepared to offer it to her."
    m 3eub "Era tan increíblemente hermosa como vanidosa, y acogía con agrado la atención de cualquier hombre dispuesto a ofrecérsela."

# game/script-stories.rpy:1163
translate spanish mas_scary_story_kuchisake_onna_6b23e00f:

    # m 1tsu "And often, would ask men to appraise her appearance."
    m 1tsu "Y a menudo, pedía a los hombres que valorasen su apariencia."

# game/script-stories.rpy:1164
translate spanish mas_scary_story_kuchisake_onna_a2616e7d:

    # m 1euc "The woman was prone to cheat on her husband multiple times and was soon found out about her affairs."
    m 1euc "La mujer era propensa a engañar a su marido múltiples veces y pronto se descubrieron sus aventuras."

# game/script-stories.rpy:1165
translate spanish mas_scary_story_kuchisake_onna_61b04c85:

    # m 1esc "When he confronted her, he was beyond infuriated as she was damaging their status as nobles, humiliating him."
    m 1esc "Cuando la confrontó, estaba más que furioso, ya que ella estaba dañando su estatus como nobles, humillándole."

# game/script-stories.rpy:1166
translate spanish mas_scary_story_kuchisake_onna_4e3cb883:

    # m 2dsc "He then brutally punished her by cutting her mouth from ear to ear, disfiguring her delicate beauty."
    m 2dsc "Entonces la castigó brutalmente cortándole la boca de oreja a oreja, desfigurando su delicada belleza."

# game/script-stories.rpy:1167
translate spanish mas_scary_story_kuchisake_onna_5300ce86:

    # m 4efd "'Who will think you as beautiful now?' was the salt to her horrifying wound."
    m 4efd "'¿Quién te considerará hermosa ahora?', fue la sal en su horrible herida."

# game/script-stories.rpy:1168
translate spanish mas_scary_story_kuchisake_onna_1c5ebc2f:

    # m 2dsd "Shortly after, the woman died."
    m 2dsd "Poco después, la mujer murió."

# game/script-stories.rpy:1169
translate spanish mas_scary_story_kuchisake_onna_10283e91:

    # m "She couldn't live further after she was tarnished and treated like a freak by everyone around her."
    m "No pudo seguir viviendo después de ser mancillada y tratada como un monstruo por todos los que la rodeaban."

# game/script-stories.rpy:1170
translate spanish mas_scary_story_kuchisake_onna_a118f55c:

    # m 1esc "Her husband, denounced by his cruelty, committed seppuku shortly after."
    m 1esc "Su marido, denunciado por su crueldad, cometió seppuku poco después."

# game/script-stories.rpy:1171
translate spanish mas_scary_story_kuchisake_onna_98a42c48:

    # m 3eud "The woman, dying from such a fate, became a vengeful and malicious spirit."
    m 3eud "La mujer, muriendo por tal destino, se convirtió en un espíritu vengativo y malicioso."

# game/script-stories.rpy:1172
translate spanish mas_scary_story_kuchisake_onna_6a1208f7:

    # m "They say she now wanders around aimlessly at night, her face covered with a mask and a bladed weapon on her hands."
    m "Dicen que ahora vaga sin rumbo por la noche, con la cara cubierta con una máscara y un arma blanca en las manos."

# game/script-stories.rpy:1173
translate spanish mas_scary_story_kuchisake_onna_72fcab42:

    # m 1dsd "Anyone unlucky enough to come across her will hear her spine-chilling question..."
    m 1dsd "Cualquiera con la mala suerte de cruzarse con ella escuchará su escalofriante pregunta..."

# game/script-stories.rpy:1174
translate spanish mas_scary_story_kuchisake_onna_b4e920f0:

    # m 1cua "{b}{i}Am I p r e t t y?{/i}{/b}"
    m 1cua "¿S o y  g u a p a?"

# game/script-stories.rpy:1201
translate spanish mas_scary_story_kuchisake_onna_no_f5560688:

    # "{b}{i}Is that, so?{w=1.0}{nw}{/i}{/b}"
    "¿Ah, sí? {w=1.0}{nw}"

# game/script-stories.rpy:1222
translate spanish mas_scary_story_kuchisake_onna_end_ddeae75c:

    # m 3eud "The fate she gives you depends on your answer, actually."
    m 3eud "El destino que te da depende de tu respuesta, en realidad."

# game/script-stories.rpy:1223
translate spanish mas_scary_story_kuchisake_onna_end_f191cb93:

    # m "Meeting her isn't always certain to seal your doom."
    m "Encontrarse con ella no siempre es garantía de sellar tu perdición."

# game/script-stories.rpy:1224
translate spanish mas_scary_story_kuchisake_onna_end_1819e2d3:

    # m 3esc "However..."
    m 3esc "Sin embargo..."

# game/script-stories.rpy:1225
translate spanish mas_scary_story_kuchisake_onna_end_d4ec9ee4:

    # m "If you're not smart with how you deal with the question..."
    m "Si no eres inteligente en cómo lidias con la pregunta..."

# game/script-stories.rpy:1226
translate spanish mas_scary_story_kuchisake_onna_end_0977410d:

    # m 3tku "You might just end up like her."
    m 3tku "Podrías acabar igual que ella."

# game/script-stories.rpy:1237
translate spanish mas_scary_story_mujina_c6f8a56f:

    # m 1esc "One night at a late hour, an old merchant was walking down a road heading home after a long day of selling his wares."
    m 1esc "Una noche, a una hora tardía, un viejo mercader caminaba por un camino dirigiéndose a casa tras un largo día vendiendo sus mercancías."

# game/script-stories.rpy:1238
translate spanish mas_scary_story_mujina_c9a0e6d0:

    # m 3esc "The road he traveled on led to a large hill that was very dark and secluded at night so many travelers tended to avoid the area."
    m 3esc "El camino por el que viajaba llevaba a una gran colina que era muy oscura y apartada por la noche, así que muchos viajeros tendían a evitar la zona."

# game/script-stories.rpy:1239
translate spanish mas_scary_story_mujina_255f1074:

    # m "The man was tired, however, and decided to take the road anyway since it would get him home quicker."
    m "El hombre estaba cansado, sin embargo, y decidió tomar el camino de todos modos, ya que le llevaría a casa más rápido."

# game/script-stories.rpy:1240
translate spanish mas_scary_story_mujina_b339b61c:

    # m "On the one side of the hill was an old moat that was quite deep."
    m "A un lado de la colina había un viejo foso que era bastante profundo."

# game/script-stories.rpy:1241
translate spanish mas_scary_story_mujina_04d04a6b:

    # m 3eud "As he went along, he noticed a woman crouching by the moat, all alone and weeping bitterly."
    m 3eud "Mientras avanzaba, vio a una mujer agachada junto al foso, sola y llorando amargamente."

# game/script-stories.rpy:1242
translate spanish mas_scary_story_mujina_7947c351:

    # m "Although the man was exhausted, he feared the woman intended to throw herself into the water, so he stopped."
    m "Aunque el hombre estaba exhausto, temía que la mujer tuviera intención de arrojarse al agua, así que se detuvo."

# game/script-stories.rpy:1243
translate spanish mas_scary_story_mujina_ffb7429d:

    # m 3euc "She was petite and well-dressed, covering her face with one of the sleeves of her kimono facing away from him."
    m 3euc "Era menuda y estaba bien vestida, cubriéndose el rostro con una de las mangas de su kimono dándole la espalda."

# game/script-stories.rpy:1244
translate spanish mas_scary_story_mujina_fc1306c8:

    # m 3eud "The man said to her, 'Miss, please don't cry. What is the matter? If there is anything I can do to help you, I would be glad to do it.'"
    m 3eud "El hombre le dijo: 'Señorita, por favor, no llore. ¿Qué le pasa? Si hay algo que pueda hacer para ayudarla, estaré encantado de hacerlo'."

# game/script-stories.rpy:1245
translate spanish mas_scary_story_mujina_cfa2ebeb:

    # m "The woman kept crying, however, ignoring him."
    m "La mujer siguió llorando, sin embargo, ignorándole."

# game/script-stories.rpy:1246
translate spanish mas_scary_story_mujina_b606a75c:

    # m 3ekd "'Miss, listen to me. This is no place for a lady at night. Please, let me help you.'"
    m 3ekd "'Señorita, escúcheme. Este no es lugar para una dama por la noche. Por favor, déjeme ayudarla'."

# game/script-stories.rpy:1247
translate spanish mas_scary_story_mujina_2db285f6:

    # m 1euc "Slowly, the woman rose up, still sobbing."
    m 1euc "Lentamente, la mujer se levantó, todavía sollozando."

# game/script-stories.rpy:1248
translate spanish mas_scary_story_mujina_d18332b1:

    # m 1dsc "The man laid his hand lightly on her shoulder..."
    m 1dsc "El hombre posó su mano suavemente sobre su hombro..."

# game/script-stories.rpy:1249
translate spanish mas_scary_story_mujina_c2902e8e:

    # m 4wud "When she abruptly turned her head to him, showing a blank face, void of all human features."
    m 4wud "Cuando ella giró bruscamente la cabeza hacia él, mostrando un rostro en blanco, carente de todo rasgo humano."

# game/script-stories.rpy:1250
translate spanish mas_scary_story_mujina_35af938d:

    # m 4wuw "No eyes, mouth, or nose. Just an empty visage that stared back at him!"
    m 4wuw "Ni ojos, ni boca, ni nariz. ¡Solo un rostro vacío que le devolvía la mirada!"

# game/script-stories.rpy:1251
translate spanish mas_scary_story_mujina_2778c1c9:

    # m "The merchant ran away as fast as he could, panicking from the haunting figure."
    m "El mercader huyó tan rápido como pudo, presa del pánico por la inquietante figura."

# game/script-stories.rpy:1252
translate spanish mas_scary_story_mujina_a52463ee:

    # m 1efc "He continued to run until he saw the light of a lantern and ran towards it."
    m 1efc "Siguió corriendo hasta que vio la luz de una linterna y corrió hacia ella."

# game/script-stories.rpy:1253
translate spanish mas_scary_story_mujina_1ab903d8:

    # m 3euc "The lantern belonged to a traveling salesman that was walking along."
    m 3euc "La linterna pertenecía a un vendedor ambulante que pasaba por allí."

# game/script-stories.rpy:1254
translate spanish mas_scary_story_mujina_13bf0796:

    # m 1esc "The old man stopped in front of him, doubled over to catch his breath."
    m 1esc "El anciano se detuvo frente a él, doblado para recuperar el aliento."

# game/script-stories.rpy:1255
translate spanish mas_scary_story_mujina_f5e4ff70:

    # m 3esc "The salesman asked why the man was running."
    m 3esc "El vendedor preguntó por qué corría el hombre."

# game/script-stories.rpy:1256
translate spanish mas_scary_story_mujina_5be3fcae:

    # m 4ekd "'A m-monster! There was a girl with no face by the moat!' the merchant cried."
    m 4ekd "'¡Un m-monstruo! ¡Había una chica sin cara junto al foso!', gritó el mercader."

# game/script-stories.rpy:1260
translate spanish mas_scary_story_mujina_cb5fe030:

    # m 2tub "The salesman responded, 'Oh, you mean...{w=2}{b}like this?{/b}'{nw}"
    m 2tub "El vendedor respondió: 'Ah, ¿quieres decir... {w=2}como esta?'{nw}"

# game/script-stories.rpy:1268
translate spanish mas_scary_story_mujina_4972fe4c:

    # m 2tub "The salesman responded, 'Oh, you mean like this?'"
    m 2tub "El vendedor respondió: 'Ah, ¿quieres decir como esta?'."

# game/script-stories.rpy:1269
translate spanish mas_scary_story_mujina_78c38ea8:

    # m 4wud "The man looked up at the salesman and saw the same horrifying emptiness from the girl."
    m 4wud "El hombre miró al vendedor y vio el mismo vacío horroroso de la chica."

# game/script-stories.rpy:1270
translate spanish mas_scary_story_mujina_abe084b4:

    # m "Before the merchant could get away, the void let out a high pitch screech..."
    m "Antes de que el mercader pudiera escapar, el vacío soltó un chillido agudo..."

# game/script-stories.rpy:1271
translate spanish mas_scary_story_mujina_4ad019e5:

    # m 1dsc "...and then there was darkness."
    m 1dsc "Y entonces se hizo la oscuridad."

# game/script-stories.rpy:1285
translate spanish mas_scary_story_ubume_cf6a9b0b:

    # m 3euc "One night at a late hour, a woman walked into a confectionery store to buy some candy right before the owner was about to head off to bed."
    m 3euc "Una noche, a una hora tardía, una mujer entró en una confitería para comprar caramelos justo antes de que el dueño se fuera a la cama."

# game/script-stories.rpy:1286
translate spanish mas_scary_story_ubume_b51b33a0:

    # m 1esc "The village was small, and the confectioner didn't recognize the woman, but didn't think much of it."
    m 1esc "El pueblo era pequeño y el confitero no reconoció a la mujer, pero no le dio mucha importancia."

# game/script-stories.rpy:1287
translate spanish mas_scary_story_ubume_f5d1515d:

    # m "He tiredly sold the woman the candy that she requested."
    m "Cansado, le vendió a la mujer los caramelos que le pidió."

# game/script-stories.rpy:1288
translate spanish mas_scary_story_ubume_dc4b6bbb:

    # m 1euc "The next night around the same time, the same woman walked into the shop to buy some more candy."
    m 1euc "A la noche siguiente, a la misma hora, la misma mujer entró en la tienda para comprar más caramelos."

# game/script-stories.rpy:1289
translate spanish mas_scary_story_ubume_6895ec30:

    # m "She continued to visit the shop nightly, until the confectioner became curious about the woman and decided to follow her the next time she came in."
    m "Siguió visitando la tienda cada noche, hasta que el confitero sintió curiosidad por la mujer y decidió seguirla la próxima vez que entrara."

# game/script-stories.rpy:1290
translate spanish mas_scary_story_ubume_2300baca:

    # m 1esd "The next night, the woman arrived at her usual time, purchased the candy that she always did, and went happily on her way."
    m 1esd "A la noche siguiente, la mujer llegó a su hora habitual, compró los caramelos que siempre compraba y se fue felizmente por su camino."

# game/script-stories.rpy:1291
translate spanish mas_scary_story_ubume_d2bc8d77:

    # m 3wud "After she walked out the door, the confectioner looked into his money box and saw the coins that the woman had given to him turned into leaves from a tree."
    m 3wud "Después de que ella saliera por la puerta, el confitero miró en su caja de dinero y vio que las monedas que la mujer le había dado se habían convertido en hojas de árbol."

# game/script-stories.rpy:1295
translate spanish mas_scary_story_ubume_195703f7:

    # m 1euc "He followed the woman to the outside of a nearby temple, where she simply vanished."
    m 1euc "Siguió a la mujer hasta el exterior de un templo cercano, donde simplemente se desvaneció."

# game/script-stories.rpy:1296
translate spanish mas_scary_story_ubume_378d2707:

    # m 1esc "The confectioner was shocked by this and decided to head back home."
    m 1esc "El confitero se quedó impactado por esto y decidió volver a casa."

# game/script-stories.rpy:1297
translate spanish mas_scary_story_ubume_f680671e:

    # m 3eud "The next day, he went to the temple and told the monk there what he saw."
    m 3eud "Al día siguiente, fue al templo y le contó al monje lo que había visto."

# game/script-stories.rpy:1298
translate spanish mas_scary_story_ubume_af218568:

    # m 1dsd "The priest told the confectioner that a young woman that was traveling through the village recently had suddenly died on the street."
    m 1dsd "El sacerdote le dijo al confitero que una joven que viajaba por el pueblo recientemente había muerto repentinamente en la calle."

# game/script-stories.rpy:1299
translate spanish mas_scary_story_ubume_d3ea598e:

    # m "The monk felt compassion for the poor dead woman, as she had been in her last month of pregnancy."
    m "El monje sintió compasión por la pobre mujer muerta, ya que estaba en su último mes de embarazo."

# game/script-stories.rpy:1300
translate spanish mas_scary_story_ubume_fdd2ada7:

    # m 1esc "He had her buried in the cemetery behind the temple and gave her and her child safe passage to the afterlife."
    m 1esc "Hizo que la enterraran en el cementerio detrás del templo y les dio a ella y a su hijo un pasaje seguro a la otra vida."

# game/script-stories.rpy:1301
translate spanish mas_scary_story_ubume_768eb73b:

    # m 4eud "As the monk led the confectioner to the site of the grave, they both heard a baby crying from beneath the ground."
    m 4eud "Mientras el monje guiaba al confitero al lugar de la tumba, ambos oyeron llorar a un bebé bajo tierra."

# game/script-stories.rpy:1302
translate spanish mas_scary_story_ubume_c28e4dd1:

    # m "Immediately, they fetched a couple of shovels and dug up the grave."
    m "Inmediatamente, fueron a buscar un par de palas y desenterraron la tumba."

# game/script-stories.rpy:1303
translate spanish mas_scary_story_ubume_6c8f3931:

    # m 1wuw "Much to their shock, they found a newborn baby boy sucking on a piece of candy."
    m 1wuw "Para su sorpresa, encontraron a un niño recién nacido chupando un caramelo."

# game/script-stories.rpy:1304
translate spanish mas_scary_story_ubume_af24feda:

    # m "Candy that the confectioner had always sold to the woman."
    m "Caramelos que el confitero siempre le había vendido a la mujer."

# game/script-stories.rpy:1305
translate spanish mas_scary_story_ubume_90c4f339:

    # m 1dsd "They lifted the boy out of the grave and the monk would take him as his own to raise."
    m 1dsd "Sacaron al niño de la tumba y el monje lo acogió como suyo para criarlo."

# game/script-stories.rpy:1306
translate spanish mas_scary_story_ubume_f2521dee:

    # m 1esc "And the woman's ghost was never seen ever again."
    m 1esc "Y el fantasma de la mujer nunca se volvió a ver."

# game/script-stories.rpy:1317
translate spanish mas_scary_story_womaninblack_774960ad:

    # m 3esd "One night, a colonel boarded a train on his way home."
    m 3esd "Una noche, un coronel subió a un tren de camino a casa."

# game/script-stories.rpy:1318
translate spanish mas_scary_story_womaninblack_949d13ca:

    # m 1esd "When he found a comfortable spot to sit, he fell asleep from the day's fatigue."
    m 1esd "Cuando encontró un sitio cómodo para sentarse, se quedó dormido por la fatiga del día."

# game/script-stories.rpy:1319
translate spanish mas_scary_story_womaninblack_e817c94e:

    # m 3eud "A short time later, he awoke abruptly feeling stiff and uneasy."
    m 3eud "Poco tiempo después, se despertó bruscamente sintiéndose rígido e inquieto."

# game/script-stories.rpy:1320
translate spanish mas_scary_story_womaninblack_e561e6d2:

    # m "To his surprise, he noticed that there was now a woman sitting opposite of him."
    m "Para su sorpresa, se dio cuenta de que ahora había una mujer sentada enfrente de él."

# game/script-stories.rpy:1321
translate spanish mas_scary_story_womaninblack_5f4161cf:

    # m "Her attire was entirely black, including a veil that obscured her face."
    m "Su atuendo era totalmente negro, incluyendo un velo que ocultaba su rostro."

# game/script-stories.rpy:1322
translate spanish mas_scary_story_womaninblack_f6405128:

    # m 1esc "She appeared to be looking down at something in her lap, although there wasn't anything there."
    m 1esc "Parecía estar mirando algo en su regazo, aunque no había nada allí."

# game/script-stories.rpy:1323
translate spanish mas_scary_story_womaninblack_af1e973a:

    # m 3esd "The colonel was a friendly fellow and tried to make small talk with her."
    m 3esd "El coronel era un tipo amable e intentó entablar conversación con ella."

# game/script-stories.rpy:1324
translate spanish mas_scary_story_womaninblack_6ef923d9:

    # m 1dsd "To his dismay, she did not respond to his pleasantries."
    m 1dsd "Para su consternación, ella no respondió a sus amabilidades."

# game/script-stories.rpy:1325
translate spanish mas_scary_story_womaninblack_d1bba771:

    # m 1esc "Suddenly, she began rocking back and forth and singing a soft lullaby."
    m 1esc "De repente, empezó a mecerse de un lado a otro y a cantar una suave nana."

# game/script-stories.rpy:1326
translate spanish mas_scary_story_womaninblack_10f8930c:

    # m "Before the colonel could inquire about it, the train screeched to a halt."
    m "Antes de que el coronel pudiera preguntar al respecto, el tren se detuvo con un chirrido."

# game/script-stories.rpy:1327
translate spanish mas_scary_story_womaninblack_8563288d:

    # m "A suitcase from the compartment above fell and hit him on the head, knocking him unconscious."
    m "Una maleta del compartimento superior cayó y le golpeó en la cabeza, dejándolo inconsciente."

# game/script-stories.rpy:1332
translate spanish mas_scary_story_womaninblack_42bfbf7a:

    # m 3eud "When he came to, the woman was gone. The colonel questioned some of the other passengers, but none of them had seen her."
    m 3eud "Cuando volvió en sí, la mujer había desaparecido. El coronel preguntó a algunos de los otros pasajeros, pero ninguno la había visto."

# game/script-stories.rpy:1333
translate spanish mas_scary_story_womaninblack_80e749f4:

    # m 3ekd "To boot, once the colonel had entered the compartment it was locked, as was customary, and no one had entered or left the compartment after he had entered."
    m 3ekd "Para colmo, una vez que el coronel entró en el compartimento, este se cerró, como era costumbre, y nadie había entrado ni salido del compartimento después de que él entrara."

# game/script-stories.rpy:1334
translate spanish mas_scary_story_womaninblack_894cb191:

    # m 1esc "When he exited the train, a railway official that overheard him talked to the colonel about the woman he was asking about."
    m 1esc "Al salir del tren, un revisor que le había escuchado hablar se acercó al coronel para contarle la historia de esa mujer."

# game/script-stories.rpy:1335
translate spanish mas_scary_story_womaninblack_370ec312:

    # m "According to the official, a woman and her husband were traveling on a train together."
    m "Según el funcionario, una mujer y su marido viajaban juntos en un tren."

# game/script-stories.rpy:1336
translate spanish mas_scary_story_womaninblack_fb979770:

    # m 1dsd "The husband had his head too far out in one of the windows and was decapitated by a wire."
    m 1dsd "El marido sacó demasiado la cabeza por una de las ventanillas y fue decapitado por un cable."

# game/script-stories.rpy:1337
translate spanish mas_scary_story_womaninblack_4c91ebf5:

    # m "His body then fell onto her lap, lifeless."
    m "Su cuerpo cayó entonces sobre el regazo de ella, sin vida."

# game/script-stories.rpy:1338
translate spanish mas_scary_story_womaninblack_4eab5b0b:

    # m 3wud "When the train arrived at its stop, she was found holding the corpse and singing a lullaby to it."
    m 3wud "Cuando el tren llegó a su parada, la encontraron abrazando el cadáver mientras le cantaba una nana."

# game/script-stories.rpy:1339
translate spanish mas_scary_story_womaninblack_37720cf2:

    # m "She never regained her sanity and died shortly after."
    m "Nunca recuperó la cordura y murió poco después."

# game/script-stories.rpy:1350
translate spanish mas_scary_story_resurrection_mary_1d0dc104:

    # m 3eua "At a dancehall around Christmas time, a young man named Lewis was enjoying some time with his friends, when a young woman he hadn't seen before caught his attention."
    m 3eua "En un salón de baile, por Navidad, un joven llamado Lewis disfrutaba de un rato con sus amigos, cuando una joven a la que no había visto antes le llamó la atención."

# game/script-stories.rpy:1351
translate spanish mas_scary_story_resurrection_mary_cd0d24f9:

    # m 1eub "The girl was tall, blonde, blue-eyed, and very beautiful."
    m 1eub "La chica era alta, rubia, de ojos azules y muy hermosa."

# game/script-stories.rpy:1352
translate spanish mas_scary_story_resurrection_mary_98e8a194:

    # m 1hub "She was wearing a fancy white dress, with white dancing shoes and a thin shawl."
    m 1hub "Llevaba un elegante vestido blanco, con zapatos de baile blancos y un chal fino."

# game/script-stories.rpy:1353
translate spanish mas_scary_story_resurrection_mary_daae4be7:

    # m 3esb "Lewis found the girl captivating. He decided to ask her to dance with him and she accepted his invitation."
    m 3esb "Lewis encontró a la chica cautivadora. Decidió pedirle que bailara con él y ella aceptó su invitación."

# game/script-stories.rpy:1354
translate spanish mas_scary_story_resurrection_mary_c9c77ea8:

    # m 1eud "She was certainly beautiful, but Lewis felt there was something strange about her."
    m 1eud "Ciertamente era hermosa, pero Lewis sintió que había algo extraño en ella."

# game/script-stories.rpy:1355
translate spanish mas_scary_story_resurrection_mary_2603dcf4:

    # m 3esd "As they danced, he tried to get to know her a little better, but all she would say about herself was that her name was Mary and that she was from the south side of town."
    m 3esd "Mientras bailaban, intentó conocerla un poco mejor, pero lo único que ella decía de sí misma era que se llamaba Mary y que era del sur de la ciudad."

# game/script-stories.rpy:1356
translate spanish mas_scary_story_resurrection_mary_ea420abf:

    # m "Also, her skin was cool and clammy to the touch. At one point during the evening, he kissed Mary, and found her lips were as cool as her skin."
    m "Además, su piel estaba fría y húmeda al tacto. En un momento de la velada, besó a Mary y descubrió que sus labios estaban tan fríos como su piel."

# game/script-stories.rpy:1357
translate spanish mas_scary_story_resurrection_mary_cf319c55:

    # m 1esb "The two spent much of the night together dancing. When the time came to leave, Lewis offered Mary a ride home and she again accepted the invitation."
    m 1esb "Los dos pasaron gran parte de la noche bailando juntos. Cuando llegó la hora de irse, Lewis se ofreció a llevar a Mary a casa y ella aceptó de nuevo la invitación."

# game/script-stories.rpy:1358
translate spanish mas_scary_story_resurrection_mary_6d6cc97c:

    # m 3esb "She directed him to drive down a certain road, and he obliged."
    m 3esb "Ella le indicó que condujera por una carretera determinada, y él obedeció."

# game/script-stories.rpy:1359
translate spanish mas_scary_story_resurrection_mary_55364284:

    # m 3eud "As they were passing the gates of a cemetery, Mary asked Lewis to pull over."
    m 3eud "Cuando pasaban por las puertas de un cementerio, Mary le pidió a Lewis que parase."

# game/script-stories.rpy:1360
translate spanish mas_scary_story_resurrection_mary_7f27c42e:

    # m 1eud "Although perplexed, Lewis stopped the car as she requested."
    m 1eud "Aunque perplejo, Lewis detuvo el coche como ella le pidió."

# game/script-stories.rpy:1361
translate spanish mas_scary_story_resurrection_mary_ebdefc90:

    # m 3eud "She then opened the door, leaned in towards Lewis and whispered that she had to go and that he could not go with her."
    m 3eud "Entonces abrió la puerta, se inclinó hacia Lewis y le susurró que tenía que irse y que él no podía ir con ella."

# game/script-stories.rpy:1362
translate spanish mas_scary_story_resurrection_mary_e1628ae9:

    # m 1euc "She got out of the car and walked towards the cemetery gate before disappearing."
    m 1euc "Salió del coche y caminó hacia la puerta del cementerio antes de desaparecer."

# game/script-stories.rpy:1363
translate spanish mas_scary_story_resurrection_mary_2c45aba1:

    # m "Lewis sat in the car for a long time bewildered by what had just happened."
    m "Lewis se quedó sentado en el coche mucho tiempo desconcertado por lo que acababa de ocurrir."

# game/script-stories.rpy:1364
translate spanish mas_scary_story_resurrection_mary_481bf229:

    # m 1esd "He never saw the beautiful woman ever again."
    m 1esd "Nunca volvió a ver a la hermosa mujer."

# game/script-stories.rpy:1378
translate spanish mas_scary_story_corpse_8debecc1:

    # m 1esa "There once was an old man that ran an old roadside inn. One evening, 4 men arrived and asked for a room."
    m 1esa "Érase una vez un anciano que regentaba una vieja posada de carretera. Una tarde, llegaron cuatro hombres y pidieron una habitación."

# game/script-stories.rpy:1379
translate spanish mas_scary_story_corpse_976d1e97:

    # m 3eua "The old man replied that all of the rooms were taken, but he could find them a place to sleep if they weren't too particular."
    m 3eua "El anciano respondió que todas las habitaciones estaban ocupadas, pero que podía buscarles un sitio para dormir si no eran muy exigentes."

# game/script-stories.rpy:1380
translate spanish mas_scary_story_corpse_96697eec:

    # m 1esa "The men were exhausted and assured the man that any place would do."
    m 1esa "Los hombres estaban agotados y aseguraron al hombre que cualquier sitio serviría."

# game/script-stories.rpy:1381
translate spanish mas_scary_story_corpse_c91f9d0c:

    # m 1eud "He led them to a room around back. Lying in the corner of the room was the corpse of a woman."
    m 1eud "Los llevó a una habitación en la parte trasera. Yaciendo en la esquina de la habitación estaba el cadáver de una mujer."

# game/script-stories.rpy:1382
translate spanish mas_scary_story_corpse_700e4314:

    # m "He explained that his daughter-in-law had recently perished and she was awaiting burial."
    m "Explicó que su nuera había fallecido recientemente y que estaba esperando el entierro."

# game/script-stories.rpy:1383
translate spanish mas_scary_story_corpse_2531da81:

    # m 1eua "After the old man departed, 3 of the 4 men fell asleep. The last man couldn't fall asleep."
    m 1eua "Después de que el anciano se marchara, tres de los cuatro hombres se durmieron. El último hombre no podía conciliar el sueño."

# game/script-stories.rpy:1384
translate spanish mas_scary_story_corpse_2a368030:

    # m 1wuo "Suddenly, the man heard a creaking noise."
    m 1wuo "De repente, el hombre oyó un crujido."

# game/script-stories.rpy:1387
translate spanish mas_scary_story_corpse_c5cf1cf4:

    # m 3wuo "He looked up and in the light of the lamp, he saw the woman rise, now bearing fangs and fingernails that looked like claws, advancing towards them."
    m 3wuo "Levantó la vista y, a la luz de la lámpara, vio a la mujer levantarse, mostrando ahora colmillos y uñas que parecían garras, avanzando hacia ellos."

# game/script-stories.rpy:1388
translate spanish mas_scary_story_corpse_e684fabe:

    # m "She bent down and bit each of the sleeping men. The fourth man, at the last second, pulled up a pillow in front of his neck."
    m "Se agachó y mordió a cada uno de los hombres dormidos. El cuarto hombre, en el último segundo, se puso una almohada delante del cuello."

# game/script-stories.rpy:1389
translate spanish mas_scary_story_corpse_8eb046b5:

    # m 1eud "The woman bit the pillow and apparently not realizing she hadn't bit the last man, returned to her original resting spot."
    m 1eud "La mujer mordió la almohada y, al parecer sin darse cuenta de que no había mordido al último hombre, volvió a su lugar de descanso original."

# game/script-stories.rpy:1390
translate spanish mas_scary_story_corpse_e29ada39:

    # m 3eud "The man kicked his companions, but none of them moved. The man decided to take his chances and make a run for it."
    m 3eud "El hombre dio patadas a sus compañeros, pero ninguno se movió. El hombre decidió arriesgarse y echar a correr."

# game/script-stories.rpy:1391
translate spanish mas_scary_story_corpse_5a347b51:

    # m 3wuo "As soon as his feet touched the ground, however, he heard another creak."
    m 3wuo "Sin embargo, en cuanto sus pies tocaron el suelo, oyó otro crujido."

# game/script-stories.rpy:1394
translate spanish mas_scary_story_corpse_6c0c33ea:

    # m "Realizing that the woman was again rising from her spot, he opened the door and ran as fast as he could."
    m "Al darse cuenta de que la mujer se levantaba de nuevo de su sitio, abrió la puerta y corrió tan rápido como pudo."

# game/script-stories.rpy:1399
translate spanish mas_scary_story_corpse_93ba0d66:

    # m 3eud "After a short distance, he looked behind him and saw that the corpse was not far behind him."
    m 3eud "Tras recorrer una corta distancia, miró hacia atrás y vio que el cadáver no estaba muy lejos de él."

# game/script-stories.rpy:1400
translate spanish mas_scary_story_corpse_1115fd62:

    # m 3wud "A chase ensued and as she caught up to him, he found himself standing under a tree."
    m 3wud "Se produjo una persecución y, cuando ella le alcanzó, él se encontró de pie bajo un árbol."

# game/script-stories.rpy:1401
translate spanish mas_scary_story_corpse_96410f80:

    # m "She charged towards him with her claw-like fingernails extended."
    m "Ella cargó hacia él con sus uñas como garras extendidas."

# game/script-stories.rpy:1402
translate spanish mas_scary_story_corpse_8646f69c:

    # m 4wud "At the last second, the man dodged and she struck the tree with great ferocity."
    m 4wud "En el último segundo, el hombre la esquivó y ella se estampó contra el árbol con gran ferocidad."

# game/script-stories.rpy:1403
translate spanish mas_scary_story_corpse_2565aa83:

    # m 3wud "Her fingernails were now deeply embedded in the tree."
    m 3wud "Sus uñas estaban ahora profundamente incrustadas en el árbol."

# game/script-stories.rpy:1404
translate spanish mas_scary_story_corpse_feece53c:

    # m 1wud "She wildly swung her freehand at the man as he lay on the ground, unable to reach him."
    m 1wud "Ella lanzó salvajemente su mano libre contra el hombre mientras yacía en el suelo, incapaz de alcanzarle."

# game/script-stories.rpy:1405
translate spanish mas_scary_story_corpse_74571f87:

    # m 1eud "The man, frightened and exhausted crawled a short distance away and then passed out."
    m 1eud "El hombre, asustado y exhausto, se arrastró una corta distancia y luego se desmayó."

# game/script-stories.rpy:1412
translate spanish mas_scary_story_corpse_fd78af00:

    # m 1esd "The next morning a passing police officer found the man and brought him back to consciousness."
    m 1esd "A la mañana siguiente, un oficial de policía que pasaba por allí encontró al hombre y le hizo recobrar el conocimiento."

# game/script-stories.rpy:1413
translate spanish mas_scary_story_corpse_ae3f3182:

    # m "The man recounted what had happened. The officer, thinking the man was a drunkard, walked the man back to the inn."
    m "El hombre relató lo sucedido. El agente, pensando que el hombre era un borracho, lo acompañó de vuelta a la posada."

# game/script-stories.rpy:1414
translate spanish mas_scary_story_corpse_00c6c18b:

    # m 1eud "As they arrived, the inn was in a state of great commotion."
    m 1eud "Al llegar, la posada estaba en un estado de gran conmoción."

# game/script-stories.rpy:1415
translate spanish mas_scary_story_corpse_2196ddcb:

    # m 3eud "The 3 travelers had been found dead in their beds."
    m 3eud "Los tres viajeros habían sido encontrados muertos en sus camas."

# game/script-stories.rpy:1416
translate spanish mas_scary_story_corpse_731e959a:

    # m "The body of the daughter-in-law was lying where she had been the night before, but now her clothes were soiled with blood and a piece of bark was found under her fingernail."
    m "El cuerpo de la nuera yacía donde había estado la noche anterior, pero ahora su ropa estaba manchada de sangre y se encontró un trozo de corteza bajo su uña."

# game/script-stories.rpy:1417
translate spanish mas_scary_story_corpse_6d98bbb8:

    # m 3esd "After some questioning, the innkeeper finally admitted that the woman had died six months previously and he was trying to save enough money to give her a proper burial."
    m 3esd "Tras algunas preguntas, el posadero admitió finalmente que la mujer había muerto seis meses antes y que intentaba ahorrar suficiente dinero para darle un entierro digno."

# game/script-stories.rpy:1430
translate spanish mas_scary_story_jack_o_lantern_0ba07c08:

    # m 4esd "There was once a man named Jack. Jack was a miserable, old drunk who took pleasure in playing tricks on people."
    m 4esd "Érase una vez un hombre llamado Jack. Jack era un viejo borracho y miserable que disfrutaba gastando bromas a la gente."

# game/script-stories.rpy:1431
translate spanish mas_scary_story_jack_o_lantern_aafb1c2f:

    # m 3esa "One night, Jack ran into the Devil and invited him to have a drink with him."
    m 3esa "Una noche, Jack se encontró con el Diablo y le invitó a tomar una copa con él."

# game/script-stories.rpy:1432
translate spanish mas_scary_story_jack_o_lantern_bee9b032:

    # m "After Jack had had his fill, he turned to the Devil and asked him to turn into a coin so he could pay for their drinks, as he didn't have the money to pay for them."
    m "Después de que Jack se saciara, se volvió hacia el Diablo y le pidió que se convirtiera en una moneda para poder pagar sus bebidas, ya que no tenía dinero para pagarlas."

# game/script-stories.rpy:1433
translate spanish mas_scary_story_jack_o_lantern_58799d5f:

    # m 1esa "Once the Devil did so, Jack pocketed the coin and walked out without paying."
    m 1esa "Una vez que el Diablo lo hizo, Jack se guardó la moneda en el bolsillo y salió sin pagar."

# game/script-stories.rpy:1434
translate spanish mas_scary_story_jack_o_lantern_f09fd606:

    # m "The Devil could not turn back to his original form because Jack had put it into his pocket next to a silver cross."
    m "El Diablo no podía volver a su forma original porque Jack la había metido en su bolsillo junto a una cruz de plata."

# game/script-stories.rpy:1435
translate spanish mas_scary_story_jack_o_lantern_84c72f53:

    # m 3esa "Jack eventually freed the Devil, under the condition that he would not bother Jack for 1 year and that, should Jack die, he would not claim his soul."
    m 3esa "Jack acabó liberando al Diablo, bajo la condición de que no molestaría a Jack durante 1 año y que, si Jack moría, no reclamaría su alma."

# game/script-stories.rpy:1436
translate spanish mas_scary_story_jack_o_lantern_1bcad4e8:

    # m "The next year, Jack ran into the Devil again. This time he tricked him into climbing into a tree to pick a piece of fruit."
    m "Al año siguiente, Jack se volvió a encontrar con el Diablo. Esta vez le engañó para que se subiera a un árbol a coger una fruta."

# game/script-stories.rpy:1437
translate spanish mas_scary_story_jack_o_lantern_d48fb8e5:

    # m 3esd "While he was in the tree, Jack surrounded it with white crosses so that the Devil could not come down."
    m 3esd "Mientras estaba en el árbol, Jack lo rodeó de cruces blancas para que el Diablo no pudiera bajar."

# game/script-stories.rpy:1438
translate spanish mas_scary_story_jack_o_lantern_a0c50971:

    # m "Once the Devil promised not to bother him again for another 10 years, Jack removed them. When Jack died, he went to Heaven."
    m "Una vez que el Diablo prometió no volver a molestarle en otros 10 años, Jack las quitó. Cuando Jack murió, fue al Cielo."

# game/script-stories.rpy:1439
translate spanish mas_scary_story_jack_o_lantern_d0a78913:

    # m 1eud "When he arrived, he was told he could not enter for how poorly he had lived his life on Earth."
    m 1eud "Cuando llegó, le dijeron que no podía entrar por lo mal que había vivido su vida en la Tierra."

# game/script-stories.rpy:1440
translate spanish mas_scary_story_jack_o_lantern_97688119:

    # m 1eua "So, he went down to Hell, where the Devil kept his promise and would not allow Jack to enter."
    m 1eua "Así que bajó al Infierno, donde el Diablo cumplió su promesa y no permitió a Jack entrar."

# game/script-stories.rpy:1441
translate spanish mas_scary_story_jack_o_lantern_db34dcd8:

    # m 1eud "Jack became scared, for he had no place to go."
    m 1eud "Jack se asustó, pues no tenía adónde ir."

# game/script-stories.rpy:1442
translate spanish mas_scary_story_jack_o_lantern_89c498d0:

    # m 1esd "Jack asked the Devil how he could leave, as there was no light."
    m 1esd "Jack le preguntó al Diablo cómo podía irse, ya que no había luz."

# game/script-stories.rpy:1447
translate spanish mas_scary_story_jack_o_lantern_e9a0bd94:

    # m 1eud "The Devil tossed Jack an ember from the flames of Hell to help Jack light his way."
    m 1eud "El Diablo le lanzó a Jack una brasa de las llamas del Infierno para ayudarle a iluminar su camino."

# game/script-stories.rpy:1448
translate spanish mas_scary_story_jack_o_lantern_2f79f76e:

    # m "Jack pulled out a turnip he had with him, carved it out, and placed the ember inside of it."
    m "Jack sacó un nabo que llevaba consigo, lo vació y colocó la brasa en su interior."

# game/script-stories.rpy:1449
translate spanish mas_scary_story_jack_o_lantern_edefa5c7:

    # m 3eua "From that day onward, Jack roamed the earth without a resting place, lighting the way as he went with his Jack O'Lantern."
    m 3eua "Desde aquel día, Jack vagó por la tierra sin lugar de descanso, iluminando el camino a su paso con su Jack-o'-lantern."

# game/script-stories.rpy:1463
translate spanish mas_scary_story_baobhan_sith_38fe590e:

    # m 1esa "There was once a young group of hunters, who stopped for the night in a small hunting lodge."
    m 1esa "Érase una vez un grupo de jóvenes cazadores que se detuvo a pasar la noche en un pequeño refugio de caza."

# game/script-stories.rpy:1464
translate spanish mas_scary_story_baobhan_sith_26d277de:

    # m 3esb "As the men settled in, they built a fire, and began eating and drinking merrily, for it had been a good day."
    m 3esb "Cuando los hombres se acomodaron, encendieron una hoguera y empezaron a comer y beber alegremente, pues había sido un buen día."

# game/script-stories.rpy:1465
translate spanish mas_scary_story_baobhan_sith_a51980b1:

    # m 1tku "They said to themselves the only thing that they lacked was the company of some beautiful women by their sides."
    m 1tku "Se dijeron a sí mismos que lo único que les faltaba era la compañía de algunas mujeres hermosas a su lado."

# game/script-stories.rpy:1466
translate spanish mas_scary_story_baobhan_sith_4e044b4f:

    # m 1tsb "Not too long after they said this, there came a knock at their door."
    m 1tsb "Poco después de decir esto, llamaron a la puerta."

# game/script-stories.rpy:1467
translate spanish mas_scary_story_baobhan_sith_013f3678:

    # m 3eub "There in the doorway stood four beautiful women."
    m 3eub "En la puerta había cuatro hermosas mujeres."

# game/script-stories.rpy:1468
translate spanish mas_scary_story_baobhan_sith_00aede4a:

    # m "The women, having become lost in the wilderness, asked if they may join the men in their shelter for the night."
    m "Las mujeres, habiéndose perdido en el bosque, preguntaron si podían unirse a los hombres en su refugio para pasar la noche."

# game/script-stories.rpy:1469
translate spanish mas_scary_story_baobhan_sith_0ee0ca16:

    # m 1tku "The men, silently congratulating themselves on their good fortunes, invited the women in."
    m 1tku "Los hombres, felicitándose en silencio por su buena suerte, invitaron a las mujeres a entrar."

# game/script-stories.rpy:1470
translate spanish mas_scary_story_baobhan_sith_22563500:

    # m 1esa "After a while of enjoying each other's company, the women expressed a wish to dance."
    m 1esa "Tras un rato disfrutando de la compañía mutua, las mujeres expresaron su deseo de bailar."

# game/script-stories.rpy:1471
translate spanish mas_scary_story_baobhan_sith_4c6a369c:

    # m 1tku "The men wasted no time coupling off with each of the maidens."
    m 1tku "Los hombres no perdieron el tiempo emparejándose con cada una de las doncellas."

# game/script-stories.rpy:1472
translate spanish mas_scary_story_baobhan_sith_ab0bdce2:

    # m 1eub "As they are dancing, one of the men notices that the other couples are dancing rather erratically."
    m 1eub "Mientras bailaban, uno de los hombres notó que las otras parejas bailaban de forma bastante errática."

# game/script-stories.rpy:1473
translate spanish mas_scary_story_baobhan_sith_8fe65db8:

    # m 1wuo "Then, to his horror, he realizes that the other men have blood pouring from their necks onto their shirts."
    m 1wuo "Entonces, para su horror, se dio cuenta de que a los otros hombres les brotaba sangre del cuello sobre sus camisas."

# game/script-stories.rpy:1474
translate spanish mas_scary_story_baobhan_sith_a4bdd3e8:

    # m 3wuo "In a blind panic, the man abandoned his partner and bolted out the door, before he could share the fate of his friends."
    m 3wuo "Presa del pánico ciego, el hombre abandonó a su pareja y salió corriendo por la puerta, antes de compartir el destino de sus amigos."

# game/script-stories.rpy:1475
translate spanish mas_scary_story_baobhan_sith_1f49067a:

    # m 3wud "He ran into the forest and hid amongst the horses he and his friends had ridden during that day's hunt."
    m 3wud "Corrió hacia el bosque y se escondió entre los caballos que él y sus amigos habían montado durante la cacería de aquel día."

# game/script-stories.rpy:1476
translate spanish mas_scary_story_baobhan_sith_bb6ecf96:

    # m "The women, not far behind, closed in, but appeared unable to get past the horses to the man."
    m "Las mujeres, no muy lejos, se acercaron, pero parecían incapaces de pasar a través de los caballos para llegar al hombre."

# game/script-stories.rpy:1477
translate spanish mas_scary_story_baobhan_sith_dc785565:

    # m 1eud "So there he stood, weary eyed, among the animals all night long as the women circled around the horses, trying to find a way to get to him."
    m 1eud "Así que allí se quedó, con los ojos cansados, entre los animales durante toda la noche mientras las mujeres daban vueltas alrededor de los caballos, tratando de encontrar la forma de llegar hasta él."

# game/script-stories.rpy:1478
translate spanish mas_scary_story_baobhan_sith_2eaf1d2b:

    # m 1esa "Just before dawn, the women gave up and retreated back into the woods."
    m 1esa "Justo antes del amanecer, las mujeres se rindieron y se retiraron al bosque."

# game/script-stories.rpy:1479
translate spanish mas_scary_story_baobhan_sith_4dbe8f67:

    # m 1esd "Now alone, the man cautiously headed back towards the hunting lodge, hearing no sound from within."
    m 1esd "Ahora solo, el hombre se dirigió cautelosamente de vuelta hacia el refugio de caza, sin oír ningún sonido procedente del interior."

# game/script-stories.rpy:1503
translate spanish mas_scary_story_baobhan_sith_face4e36:

    # m 3wuo "When he looked inside, he saw his three comrades dead on the floor, their skin almost translucent, as they lay in a pool of their own blood."
    m 3wuo "Cuando miró dentro, vio a sus tres camaradas muertos en el suelo, con la piel casi translúcida, yaciendo en un charco de su propia sangre."

# game/script-stories.rpy:1514
translate spanish mas_scary_story_serial_killer_ed6b2b31:

    # m 3tub "A young couple parked their car next to a large willow tree at a cemetery one night for some undisturbed 'lovemaking.'"
    m 3tub "Una noche, una joven pareja aparcó su coche junto a un gran sauce en un cementerio para 'hacer el amor' sin ser molestados."

# game/script-stories.rpy:1515
translate spanish mas_scary_story_serial_killer_ba0320f5:

    # m 3euc "After a while, they were interrupted by a radio report that a notorious serial killer had escaped from a psychiatric hospital nearby."
    m 3euc "Al cabo de un rato, fueron interrumpidos por un informe de radio que decía que un famoso asesino en serie había escapado de un hospital psiquiátrico cercano."

# game/script-stories.rpy:1516
translate spanish mas_scary_story_serial_killer_b5398406:

    # m "Worried about their safety, they decided to continue elsewhere."
    m "Preocupados por su seguridad, decidieron continuar en otro lugar."

# game/script-stories.rpy:1517
translate spanish mas_scary_story_serial_killer_2f54ab08:

    # m 1esc "However...{w=0.3}the car wouldn't start at all."
    m 1esc "Sin embargo... {w=0.3}el coche no arrancaba en absoluto."

# game/script-stories.rpy:1518
translate spanish mas_scary_story_serial_killer_8d87ddef:

    # m 3esd "The young man got out of the car to look for help and told the girl to stay inside with the doors locked."
    m 3esd "El joven salió del coche para buscar ayuda y le dijo a la chica que se quedara dentro con las puertas cerradas."

# game/script-stories.rpy:1519
translate spanish mas_scary_story_serial_killer_5703015f:

    # m 3wud "A few moments later, she was startled when she heard an eerie scratching sound on the roof of the car."
    m 3wud "Unos momentos después, se sobresaltó al oír un espeluznante sonido de arañazos en el techo del coche."

# game/script-stories.rpy:1520
translate spanish mas_scary_story_serial_killer_eb9c5ced:

    # m 1eud "She thought to herself that it must've been a tree branch in the wind."
    m 1eud "Pensó que debía ser una rama de árbol movida por el viento."

# game/script-stories.rpy:1521
translate spanish mas_scary_story_serial_killer_f9886153:

    # m 1euc "After a long time had passed, a police car drove by and stopped but still no sight of her boyfriend."
    m 1euc "Después de mucho tiempo, pasó un coche de policía y se detuvo, pero seguía sin haber rastro de su novio."

# game/script-stories.rpy:1522
translate spanish mas_scary_story_serial_killer_ce38f2fa:

    # m 1eud "The police officer went to the car and instructed the girl to exit the vehicle and walk toward him and not look back."
    m 1eud "El oficial de policía se dirigió al coche y le indicó a la chica que saliera del vehículo, caminara hacia él y no mirara atrás."

# game/script-stories.rpy:1523
translate spanish mas_scary_story_serial_killer_35b3d997:

    # m "She did so slowly..."
    m "Ella lo hizo lentamente..."

# game/script-stories.rpy:1524
translate spanish mas_scary_story_serial_killer_ccf45ed6:

    # m 1ekc "The girl then noticed numerous other police cars arriving with their sirens blaring behind the first one to arrive."
    m 1ekc "Entonces la chica se dio cuenta de que llegaban otros muchos coches de policía con las sirenas a todo volumen detrás del primero."

# game/script-stories.rpy:1525
translate spanish mas_scary_story_serial_killer_387e39c3:

    # m 1dsd "Curiosity then got the better of her and she turned to look at the car..."
    m 1dsd "La curiosidad pudo con ella y se giró para mirar el coche..."

# game/script-stories.rpy:1526
translate spanish mas_scary_story_serial_killer_a458d9cc:

    # m 4wfw "She saw her boyfriend upside down and hanging from the tree above their car with his neck slit wide open..."
    m 4wfw "Vio a su novio boca abajo y colgado del árbol sobre su coche con el cuello totalmente rajado..."

# game/script-stories.rpy:1534
translate spanish mas_scary_story_serial_killer_6eb05250:

    # m 1dfc "...and his broken and bloody fingernails on the roof."
    m 1dfc "Y sus uñas rotas y ensangrentadas sobre el techo."

# game/script-stories.rpy:1546
translate spanish mas_scary_story_revenant_12889e42:

    # m 4eua "There was once a man who married a woman."
    m 4eua "Érase una vez un hombre que se casó con una mujer."

# game/script-stories.rpy:1547
translate spanish mas_scary_story_revenant_67d7e77b:

    # m 4ekd "He was a wealthy person who made his money through ill-gotten means."
    m 4ekd "Era una persona rica que hacía su dinero por medios ilícitos."

# game/script-stories.rpy:1548
translate spanish mas_scary_story_revenant_b0ed5d85:

    # m 2eud "Shortly after their marriage, he started to hear rumors that his wife was being unfaithful to him."
    m 2eud "Poco después de su matrimonio, empezó a oír rumores de que su mujer le estaba siendo infiel."

# game/script-stories.rpy:1549
translate spanish mas_scary_story_revenant_73d809ac:

    # m 2esd "Anxious to ascertain the truth, the man told his wife he was going away on a business trip for a few days and left the house."
    m 2esd "Ansioso por comprobar la verdad, el hombre le dijo a su esposa que se iba de viaje de negocios unos días y salió de la casa."

# game/script-stories.rpy:1550
translate spanish mas_scary_story_revenant_6954c5fc:

    # m 2eud "Unbeknownst to his wife, the man snuck back into the house later in the evening with the aid of one of his servants."
    m 2eud "Sin que su mujer lo supiera, el hombre volvió a entrar a escondidas en la casa más tarde esa noche con la ayuda de uno de sus sirvientes."

# game/script-stories.rpy:1551
translate spanish mas_scary_story_revenant_456af2e5:

    # m "The man climbed up one of the beams overhanging in his bedchamber and laid in wait."
    m "El hombre trepó a una de las vigas que sobresalían en su dormitorio y se quedó esperando."

# game/script-stories.rpy:1552
translate spanish mas_scary_story_revenant_9b1decb4:

    # m 4ekd "Shortly afterwards his wife entered with a man of the neighborhood, the two chatted for a while and then began to undress themselves."
    m 4ekd "Poco después entró su mujer con un hombre del vecindario, los dos charlaron un rato y luego empezaron a desvestirse."

# game/script-stories.rpy:1553
translate spanish mas_scary_story_revenant_121936e0:

    # m 4eud "The man, at this time, clumsily fell to the ground not far from where the two were, unconscious."
    m 4eud "En ese momento, el hombre cayó torpemente al suelo, quedando inconsciente a poca distancia de ellos."

# game/script-stories.rpy:1554
translate spanish mas_scary_story_revenant_f51541c6:

    # m "The adulterer grabbed his clothes and ran away, but the wife came over to her husband and gently patted his hair until he awoke."
    m "El adúltero cogió su ropa y huyó, pero la esposa se acercó a su marido y le acarició suavemente el pelo hasta que se despertó."

# game/script-stories.rpy:1555
translate spanish mas_scary_story_revenant_cc454b1b:

    # m "The man chastised his wife for her adultery and threatened punishment once he recovered from his fall."
    m "El hombre reprendió a su esposa por su adulterio y amenazó con castigarla una vez que se recuperara de su caída."

# game/script-stories.rpy:1556
translate spanish mas_scary_story_revenant_8d163122:

    # m 2dsc "The man, however, never recovered from his fall and died overnight. He was buried the next day."
    m 2dsc "El hombre, sin embargo, nunca se recuperó de su caída y murió durante la noche. Fue enterrado al día siguiente."

# game/script-stories.rpy:1557
translate spanish mas_scary_story_revenant_a7da7e7c:

    # m 2esd "That night, the man's corpse rose up from his grave and began to wander the neighborhoods."
    m 2esd "Esa noche, el cadáver del hombre se levantó de su tumba y comenzó a vagar por los vecindarios."

# game/script-stories.rpy:1558
translate spanish mas_scary_story_revenant_943aac78:

    # m "As dawn broke, he would return to his grave."
    m "Al amanecer, volvía a su tumba."

# game/script-stories.rpy:1559
translate spanish mas_scary_story_revenant_7d7b71c9:

    # m 3esd "This continued night after night and people began locking their doors, fearing to go out to run any errands after the sun went down."
    m 3esd "Esto continuó noche tras noche y la gente empezó a cerrar sus puertas con llave, temiendo salir a hacer recados después de la puesta de sol."

# game/script-stories.rpy:1560
translate spanish mas_scary_story_revenant_4fa03516:

    # m "Lest they run into the creature and be beaten black and blue."
    m "Por miedo a toparse con la criatura y recibir una paliza."

# game/script-stories.rpy:1561
translate spanish mas_scary_story_revenant_c1b6fe42:

    # m 2dsd "Not long afterwards, the town became plagued by disease and there was no doubt in their minds that the corpse was to blame."
    m 2dsd "No mucho después, el pueblo se vio asolado por una enfermedad y no les cabía duda de que la culpa era del cadáver."

# game/script-stories.rpy:1562
translate spanish mas_scary_story_revenant_08f89376:

    # m 2dsc "People started fleeing the town, lest they too should die by the disease."
    m 2dsc "La gente empezó a huir del pueblo, por miedo a morir también por la enfermedad."

# game/script-stories.rpy:1563
translate spanish mas_scary_story_revenant_85995ac3:

    # m 2esd "As the town was falling apart, a meeting was gathered and it was decided that the corpse should be dug up and disposed of."
    m 2esd "Mientras el pueblo se desmoronaba, se convocó una reunión y se decidió desenterrar el cadáver y deshacerse de él."

# game/script-stories.rpy:1564
translate spanish mas_scary_story_revenant_332f7e55:

    # m "A group of people took spades and found the cemetery the man was buried in."
    m "Un grupo de personas cogió palas y encontró el cementerio en el que estaba enterrado el hombre."

# game/script-stories.rpy:1565
translate spanish mas_scary_story_revenant_7a768c44:

    # m "They didn't have to dig long before they reached the man's corpse."
    m "No tuvieron que cavar mucho antes de llegar al cadáver del hombre."

# game/script-stories.rpy:1566
translate spanish mas_scary_story_revenant_51732e44:

    # m 4eud "Once he was fully disinterred, the villagers beat the carcass with their shovels and dragged the body out of town."
    m 4eud "Una vez desenterrado por completo, los aldeanos golpearon el cadáver con sus palas y arrastraron el cuerpo fuera del pueblo."

# game/script-stories.rpy:1567
translate spanish mas_scary_story_revenant_97936de9:

    # m 3esd "There, they built a great fire and threw the body on the fire."
    m 3esd "Allí encendieron una gran hoguera y arrojaron el cuerpo al fuego."

# game/script-stories.rpy:1568
translate spanish mas_scary_story_revenant_13c8351c:

    # m 3eub "The man's corpse let out a blood curdling scream and attempted to crawl out of the flames before finally succumbing to it."
    m 3eub "El cadáver del hombre soltó un grito espeluznante e intentó salir arrastrándose de las llamas antes de sucumbir finalmente a ellas."

# game/script-stories.rpy:1586
translate spanish mas_scary_story_yuki_onna_e6614079:

    # m 4eud "There were once two woodcutters, a father and son, who were on their way home when a blizzard suddenly arose."
    m 4eud "Érase una vez dos leñadores, padre e hijo, que iban de camino a casa cuando de repente se desató una ventisca."

# game/script-stories.rpy:1587
translate spanish mas_scary_story_yuki_onna_2921a22f:

    # m "After a little bit of travel, they came across an abandoned cabin and took shelter in it."
    m "Tras un poco de viaje, se toparon con una cabaña abandonada y se refugiaron en ella."

# game/script-stories.rpy:1588
translate spanish mas_scary_story_yuki_onna_74be4502:

    # m 2eua "They were able to build a modest fire and huddled together for warmth before falling asleep."
    m 2eua "Pudieron hacer un fuego modesto y se acurrucaron juntos para entrar en calor antes de quedarse dormidos."

# game/script-stories.rpy:1589
translate spanish mas_scary_story_yuki_onna_0d6a7d3f:

    # m 2esd "In the middle of the night, the son awoke from his sleep with a jolt."
    m 2esd "En medio de la noche, el hijo se despertó sobresaltado."

# game/script-stories.rpy:1590
translate spanish mas_scary_story_yuki_onna_ee05b63f:

    # m 2wud "To his surprise, a beautiful woman was standing over his father, blowing her breath on him and instantly freezing him."
    m 2wud "Para su sorpresa, una hermosa mujer estaba de pie sobre su padre, soplando su aliento sobre él y congelándolo al instante."

# game/script-stories.rpy:1591
translate spanish mas_scary_story_yuki_onna_17500bda:

    # m 4wud "As she turned to the son, she paused. The woman said to him that she would spare him of the same fate, for he was young and very handsome."
    m 4wud "Al volverse hacia el hijo, se detuvo. La mujer le dijo que le libraría del mismo destino, pues era joven y muy apuesto."

# game/script-stories.rpy:1592
translate spanish mas_scary_story_yuki_onna_21b25a72:

    # m 4ekc "If he ever spoke a word of it to anyone, she would come back to kill him."
    m 4ekc "Si alguna vez le contaba una palabra de esto a alguien, ella volvería para matarlo."

# game/script-stories.rpy:1593
translate spanish mas_scary_story_yuki_onna_61885dd6:

    # m 4esa "The following winter, the young man was on his way home from a day of cutting wood, when he came across a beautiful traveling woman."
    m 4esa "El invierno siguiente, el joven volvía a casa tras un día cortando leña, cuando se cruzó con una hermosa mujer viajera."

# game/script-stories.rpy:1594
translate spanish mas_scary_story_yuki_onna_9c3b2826:

    # m 2eua "It was starting to snow, and the man offered the woman shelter from the storm, and she quickly accepted."
    m 2eua "Empezaba a nevar, y el hombre le ofreció a la mujer refugio de la tormenta, y ella aceptó rápidamente."

# game/script-stories.rpy:1595
translate spanish mas_scary_story_yuki_onna_41658c8c:

    # m 2eua "The two quickly fell in love and ended up marrying each other."
    m 2eua "Los dos se enamoraron rápidamente y acabaron casándose."

# game/script-stories.rpy:1596
translate spanish mas_scary_story_yuki_onna_f773ccb1:

    # m 2hua "They lived happily for years and had several kids as time went by."
    m 2hua "Vivieron felices durante años y tuvieron varios hijos a medida que pasaba el tiempo."

# game/script-stories.rpy:1597
translate spanish mas_scary_story_yuki_onna_956c0e07:

    # m 2esa "One night, while the kids were sleeping, the woman was sewing by the light of the fire."
    m 2esa "Una noche, mientras los niños dormían, la mujer cosía a la luz del fuego."

# game/script-stories.rpy:1598
translate spanish mas_scary_story_yuki_onna_012c23b3:

    # m 2eud "The man looked up from what he was doing and the memory of the night he was never to speak of came back to him."
    m 2eud "El hombre levantó la vista de lo que estaba haciendo y le vino a la mente el recuerdo de la noche de la que nunca debía hablar."

# game/script-stories.rpy:1599
translate spanish mas_scary_story_yuki_onna_2b85379b:

    # m "The wife asked the man why he was looking at her the way he was."
    m "La esposa le preguntó al hombre por qué la miraba de esa manera."

# game/script-stories.rpy:1600
translate spanish mas_scary_story_yuki_onna_f4e77c63:

    # m 3esc "The man told his tale of his encounter with the snow woman."
    m 3esc "El hombre contó la historia de su encuentro con la mujer de las nieves."

# game/script-stories.rpy:1601
translate spanish mas_scary_story_yuki_onna_483653bb:

    # m 2wud "The smile on his wife's face melted into anger as she revealed that she was the snow woman he spoke of."
    m 2wud "La sonrisa en el rostro de su mujer se fundió en ira al revelar que ella era la mujer de las nieves de la que él hablaba."

# game/script-stories.rpy:1602
translate spanish mas_scary_story_yuki_onna_2907efa7:

    # m 4efc "She reprimanded him for breaking his promise and would have killed him if it weren't for the sake of their children."
    m 4efc "Ella le reprendió por romper su promesa y le habría matado de no ser por el bien de sus hijos."

# game/script-stories.rpy:1603
translate spanish mas_scary_story_yuki_onna_208b9198:

    # m 4efd "She told the man that he better treat their children well or she would be back to deal with him."
    m 4efd "Le dijo al hombre que más le valía tratar bien a sus hijos o volvería para ajustar cuentas con él."

# game/script-stories.rpy:1604
translate spanish mas_scary_story_yuki_onna_8706d6ec:

    # m 4dsd "The next instant she vanished, never to be seen again."
    m 4dsd "Al instante siguiente se desvaneció, para no volver a ser vista jamás."

# game/script-stories.rpy:1630
translate spanish mas_scary_story_many_loves_de4f63b3:

    # m 4esa "There once was a young woman who appeared in a village one day to find a husband."
    m 4esa "Érase una vez una joven que apareció un día en un pueblo para buscar marido."

# game/script-stories.rpy:1631
translate spanish mas_scary_story_many_loves_6f6759b8:

    # m 4eua "She was very beautiful and quickly attracted many suitors."
    m 4eua "Era muy hermosa y rápidamente atrajo a muchos pretendientes."

# game/script-stories.rpy:1632
translate spanish mas_scary_story_many_loves_cbdf8c2c:

    # m 2eua "Eventually settling down with a husky fisherman."
    m 2eua "Finalmente se estableció con un fornido pescador."

# game/script-stories.rpy:1633
translate spanish mas_scary_story_many_loves_0b3c7920:

    # m 2esd "The two had a happy marriage, but in less than a year, the husband wasted away and died."
    m 2esd "Los dos tuvieron un matrimonio feliz, pero en menos de un año, el marido se consumió y murió."

# game/script-stories.rpy:1634
translate spanish mas_scary_story_many_loves_4f53f310:

    # m "The people in the village felt sorry for the young woman and comforted her the best they could."
    m "La gente del pueblo sintió lástima por la joven y la consoló lo mejor que pudo."

# game/script-stories.rpy:1635
translate spanish mas_scary_story_many_loves_fe761223:

    # m 4esa "A few months later, the woman married a burly woodcutter."
    m 4esa "Unos meses más tarde, la mujer se casó con un corpulento leñador."

# game/script-stories.rpy:1636
translate spanish mas_scary_story_many_loves_80a057af:

    # m 4dsd "The two lived happily together for a time, but he too withered away and died."
    m 4dsd "Los dos vivieron felices juntos durante un tiempo, pero él también se marchitó y murió."

# game/script-stories.rpy:1637
translate spanish mas_scary_story_many_loves_3a71777e:

    # m 4eud "Some of the villagers thought that it was odd both husbands had died in the same fashion, but no one said anything, and comforted the girl for her poor luck."
    m 4eud "Algunos aldeanos pensaron que era extraño que ambos maridos hubieran muerto de la misma manera, pero nadie dijo nada, y consolaron a la chica por su mala suerte."

# game/script-stories.rpy:1638
translate spanish mas_scary_story_many_loves_2133dcb7:

    # m 2esc "A time later, the woman was married again, this time to a stout mason and they too appeared to have a happy marriage, but within a year, the woman was again a widow."
    m 2esc "Un tiempo después, la mujer se casó de nuevo, esta vez con un robusto albañil, y también parecían tener un matrimonio feliz, pero en menos de un año, la mujer volvió a enviudar."

# game/script-stories.rpy:1639
translate spanish mas_scary_story_many_loves_53aa68b6:

    # m "This time the villagers talked amongst themselves and felt something suspicious was going on, so a group of villagers set out to find the nearest shaman."
    m "Esta vez los aldeanos hablaron entre ellos y sintieron que algo sospechoso estaba ocurriendo, así que un grupo de aldeanos salió a buscar al chamán más cercano."

# game/script-stories.rpy:1640
translate spanish mas_scary_story_many_loves_df1b71b4:

    # m "Once they found the shaman and told him their story, the shaman indicated he knew what was going on."
    m "Una vez que encontraron al chamán y le contaron su historia, el chamán indicó que sabía lo que estaba pasando."

# game/script-stories.rpy:1641
translate spanish mas_scary_story_many_loves_53bf14e9:

    # m 3euc "He called his assistant over, a young, well-built fellow, whispered into his ear and sent him off to return with the villagers."
    m 3euc "Llamó a su asistente, un joven bien formado, le susurró al oído y lo envió de vuelta con los aldeanos."

# game/script-stories.rpy:1642
translate spanish mas_scary_story_many_loves_3ab97dd2:

    # m "Telling them not to worry, his assistant would get to the bottom of it."
    m "Diciéndoles que no se preocuparan, que su ayudante llegaría al fondo del asunto."

# game/script-stories.rpy:1643
translate spanish mas_scary_story_many_loves_700c3b52:

    # m 2esc "When they returned to the village, the assistant called on the widow and not long afterwards they were married."
    m 2esc "Cuando regresaron al pueblo, el ayudante visitó a la viuda y poco después se casaron."

# game/script-stories.rpy:1644
translate spanish mas_scary_story_many_loves_491b21f2:

    # m 2efc "On the night of their wedding, the assistant placed a knife under his pillow and feigned sleep."
    m 2efc "En la noche de bodas, el ayudante colocó un cuchillo debajo de la almohada y fingió dormir."

# game/script-stories.rpy:1645
translate spanish mas_scary_story_many_loves_1b213670:

    # m 2esd "A little after midnight, the man felt a presence over him and a prick on his neck."
    m 2esd "Poco después de medianoche, el hombre sintió una presencia sobre él y un pinchazo en el cuello."

# game/script-stories.rpy:1646
translate spanish mas_scary_story_many_loves_fbc73d0c:

    # m 2dfc "The man grabbed the knife and stuck it into the thing on top of him."
    m 2dfc "El hombre agarró el cuchillo y lo clavó en la cosa que tenía encima."

# game/script-stories.rpy:1660
translate spanish mas_scary_story_many_loves_a4042a55:

    # m 3wfc "He heard a screech and the flapping of wings as the creature flew through a window."
    m 3wfc "Oyó un chillido y el batir de alas mientras la criatura salía volando por una ventana."

# game/script-stories.rpy:1661
translate spanish mas_scary_story_many_loves_724dd438:

    # m 1dfc "The next day, the bride was found dead some distance from the house with a knife wound in her chest."
    m 1dfc "Al día siguiente, la novia fue encontrada muerta a cierta distancia de la casa con una herida de cuchillo en el pecho."

# game/script-stories.rpy:1679
translate spanish mas_scary_story_gray_lady_9826e443:

    # m 4eua "There was once a man named William, who grew up helping his father with his nefarious exploits."
    m 4eua "Érase una vez un hombre llamado William, que creció ayudando a su padre en sus infames hazañas."

# game/script-stories.rpy:1680
translate spanish mas_scary_story_gray_lady_c2cdf11b:

    # m 4ekd "Such as waving lights from the shore line in the dead of night, hoping to lure ships to wreck upon the treacherous rocks along the shore."
    m 4ekd "Como agitar luces desde la orilla en plena noche, esperando atraer barcos para que naufragaran en las traicioneras rocas de la costa."

# game/script-stories.rpy:1681
translate spanish mas_scary_story_gray_lady_b5ebad91:

    # m 2ekc "And then collect the plunder that was spilled from the ship and kill any survivors."
    m 2ekc "Y luego recoger el botín derramado del barco y matar a los supervivientes."

# game/script-stories.rpy:1682
translate spanish mas_scary_story_gray_lady_b6bc5573:

    # m 2eud "During one of his father's expositions, he saved a beautiful woman and ultimately decided to leave his old life behind and married her."
    m 2eud "Durante una de las exposiciones de su padre, salvó a una hermosa mujer y finalmente decidió dejar atrás su antigua vida y casarse con ella."

# game/script-stories.rpy:1683
translate spanish mas_scary_story_gray_lady_89897949:

    # m 2esa "The couple rented a manor not too far away."
    m 2esa "La pareja alquiló una mansión no muy lejos."

# game/script-stories.rpy:1684
translate spanish mas_scary_story_gray_lady_801d60c7:

    # m 2hub "The two lived a happy life there together, but were especially joyous when their baby daughter Kate was born."
    m 2hub "Los dos vivieron felices allí juntos, pero se alegraron especialmente cuando nació su hija Kate."

# game/script-stories.rpy:1685
translate spanish mas_scary_story_gray_lady_08ecf118:

    # m 4esa "As the years went by, Kate grew into a vivacious young woman."
    m 4esa "Con el paso de los años, Kate se convirtió en una joven vivaz."

# game/script-stories.rpy:1686
translate spanish mas_scary_story_gray_lady_d339ac66:

    # m 2ekc "William was secretly ashamed that he didn't have enough money to buy the manor outright to offer as a dowry to the man who would marry his daughter."
    m 2ekc "William se avergonzaba en secreto de no tener suficiente dinero para comprar la mansión y ofrecerla como dote al hombre que se casara con su hija."

# game/script-stories.rpy:1687
translate spanish mas_scary_story_gray_lady_111fb49e:

    # m 4hub "Then one day, Kate met and fell in love with an Irish pirate captain and the two of them were married."
    m 4hub "Entonces, un día, Kate conoció y se enamoró de un capitán pirata irlandés y los dos se casaron."

# game/script-stories.rpy:1688
translate spanish mas_scary_story_gray_lady_0189d33c:

    # m 4esb "The happy couple decided to settle down in Dublin, since Kate's parents had no land of their own to offer them."
    m 4esb "La feliz pareja decidió establecerse en Dublín, ya que los padres de Kate no tenían tierras propias que ofrecerles."

# game/script-stories.rpy:1689
translate spanish mas_scary_story_gray_lady_a6848d6d:

    # m 4eua "Kate promised to return and visit her parents again one day."
    m 4eua "Kate prometió volver y visitar a sus padres algún día."

# game/script-stories.rpy:1690
translate spanish mas_scary_story_gray_lady_cc6bdf0a:

    # m 4esd "Time passed and William and his wife missed their daughter dearly and wished for her to return."
    m 4esd "El tiempo pasó y William y su esposa echaban mucho de menos a su hija y deseaban que volviera."

# game/script-stories.rpy:1691
translate spanish mas_scary_story_gray_lady_b3e0fd4f:

    # m 2dkc "William decided to go back to his old ways long enough to get the money necessary to buy the manor and invite their daughter and her husband back to live with them."
    m 2dkc "William decidió volver a las andadas el tiempo suficiente para conseguir el dinero necesario para comprar la mansión e invitar a su hija y a su marido a vivir con ellos."

# game/script-stories.rpy:1692
translate spanish mas_scary_story_gray_lady_ef69a559:

    # m 4wud "One night, after attracting a ship to wreck on the shore and gathering the plunder from it, he noticed a badly injured woman lying on the rocks before him."
    m 4wud "Una noche, tras atraer un barco para que naufragara en la orilla y recoger el botín, vio a una mujer gravemente herida tendida en las rocas ante él."

# game/script-stories.rpy:1693
translate spanish mas_scary_story_gray_lady_67776e75:

    # m 2wuc "Her facial features were rendered unrecognizable due to the injuries she had sustained."
    m 2wuc "Sus rasgos faciales quedaron irreconocibles debido a las heridas que había sufrido."

# game/script-stories.rpy:1694
translate spanish mas_scary_story_gray_lady_2d429caf:

    # m 2ekc "William, taking pity on her, carried her back to the manor, and did what he could to try to save her life, but the woman died without ever regaining consciousness."
    m 2ekc "William, compadeciéndose de ella, la llevó a la mansión e hizo lo que pudo para intentar salvarle la vida, pero la mujer murió sin recobrar el conocimiento."

# game/script-stories.rpy:1695
translate spanish mas_scary_story_gray_lady_28e0f8e2:

    # m 2eud "As they searched her body for some clue as to her identity, they found a small purse strapped to her waist full of enough gold coins and jewels for them to finally purchase the manor they rented."
    m 2eud "Al registrar su cuerpo en busca de alguna pista sobre su identidad, encontraron un pequeño bolso atado a su cintura lleno de suficientes monedas de oro y joyas para poder comprar finalmente la mansión que alquilaban."

# game/script-stories.rpy:1696
translate spanish mas_scary_story_gray_lady_15226eec:

    # m 2dsc "A few days later, the Admiralty inquired the couple about a missing passenger from the wreckage that turned out to be none other than their daughter."
    m 2dsc "Unos días más tarde, el Almirantazgo preguntó a la pareja sobre un pasajero desaparecido del naufragio que resultó ser nada menos que su hija."

# game/script-stories.rpy:1697
translate spanish mas_scary_story_gray_lady_d94e5f5f:

    # m 3dsd "Devastated and ashamed, the parents walled up her remains in a secret room and moved away, never to return."
    m 3dsd "Devastados y avergonzados, los padres emparedaron sus restos en una habitación secreta y se mudaron, para no volver jamás."

# game/script-stories.rpy:1717
translate spanish mas_scary_story_flowered_lantern_509c641a:

    # m 3eub "Before we start, I need to tell you that my next story is going to be a bit long."
    m 3eub "Antes de empezar, tengo que decirte que mi próxima historia va a ser un poco larga."

# game/script-stories.rpy:1718
translate spanish mas_scary_story_flowered_lantern_199a1748:

    # m 3eua "So, I'll split it in parts."
    m 3eua "Así que la dividiré en partes."

# game/script-stories.rpy:1719
translate spanish mas_scary_story_flowered_lantern_bfd5ef9d:

    # m "Once I finish this part I'll ask you if you want to continue it or not."
    m "Cuando termine esta parte, te preguntaré si quieres continuar o no."

# game/script-stories.rpy:1720
translate spanish mas_scary_story_flowered_lantern_18cb06ad:

    # m 1eub "If you say no, you can ask me later to tell you the next part, so don't worry about it."
    m 1eub "Si dices que no, puedes pedirme más tarde que te cuente la siguiente parte, así que no te preocupes."

# game/script-stories.rpy:1721
translate spanish mas_scary_story_flowered_lantern_ed17e502:

    # m 4hua "Alright, let's begin now."
    m 4hua "Bien, empecemos ahora."

# game/script-stories.rpy:1723
translate spanish mas_scary_story_flowered_lantern_47388db9:

    # m 4eua "There was once a beautiful, young maiden named Tsuyu, whose father was a high-ranking samurai."
    m 4eua "Érase una vez una hermosa y joven doncella llamada Tsuyu, cuyo padre era un samurái de alto rango."

# game/script-stories.rpy:1724
translate spanish mas_scary_story_flowered_lantern_9aa7afb6:

    # m 4eud "Tsuyu's mother had been dead and her father eventually remarried."
    m 4eud "La madre de Tsuyu había muerto y su padre acabó volviéndose a casar."

# game/script-stories.rpy:1725
translate spanish mas_scary_story_flowered_lantern_d733f579:

    # m 2euc "Although it became obvious to Tsuyu's father that she and her step mother couldn't get along."
    m 2euc "Aunque se hizo obvio para el padre de Tsuyu que ella y su madrastra no se llevaban bien."

# game/script-stories.rpy:1726
translate spanish mas_scary_story_flowered_lantern_54efa4ca:

    # m 2esa "Wanting to ensure his only daughter's happiness, he had a luxurious house built for her, away from them and had her move into it."
    m 2esa "Deseando asegurar la felicidad de su única hija, hizo construir una lujosa casa para ella, lejos de ellos, y la hizo mudarse allí."

# game/script-stories.rpy:1727
translate spanish mas_scary_story_flowered_lantern_1f1568cf:

    # m "One day, the family physician went to Tsuyu's residence on a routine visit with a young samurai named Hagiwara, who was very handsome."
    m "Un día, el médico de la familia fue a la residencia de Tsuyu en una visita rutinaria con un joven samurái llamado Hagiwara, que era muy apuesto."

# game/script-stories.rpy:1728
translate spanish mas_scary_story_flowered_lantern_173940b3:

    # m 4eub "Tsuyu and Hagiwara fell in love the moment they set eyes on each other."
    m 4eub "Tsuyu y Hagiwara se enamoraron en el momento en que se vieron."

# game/script-stories.rpy:1729
translate spanish mas_scary_story_flowered_lantern_828bc15b:

    # m 4esc "Unbeknownst to the doctor, the two pledged themselves to each other for life and before the two left."
    m 4esc "Sin que el médico lo supiera, los dos se prometieron mutuamente de por vida y antes de que se marcharan."

# game/script-stories.rpy:1730
translate spanish mas_scary_story_flowered_lantern_bb7f2d53:

    # m 4dsd "Tsuyu whispered to Hagiwara that she would surely die if he didn't return to see her."
    m 4dsd "Tsuyu le susurró a Hagiwara que seguramente moriría si él no volvía a verla."

# game/script-stories.rpy:1731
translate spanish mas_scary_story_flowered_lantern_8104b415:

    # m 2esc "Hagiwara didn't forget her words, but etiquette forbade him to make a call to visit a maiden alone, so he had to wait for the doctor to ask him to join him on another visit."
    m 2esc "Hagiwara no olvidó sus palabras, pero la etiqueta le prohibía hacer una visita a una doncella a solas, así que tuvo que esperar a que el médico le pidiera que le acompañara en otra visita."

# game/script-stories.rpy:1732
translate spanish mas_scary_story_flowered_lantern_203cdac1:

    # m 2dsd "The doctor, however, had perceived his sudden affection for Tsuyu."
    m 2dsd "El médico, sin embargo, había percibido su repentino afecto por Tsuyu."

# game/script-stories.rpy:1733
translate spanish mas_scary_story_flowered_lantern_42684d52:

    # m 4ekc "Tsuyu's father was known to behead those who angered him, and fearing that he would hold him responsible for introducing the two, he avoided Hagiwara."
    m 4ekc "El padre de Tsuyu era conocido por decapitar a quienes le enfadaban y, temiendo que le hiciera responsable de haberlos presentado, evitó a Hagiwara."

# game/script-stories.rpy:1734
translate spanish mas_scary_story_flowered_lantern_1c69a476:

    # m 2rkc "Months passed and Tsuyu, feeling scorned that Hagiwara had abandoned her, passed away."
    m 2rkc "Pasaron los meses y Tsuyu, sintiéndose despreciada porque Hagiwara la había abandonado, falleció."

# game/script-stories.rpy:1735
translate spanish mas_scary_story_flowered_lantern_ade18b80:

    # m 1ekc "Not long afterwards, the doctor ran into Hagiwara, informing him of Tsuyu's death."
    m 1ekc "Poco después, el médico se encontró con Hagiwara y le informó de la muerte de Tsuyu."

# game/script-stories.rpy:1736
translate spanish mas_scary_story_flowered_lantern_367322ac:

    # m 1dsd "Hagiwara was deeply saddened and mourned greatly over her, saying prayers and burning incense for her."
    m 1dsd "Hagiwara se entristeció profundamente y la lloró mucho, rezando y quemando incienso por ella."

# game/script-stories.rpy:1740
translate spanish mas_scary_story_flowered_lantern_83982e2a:

    # m 1hua "...And that's it for part one! Do you want to continue to the next one?{nw}"
    m 1hua "¡Y hasta aquí la primera parte! ¿Quieres continuar con la siguiente?{nw}"

# game/script-stories.rpy:1743
translate spanish mas_scary_story_flowered_lantern_99a43432:

    # m "...And that's it for part one! Do you want to continue to the next one?{fast}" nointeract
    m "¡Y hasta aquí la primera parte! ¿Quieres continuar con la siguiente?{fast}" nointeract

# game/script-stories.rpy:1767
translate spanish mas_scary_story_flowered_lantern_2_63b9e5b1:

    # m 4ekd "After sun down, on the first night of the Festival of the Dead, Hagiwara sat outside, still grieving the loss of his love until late evening."
    m 4ekd "Tras la puesta de sol, en la primera noche del Festival de los Muertos, Hagiwara se sentó fuera, llorando aún la pérdida de su amor hasta bien entrada la noche."

# game/script-stories.rpy:1768
translate spanish mas_scary_story_flowered_lantern_2_24110b20:

    # m 2eud "However, just as he was about to go inside and go to sleep, he heard footsteps on the path outside his gate."
    m 2eud "Sin embargo, justo cuando estaba a punto de entrar e irse a dormir, oyó pasos en el camino fuera de su puerta."

# game/script-stories.rpy:1769
translate spanish mas_scary_story_flowered_lantern_2_fb69a8f5:

    # m 4euc "Hagiwara lived on a lonely street with few pedestrians and since it was so late out, he decided to see who it was."
    m 4euc "Hagiwara vivía en una calle solitaria con pocos peatones y, como era tan tarde, decidió ver quién era."

# game/script-stories.rpy:1770
translate spanish mas_scary_story_flowered_lantern_2_ee91ff8c:

    # m 4wub "To his great surprise and delight, the person walking along the path was none other than Tsuyu, carrying a paper lantern decorated with flowers to light her way."
    m 4wub "Para su gran sorpresa y deleite, la persona que caminaba por el sendero no era otra que Tsuyu, llevando una linterna de papel decorada con flores para alumbrar su camino."

# game/script-stories.rpy:1771
translate spanish mas_scary_story_flowered_lantern_2_daedebf9:

    # m 1hua "Hagiwara called out Tsuyu's name and she immediately came to him and embraced him."
    m 1hua "Hagiwara gritó el nombre de Tsuyu y ella acudió inmediatamente a él y le abrazó."

# game/script-stories.rpy:1772
translate spanish mas_scary_story_flowered_lantern_2_f48cfc5e:

    # m 1eua "Each of them told the other that they were told by the doctor that the other person had died."
    m 1eua "Cada uno le contó al otro que el médico les había dicho que la otra persona había muerto."

# game/script-stories.rpy:1773
translate spanish mas_scary_story_flowered_lantern_2_703ef0cf:

    # m "Tsuyu told him that her father wanted her to marry another man."
    m "Tsuyu le contó que su padre quería que se casara con otro hombre."

# game/script-stories.rpy:1774
translate spanish mas_scary_story_flowered_lantern_2_812552c4:

    # m 3eub "She refused and fled her luxurious home to hide from him and was currently taking residence in a cramped house in a certain neighborhood nearby."
    m 3eub "Ella se negó y huyó de su lujosa casa para esconderse de él, y actualmente residía en una casa pequeña en un vecindario cercano."

# game/script-stories.rpy:1775
translate spanish mas_scary_story_flowered_lantern_2_db47c22a:

    # m 3eua "He invited her inside, but told her to keep quiet so that they didn't disturb his servant who might inquire who she was."
    m 3eua "La invitó a entrar, pero le dijo que guardara silencio para no molestar a su sirviente, que podría preguntar quién era."

# game/script-stories.rpy:1776
translate spanish mas_scary_story_flowered_lantern_2_6fe2ce34:

    # m 4eua "The two spent the night together and right before dawn, Tsuyu left to return to her dwelling."
    m 4eua "Los dos pasaron la noche juntos y, justo antes del amanecer, Tsuyu se marchó para volver a su morada."

# game/script-stories.rpy:1777
translate spanish mas_scary_story_flowered_lantern_2_c043e00c:

    # m 4esa "On the next night, Tsuyu visited again at the same time she had arrived the previous night."
    m 4esa "A la noche siguiente, Tsuyu volvió a visitarlo a la misma hora que la noche anterior."

# game/script-stories.rpy:1778
translate spanish mas_scary_story_flowered_lantern_2_2a5e420d:

    # m 2euc "This time, however, Hagiwara's servant awoke and heard a young woman's voice he didn't recognize."
    m 2euc "Esta vez, sin embargo, el sirviente de Hagiwara se despertó y oyó la voz de una joven que no reconoció."

# game/script-stories.rpy:1779
translate spanish mas_scary_story_flowered_lantern_2_202045cd:

    # m 4esd "Curious, but not wanting to disturb his master, he snuck to his master's room and peeked through a small crack in his door and saw that he was indeed talking to a young woman."
    m 4esd "Curioso, pero sin querer molestar a su amo, se coló en la habitación de su amo y miró a través de una pequeña rendija en la puerta, viendo que, en efecto, estaba hablando con una joven."

# game/script-stories.rpy:1780
translate spanish mas_scary_story_flowered_lantern_2_bbf1f092:

    # m 4eud "The woman's back was turned to him, but he was able to make out that she was very thin and was dressed in a very elegant kimono that only the upper class would wear."
    m 4eud "La mujer le daba la espalda, pero pudo distinguir que era muy delgada y vestía un kimono muy elegante que solo llevaría la clase alta."

# game/script-stories.rpy:1781
translate spanish mas_scary_story_flowered_lantern_2_2fdbc49b:

    # m 4esc "His curiosity piqued, the servant decided to get a glimpse of this girl's face before retiring."
    m 4esc "Con la curiosidad picada, el sirviente decidió echar un vistazo a la cara de esta chica antes de retirarse."

# game/script-stories.rpy:1782
translate spanish mas_scary_story_flowered_lantern_2_a4cf648d:

    # m 2dsc "He saw that the master had left a window open, so he quietly made his way over to it."
    m 2dsc "Vio que el amo había dejado una ventana abierta, así que se acercó sigilosamente."

# game/script-stories.rpy:1783
translate spanish mas_scary_story_flowered_lantern_2_7f2afd6a:

    # m 4wuw "As he peered inside, he saw to his horror that the face of the woman was one that was long dead and the fingers caressing his master's face were those of naked bone."
    m 4wuw "Al mirar dentro, vio con horror que el rostro de la mujer pertenecía a alguien que llevaba mucho tiempo muerto y que los dedos que acariciaban la cara de su amo eran de puro hueso."

# game/script-stories.rpy:1784
translate spanish mas_scary_story_flowered_lantern_2_70ffc06d:

    # m 2wfd "He fled away in terror without making a peep."
    m 2wfd "Huyó aterrorizado sin decir ni pío."

# game/script-stories.rpy:1785
translate spanish mas_scary_story_flowered_lantern_2_70dffee6:

    # m 1efc "The next morning, the servant approached his master and asked him about the woman."
    m 1efc "A la mañana siguiente, el sirviente se acercó a su amo y le preguntó por la mujer."

# game/script-stories.rpy:1786
translate spanish mas_scary_story_flowered_lantern_2_c31dd9b0:

    # m 4efd "At first, Hagiwara denied having any visitors, but after perceiving that it was to no avail, he confessed everything that had transpired."
    m 4efd "Al principio, Hagiwara negó haber tenido visitas, pero tras percibir que era inútil, confesó todo lo que había ocurrido."

# game/script-stories.rpy:1787
translate spanish mas_scary_story_flowered_lantern_2_e79760b2:

    # m 4ekc "The servant told Hagiwara what he saw the night before and felt surely his master's life was in danger and pleaded for him to see a priest about it."
    m 4ekc "El sirviente le contó a Hagiwara lo que vio la noche anterior y sintió que seguramente la vida de su amo corría peligro, y le suplicó que viera a un sacerdote al respecto."

# game/script-stories.rpy:1788
translate spanish mas_scary_story_flowered_lantern_2_9f2e3242:

    # m 2euc "Startled but not entirely convinced, Hagiwara decided to put his servant's mind at ease by finding Tsuyu's residence."
    m 2euc "Sobresaltado pero no del todo convencido, Hagiwara decidió tranquilizar a su sirviente buscando la residencia de Tsuyu."

# game/script-stories.rpy:1789
translate spanish mas_scary_story_flowered_lantern_2_dcaeadc2:

    # m "Hagiwara set out and explored the neighborhood that Tsuyu told him she was staying at."
    m "Hagiwara partió y exploró el vecindario en el que Tsuyu le dijo que se alojaba."

# game/script-stories.rpy:1790
translate spanish mas_scary_story_flowered_lantern_2_3c0b5b21:

    # m 2esc "He looked around and inquired people about her but to no avail."
    m 2esc "Miró a su alrededor y preguntó a la gente por ella, pero fue en vano."

# game/script-stories.rpy:1791
translate spanish mas_scary_story_flowered_lantern_2_bf10858e:

    # m 4dsd "When he decided that searching more would be fruitless, he headed home."
    m 4dsd "Cuando decidió que buscar más sería infructuoso, se dirigió a casa."

# game/script-stories.rpy:1792
translate spanish mas_scary_story_flowered_lantern_2_296bbf27:

    # m 4eud "On his way back, he passed a cemetery next to a temple."
    m 4eud "De regreso, pasó por un cementerio junto a un templo."

# game/script-stories.rpy:1793
translate spanish mas_scary_story_flowered_lantern_2_286cb482:

    # m "His attention was attracted by a large new tomb, near the back that he hadn't noticed before."
    m "Su atención fue atraída por una tumba grande y nueva, cerca del fondo, que no había notado antes."

# game/script-stories.rpy:1796
translate spanish mas_scary_story_flowered_lantern_2_42efc306:

    # m 4euc "Hanging above it was a paper lantern decorated with beautiful flowers that looked exactly the same as the one that Tsuyu carried with her at night."
    m 4euc "Colgada sobre ella había una linterna de papel decorada con hermosas flores que parecía exactamente igual a la que Tsuyu llevaba consigo por la noche."

# game/script-stories.rpy:1797
translate spanish mas_scary_story_flowered_lantern_2_14e4bd8c:

    # m 4wuc "Intrigued, he walked towards it, as he looked at the name of the person it belonged to, he jumped back with fright as he read it belonged to his beloved Tsuyu."
    m 4wuc "Intrigado, caminó hacia ella, y al mirar el nombre de la persona a la que pertenecía, saltó hacia atrás asustado al leer que pertenecía a su amada Tsuyu."

# game/script-stories.rpy:1798
translate spanish mas_scary_story_flowered_lantern_2_0d602ad0:

    # m 2wkc "Terror stricken, Hagiwara immediately headed into the adjoining temple and asked to speak to the head priest."
    m 2wkc "Aterrorizado, Hagiwara se dirigió inmediatamente al templo contiguo y pidió hablar con el sacerdote principal."

# game/script-stories.rpy:1799
translate spanish mas_scary_story_flowered_lantern_2_5592ba67:

    # m 4esc "When he was admitted, he told the head priest everything that had transpired."
    m 4esc "Cuando fue admitido, le contó al sacerdote principal todo lo que había ocurrido."

# game/script-stories.rpy:1800
translate spanish mas_scary_story_flowered_lantern_2_b50bab3b:

    # m 4esd "After he had finished, the head priest told him his life was indeed in danger."
    m 4esd "Cuando terminó, el sacerdote principal le dijo que su vida corría peligro."

# game/script-stories.rpy:1801
translate spanish mas_scary_story_flowered_lantern_2_212d0729:

    # m "Hagiwara's intense grieving for her and her intense love for him had brought her back during the Festival of the Dead."
    m "El intenso duelo de Hagiwara por ella y el intenso amor de ella por él la habían traído de vuelta durante el Festival de los Muertos."

# game/script-stories.rpy:1802
translate spanish mas_scary_story_flowered_lantern_2_abfcdd00:

    # m 4dsc "Love between one who is alive and one who is dead can only result in the death of the one who is alive."
    m 4dsc "El amor entre alguien vivo y alguien muerto solo puede acabar con la muerte de quien aún respira."

# game/script-stories.rpy:1808
translate spanish mas_scary_story_flowered_lantern_2_94244c7c:

    # m 1hua "...And that's it for part two! Do you want to continue to the next one?{nw}"
    m 1hua "¡Y hasta aquí la segunda parte! ¿Quieres continuar con la siguiente?{nw}"

# game/script-stories.rpy:1811
translate spanish mas_scary_story_flowered_lantern_2_2f210465:

    # m "...And that's it for part two! Do you want to continue to the next one?{fast}" nointeract
    m "¡Y hasta aquí la segunda parte! ¿Quieres continuar con la siguiente?{fast}" nointeract

# game/script-stories.rpy:1835
translate spanish mas_scary_story_flowered_lantern_3_82dcd93c:

    # m 1eud "As it was the last day of the Festival of the Dead, Tsuyu would have to return to the dead on this night and she would take Hagiwara with her if they were to see each other again."
    m 1eud "Como era el último día del Festival de los Muertos, Tsuyu tendría que volver con los muertos esa noche y se llevaría a Hagiwara con ella si volvían a verse."

# game/script-stories.rpy:1836
translate spanish mas_scary_story_flowered_lantern_3_fd34cd77:

    # m 3esd "Hagiwara pleaded with the priest to help him."
    m 3esd "Hagiwara le suplicó al sacerdote que le ayudara."

# game/script-stories.rpy:1837
translate spanish mas_scary_story_flowered_lantern_3_4a9a76c9:

    # m 3esc "The priest said the passional karma between them was very strong, but there was some hope still."
    m 3esc "El sacerdote dijo que el karma pasional entre ellos era muy fuerte, pero que aún había alguna esperanza."

# game/script-stories.rpy:1838
translate spanish mas_scary_story_flowered_lantern_3_521e823f:

    # m "He handed Hagiwara a stack of paper talismans that keep out spirits, and instructed him to cover every opening in his home, no matter how small, with them."
    m "Le entregó a Hagiwara un montón de talismanes de papel que mantenían alejados a los espíritus, y le ordenó que cubriera con ellos cada abertura de su casa, por pequeña que fuera."

# game/script-stories.rpy:1839
translate spanish mas_scary_story_flowered_lantern_3_43bbfa83:

    # m 1esd "Tsuyu would not be able to enter the dwelling as long as he heeded these instructions."
    m 1esd "Tsuyu no podría entrar en la morada mientras él siguiera estas instrucciones."

# game/script-stories.rpy:1840
translate spanish mas_scary_story_flowered_lantern_3_901d7475:

    # m 2esa "Hagiwara, with the assistance of his servant was able to successfully cover the house with the paper talismans before dark."
    m 2esa "Hagiwara, con la ayuda de su sirviente, pudo cubrir con éxito la casa con los talismanes de papel antes del anochecer."

# game/script-stories.rpy:1841
translate spanish mas_scary_story_flowered_lantern_3_9662cfec:

    # m 4esc "As the night went on, Hagiwara attempted to fall asleep but to no avail. So he sat up meditating over the recent events."
    m 4esc "A medida que avanzaba la noche, Hagiwara intentó dormirse, pero fue en vano. Así que se sentó meditando sobre los recientes acontecimientos."

# game/script-stories.rpy:1842
translate spanish mas_scary_story_flowered_lantern_3_2a372aac:

    # m 2dsd "At a late hour, he heard footsteps outside his home."
    m 2dsd "A una hora tardía, oyó pasos fuera de su casa."

# game/script-stories.rpy:1843
translate spanish mas_scary_story_flowered_lantern_3_589d8051:

    # m "The steps came nearer and nearer."
    m "Los pasos se acercaban más y más."

# game/script-stories.rpy:1844
translate spanish mas_scary_story_flowered_lantern_3_6192815b:

    # m 4wkc "Hagiwara felt a sudden compulsion, stronger than even his fear, to look."
    m 4wkc "Hagiwara sintió una compulsión repentina, más fuerte incluso que su miedo, de mirar."

# game/script-stories.rpy:1845
translate spanish mas_scary_story_flowered_lantern_3_6c32149c:

    # m 4wkd "He foolishly approached the shutters and through a chink saw Tsuyu standing at the entrance of his house with her paper lantern staring at the paper talismans."
    m 4wkd "Cometió la estupidez de acercarse a los postigos y, a través de una rendija, vio a Tsuyu de pie en la entrada con su linterna, mirando fijamente los talismanes de papel."

# game/script-stories.rpy:1846
translate spanish mas_scary_story_flowered_lantern_3_6a340242:

    # m "Never before had he seen Tsuyu look so beautiful and his heart felt so drawn to her."
    m "Nunca antes había visto a Tsuyu tan hermosa y su corazón se sintió tan atraído por ella."

# game/script-stories.rpy:1847
translate spanish mas_scary_story_flowered_lantern_3_8d6e83a4:

    # m 2ekd "Outside, Tsuyu began to weep bitterly, saying to herself that Hagiwara had broken the pledge that they had made to each other."
    m 2ekd "Fuera, Tsuyu empezó a llorar amargamente, diciéndose a sí misma que Hagiwara había roto la promesa que se habían hecho el uno al otro."

# game/script-stories.rpy:1848
translate spanish mas_scary_story_flowered_lantern_3_2820d278:

    # m 4eud "She wept until she collected herself and said aloud that she wouldn't leave without seeing him one last time."
    m 4eud "Lloró hasta recomponerse y dijo en voz alta que no se marcharía sin verlo una última vez."

# game/script-stories.rpy:1849
translate spanish mas_scary_story_flowered_lantern_3_fff726b3:

    # m 4esd "Hagiwara heard footsteps as she walked around his house, every so often he would see the light from the lantern as she went along."
    m 4esd "Hagiwara oyó unos pasos mientras ella caminaba alrededor de su casa, y de vez en cuando veía la luz de la linterna a su paso."

# game/script-stories.rpy:1850
translate spanish mas_scary_story_flowered_lantern_3_4186ecea:

    # m 2wud "When she came near the spot he had peered out of, the footsteps stopped and suddenly Hagiwara saw one of Tsuyu's eyes looking in at him."
    m 2wud "Cuando ella se acercó al lugar desde donde él se había asomado, los pasos se detuvieron y de repente Hagiwara vio uno de los ojos de Tsuyu mirándole."

# game/script-stories.rpy:1858
translate spanish mas_scary_story_flowered_lantern_3_4c1b19fd:

    # ".{w=0.7}.{w=0.9}.{nw}"
    ".{w=0.7}.{w=0.9}.{nw}"

# game/script-stories.rpy:1867
translate spanish mas_scary_story_flowered_lantern_3_916b9a3c:

    # m 2dsc "The next day, the servant awoke and approached his master's room and knocked upon his door."
    m 2dsc "Al día siguiente, el sirviente se despertó y se acercó a la habitación de su amo y llamó a su puerta."

# game/script-stories.rpy:1868
translate spanish mas_scary_story_flowered_lantern_3_e8983445:

    # m 4ekc "For the first time in years he didn't receive a response and he was worried."
    m 4ekc "Por primera vez en años no recibió respuesta y estaba preocupado."

# game/script-stories.rpy:1869
translate spanish mas_scary_story_flowered_lantern_3_dc17caab:

    # m 2dsd "He called his master repeatedly but to no avail."
    m 2dsd "Llamó a su amo repetidamente, pero en vano."

# game/script-stories.rpy:1870
translate spanish mas_scary_story_flowered_lantern_3_4ca126ed:

    # m 2esc "Finally, with a bit of courage, he entered into his master's room."
    m 2esc "Finalmente, con un poco de valor, entró en la habitación de su amo."

# game/script-stories.rpy:1871
translate spanish mas_scary_story_flowered_lantern_3_07fa8e10:

    # m 4wuw "...Only to flee from the house crying in horror after seeing him."
    m 4wuw "Solo para huir de la casa llorando de horror tras verle."

# game/script-stories.rpy:1872
translate spanish mas_scary_story_flowered_lantern_3_c7ce5c0e:

    # m "Hagiwara was dead, hideously dead, and his face had the expression of uttermost agony of fear..."
    m "Hagiwara estaba muerto, espantosamente muerto, y su rostro tenía la expresión de la más absoluta agonía de miedo..."

# game/script-stories.rpy:1873
translate spanish mas_scary_story_flowered_lantern_3_bb2f7e5e:

    # m 2wfc "And lying beside him in the bed were the bones of a woman with its arms clung around his neck as if in an embrace."
    m 2wfc "Y yaciendo a su lado en la cama estaban los huesos de una mujer con los brazos aferrados a su cuello como en un abrazo."

# game/script-stories.rpy:1891
translate spanish mas_scary_story_prison_escape_84f67ead:

    # m 1ekd "A pretty woman was serving a life sentence in prison for murder."
    m 1ekd "Una guapa mujer cumplía cadena perpetua en prisión por asesinato."

# game/script-stories.rpy:1892
translate spanish mas_scary_story_prison_escape_03678f6f:

    # m 2tfc "Angry and resentful about her situation, she decided that she couldn't spend her life in prison. {w=0.2}She began plotting ways to escape."
    m 2tfc "Enfadada y resentida por su situación, decidió que no podía pasarse la vida en la cárcel. {w=0.2}Empezó a tramar formas de escapar."

# game/script-stories.rpy:1893
translate spanish mas_scary_story_prison_escape_42e5abc2:

    # m 7eua "Over time, she became good friends with one of the prison caretakers."
    m 7eua "Con el tiempo, se hizo buena amiga de uno de los cuidadores de la prisión."

# game/script-stories.rpy:1894
translate spanish mas_scary_story_prison_escape_bc0fb870:

    # m 3esc "His job was to bury any prisoners who died in a graveyard just outside the prison walls."
    m 3esc "Su trabajo consistía en enterrar a los prisioneros que morían en un cementerio justo fuera de los muros de la prisión."

# game/script-stories.rpy:1895
translate spanish mas_scary_story_prison_escape_923980fd:

    # m 3esd "Whenever a prisoner died, the caretaker rang a bell which was heard by all of the inmates."
    m 3esd "Cada vez que moría un preso, el cuidador tocaba una campana que oían todos los reclusos."

# game/script-stories.rpy:1896
translate spanish mas_scary_story_prison_escape_5c9c7a21:

    # m 3esc "Next, he got the body and put it in a casket, and then entered his office to fill out the death certificate before returning to nail the casket lid shut."
    m 3esc "A continuación, cogía el cadáver y lo metía en un ataúd, y luego entraba en su despacho para rellenar el certificado de defunción antes de volver para clavar la tapa del ataúd."

# game/script-stories.rpy:1897
translate spanish mas_scary_story_prison_escape_5a641248:

    # m 3esd "Finally, he put it on a wagon to take to the graveyard and bury it."
    m 3esd "Finalmente, lo subía a una carreta para llevarlo al cementerio y enterrarlo."

# game/script-stories.rpy:1898
translate spanish mas_scary_story_prison_escape_9d7e3faa:

    # m 1euc "Knowing this routine, the woman devised an escape plan and shared it with the caretaker..."
    m 1euc "Conociendo esta rutina, la mujer ideó un plan de fuga y lo compartió con el cuidador..."

# game/script-stories.rpy:1899
translate spanish mas_scary_story_prison_escape_f9a73625:

    # m 1eud "The next time the bell rang, the woman would leave her cell and sneak into the dark room where the coffins were kept."
    m 1eud "La próxima vez que sonara la campana, la mujer saldría de su celda y se colaría en la oscura sala donde se guardaban los ataúdes."

# game/script-stories.rpy:1900
translate spanish mas_scary_story_prison_escape_5cef0000:

    # m 1eud "She would slip into the coffin with the dead body while the caretaker was filling out the death certificate."
    m 1eud "Se deslizaría en el ataúd con el cadáver mientras el cuidador rellenaba el certificado de defunción."

# game/script-stories.rpy:1901
translate spanish mas_scary_story_prison_escape_ded21bc1:

    # m 3euc "When the caretaker returned, he would nail the lid shut and take the coffin outside the prison and bury it."
    m 3euc "Cuando el cuidador regresara, clavaría la tapa y llevaría el ataúd fuera de la prisión para enterrarlo."

# game/script-stories.rpy:1902
translate spanish mas_scary_story_prison_escape_f9da0876:

    # m 3euc "The woman knew there would be enough air for her to breathe until later in the evening when the caretaker would return under cover of darkness, dig up the coffin, and set her free."
    m 3euc "La mujer sabía que habría aire suficiente para respirar hasta más tarde esa noche, cuando el cuidador volviera al amparo de la oscuridad, desenterrara el ataúd y la liberara."

# game/script-stories.rpy:1903
translate spanish mas_scary_story_prison_escape_d4cb2032:

    # m 2eksdlc "The caretaker was reluctant to go along with this plan, {w=0.1}{nw}"
    m 2eksdlc "El cuidador era reacio a seguir este plan, {w=0.1}{nw}"

# game/script-stories.rpy:1904
translate spanish mas_scary_story_prison_escape_a85fbf5f:

    # extend 4esa "but since he and the woman had become good friends over the years, he agreed to do it."
    extend 4esa "pero como él y la mujer se habían hecho buenos amigos a lo largo de los años, aceptó hacerlo."

# game/script-stories.rpy:1905
translate spanish mas_scary_story_prison_escape_3184efa1:

    # m 2tsc "The woman waited several months for one of the other inmates to die."
    m 2tsc "La mujer esperó varios meses a que muriera alguno de los otros reclusos."

# game/script-stories.rpy:1906
translate spanish mas_scary_story_prison_escape_f855e430:

    # m 7dsc "One night, she was asleep in her cell when she heard the death bell ringing."
    m 7dsc "Una noche, estaba dormida en su celda cuando oyó sonar la campana de la muerte."

# game/script-stories.rpy:1907
translate spanish mas_scary_story_prison_escape_9806635f:

    # m 3euc "She got up, picked the lock of her cell, and slowly walked down the hallway."
    m 3euc "Se levantó, forzó la cerradura de su celda y caminó lentamente por el pasillo."

# game/script-stories.rpy:1908
translate spanish mas_scary_story_prison_escape_f6879bfa:

    # m 3wud "She was nearly caught a couple of times...{w=0.3}her heart was beating so fast."
    m 3wud "Estuvo a punto de ser pillada un par de veces... {w=0.3}su corazón latía muy deprisa."

# game/script-stories.rpy:1909
translate spanish mas_scary_story_prison_escape_b6b2883c:

    # m 3ekc "She opened the door to the darkened room where the coffins were kept and quietly found the one that contained the dead body."
    m 3ekc "Abrió la puerta de la oscura sala donde se guardaban los ataúdes y encontró en silencio el que contenía el cadáver."

# game/script-stories.rpy:1910
translate spanish mas_scary_story_prison_escape_ec88ee62:

    # m 3dkc "After carefully climbing into it, she pulled the lid shut to wait for the caretaker to come and nail the lid down."
    m 3dkc "Tras meterse con cuidado, cerró la tapa para esperar a que viniera el cuidador y la clavara."

# game/script-stories.rpy:1911
translate spanish mas_scary_story_prison_escape_bdf1c4b5:

    # m 2eka "Soon she heard footsteps and the pounding of the hammer and nails."
    m 2eka "Pronto oyó pasos y el golpe del martillo y los clavos."

# game/script-stories.rpy:1912
translate spanish mas_scary_story_prison_escape_6a0880b6:

    # m 4eksdlc "Even though she was very uncomfortable in the coffin with the dead body beneath her, she knew that with each nail she was one step closer to freedom."
    m 4eksdlc "Aunque estaba muy incómoda en el ataúd con el cadáver debajo, sabía que con cada clavo estaba un paso más cerca de la libertad."

# game/script-stories.rpy:1913
translate spanish mas_scary_story_prison_escape_3dd8d8ae:

    # m 2eud "The coffin was lifted onto the wagon and taken outside to the graveyard."
    m 2eud "El ataúd fue subido a la carreta y llevado fuera, al cementerio."

# game/script-stories.rpy:1914
translate spanish mas_scary_story_prison_escape_95fbb824:

    # m 2eksdlc "She didn't make a sound as the coffin hit the bottom of the grave with a thud."
    m 2eksdlc "No hizo ningún ruido cuando el ataúd golpeó el fondo de la tumba con un ruido sordo."

# game/script-stories.rpy:1915
translate spanish mas_scary_story_prison_escape_1fab1335:

    # m 4eksdlc "Finally she heard the dirt dropping onto the top of the wooden coffin, {w=0.1}{nw}"
    m 4eksdlc "Finalmente oyó caer la tierra sobre la tapa del ataúd de madera, {w=0.1}{nw}"

# game/script-stories.rpy:1916
translate spanish mas_scary_story_prison_escape_7153b381:

    # extend 4eksdla "and she knew that it was only a matter of time until she would be free at last."
    extend 4eksdla "y supo que solo era cuestión de tiempo que fuera libre por fin."

# game/script-stories.rpy:1917
translate spanish mas_scary_story_prison_escape_f53504a2:

    # m 2hksdlb "After a hour of absolute silence, she began to chuckle quietly to herself."
    m 2hksdlb "Tras una hora de silencio absoluto, empezó a reírse por lo bajo."

# game/script-stories.rpy:1918
translate spanish mas_scary_story_prison_escape_bab84b35:

    # m 2eta "Feeling curious, she decided to light a match to find out the identity of the dead prisoner beside her."
    m 2eta "Sintiendo curiosidad, decidió encender una cerilla para averiguar la identidad del prisionero muerto que estaba a su lado."

# game/script-stories.rpy:1919
translate spanish mas_scary_story_prison_escape_f1d1d45b:

    # m 2wusdld "...!"
    m 2wusdld "¡!"

# game/script-stories.rpy:1920
translate spanish mas_scary_story_prison_escape_c01b3923:

    # m 2wusdlo "It was the dead caretaker!"
    m 2wusdlo "¡Era el cuidador muerto!"

