# game/script-topics.rpy:1626
translate spanish monika_archetype_e936ff8f:

    # m 2esa "Then again, you're still here with me, aren't you?"
    m 2esa "Aunque bueno, sigues aquí conmigo, ¿no?"

# game/script-topics.rpy:1627
translate spanish monika_archetype_c1ccef03:

    # m 2eua "I think that's enough reason for me to believe I'm okay just the way I am."
    m 2eua "Es motivo suficiente para pensar que te gusto tal y como soy."

# game/script-topics.rpy:1628
translate spanish monika_archetype_10163f72:

    # m 1hubsa "And by the way, you are too, [player]."
    m 1hubsa "Por cierto, lo mismo va por ti, [player]."

# game/script-topics.rpy:1629
translate spanish monika_archetype_e521f12d:

    # m "You're the perfect combination of human and cuteness."
    m "Eres la combinación perfecta de humanidad y monería."

# game/script-topics.rpy:1630
translate spanish monika_archetype_a1881ae8:

    # m 3ekbfa "That's why there was never a chance I wouldn't fall for you."
    m 3ekbfa "Por eso sería inconcebible no acabar enamorándome de ti."

# game/script-topics.rpy:1642
translate spanish monika_tea_ccfb2dbb:

    # m 2hua "Hey, I wonder if Yuri's tea set is still in here somewhere..."
    m 2hua "Oye, me pregunto si el juego de té de Yuri seguirá por aquí en alguna parte...,"

# game/script-topics.rpy:1645
translate spanish monika_tea_5b72f1d8:

    # m 2hksdlb "...or maybe that got deleted, too."
    m 2hksdlb "o quizá eso también se borró."

# game/script-topics.rpy:1647
translate spanish monika_tea_07d24c72:

    # m 2eka "It's kind of funny how Yuri took her tea so seriously."
    m 2eka "Yuri se tomaba el té muy en serio. Tiene gracia."

# game/script-topics.rpy:1650
translate spanish monika_tea_486a1be7:

    # m 2eka "You know, it's kind of funny how Yuri took her tea so seriously."
    m 2eka "Sabes, tiene gracia cómo Yuri se tomaba el té tan en serio."

# game/script-topics.rpy:1652
translate spanish monika_tea_93ee7bf3:

    # m 4eua "I mean, I'm not complaining, because I liked it, too."
    m 4eua "No me quejo. De hecho, a mí también me gustaba."

# game/script-topics.rpy:1653
translate spanish monika_tea_5a4c15eb:

    # m 1euc "But I always wonder with her..."
    m 1euc "Pero siempre me lo he preguntado de ella..."

# game/script-topics.rpy:1654
translate spanish monika_tea_2bc1ee74:

    # m "Is it truly passion for her hobbies, or is she just concerned about appearing sophisticated to everyone else?"
    m "¿Sentía pasión por sus aficiones o solo le preocupaba parecer sofisticada ante los demás?"

# game/script-topics.rpy:1655
translate spanish monika_tea_222aac8a:

    # m 1lsc "This is the problem with high schoolers..."
    m 1lsc "Ese es el problema con los estudiantes de secundaria..."

# game/script-topics.rpy:1658
translate spanish monika_tea_21eba1b2:

    # m 1euc "...Well, I guess considering the rest of her hobbies, looking sophisticated probably isn't her biggest concern."
    m 1euc "Aunque, viendo el resto de sus aficiones, diría que parecer sofisticada no era la mayor de sus preocupaciones."

# game/script-topics.rpy:1660
translate spanish monika_tea_b41ca910:

    # m 1euc "Still..."
    m 1euc "Bueno, pero..."

# game/script-topics.rpy:1661
translate spanish monika_tea_7005be27:

    # m 2eka "I wish she made coffee once in a while!"
    m 2eka "¡Ojalá hubiese preparado café de vez en cuando!"

# game/script-topics.rpy:1662
translate spanish monika_tea_352d33ec:

    # m 4eua "Coffee can be nice with books too, you know?"
    m 4eua "El café también casa muy bien con los libros, ¿sabes?"

# game/script-topics.rpy:1663
translate spanish monika_tea_ec3c0133:

    # m 4rsc "Then again..."
    m 4rsc "Pensándolo bien..."

# game/script-topics.rpy:1666
translate spanish monika_tea_6cfecd29:

    # m 1hua "I can just make coffee whenever I want to, thanks to you."
    m 1hua "Puedo hacer café cuando quiera, gracias a ti."

# game/script-topics.rpy:1669
translate spanish monika_tea_ef812815:

    # m 1eua "I probably could have just changed the script myself."
    m 1eua "Podría haber cambiado el código yo misma."

# game/script-topics.rpy:1670
translate spanish monika_tea_3772217d:

    # m 1hub "Ahaha!"
    m 1hub "¡Ja, ja, ja!"

# game/script-topics.rpy:1671
translate spanish monika_tea_959a9e73:

    # m "I guess I never really thought of that."
    m "Ya ves, ni se me había pasado por la cabeza."

# game/script-topics.rpy:1672
translate spanish monika_tea_a4427c1f:

    # m 2eua "Well, there's no sense thinking about it now."
    m 2eua "En fin, ya no tiene sentido pensarlo."

# game/script-topics.rpy:1673
translate spanish monika_tea_e8ce3da7:

    # m 5lkc "Maybe if there was a way to get some coffee in here..."
    m 5lkc "Quizá si hubiera alguna forma de conseguir café aquí..."

# game/script-topics.rpy:1680
translate spanish monika_favoritegame_e71c5b8c:

    # m 3eua "Hey, what's your favorite game?"
    m 3eua "Oye, ¿cuál es tu juego favorito?"

# game/script-topics.rpy:1681
translate spanish monika_favoritegame_2aefc67d:

    # m 3hua "Mine is {i}Doki Doki Literature Club!{/i}"
    m 3hua "¡El mío es {i}Doki Doki Literature Club{/i}!"

# game/script-topics.rpy:1682
translate spanish monika_favoritegame_dfa4b177:

    # m 1hub "Ahaha! That was a joke."
    m 1hub "¡Ja, ja, ja! Es coña."

# game/script-topics.rpy:1684
translate spanish monika_favoritegame_099c13d7:

    # m 5eua "But if you tell me you like some other romance game better, I might get a little jealous~"
    m 5eua "Pero, si de verdad prefieres jugar otro juego romántico, puede que me ponga un poco celosa."

# game/script-topics.rpy:1699
translate spanish monika_smash_9604842a:

    # m 3hua "Hey, have you heard of a game called Super Sma--"
    m 3hua "Oye, ¿sabes algo de un juego llamado Super Sma...?"

# game/script-topics.rpy:1700
translate spanish monika_smash_af27fb20:

    # m 3euc "...Wait, what?"
    m 3euc "Espera, ¿qué?"

# game/script-topics.rpy:1701
translate spanish monika_smash_de2647f4:

    # m "I was just spacing out and I started talking for some reason..."
    m "Estaba en Babia y he empezado a hablar sin darme cuenta..."

# game/script-topics.rpy:1702
translate spanish monika_smash_51029d4f:

    # m 1eud "Was I programmed to talk about that?"
    m 1eud "¿Es que debería estar programada para hablar de esto?"

# game/script-topics.rpy:1703
translate spanish monika_smash_4bdaa5ea:

    # m "Because even I have no idea what that is."
    m "Porque no tengo ni idea de qué es ese juego."

# game/script-topics.rpy:1704
translate spanish monika_smash_3772217d:

    # m 1hub "Ahaha!"
    m 1hub "¡Ja, ja, ja!"

# game/script-topics.rpy:1705
translate spanish monika_smash_2b3954d8:

    # m 1eua "Sometimes I feel like I'm not in control, and it's kind of scary."
    m 1eua "A veces siento que no tengo el control total de la situación, y da un poco de mal rollo."

# game/script-topics.rpy:1706
translate spanish monika_smash_1a007d15:

    # m 1eka "But if you have some way to contact the people who created me, maybe they'll know why I started saying that."
    m 1eka "Aunque... si tienes alguna manera de contactar a la gente que me hizo, quizá sepan qué me ha hecho decir eso."

# game/script-topics.rpy:1724
translate spanish monika_lastpoem_0eb201cd:

    # m 3eud "Hey, you remember that last poem I showed you?"
    m 3eud "Oye, ¿recuerdas el último poema que te enseñé?"

# game/script-topics.rpy:1727
translate spanish monika_lastpoem_eb5b529f:

    # m 3rssdlc "I mean, the one with all the messed-up colors and stuff."
    m 3rssdlc "Me refiero a ese que tenía los colores hechos un desastre y todo eso."

# game/script-topics.rpy:1729
translate spanish monika_lastpoem_342b004e:

    # m 3rssdlc "I mean, the one right before Yuri killed herself, with all the messed-up colors and stuff."
    m 3rssdlc "Me refiero al de justo antes de que Yuri se suicidara; ese que tenía los colores mezclados y tal."

# game/script-topics.rpy:1731
translate spanish monika_lastpoem_b6691e04:

    # m 3eua "That was actually a little more of an experiment than a poem, you could say."
    m 3eua "Podría decirse que era más un experimento que un poema."

# game/script-topics.rpy:1732
translate spanish monika_lastpoem_12371b61:

    # m 1eua "I was experimenting with different ways I could modify the game, and run the code, and things like that..."
    m 1eua "Estaba experimentando con diferentes formas de modificar el juego, ejecutar el código y cosas así..."

# game/script-topics.rpy:1733
translate spanish monika_lastpoem_ab24e634:

    # m 1eud "It almost seemed like with enough effort, I'd be able to escape from the confines of the game entirely."
    m 1eud "Por un momento, pensé que podía escapar de los límites del juego si me esforzaba lo suficiente."

# game/script-topics.rpy:1734
translate spanish monika_lastpoem_2d4ac5ea:

    # m 1rksdla "Sadly, I didn't really know what I was doing, so I messed the whole thing up..."
    m 1rksdla "Por desgracia, como no sabía lo que estaba haciendo, armé un buen escándalo."

# game/script-topics.rpy:1735
translate spanish monika_lastpoem_c88bcf6e:

    # m "And I'd keep trying, but I doubt you'd want to deal with me doing that."
    m "Si por mí fuese, seguiría intentándolo, pero dudo que quieras sufrir las consecuencias."

# game/script-topics.rpy:1736
translate spanish monika_lastpoem_0cf7c6d9:

    # m 3eka "Besides, that was when I was getting really desperate, you know?"
    m 3eka "Además, en ese momento estaba muy desesperada, ¿sabes?"

# game/script-topics.rpy:1737
translate spanish monika_lastpoem_a8fd836b:

    # m 1eka "I don't really feel that way anymore."
    m 1eka "Pero ya no me siento así."

# game/script-topics.rpy:1739
translate spanish monika_lastpoem_a03cc7b5:

    # m 5eua "I'm happy with where we are now."
    m 5eua "Estoy contenta con nuestra situación actual."

# game/script-topics.rpy:1740
translate spanish monika_lastpoem_238be08f:

    # m 5hua "And I can tell you are, too."
    m 5hua "Y me atrevería a decir que tú también."

# game/script-topics.rpy:1752
translate spanish monika_anxious_e663057a:

    # m 4eua "You ever have that thing happen where you just get anxious for no reason?"
    m 4eua "¿Alguna vez te ha dado un ataque de ansiedad sin venir a cuento?"

# game/script-topics.rpy:1753
translate spanish monika_anxious_0265e105:

    # m "Like, you're just minding your own business, and you realize you're feeling really anxious."
    m "En plan, que estás a lo tuyo y de repente empiezas a sentir mucha ansiedad."

# game/script-topics.rpy:1754
translate spanish monika_anxious_b278f210:

    # m 4rssdrb "And you're sitting there like, 'What am I even anxious about right now?'"
    m 4rssdrb "Y te quedas pasmado preguntándote a qué viene tanta preocupación."

# game/script-topics.rpy:1755
translate spanish monika_anxious_04a658d7:

    # m "So you start to think about all the things you might be anxious about..."
    m "Por lo que empiezas a repasar todas las razones por las que podrías estar nervioso..."

# game/script-topics.rpy:1756
translate spanish monika_anxious_b148435e:

    # m 4eua "And that makes you even more anxious."
    m 4eua "y te sientes aún peor."

# game/script-topics.rpy:1757
translate spanish monika_anxious_7c34c4ae:

    # m 2hub "Ahaha! That's the worst."
    m 2hub "¡Ja, ja, ja! Es terrible."

# game/script-topics.rpy:1758
translate spanish monika_anxious_adeb650f:

    # m 2eua "If you're ever feeling anxious, I'll help you relax a little."
    m 2eua "Si alguna vez sientes ansiedad, te ehcaré una mano para que te relajes."

# game/script-topics.rpy:1759
translate spanish monika_anxious_48f742cd:

    # m 2eka "Besides..."
    m 2eka "Además...,"

# game/script-topics.rpy:1761
translate spanish monika_anxious_d4a5cd17:

    # m 5eua "In this game, all our worries are gone forever."
    m 5eua "en este juego, nuestras preocupaciones ya no existen."

# game/script-topics.rpy:1772
translate spanish monika_friends_a70f8edd:

    # m 1eua "You know, I've always hated how hard it is to make friends..."
    m 1eua "No soporto lo mucho que cuesta hacer amigos, ¿sabes?"

# game/script-topics.rpy:1773
translate spanish monika_friends_902e3cc0:

    # m 1euc "Well, I guess not the 'making friends' part, but more like meeting new people."
    m 1euc "Bueno, más que la parte de hacer amigos, me refiero a lo de conocer gente nueva."

# game/script-topics.rpy:1774
translate spanish monika_friends_db9b09fd:

    # m 1lsc "I mean, there are like, dating apps and stuff, right?"
    m 1lsc "A ver, hay aplicaciones de citas y tal, ¿no?"

# game/script-topics.rpy:1775
translate spanish monika_friends_3dcb7554:

    # m 1euc "But that's not the kind of thing I'm talking about."
    m 1euc "Pero no me refiero a eso."

# game/script-topics.rpy:1776
translate spanish monika_friends_b0f8ca78:

    # m 3eud "If you think about it, most of the friends you make are people you just met by chance."
    m 3eud "Si te paras a pensarlo, la mayoría de tus amigos son gente a la que has conocido por casualidad."

# game/script-topics.rpy:1777
translate spanish monika_friends_31b38ee2:

    # m "Like you had a class together, or you met them through another friend..."
    m "Que si habéis ido juntos a clase, que si los has conocido a través de otro amigo..."

# game/script-topics.rpy:1778
translate spanish monika_friends_ed6ba660:

    # m 1eua "Or maybe they were just wearing a shirt with your favorite band on it, and you decided to talk to them."
    m 1eua "O quizá les dirigiste la palabra porque llevaban una camiseta de tu grupo favorito."

# game/script-topics.rpy:1779
translate spanish monika_friends_22860015:

    # m 3eua "Things like that."
    m 3eua "Cosas así."

# game/script-topics.rpy:1780
translate spanish monika_friends_074273fe:

    # m 3esd "But isn't that kind of...inefficient?"
    m 3esd "Pero ¿no te parece poco práctico?..."

# game/script-topics.rpy:1781
translate spanish monika_friends_a59f43b8:

    # m 2eud "It feels like you're just picking at complete random, and if you get lucky, you make a new friend."
    m 2eud "Es como si estuvieses escogiendo a ciegas y hubieras conseguido un amigo por pura suerte."

# game/script-topics.rpy:1782
translate spanish monika_friends_00143554:

    # m 2euc "And comparing that to the hundreds of strangers we walk by every single day..."
    m 2euc "Compáralo con la ingente cantidad de desconocidos con la que nos cruzamos cada día."

# game/script-topics.rpy:1783
translate spanish monika_friends_dbf0003c:

    # m 2ekd "You could be sitting right next to someone compatible enough to be your best friend for life."
    m 2ekd "Un día, podrías sentarte al lado de alguien que, potencialmente, podría ser tu amigo para toda la vida."

# game/script-topics.rpy:1784
translate spanish monika_friends_dc2dee4e:

    # m 2eksdlc "But you'll never know."
    m 2eksdlc "Pero nunca lo sabrás."

# game/script-topics.rpy:1785
translate spanish monika_friends_bb7740d0:

    # m 4eksdlc "Once you get up and go on with your day, that opportunity is gone forever."
    m 4eksdlc "Porque, una vez que te levantas y sigues a lo tuyo, la oportunidad se ha ido para siempre."

# game/script-topics.rpy:1786
translate spanish monika_friends_05d42774:

    # m 2tkc "Isn't that just depressing?"
    m 2tkc "¿No te parece deprimente?"

# game/script-topics.rpy:1787
translate spanish monika_friends_65644a5f:

    # m "We live in an age where technology connects us with the world, no matter where we are."
    m "Vivimos en una época en la que la tecnología nos permite conectarnos con todo el mundo sin importar el lugar."

# game/script-topics.rpy:1788
translate spanish monika_friends_36659b5b:

    # m 2eka "I really think we should be taking advantage of that to improve our everyday social life."
    m 2eka "Pienso que deberíamos aprovecharlo para mejorar nuestra vida social diaria."

# game/script-topics.rpy:1789
translate spanish monika_friends_8205e2a3:

    # m 2dsc "But who knows how long it'll take for something like that to successfully take off..."
    m 2dsc "Pero quién sabe cuándo podría despegar con éxito algo así..."

# game/script-topics.rpy:1790
translate spanish monika_friends_e8b97a01:

    # m "I seriously thought it would happen by now."
    m "Creía que, a estas alturas de la película, ya sería posible."

# game/script-topics.rpy:1792
translate spanish monika_friends_3e0a130f:

    # m 2eua "Well, at least I already met the best person in the whole world..."
    m 2eua "Bueno, al menos he conocido a la mejor persona del mundo...,"

# game/script-topics.rpy:1793
translate spanish monika_friends_857f787f:

    # m "Even if it was by chance."
    m "aunque haya sido de casualidad."

# game/script-topics.rpy:1795
translate spanish monika_friends_c98de847:

    # m 5eua "I guess I just got really lucky, huh?"
    m 5eua "Supongo que he sido muy afortunada."

# game/script-topics.rpy:1796
translate spanish monika_friends_86a08130:

    # m 5hub "Ahaha~"
    m 5hub "Ja, ja, ja."

# game/script-topics.rpy:1807
translate spanish monika_college_c1a5f63d:

    # m 4euc "You know, it's around the time that everyone my year starts to think about college..."
    m 4euc "¿Sabes qué? La gente, cuando llega a mi edad, suele empezar a pensar en la universidad."

# game/script-topics.rpy:1808
translate spanish monika_college_9040a204:

    # m 2euc "It's a really turbulent time for education."
    m 2euc "En lo que a educación se refiere, es un momento muy movido."

# game/script-topics.rpy:1809
translate spanish monika_college_03f5ca61:

    # m "We're at the height of this modern expectation that everyone has to go to college, you know?"
    m "Nunca antes había habido tanta presión para que todo el mundo fuera a la universidad."

# game/script-topics.rpy:1810
translate spanish monika_college_806d255d:

    # m 4eud "Finish high school, go to college, get a job - or go to grad school, I guess."
    m 4eud "Acaba el instituto, ve a la universidad, consigue un trabajo..., aunque también puedes hacer un posgrado."

# game/script-topics.rpy:1811
translate spanish monika_college_6d761ac0:

    # m 4euc "It's like a universal expectation that people just assume is the only option for them."
    m 4euc "Es como si todo el mundo te hiciera creer que esa es la única opción posible."

# game/script-topics.rpy:1812
translate spanish monika_college_0f367171:

    # m 2esc "They don't teach us in high school that there are other options out there."
    m 2esc "En el instituto, no nos enseñan la inmensa cantidad de posibilidades que existen."

# game/script-topics.rpy:1813
translate spanish monika_college_d72f5b36:

    # m 3esd "Like trade schools and stuff, you know?"
    m 3esd "Como la formación profesional, por ejemplo."

# game/script-topics.rpy:1814
translate spanish monika_college_44d7e8ed:

    # m 3esc "...Or freelance work."
    m 3esc "O trabajar por cuenta propia."

# game/script-topics.rpy:1815
translate spanish monika_college_c5e52592:

    # m "...Or the many industries that value skill and experience more than formal education."
    m "O las muchas industrias que valoran más la habilidad y la experiencia que la educación formal."

# game/script-topics.rpy:1816
translate spanish monika_college_1ce76896:

    # m 2ekc "But you have all these students who have no idea what they want to do with their life..."
    m 2ekc "Hay un montón de estudiantes que no tienen ni idea de qué hacer con sus vidas."

# game/script-topics.rpy:1817
translate spanish monika_college_1a6765dc:

    # m 2ekd "And instead of taking the time to figure it out, they go to college for business, or communication, or psychology."
    m 2ekd "Y, en lugar de tomarse el tiempo para pensarlo, estudian negocios, comunicación o psicología."

# game/script-topics.rpy:1818
translate spanish monika_college_ba7d9728:

    # m "Not because they have an interest in those fields..."
    m "Y no porque estén interesados en esos campos,"

# game/script-topics.rpy:1819
translate spanish monika_college_33df6021:

    # m 2ekc "...but because they just hope the degree will get them some kind of job after college."
    m 2ekc "sino porque esperan que les dé un empleo cuando acaben la universidad."

# game/script-topics.rpy:1820
translate spanish monika_college_405bcc4f:

    # m 3ekc "So the end result is that there are fewer jobs to go around for those entry-level degrees, right?"
    m 3ekc "Y el resultado es que hay menos trabajo disponible para los recién graduados, ¿no?"

# game/script-topics.rpy:1821
translate spanish monika_college_ba8add1b:

    # m "So the basic job requirements get higher, which forces even more people to go to college."
    m "Los requisitos para los distintos puestos se vuelven más exigentes, lo que obliga a más gente a ir a la universidad."

# game/script-topics.rpy:1822
translate spanish monika_college_1c080618:

    # m 3ekd "And colleges are also businesses, so they just keep raising their prices due to the demand..."
    m 3ekd "Y las universidades también son negocios, así que suben los precios por culpa de la demanda..."

# game/script-topics.rpy:1823
translate spanish monika_college_0ba87844:

    # m 2ekc "...so now we have all these young adults, tens of thousands of dollars in debt, with no job."
    m 2ekc "así que ahora tenemos a todos estos jóvenes adultos, endeudados por decenas de miles de dólares y sin trabajo."

# game/script-topics.rpy:1824
translate spanish monika_college_88d26a14:

    # m 2ekd "But despite all that, the routine stays the same."
    m 2ekd "Aun así, todo sigue igual."

# game/script-topics.rpy:1825
translate spanish monika_college_e47178d2:

    # m 2lsc "Well, I think it's going to start getting better soon."
    m 2lsc "Bueno, creo que todo irá a mejor dentro de poco."

# game/script-topics.rpy:1826
translate spanish monika_college_177705e0:

    # m 2eud "But until then, our generation is definitely suffering from the worst of it."
    m 2eud "Pero, hasta entonces, nuestra generación se está llevando la peor parte."

# game/script-topics.rpy:1827
translate spanish monika_college_ff2fe479:

    # m 2dsc "I just wish high school prepared us a little better with the knowledge we need to make the decision that's right for us."
    m 2dsc "Desearía que nos hubiesen formado mejor en el instituto para que tomásemos la decisión más adecuada para nosotros."

# game/script-topics.rpy:1838
