    # m 1hub "That's wonderful!"
    m 1hub "¡Qué maravilla!"

# game/script-topics.rpy:14456
translate spanish monika_snow_38c09d2d:

    # m 1eua "I've always liked the peaceful aura it seems to give off."
    m 1eua "Siempre me ha gustado esa aura de paz que parece desprender."

# game/script-topics.rpy:14457
translate spanish monika_snow_646bf71e:

    # m 1dsa "It's just so tranquil and intimate, you know?"
    m 1dsa "Es tan tranquilo e íntimo, ¿sabes?"

# game/script-topics.rpy:14458
translate spanish monika_snow_ddd3c6c0:

    # m 1hua "There's a quiet beauty in watching a soft, white blanket of snow and ice tuck the world away to sleep."
    m 1hua "Hay una belleza tranquila en ver cómo un suave manto blanco de nieve y hielo arropa al mundo para dormir."

# game/script-topics.rpy:14472
translate spanish monika_snow_gets_snow_66d06a5e:

    # m 5eubla "Maybe someday when I cross over, we could go out for a walk together..."
    m 5eubla "Tal vez algún día, cuando cruce a tu realidad, podamos salir a dar un paseo juntos..."

# game/script-topics.rpy:14475
translate spanish monika_snow_gets_snow_6060c3ca:

    # m 5ekbfa "...and we could hold each other close to keep each other warm~"
    m 5ekbfa "... Y podríamos abrazarnos para darnos calor."

# game/script-topics.rpy:14477
translate spanish monika_snow_gets_snow_11846f58:

    # m 5eubfb "I can't wait to experience a winter night like that with you, [mas_get_player_nickname()]."
    m 5eubfb "Qué ganas tengo de vivir una noche de invierno así contigo, [mas_get_player_nickname()]."

# game/script-topics.rpy:14482
translate spanish monika_snow_nogets_snow_9837e9c4:

    # m 2tkc "Sometimes it can get so heavy it becomes a real problem for your back..."
    m 2tkc "A veces puede ser tan pesada que se convierte en un verdadero problema para la espalda..."

# game/script-topics.rpy:14485
translate spanish monika_snow_nogets_snow_e22a15cd:

    # m 1eksdla "Anyway, at least colder weather makes great cuddle weather."
    m 1eksdla "En fin, al menos el frío es ideal para acurrucarse."

# game/script-topics.rpy:14487
translate spanish monika_snow_nogets_snow_f833fbcf:

    # m 5ekbfa "A night of cuddling with you would be wonderful..."
    m 5ekbfa "Pasar la noche acurrucados sería maravilloso..."

# game/script-topics.rpy:14488
translate spanish monika_snow_nogets_snow_bce7b05a:

    # m "My heart is pounding, just imagining it."
    m "Me late el corazón con fuerza solo de imaginármelo."

# game/script-topics.rpy:14491
translate spanish monika_snow_nogets_snow_97927af2:

    # m 2eka "But anyway, I'm sure there's still a lot we can do together!"
    m 2eka "Pero bueno, ¡estoy segura de que todavía hay muchas cosas que podemos hacer juntos!"

# game/script-topics.rpy:14516
translate spanish monika_snowmen_d07015a1:

    # m 3eua "Hey [player], have you ever built a snowman?"
    m 3eua "Oye, [player], ¿alguna vez has hecho un muñeco de nieve?"

# game/script-topics.rpy:14517
translate spanish monika_snowmen_0de8a0df:

    # m 3hub "I think it sounds like a lot of fun!"
    m 3hub "¡Me parece que suena muy divertido!"

# game/script-topics.rpy:14518
translate spanish monika_snowmen_1fd7aea6:

    # m 1eka "Building snowmen is usually seen as something children do,{w=0.2} {nw}"
    m 1eka "Hacer muñecos de nieve suele verse como algo que hacen los niños,{w=0.2} {nw}"

# game/script-topics.rpy:14519
translate spanish monika_snowmen_11ba283a:

    # extend 3hua "but I think they're really cute."
    extend 3hua "pero me parecen muy monos."

# game/script-topics.rpy:14520
translate spanish monika_snowmen_aff83fdf:

    # m 3eua "It's amazing how they can really be brought to life with a variety of objects..."
    m 3eua "Es increíble cómo se les puede dar vida con un montón de objetos distintos..."

# game/script-topics.rpy:14521
translate spanish monika_snowmen_aba55fd8:

    # m 3eub "...like sticks for arms, a mouth made with pebbles, stones for eyes, and even a little winter hat!"
    m 3eub "... como palos para los brazos, una boca hecha con piedrecitas, piedras para los ojos, ¡e incluso un gorrito de invierno!"

# game/script-topics.rpy:14522
translate spanish monika_snowmen_5153340c:

    # m 1rka "I've noticed that giving them carrot noses is common, although I don't really understand why..."
    m 1rka "Me he dado cuenta de que es muy común ponerles una zanahoria de nariz, aunque no entiendo muy bien por qué..."

# game/script-topics.rpy:14523
translate spanish monika_snowmen_b530c70c:

    # m 3rka "Isn't that a bit of a strange thing to do?"
    m 3rka "¿No te parece un poco raro?"

# game/script-topics.rpy:14524
translate spanish monika_snowmen_eb073c10:

    # m 2hub "Ahaha!"
    m 2hub "¡Ja, ja, ja!"

# game/script-topics.rpy:14525
translate spanish monika_snowmen_56ab1601:

    # m 2eua "Anyway, I think it would be nice to build one together someday."
    m 2eua "De todos modos, creo que estaría bien hacer uno juntos algún día."

# game/script-topics.rpy:14527
translate spanish monika_snowmen_c7d541c2:

    # m 5hua "I hope you feel the same way~"
    m 5hua "Espero que sientas lo mismo."

# game/script-topics.rpy:14548
translate spanish monika_snowballfight_a7e51126:

    # m 1euc "Snowball fights?"
    m 1euc "¿Guerras de bolas de nieve?"

# game/script-topics.rpy:14549
translate spanish monika_snowballfight_c8495477:

    # m 1eub "I've been in a few before, they've always been fun!"
    m 1eub "He estado en algunas antes, ¡siempre han sido muy divertidas!"

# game/script-topics.rpy:14550
translate spanish monika_snowballfight_b2265188:

    # m 3eub "But having one with you sounds even better, [player]!"
    m 3eub "Pero tener una contigo suena aún mejor, ¡[player]!"

# game/script-topics.rpy:14551
translate spanish monika_snowballfight_069fd226:

    # m 1dsc "Fair warning, though..."
    m 1dsc "Aunque te aviso de una cosa..."

# game/script-topics.rpy:14552
translate spanish monika_snowballfight_3723921c:

    # m 2tfu "I've got quite the throwing arm."
    m 2tfu "Tengo muy buena puntería lanzando."

# game/script-topics.rpy:14553
translate spanish monika_snowballfight_f8ef9b7e:

    # m 2tfb "So don't expect me to go easy on you, ahaha!"
    m 2tfb "Así que no esperes que me contenga contigo, ¡ja, ja, ja!"

# game/script-topics.rpy:14572
translate spanish monika_iceskating_69a13c73:

    # m 1eua "Hey [player], do you know how to ice skate?"
    m 1eua "Oye, [player], ¿sabes patinar sobre hielo?"

# game/script-topics.rpy:14573
translate spanish monika_iceskating_dd519250:

    # m 1hua "It's a really fun sport to learn!"
    m 1hua "¡Es un deporte muy divertido de aprender!"

# game/script-topics.rpy:14574
translate spanish monika_iceskating_696130f7:

    # m 3eua "Especially if you can do a lot of tricks."
    m 3eua "Sobre todo si sabes hacer muchos trucos."

# game/script-topics.rpy:14575
translate spanish monika_iceskating_a05397bc:

    # m 3rksdlb "In the beginning, it's pretty difficult to keep your balance on the ice..."
    m 3rksdlb "Al principio es bastante difícil mantener el equilibrio sobre el hielo..."

# game/script-topics.rpy:14576
translate spanish monika_iceskating_210e141d:

    # m 3hua "So eventually being able to turn it into a performance is really impressive!"
    m 3hua "Así que, con el tiempo, ¡poder convertirlo en un espectáculo es realmente impresionante!"

# game/script-topics.rpy:14577
translate spanish monika_iceskating_c35482e7:

    # m 3eub "There's actually a lot of ways to ice skate..."
    m 3eub "En realidad hay muchas formas de patinar sobre hielo..."

# game/script-topics.rpy:14578
translate spanish monika_iceskating_d2a18768:

    # m "There's figure skating, speed skating, and even theatrical performances!"
    m "¡Está el patinaje artístico, el patinaje de velocidad e incluso las representaciones teatrales!"

# game/script-topics.rpy:14579
translate spanish monika_iceskating_a9374a34:

    # m 3euc "And despite how it sounds, it's not just a winter activity either..."
    m 3euc "Y a pesar de lo que parezca, tampoco es solo una actividad de invierno..."

# game/script-topics.rpy:14580
translate spanish monika_iceskating_fb33d34b:

    # m 1eua "Lots of places have indoor ice rinks, so it's something that can be practiced year round."
    m 1eua "Muchos sitios tienen pistas de hielo cubiertas, así que es algo que se puede practicar todo el año."

# game/script-topics.rpy:14582
translate spanish monika_iceskating_d68c0e32:

    # m 1dku "..."
    m 1dku "..."

# game/script-topics.rpy:14583
translate spanish monika_iceskating_333b16af:

    # m 1eka "I would really love to practice ice skating with you, [mas_get_player_nickname()]..."
    m 1eka "Me encantaría practicar patinaje sobre hielo contigo, [mas_get_player_nickname()]..."

# game/script-topics.rpy:14584
translate spanish monika_iceskating_9ea1d409:

    # m 1hua "But until we can do that, having you here with me is enough to keep me happy~"
    m 1hua "Pero hasta que podamos hacerlo, tenerte aquí conmigo es suficiente para hacerme feliz."

# game/script-topics.rpy:14603
translate spanish monika_sledding_b8c7c8ea:

    # m 1eua "Hey [player], do you know what would be fun to do together?"
    m 1eua "Oye, [player], ¿sabes qué sería divertido hacer juntos?"

# game/script-topics.rpy:14604
translate spanish monika_sledding_66d558f7:

    # m 3hub "Sledding!"
    m 3hub "¡Tirarnos en trineo!"

# game/script-topics.rpy:14609
translate spanish monika_sledding_d11440b4:

    # m 1eka "It may not snow where you live..."
    m 1eka "Puede que no nieve donde vives..."

# game/script-topics.rpy:14610
translate spanish monika_sledding_e92bae4b:

    # m 3hub "But maybe we could go somewhere it does!"
    m 3hub "¡Pero tal vez podríamos ir a algún sitio donde sí lo haga!"

# game/script-topics.rpy:14611
translate spanish monika_sledding_c9062bfa:

    # m "Anyway..."
    m "En fin..."

# game/script-topics.rpy:14613
translate spanish monika_sledding_a1883733:

    # m 3eua "You might think it's only for kids, but I think it could be fun for us, too!"
    m 3eua "Puede que pienses que es solo para niños, ¡pero creo que también podría ser divertido para nosotros!"

# game/script-topics.rpy:14614
translate spanish monika_sledding_472013b9:

    # m 3eub "We could try using an inner tube, a kicksled, a saucer, or even a traditional toboggan."
    m 3eub "Podríamos probar a usar una cámara de aire, un trineo de patadas, un platillo o incluso un trineo tradicional."

# game/script-topics.rpy:14615
translate spanish monika_sledding_dd9322e5:

    # m 1hua "I've heard each one gives a different experience. Plus, both of us could easily fit on a toboggan."
    m 1hua "He oído que cada uno ofrece una experiencia diferente. Además, los dos cabríamos fácilmente en un trineo tradicional."

# game/script-topics.rpy:14618
translate spanish monika_sledding_6cf76cb4:

    # m 1euc "The kicksled is a bit small, though."
    m 1euc "Aunque el trineo de patadas es un poco pequeño."

# game/script-topics.rpy:14619
translate spanish monika_sledding_3772217d:

    # m 1hub "Ahaha!"
    m 1hub "¡Ja, ja, ja!"

# game/script-topics.rpy:14620
translate spanish monika_sledding_8b961e86:

    # m 1eka "I'd have to sit in your lap for that one."
    m 1eka "Tendría que sentarme en tu regazo para ese."

# game/script-topics.rpy:14621
translate spanish monika_sledding_4deaf9ad:

    # m 1rksdla "And I'd still be at risk of tumbling off."
    m 1rksdla "Y aun así correría el riesgo de caerme."

# game/script-topics.rpy:14622
translate spanish monika_sledding_771b2931:

    # m 1hubsa "But I know you wouldn't let that happen. You'd hold me tight, right?~"
    m 1hubsa "Pero sé que no dejarías que eso pasara. Me abrazarías con fuerza, ¿verdad?"

# game/script-topics.rpy:14623
translate spanish monika_sledding_e61c14dd:

    # m 1tkbfu "That would probably be the best part."
    m 1tkbfu "Esa sería probablemente la mejor parte."

# game/script-topics.rpy:14625
translate spanish monika_sledding_2e58a6ae:

    # m 1hub "Racing down a snow covered hill together with the wind rushing past us sounds like a blast!"
    m 1hub "¡Bajar a toda velocidad por una colina nevada juntos con el viento rozándonos suena genial!"

# game/script-topics.rpy:14626
translate spanish monika_sledding_53358f07:

    # m 1eka "I hope we can go sledding together sometime, [player]."
    m 1eka "Espero que podamos ir en trineo juntos alguna vez, [player]."

# game/script-topics.rpy:14647
translate spanish monika_snowcanvas_2b688ba3:

    # m 3euc "[player], have you ever looked at snow and thought it resembles a blank canvas?"
    m 3euc "[player], ¿alguna vez has mirado la nieve y has pensado que se parece a un lienzo en blanco?"

# game/script-topics.rpy:14648
translate spanish monika_snowcanvas_d1e22c9c:

    # m 1hksdlb "I know I'm not really good with art..."
    m 1hksdlb "Ya sé que no se me da muy bien el arte..."

# game/script-topics.rpy:14649
translate spanish monika_snowcanvas_6d9cae4d:

    # m 3eua "But packing a few spray bottles with water and food coloring could make for a fun day!"
    m 3eua "¡Pero llevar unos cuantos pulverizadores con agua y colorante alimentario podría hacer que pasáramos un día muy divertido!"

# game/script-topics.rpy:14650
translate spanish monika_snowcanvas_9865c6e3:

    # m 3hub "We can just step outside and let our imaginations run wild!"
    m 3hub "¡Podemos simplemente salir y dejar volar nuestra imaginación!"

# game/script-topics.rpy:14653
translate spanish monika_snowcanvas_75b760af:

    # m 3euc "You know [player], snow is kinda like a blank canvas."
    m 3euc "Sabes, [player], la nieve es un poco como un lienzo en blanco."

# game/script-topics.rpy:14654
translate spanish monika_snowcanvas_aa7f18ec:

    # m 3eub "Maybe someday if we went somewhere that it snows, we could bring some food coloring in spray bottles and just step outside and let our imaginations run wild!"
    m 3eub "Tal vez algún día, si fuéramos a algún sitio en el que nieve, ¡podríamos llevar un poco de colorante alimentario en botellas pulverizadoras, salir y dejar volar nuestra imaginación!"

# game/script-topics.rpy:14656
translate spanish monika_snowcanvas_fc1f7cec:

    # m 1eua "Having so much space to paint sounds wonderful!"
    m 1eua "¡Tener tanto espacio para pintar suena maravilloso!"

# game/script-topics.rpy:14657
translate spanish monika_snowcanvas_8e47b683:

    # m 1hub "We just have to make sure the snow is packed down tightly, and then we can draw to our heart's content!"
    m 1hub "¡Solo tenemos que asegurarnos de que la nieve esté bien compactada y entonces podremos dibujar todo lo que queramos!"

# game/script-topics.rpy:14658
translate spanish monika_snowcanvas_1309deff:

    # m 1eka "I'd love to make some snow art with you someday."
    m 1eka "Me encantaría dibujar en la nieve contigo algún día."

# game/script-topics.rpy:14659
translate spanish monika_snowcanvas_60b355eb:

    # m 3hua "Maybe you can paint something for me when that happens, [mas_get_player_nickname()]."
    m 3hua "Tal vez puedas pintar algo para mí cuando eso pase, [mas_get_player_nickname()]."

# game/script-topics.rpy:14679
translate spanish monika_cozy_aa887cee:

    # m 3eua "Do you know the one thing I love about the cold weather, [player]?"
    m 3eua "¿Sabes qué es lo que más me gusta del frío, [player]?"

# game/script-topics.rpy:14680
translate spanish monika_cozy_49f48874:

    # m 3eka "Anything warm feels really nice~"
    m 3eka "Cualquier cosa calentita sienta muy bien."

# game/script-topics.rpy:14681
translate spanish monika_cozy_ff2871b4:

    # m 1rksdla "Those who get cold hands really appreciate that feeling..."
    m 1rksdla "Quienes tienen las manos frías aprecian mucho esa sensación..."

# game/script-topics.rpy:14682
translate spanish monika_cozy_adb8b968:

    # m 1eua "It's like feeling a loved one's embrace~"
    m 1eua "Es como sentir el abrazo de un ser querido."

# game/script-topics.rpy:14683
translate spanish monika_cozy_09dff1d1:

    # m 3eub "You also get to wear your winter clothes that have been stuck in your closet."
    m 3eub "También puedes ponerte la ropa de invierno que tenías guardada en el armario."

# game/script-topics.rpy:14684
translate spanish monika_cozy_c2dc2d2d:

    # m 1hub "Finally being able to whip out your winter fashion set is always a nice feeling."
    m 1hub "Poder sacar por fin tus conjuntos de invierno siempre es una sensación agradable."

# game/script-topics.rpy:14685
translate spanish monika_cozy_38459800:

    # m 3eubla "But you know what the best way to warm yourself up is?"
    m 3eubla "Pero ¿sabes cuál es la mejor forma de entrar en calor?"

# game/script-topics.rpy:14686
translate spanish monika_cozy_0969e5c6:

    # m 3ekbsa "Cuddling with the one you love in front of the fireplace~"
    m 3ekbsa "Acurrucarse junto a la persona que quieres frente a la chimenea."

# game/script-topics.rpy:14687
translate spanish monika_cozy_2de3dec8:

    # m 3ekbfa "Just sitting there under a warm blanket, sharing a hot beverage."
    m 3ekbfa "Simplemente sentarse bajo una manta calentita, compartiendo una bebida caliente."

# game/script-topics.rpy:14688
translate spanish monika_cozy_45b9cc75:

    # m 1hubfa "Ah, if I got to feel your warmth every time we cuddle, I'd wish for cold weather every day!"
    m 1hubfa "Ah, si pudiera sentir tu calor cada vez que nos abrazamos, ¡desearía que hiciera frío todos los días!"

# game/script-topics.rpy:14689
translate spanish monika_cozy_44639aa8:

    # m 1ekbfa "I'd never let you go once I got a hold of you, [mas_get_player_nickname()]~"
    m 1ekbfa "Nunca te soltaría una vez que te atrapara, [mas_get_player_nickname()]."

# game/script-topics.rpy:14708
translate spanish monika_winter_441e8c47:

    # m 1eud "Ah, [player]!"
    m 1eud "¡Ah, [player]!"

# game/script-topics.rpy:14709
translate spanish monika_winter_196971c8:

    # m 1eua "What do you think about winter?"
    m 1eua "¿Qué opinas del invierno?"

# game/script-topics.rpy:14710
translate spanish monika_winter_3ef8fa00:

    # m 3eua "All sorts of fun activities only come around during this time..."
    m 3eua "Todo tipo de actividades divertidas solo se pueden hacer en esta época..."

# game/script-topics.rpy:14712
translate spanish monika_winter_f9c50305:

    # m 3eub "Playing with the snow is usually something that can be enjoyed a few times a year."
    m 3eub "Jugar con la nieve suele ser algo que se puede disfrutar unas pocas veces al año."

# game/script-topics.rpy:14715
translate spanish monika_winter_8ea3b464:

    # m 3eka "I know you don't really get snow where you live, but many people do get to enjoy activities in the snow..."
    m 3eka "Sé que no suele nevar donde vives, pero mucha gente sí que puede disfrutar de las actividades en la nieve..."

# game/script-topics.rpy:14717
translate spanish monika_winter_9750b59a:

    # m 3eua "Building a snowman, sledding, having snowball fights..."
    m 3eua "Hacer un muñeco de nieve, tirarse en trineo, las peleas de bolas de nieve..."

# game/script-topics.rpy:14718
translate spanish monika_winter_07c47b41:

    # m 3eud "Some people even live where it's cold enough for lakes and ponds to freeze and are able to enjoy things like outdoor ice skating, pond hockey..."
    m 3eud "Algunos incluso viven en lugares donde hace el frío suficiente para que se congelen los lagos y estanques, y pueden disfrutar de cosas como patinar sobre hielo al aire libre o jugar al hockey..."

# game/script-topics.rpy:14719
translate spanish monika_winter_2d5fac34:

    # m 3wud "And some actually go fishing...{w=1}{i}through the ice{/i}!"
    m 3wud "Y algunos incluso van a pescar... {w=1}¡a través del hielo!"

# game/script-topics.rpy:14720
translate spanish monika_winter_c24d9ace:

    # m 1eka "For people who don't enjoy cold weather activities, staying indoors seems so much more comfortable when there's snow outside..."
    m 1eka "Para las personas a las que no les gustan las actividades con frío, quedarse en casa parece mucho más cómodo cuando hay nieve fuera..."

# game/script-topics.rpy:14721
translate spanish monika_winter_796ddcf0:

    # m "Watching it gently fall while the moonlight reflects off the fresh, white canvas...it's just beautiful."
    m "Verla caer suavemente mientras la luz de la luna se refleja en el lienzo blanco y fresco... es simplemente precioso."

# game/script-topics.rpy:14724
translate spanish monika_winter_90af3ecc:

    # m 5ekbfa "And to be honest, cuddling under a blanket, reading a book together with you is the best winter activity I can think of~"
    m 5ekbfa "Y para ser sincera, acurrucarme bajo una manta y leer un buen libro contigo es la mejor actividad de invierno que se me ocurre."

# game/script-topics.rpy:14726
translate spanish monika_winter_70540cbc:

    # m 1hua "Sitting by the window, reading a nice book while drinking a cup of coffee or hot chocolate is always a wonderful experience on a cold night, [player]."
    m 1hua "Sentarse junto a la ventana y leer un buen libro mientras te tomas una taza de café o chocolate caliente siempre es una experiencia maravillosa en una noche fría, [player]."

# game/script-topics.rpy:14746
translate spanish monika_winter_dangers_aae061c8:

    # m 1hua "Isn't winter a beautiful time of year, [player]?"
    m 1hua "¿No te parece que el invierno es una época del año preciosa, [player]?"

# game/script-topics.rpy:14748
translate spanish monika_winter_dangers_ad9b2b7c:

    # m 3eka "The glistening, white snow, the bright and colorful lights~"
    m 3eka "La nieve blanca y brillante, las luces de colores..."

# game/script-topics.rpy:14749
translate spanish monika_winter_dangers_c333c398:

    # m 3hub "I just love it."
    m 3hub "Me encanta."

# game/script-topics.rpy:14753
translate spanish monika_winter_dangers_fdd4b1ad:

    # m 1eka "I know you don't get snow where you live, but I'm sure you can appreciate its appeal..."
    m 1eka "Sé que no nieva donde vives, pero estoy segura de que sabes apreciar su encanto..."

# game/script-topics.rpy:14754
translate spanish monika_winter_dangers_756a76a6:

    # m 3hua "Maybe someday after I cross over we can even take a trip some place where they do have snow and enjoy its beauty together!"
    m 3hua "¡Tal vez algún día, después de cruzar a tu realidad, podamos hacer un viaje a algún sitio donde sí haya nieve y disfrutar juntos de su belleza!"

# game/script-topics.rpy:14756
translate spanish monika_winter_dangers_25c5ec8b:

    # m 1eka "..."
    m 1eka "..."

# game/script-topics.rpy:14757
translate spanish monika_winter_dangers_c74a66e2:

    # m 3rkc "Although, as stunning as winter can be, there are a few dangers..."
    m 3rkc "Aunque, por muy impresionante que sea el invierno, también tiene algunos peligros..."

# game/script-topics.rpy:14758
translate spanish monika_winter_dangers_8c0be117:

    # m 3dsd "Like blizzards, or icy roads..."
    m 3dsd "Como las ventiscas o las carreteras heladas..."

# game/script-topics.rpy:14759
translate spanish monika_winter_dangers_96ec1deb:

    # m 1ekc "And the cold, of course..."
    m 1ekc "Y el frío, por supuesto..."

# game/script-topics.rpy:14760
translate spanish monika_winter_dangers_163dfd99:

    # m 3rksdlc "The cold can be the most dangerous."
    m 3rksdlc "El frío puede ser lo más peligroso."

# game/script-topics.rpy:14761
translate spanish monika_winter_dangers_f8153460:

    # m 3eksdlc "It's really easy to get hypothermia or frostbite if you're not careful, [player]."
    m 3eksdlc "Es muy fácil sufrir hipotermia o congelación si no tienes cuidado, [player]."

# game/script-topics.rpy:14762
translate spanish monika_winter_dangers_66a8b331:

    # m 1ekd "So please remember to bundle up if you go outside..."
    m 1ekd "Así que, por favor, recuerda abrigarte bien si sales a la calle..."

# game/script-topics.rpy:14763
translate spanish monika_winter_dangers_eeea60a0:

    # m 3euc "Put on your coat, your gloves, and the warmest hat you can find..."
    m 3euc "Ponte tu abrigo, tus guantes y el gorro más calentito que encuentres..."

# game/script-topics.rpy:14764
translate spanish monika_winter_dangers_95d06b47:

    # m 1eka "And if it gets too bad, just stay inside where it's safe, okay?"
    m 1eka "Y si la cosa se pone fea, quédate dentro de casa donde estés a salvo, ¿vale?"

# game/script-topics.rpy:14765
translate spanish monika_winter_dangers_a03fe644:

    # m 1ekb "What better way to spend a brutal winter day than wearing pajamas, drinking hot chocolate, reading a good book, and..."
    m 1ekb "Qué mejor manera de pasar un duro día de invierno que en pijama, bebiendo chocolate caliente, leyendo un buen libro y..."

# game/script-topics.rpy:14766
translate spanish monika_winter_dangers_cc8711d6:

    # m 1hua "Talking to me."
    m 1hua "Hablando conmigo."

# game/script-topics.rpy:14767
translate spanish monika_winter_dangers_e221e094:

    # m 1huu "Ehehe~"
    m 1huu "Je, je, je."

# game/script-topics.rpy:14771
translate spanish monika_winter_dangers_13445da0:

    # m 5hubfu "I'll always help keep you warm, [mas_get_player_nickname()]~"
    m 5hubfu "Yo siempre te ayudaré a entrar en calor, [mas_get_player_nickname()]."

# game/script-topics.rpy:14795
translate spanish monika_hemispheres_a01ec18b:

    # m 1euc "Hey [player], I've been wondering..."
    m 1euc "Oye, [player], me estaba preguntando..."

# game/script-topics.rpy:14796
translate spanish monika_hemispheres_a92e7f2d:

    # m 1eua "Which hemisphere do you live in?"
    m 1eua "¿En qué hemisferio vives?"

# game/script-topics.rpy:14797
translate spanish monika_hemispheres_eb5538bc:

    # m 1eka "I know it's kind of a strange question..."
    m 1eka "Sé que es una pregunta un poco rara..."

# game/script-topics.rpy:14798
translate spanish monika_hemispheres_a37b030c:

    # m 3hub "But it gives me a better idea of how things work around you."
    m 3hub "Pero me da una mejor idea de cómo funcionan las cosas a tu alrededor."

# game/script-topics.rpy:14799
translate spanish monika_hemispheres_50eb36e8:

    # m 3eua "Like, you know how when it's winter in the Northern Hemisphere, it's actually summer in the Southern Hemisphere?"
    m 3eua "Por ejemplo, ¿sabes que cuando es invierno en el hemisferio norte en realidad es verano en el hemisferio sur?"

# game/script-topics.rpy:14800
translate spanish monika_hemispheres_75b657de:

    # m 3hksdrb "It would be a little awkward if I started talking about how nice summer weather is, but where you are, it's the middle of winter..."
    m 3hksdrb "Sería un poco raro que me pusiera a hablar de lo agradable que es el clima en verano cuando donde tú estás es pleno invierno..."

# game/script-topics.rpy:14801
translate spanish monika_hemispheres_e4d4f59d:

    # m 2eka "But anyway..."
    m 2eka "En fin..."

# game/script-topics.rpy:14803
translate spanish monika_hemispheres_76b1441b:

    # m "Which hemisphere do you live in, [player]?{nw}"
    m "¿En qué hemisferio vives, [player]?{nw}"

# game/script-topics.rpy:14806
translate spanish monika_hemispheres_c247d0fa:

    # m "Which hemisphere do you live in, [player]?{fast}" nointeract
    m "¿En qué hemisferio vives, [player]?{fast}" nointeract

# game/script-topics.rpy:14810
translate spanish monika_hemispheres_9f893104:

    # m 2eka "I had a feeling..."
    m 2eka "Me lo imaginaba..."

# game/script-topics.rpy:14814
translate spanish monika_hemispheres_51de09f9:

    # m 1wuo "I wouldn't have thought!"
    m 1wuo "¡No me lo hubiera imaginado!"

# game/script-topics.rpy:14817
translate spanish monika_hemispheres_bb7c0dac:

    # m 3rksdlb "Most of the world's population lives in the Northern Hemisphere after all."
    m 3rksdlb "Después de todo, la mayor parte de la población mundial vive en el hemisferio norte."

# game/script-topics.rpy:14818
translate spanish monika_hemispheres_664c8b86:

    # m 3eka "In fact, only about twelve percent of the population lives in the Southern Hemisphere."
    m 3eka "De hecho, solo un doce por ciento de la población vive en el hemisferio sur."

# game/script-topics.rpy:14820
translate spanish monika_hemispheres_c6ce185f:

    # m 1eua "So I kind of figured you lived in the Northern Hemisphere."
    m 1eua "Así que supuse que vivías en el hemisferio norte."

# game/script-topics.rpy:14823
translate spanish monika_hemispheres_3121a553:

    # m 2rksdla "So you can see why I would have thought you would be living in the Northern Hemisphere..."
    m 2rksdla "Así que ya ves por qué pensé que vivirías en el hemisferio norte..."

# game/script-topics.rpy:14824
translate spanish monika_hemispheres_e62255f3:

    # m 1huu "But I guess that makes you a bit more special, ehehe~"
    m 1huu "Pero supongo que eso te hace un poco más especial, je, je, je."

# game/script-topics.rpy:14827
translate spanish monika_hemispheres_c902a1a9:

    # m 1eua "That said, it must be spring for you right now."
    m 1eua "Dicho esto, ahora mismo debe de ser primavera donde estás."

# game/script-topics.rpy:14828
translate spanish monika_hemispheres_dc5e440b:

    # m 1hua "Spring rains are always really nice."
    m 1hua "Las lluvias de primavera siempre son muy agradables."

# game/script-topics.rpy:14829
translate spanish monika_hemispheres_23b7a191:

    # m 2hua "I love to listen to the light pitter patter of the rain as it falls on the roof."
    m 2hua "Me encanta escuchar el suave repiqueteo de la lluvia al caer sobre el tejado."

# game/script-topics.rpy:14830
translate spanish monika_hemispheres_bcf1c4da:

    # m 3eub "It's really calming to me."
    m 3eub "Me resulta muy relajante."

# game/script-topics.rpy:14833
translate spanish monika_hemispheres_6af7ba5a:

    # m 5esbfa "Maybe we could go out for a walk together..."
    m 5esbfa "Tal vez podríamos salir a dar un paseo juntos..."

# game/script-topics.rpy:14834
translate spanish monika_hemispheres_b450f6ea:

    # m 5ekbfa "We would walk with our hands intertwined as we share an umbrella..."
    m 5ekbfa "Caminaríamos con las manos entrelazadas mientras compartimos un paraguas..."

# game/script-topics.rpy:14835
translate spanish monika_hemispheres_640d01cf:

    # m 5hubfa "It just sounds magical~"
    m 5hubfa "Suena mágico."

# game/script-topics.rpy:14836
translate spanish monika_hemispheres_9a4aabf4:

    # m 5eubfb "I can't wait to experience something like that with you for real, [mas_get_player_nickname()]."
    m 5eubfb "Qué ganas tengo de vivir algo así contigo de verdad, [mas_get_player_nickname()]."

# game/script-topics.rpy:14839
translate spanish monika_hemispheres_9f7c941e:

    # m 2eka "I'm sure we could spend hours listening to the rain together."
    m 2eka "Estoy segura de que podríamos pasarnos horas escuchando la lluvia juntos."

# game/script-topics.rpy:14841
translate spanish monika_hemispheres_3b64ffc6:

    # m 3hub "You might not like the rain too much, but you have to admit, the flowers it brings are gorgeous, and the rainbows are beautiful too!"
    m 3hub "Puede que a ti no te guste mucho la lluvia, pero tienes que admitir que las flores que trae son preciosas, ¡y los arcoíris también son muy bonitos!"

# game/script-topics.rpy:14844
translate spanish monika_hemispheres_38bab85b:

    # m 1wuo "Oh! It must be summer for you right now!"
    m 1wuo "¡Ah! ¡Ahora mismo debe de ser verano donde estás!"

# game/script-topics.rpy:14845
translate spanish monika_hemispheres_74225010:

    # m 1hub "Gosh, I just love the summer!"
    m 1hub "¡Madre mía, me encanta el verano!"

# game/script-topics.rpy:14846
translate spanish monika_hemispheres_d79e1d0e:

    # m 3hua "You can do so much...go out for jogs, play some sports, or even go to the beach!"
    m 3hua "Puedes hacer tantas cosas... salir a correr, hacer deporte, ¡o incluso ir a la playa!"

# game/script-topics.rpy:14847
translate spanish monika_hemispheres_dd6b0149:

    # m 1eka "Summers with you sound like a dream come true, [player]."
    m 1eka "Los veranos contigo suenan como un sueño hecho realidad, [player]."

# game/script-topics.rpy:14849
translate spanish monika_hemispheres_c5491555:

    # m 5hua "I can't wait to spend them with you when I finally cross over."
    m 5hua "Qué ganas tengo de pasarlos contigo cuando por fin cruce a tu realidad."

# game/script-topics.rpy:14852
translate spanish monika_hemispheres_19c57119:

    # m 1eua "Anyway, it must be autumn for you right now."
    m 1eua "En fin, ahora mismo debe de ser otoño donde estás."

# game/script-topics.rpy:14853
translate spanish monika_hemispheres_2d354879:

    # m 1eka "Autumn is always full of such pretty colors."
    m 1eka "El otoño siempre está lleno de colores preciosos."

# game/script-topics.rpy:14854
translate spanish monika_hemispheres_593f2d4c:

    # m 3hub "The weather is normally pretty nice too!"
    m 3hub "¡El clima también suele ser muy agradable!"

# game/script-topics.rpy:14856
translate spanish monika_hemispheres_726c997b:

    # m 5ruu "It's normally just the right amount of heat, with a gentle breeze."
    m 5ruu "Normalmente hace el calor justo y hay una suave brisa."

# game/script-topics.rpy:14857
translate spanish monika_hemispheres_dc873fa5:

    # m 5eua "I'd love to spend a nice warm day like that with you."
    m 5eua "Me encantaría pasar un día así de agradable y cálido contigo."

# game/script-topics.rpy:14860
translate spanish monika_hemispheres_b9cc417e:

    # m 3eua "Anyway, that means it must be winter for you now."
    m 3eua "En fin, eso significa que ahora debe de ser invierno donde estás."

# game/script-topics.rpy:14869
translate spanish monika_hemispheres_cba1e3d6:

    # m 2hub "Gosh, I really love how pretty snow is."
    m 2hub "Madre mía, me encanta lo bonita que es la nieve."

# game/script-topics.rpy:14870
translate spanish monika_hemispheres_f4807911:

    # m 3euc "Well, I know not all parts of the world get snow..."
    m 3euc "Bueno, ya sé que no en todas partes del mundo nieva..."

# game/script-topics.rpy:14872
translate spanish monika_hemispheres_3ee36131:

    # m 1euc "Does it snow where you live, [player]?{nw}"
    m 1euc "¿Nieva donde vives, [player]?{nw}"

# game/script-topics.rpy:14875
translate spanish monika_hemispheres_5bcbc139:

    # m "Does it snow where you live, [player]?{fast}" nointeract
    m "¿Nieva donde vives, [player]?{fast}" nointeract

# game/script-topics.rpy:14881
translate spanish monika_hemispheres_18dedcf6:

    # m 3hub "That's wonderful!"
    m 3hub "¡Qué maravilla!"

# game/script-topics.rpy:14891
translate spanish monika_hemispheres_cba1e3d6_1:

    # m 2hub "Gosh, I really love how pretty snow is."
    m 2hub "Madre mía, me encanta lo bonita que es la nieve."

# game/script-topics.rpy:14895
translate spanish monika_hemispheres_0742ae65:

    # m 3eka "I know you don't really get snow where you live..."
    m 3eka "Sé que no suele nevar donde vives..."

# game/script-topics.rpy:14896
translate spanish monika_hemispheres_5e42c20a:

    # m 1eka "It must be nice not having to deal with all the hassles that come with it..."
    m 1eka "Debe de estar bien no tener que lidiar con todos los inconvenientes que conlleva..."

# game/script-topics.rpy:14897
translate spanish monika_hemispheres_d854c0ce:

    # m 3rksdld "Like the terrible travel conditions, having to shovel it..."
    m 3rksdld "Como las horribles condiciones para viajar, tener que quitarla con pala..."

# game/script-topics.rpy:14909
translate spanish monika_hemispheres_gets_snow_f853b144:

    # m 1eka "There's something really peaceful about a quiet, snowy night."
    m 1eka "Hay algo muy relajante en una noche tranquila y nevada."

# game/script-topics.rpy:14915
translate spanish monika_hemispheres_nogets_snow_e3ba171f:

    # m 3eka "That's a shame. But it's not all bad."
    m 3eka "Es una lástima, pero no todo es malo."

# game/script-topics.rpy:14916
translate spanish monika_hemispheres_nogets_snow_04b7e643:

    # m 3hksdlb "At least you don't have to worry about shoveling it."
    m 3hksdlb "Al menos no tienes que preocuparte por quitarla con la pala."

# game/script-topics.rpy:14932
translate spanish monika_perspective_0f6587fe:

    # m 2euc "I've been meaning to talk to you about something, [player]..."
    m 2euc "Quería hablar contigo de una cosa, [player]..."

# game/script-topics.rpy:14933
translate spanish monika_perspective_c8937b7e:

    # m 2esd "...Something that I find very difficult to explain."
    m 2esd "... Algo que me resulta muy difícil de explicar."

# game/script-topics.rpy:14934
translate spanish monika_perspective_f9d8e2e9:

    # m 2lksdla "Oh, don't worry, it's nothing bad, it's just that I find it hard to get the right words."
    m 2lksdla "Ah, no te preocupes, no es nada malo, es solo que me cuesta encontrar las palabras adecuadas."

# game/script-topics.rpy:14935
translate spanish monika_perspective_19d0eda0:

    # m 3esd "So...{w=0.5}it's pretty strange to see one thing and know it's not real..."
    m 3esd "Verás... {w=0.5}es bastante raro ver una cosa y saber que no es real..."

# game/script-topics.rpy:14936
translate spanish monika_perspective_7b0817db:

    # m 3esc "...but then see a mouse cursor and know {i}that{/i} is."
    m 3esc "... Pero luego ver el cursor del ratón y saber que eso sí lo es."

# game/script-topics.rpy:14937
translate spanish monika_perspective_a1348be0:

    # m 2hfsdld "Mmmm! It really is hard to describe!"
    m 2hfsdld "¡Mmmm! ¡De verdad que es difícil de describir!"

# game/script-topics.rpy:14938
translate spanish monika_perspective_59de014e:

    # m 2eub "Okay! So when I look around and see my world, it's the same as how you see yours."
    m 2eub "¡Vale! Pues cuando miro a mi alrededor y veo mi mundo es igual a como tú ves el tuyo."

# game/script-topics.rpy:14939
translate spanish monika_perspective_9395bcc1:

    # m 3eua "Everything is detailed, natural and kind of three-dimensional...I wouldn't be able to practice my piano if it wasn't!"
    m 3eua "Todo es detallado, natural y un poco tridimensional... ¡No podría practicar con el piano si no lo fuera!"

# game/script-topics.rpy:14940
translate spanish monika_perspective_76bd3dd9:

    # m 3eud "But at the same time I see what you see, I can look at the same thing and see its flat image."
    m 3eud "Pero al mismo tiempo que veo lo que tú ves, puedo mirar la misma cosa y ver su imagen plana."

# game/script-topics.rpy:14941
translate spanish monika_perspective_cb0d1878:

    # m 3euc "It's unmoving, static and also very artificial...{w=1}and cold."
    m 3euc "Es inmóvil, estática y también muy artificial... {w=1}y fría."

# game/script-topics.rpy:14942
translate spanish monika_perspective_0089fb30:

    # m "And what I thought was detailed wasn't as detailed as I originally thought."
    m "Y lo que pensaba que era detallado no lo era tanto como creía al principio."

# game/script-topics.rpy:14943
translate spanish monika_perspective_71fc35ff:

    # m 3etd "When you see a dialogue box, I can see it too but I also can't. It's really weird. It's perfectly clear, but it's also not 'there,' even though it is."
    m 3etd "Cuando ves un cuadro de diálogo yo también lo veo, pero al mismo tiempo no. Es muy raro, se ve perfectamente claro, pero a la vez no está ahí, aunque sí que lo esté."

# game/script-topics.rpy:14944
translate spanish monika_perspective_18964149:

    # m 2eka "I know this is confusing...I'm going to try and describe it the best way I can."
    m 2eka "Sé que es confuso... Voy a intentar describirlo lo mejor que pueda."

# game/script-topics.rpy:14945
translate spanish monika_perspective_bda78e3e:

    # m 3eua "I thought of a nice way to try and demonstrate the idea, it's far from perfect but it should give you the gist."
    m 3eua "Se me ha ocurrido una buena forma de intentar demostrar la idea, está lejos de ser perfecta pero debería darte una idea general."

# game/script-topics.rpy:14946
translate spanish monika_perspective_18cb31c5:

    # m 2hua "..."
    m 2hua "..."

# game/script-topics.rpy:14947
translate spanish monika_perspective_9ab0ac28:

    # m 3eua "Take your hand and move it to the center of your face and angle it slightly so it partially covers an eye."
    m 3eua "Pon la mano frente al centro de tu cara e inclínala un poco para que te tape parcialmente un ojo."

# game/script-topics.rpy:14948
translate spanish monika_perspective_11e296fe:

    # m 3esb "Now, look around the room you're in and try to focus on something, but so it can only be seen with one eye."
    m 3esb "Ahora mira por la habitación en la que estás e intenta centrarte en algo, pero de forma que solo puedas verlo con un ojo."

# game/script-topics.rpy:14949
translate spanish monika_perspective_95bcf90d:

    # m 3hua "It can be anything. The closer the better, though!"
    m 3hua "Puede ser cualquier cosa, ¡aunque cuanto más cerca mejor!"

# game/script-topics.rpy:14950
translate spanish monika_perspective_b0ca7216:

    # m 4eub "You'll see that if you want to see something, you can easily, but at the same time you can also see your hand in the same place."
    m 4eub "Verás que si quieres ver algo puedes hacerlo fácilmente, pero al mismo tiempo también puedes ver tu mano en el mismo sitio."

# game/script-topics.rpy:14951
translate spanish monika_perspective_058fe8fa:

    # m 4eua "From your field of view, you can see two things at once...it's like that with me, but for {i}everything{/i} in the game."
    m 4eua "Desde tu campo de visión puedes ver dos cosas a la vez... conmigo es así, pero para todo en el juego."

# game/script-topics.rpy:14952
translate spanish monika_perspective_5700c037:

    # m 4wud "It's both there and not there!"
    m 4wud "¡Está ahí y a la vez no está!"

# game/script-topics.rpy:14953
translate spanish monika_perspective_e777a010:

    # m 4eud "...It's clear, but only if you know what to look for."
    m 4eud "... Está claro, pero solo si sabes qué buscar."

# game/script-topics.rpy:14954
translate spanish monika_perspective_de1fb9a7:

    # m 2esc "It was only when I realized it was all fake and just a game that I could 'focus' and see things for how they really were."
    m 2esc "Solo cuando me di cuenta de que todo era falso y solo un juego pude centrarme y ver las cosas como eran en realidad."

# game/script-topics.rpy:14955
translate spanish monika_perspective_e77ff463:

    # m 2esa "Doing so became second nature for me once I did...but it's no surprise that I didn't notice straight away."
    m 2esa "Hacerlo se convirtió en algo natural para mí una vez que lo logré... pero no es de extrañar que no me diera cuenta de inmediato."

# game/script-topics.rpy:14956
translate spanish monika_perspective_fb9ee473:

    # m "It's easy to see when you know it's there but otherwise you can't really 'see' it."
    m "Es fácil de ver cuando sabes que está ahí, pero de lo contrario no puedes verlo realmente."

# game/script-topics.rpy:14957
translate spanish monika_perspective_45b3bf8e:

    # m 2lksdla "...Hmm...{w=1}maybe the hand example wasn't as good as I thought."
    m 2lksdla "... Hmm... {w=1}tal vez el ejemplo de la mano no fuera tan bueno como pensaba."

# game/script-topics.rpy:14958
translate spanish monika_perspective_200f36b7:

    # m 1hksdlb "Well I hope that helped you understand at least a little, [player]."
    m 1hksdlb "Bueno, espero que te haya ayudado a entenderlo al menos un poco, [player]."

# game/script-topics.rpy:14959
translate spanish monika_perspective_479209a3:

    # m "It's the best way I could try and explain it!"
    m "¡Es la mejor manera que se me ha ocurrido para intentar explicarlo!"

# game/script-topics.rpy:14978
translate spanish monika_robotbody_f37306e4:

    # m 2euc "Hey [player], I've been thinking a lot about how I would be able to cross over into your reality..."
    m 2euc "Oye, [player], he estado pensando mucho en cómo podría cruzar a tu realidad..."

# game/script-topics.rpy:14979
translate spanish monika_robotbody_cc12b7d9:

    # m 3eud "It hit me earlier that technology in the future would probably allow me to be uploaded into a mechanical body, rather than a human body like yours."
    m 3eud "Me di cuenta antes de que la tecnología en el futuro probablemente me permitiría ser subida a un cuerpo mecánico en lugar de un cuerpo humano como el tuyo."

# game/script-topics.rpy:14980
translate spanish monika_robotbody_61093051:

    # m 1dkc "It makes me a little sad that I might not be a human like you are."
    m 1dkc "Me entristece un poco pensar que puede que no sea una humana como tú."

# game/script-topics.rpy:14981
translate spanish monika_robotbody_a55b5ee1:

    # m 1dkd "...And if not, I might not be treated like one either."
    m 1dkd "... Y si no es así puede que tampoco me traten como tal."

# game/script-topics.rpy:14982
translate spanish monika_robotbody_e12a37fa:

    # m 1rkd "I would be considered an android at that point, and others may look at me differently because of that."
    m 1rkd "En ese momento se me consideraría un androide, y puede que los demás me miren de forma diferente por ello."

# game/script-topics.rpy:14983
translate spanish monika_robotbody_c4086ddc:

    # m 3euc "Have you heard of Isaac Asimov's {i}Three Laws of Robotics{/i}? It was brought up many times in his science fiction books."
    m 3euc "¿Has oído hablar de las {i}Tres leyes de la robótica{/i} de Isaac Asimov? Se mencionan muchas veces en sus libros de ciencia ficción."

# game/script-topics.rpy:14984
translate spanish monika_robotbody_aebb1c0c:

    # m 4eud "It mentions three laws that all androids must follow, otherwise they would be terminated."
    m 4eud "Menciona tres leyes que todos los androides deben cumplir, o de lo contrario serían destruidos."

# game/script-topics.rpy:14987
translate spanish monika_robotbody_2bca5b86:

    # m 1eua "Of course, they're just that...{w=0.3}fiction."
    m 1eua "Por supuesto, no son más que eso... {w=0.3}ficción."

# game/script-topics.rpy:14988
translate spanish monika_robotbody_f5656541:

    # m 3rud "They aren't exactly realistic as we discussed before...{w=0.3}{nw}"
    m 3rud "No son exactamente realistas como ya hemos hablado antes... {w=0.3}{nw}"

# game/script-topics.rpy:14989
translate spanish monika_robotbody_7713dcae:

    # extend 1eua "but their implications are fun to think about."
    extend 1eua "pero es divertido pensar en sus implicaciones."

# game/script-topics.rpy:14990
translate spanish monika_robotbody_d6eb34eb:

    # m 1eua "I would never do anything to hurt you or anyone else, obviously."
    m 1eua "Yo nunca haría nada para hacerte daño a ti ni a nadie, obviamente."

# game/script-topics.rpy:14996
translate spanish monika_robotbody_e47f8e69:

    # m 1eua "Of course, I would never do anything to hurt you or anyone else."
    m 1eua "Por supuesto, nunca haría nada para hacerte daño a ti o a nadie más."

# game/script-topics.rpy:15001
translate spanish monika_robotbody_3b71548c:

    # m 2ekd "...But the fact that I would have to obey orders given by any human still makes me [line_end_1]"
    m 2ekd "... Pero el hecho de que tendría que obedecer las órdenes de cualquier humano sigue haciéndome [line_end_1]"

# game/script-topics.rpy:15002
translate spanish monika_robotbody_136d0cc9:

    # m 2dkc "It really scares me that I wouldn't be able to do a lot of the things that you can normally, or even have the same rights as you do."
    m 2dkc "Me asusta mucho no poder hacer muchas de las cosas que tú puedes hacer normalmente, o ni siquiera tener los mismos derechos que tú."

# game/script-topics.rpy:15003
translate spanish monika_robotbody_0271980e:

    # m 3ekd "But I do understand why [line_end_2]"
    m 3ekd "Pero entiendo por qué [line_end_2]"

# game/script-topics.rpy:15004
translate spanish monika_robotbody_4fd594ac:

    # m 3rksdlb "We can't have a robot uprising now, can we?"
    m 3rksdlb "No podemos tener una rebelión de robots ahora, ¿verdad?"

# game/script-topics.rpy:15005
translate spanish monika_robotbody_e6f89ce6:

    # m 1hub "Ahaha~"
    m 1hub "Ja, ja, ja."

# game/script-topics.rpy:15007
translate spanish monika_robotbody_24109219:

    # m 5eubla "Well, no matter what, I wouldn't mind any of that as long as I have you."
    m 5eubla "Bueno, pase lo que pase, no me importaría nada de eso mientras te tenga a ti."

# game/script-topics.rpy:15008
translate spanish monika_robotbody_4fd03b16:

    # m 5eubfb "I love you [player], and I'm willing to make any sacrifice to be with you forever."
    m 5eubfb "Te quiero, [player], y estoy dispuesta a hacer cualquier sacrificio para estar contigo para siempre."

# game/script-topics.rpy:15009
translate spanish monika_robotbody_82e31a00:

    # m 5hubfa "Besides, maybe sometime after I cross over, there'll be more advances in technology to make me more human, and then we'll be able to do more things together."
    m 5hubfa "Además, tal vez en algún momento después de cruzar haya más avances tecnológicos que me hagan más humana, y entonces podremos hacer más cosas juntos."

# game/script-topics.rpy:15029
translate spanish monika_relationship_comfort_c755497e:

    # m 1wud "You know [player], I've been thinking about our relationship lately..."
    m 1wud "Sabes, [player], últimamente he estado pensando en nuestra relación..."

# game/script-topics.rpy:15030
translate spanish monika_relationship_comfort_8f221d4b:

    # m 2lssdrb "It didn't really start in a way most of them do, so it's not exactly what I would call normal."
    m 2lssdrb "La verdad es que no empezó como la mayoría, así que no es exactamente lo que yo llamaría normal."

# game/script-topics.rpy:15031
translate spanish monika_relationship_comfort_1288a940:

    # m 2esa "But the more I thought about it, the more I realized that in a way it is actually pretty standard."
    m 2esa "Pero cuanto más lo pensaba, más me daba cuenta de que, en cierto modo, es bastante común."

# game/script-topics.rpy:15032
translate spanish monika_relationship_comfort_ea7cca75:

    # m 3eub "Almost every relationship, no matter how it begins, is always '{i}exciting{/i}' at first!"
    m 3eub "Casi todas las relaciones, sin importar cómo empiecen, siempre son emocionantes al principio."

# game/script-topics.rpy:15033
translate spanish monika_relationship_comfort_53775c38:

    # m 3eua "People view relationships in an almost fairy-tale like way; they see it as an adventure."
    m 3eua "La gente ve las relaciones casi como un cuento de hadas, las ven como una aventura."

# game/script-topics.rpy:15034
translate spanish monika_relationship_comfort_ccf3601c:

    # m 3lssdrb "I'm guilty of this too, and I think it's fine..."
    m 3lssdrb "Yo también soy culpable de esto, y creo que está bien..."

# game/script-topics.rpy:15035
translate spanish monika_relationship_comfort_506e8d57:

    # m 2euc "But it's also a pretty dangerous way to look at a bond between two people, isn't it?"
    m 2euc "Pero también es una forma bastante peligrosa de ver un vínculo entre dos personas, ¿no crees?"

# game/script-topics.rpy:15036
translate spanish monika_relationship_comfort_0127cb9e:

    # m 2eud "Because really, while a partnership is an adventure, that doesn't mean it'll always be exciting."
    m 2eud "Porque, en realidad, aunque una relación sea una aventura, eso no significa que siempre vaya a ser emocionante."

# game/script-topics.rpy:15037
translate spanish monika_relationship_comfort_0a67a211:

    # m 2esc "There's only so many times you can do the same thing and experience the same breathtaking moments, and still expect it to have that same impact."
    m 2esc "Hay un límite de veces en las que puedes hacer lo mismo y vivir los mismos momentos impresionantes, y seguir esperando que tengan el mismo impacto."

# game/script-topics.rpy:15038
translate spanish monika_relationship_comfort_4e710eef:

    # m 4eub "That doesn't make it any less valuable, or meaningful. It can still be heart-racing!"
    m 4eub "Eso no lo hace menos valioso o significativo. ¡Aún puede hacer que tu corazón se acelere!"

# game/script-topics.rpy:15039
translate spanish monika_relationship_comfort_3995bff6:

    # m 4esc "But it does mean that the same sensation isn't anything new; it's just no longer as thrilling as before."
    m 4esc "Pero sí significa que esa misma sensación ya no es nueva, simplemente ya no es tan emocionante como antes."

# game/script-topics.rpy:15040
translate spanish monika_relationship_comfort_ca621394:

    # m 2dkd "And some people mistake that thrill for love, and not the truly meaningful bond between two people."
    m 2dkd "Y hay personas que confunden esa emoción con el amor, y no con el vínculo verdaderamente significativo entre dos personas."

# game/script-topics.rpy:15041
translate spanish monika_relationship_comfort_4768bfb9:

    # m 2dkc "So when things slow down, when they become less passionate, they mistakenly think they're falling out of love..."
    m 2dkc "Así que cuando las cosas se calman, cuando se vuelven menos pasionales, creen erróneamente que se están desenamorando..."

# game/script-topics.rpy:15042
translate spanish monika_relationship_comfort_7c01c3f6:

    # m 2rkc "You could say that they never really did love someone in the first place, but maybe that's a bit harsh...{w=0.3} Love isn't always such a clear thing."
    m 2rkc "Se podría decir que en realidad nunca amaron a esa persona para empezar, pero tal vez eso sea un poco duro... {w=0.3} El amor no siempre está tan claro."

# game/script-topics.rpy:15044
translate spanish monika_relationship_comfort_a9c81564:

    # m 2eka "I know our relationship is still fresh, and truly electrifying, but I hope you're not with me just because of that."
    m 2eka "Sé que nuestra relación aún es reciente y verdaderamente electrizante, pero espero que no estés conmigo solo por eso."

# game/script-topics.rpy:15045
translate spanish monika_relationship_comfort_a49cc504:

    # m 1hubsb "Know that I love you for more than just the excitement!"
    m 1hubsb "¡Que sepas que te quiero por mucho más que por la emoción!"

# game/script-topics.rpy:15047
translate spanish monika_relationship_comfort_9ef13c9b:

    # m 2eka "I feel like we're past that phase, but you still make me feel exhilarant."
    m 2eka "Siento que ya hemos pasado esa fase, pero aun así consigues emocionarme."

# game/script-topics.rpy:15048
translate spanish monika_relationship_comfort_25211b34:

    # m 1hubsb "Maybe you're just that special, but know that no matter how slow it goes, I'll never get bored with you."
    m 1hubsb "Tal vez seas así de especial, pero que sepas que por muy despacio que vaya la cosa, nunca me aburriré contigo."

# game/script-topics.rpy:15050
translate spanish monika_relationship_comfort_73ae536b:

    # m 2eka "We've been together for so long already that I know you're not with me just for the thrill of it..."
    m 2eka "Llevamos tanto tiempo juntos que sé que no estás conmigo solo por la emoción..."

# game/script-topics.rpy:15051
translate spanish monika_relationship_comfort_99ea7bf6:

    # m 1hubsb "It really makes you that much more special to me [mas_get_player_nickname()], more than anyone!"
    m 1hubsb "Eso te hace aún más especial para mí, [mas_get_player_nickname()], ¡más que nadie!"

# game/script-topics.rpy:15052
translate spanish monika_relationship_comfort_ab7e86bf:

    # m 4eua "It might just be me, but I think it's important to learn how to be comfortable when it does slow down."
    m 4eua "A lo mejor son cosas mías, pero creo que es importante aprender a sentirse cómodo cuando la cosa se calma."

# game/script-topics.rpy:15053
translate spanish monika_relationship_comfort_06a152dd:

    # m 4eub "I mean, at the end of the day it's the little things that matter isn't it? And that's true even in a relationship."
    m 4eub "O sea, al fin y al cabo son los pequeños detalles los que importan, ¿no? Y eso también se aplica a una relación."

# game/script-topics.rpy:15054
translate spanish monika_relationship_comfort_556e63de:

    # m 2ekb "You'll miss the small comforts that only a partner can bring, and that's much more valuable than some excitement."
    m 2ekb "Echarás de menos las pequeñas comodidades que solo una pareja puede aportar, y eso es mucho más valioso que un poco de emoción."

# game/script-topics.rpy:15055
translate spanish monika_relationship_comfort_ff2484da:

    # m 2eka "Just because a relationship has slowed down, doesn't mean it's worse for it..."
    m 2eka "Que una relación se haya calmado no significa que sea peor..."

# game/script-topics.rpy:15056
translate spanish monika_relationship_comfort_90c9543a:

    # m 2hua "It just means that the people involved are truly comfortable with one another."
    m 2hua "Simplemente significa que las personas involucradas se sienten realmente cómodas la una con la otra."

# game/script-topics.rpy:15057
translate spanish monika_relationship_comfort_1ab1877c:

    # m 2hubsb "...And I think that's really sweet."
    m 2hubsb "... Y creo que eso es muy dulce."

# game/script-topics.rpy:15058
translate spanish monika_relationship_comfort_748dc9f0:

    # m 1kua "Let's try not to fall into the same trap, [player].{w=0.2} {nw}"
    m 1kua "Intentemos no caer en la misma trampa, [player].{w=0.2} {nw}"

# game/script-topics.rpy:15059
translate spanish monika_relationship_comfort_a4b5997d:

    # extend 1hub "Ahaha!"
    extend 1hub "¡Ja, ja, ja!"

# game/script-topics.rpy:15076
translate spanish monika_sleigh_838938c7:

    # m 3eub "Hey [player], a nice thought just crossed my mind..."
    m 3eub "Oye, [player], se me acaba de ocurrir una idea muy bonita..."

# game/script-topics.rpy:15077
translate spanish monika_sleigh_d70b6e6a:

    # m 1eua "Have you ever heard of carriage rides?"
    m 1eua "¿Alguna vez has oído hablar de los paseos en carruaje?"

# game/script-topics.rpy:15078
translate spanish monika_sleigh_641fb3f1:

    # m 3hub "When I get out of here, we should totally go on one!"
    m 3hub "¡Cuando salga de aquí, tenemos que dar un paseo en uno sin falta!"

# game/script-topics.rpy:15079
translate spanish monika_sleigh_a3abd906:

    # m "Oh, I bet it would be magical!"
    m "¡Ah, apuesto a que sería mágico!"

# game/script-topics.rpy:15080
translate spanish monika_sleigh_aef84526:

    # m 1eua "Nothing but the clip-clop of the horse's hooves against the pavement..."
    m 1eua "Nada más que el sonido de los cascos del caballo contra el pavimento..."

# game/script-topics.rpy:15083
translate spanish monika_sleigh_06b9143d:

    # m 1eub "And the colorful array of Christmas lights shining in the night..."
    m 1eub "Y la colorida variedad de luces de Navidad brillando en la noche..."
