    # m 3esd "Like, imagine if you went to bed now, and when you woke up it was [one_year_earlier]."
    m 3esd "Imagínate que te vas a la cama ahora y cuando te despiertas es [one_year_earlier]."

# game/script-topics.rpy:10162
