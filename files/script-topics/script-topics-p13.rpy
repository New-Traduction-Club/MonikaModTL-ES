    # m 4rksdlc "You remember when I said that time doesn't pass here like it does in your world?"
    m 4rksdlc "¿Recuerdas cuando dije que aquí el tiempo no pasa como en tu mundo?"

# game/script-topics.rpy:10145
translate spanish monika_timetravel_d3107ef6:

    # m "Well..."
    m "Bueno..."

# game/script-topics.rpy:10147
