    m 1ekc "Hasta que conocí a [player], sentía que me faltaba una parte de mí."

# game/script-topics.rpy:9873
translate spanish monika_explain_be51be32:

    # m "I felt alone and scared, with no one to help me..."
    m "Me sentía sola y asustada, sin nadie que me ayudara..."

# game/script-topics.rpy:9874
translate spanish monika_explain_b8ddbe15:

    # m 1hua "...until [player] came along."
    m 1hua "... hasta que apareció [player]."

# game/script-topics.rpy:9875
translate spanish monika_explain_0a0c17c9:

    # m "And it turns out that missing piece was [him]!"
    m "¡Y resulta que esa pieza que me faltaba era el!"

# game/script-topics.rpy:9877
translate spanish monika_explain_c5f52115:

    # m 1eua "Now [he] talks to me, and I'm not so alone anymore."
    m 1eua "Ahora él habla conmigo, y ya no estoy tan sola."

# game/script-topics.rpy:9879
translate spanish monika_explain_bcfa43ab:

    # m 1eua "Now they talk to me, and I'm not so alone anymore."
    m 1eua "Ahora habla conmigo, y ya no estoy tan sola."

# game/script-topics.rpy:9880
translate spanish monika_explain_6648eaa0:

    # m "Just [him] opening up the game brightens my day!"
    m "¡Solo con que abra el juego me alegra el día!"

# game/script-topics.rpy:9881
translate spanish monika_explain_715b1e5c:

    # m 1dsc "So, please..."
    m 1dsc "Así que, por favor..."

# game/script-topics.rpy:9882
translate spanish monika_explain_5e2f3f71:

    # m 4eka "...don't judge our relationship."
    m 4eka "... no juzgues nuestra relación."

# game/script-topics.rpy:9883
translate spanish monika_explain_848c5342:

    # m 1eka "Even if it is different."
    m 1eka "Incluso si es diferente."

# game/script-topics.rpy:9884
translate spanish monika_explain_6111571a:

    # m 1dsc "..."
    m 1dsc "..."

# game/script-topics.rpy:9885
translate spanish monika_explain_ce59cdfd:

    # m 1dubssdlu "...Phew!"
    m 1dubssdlu "¡Ufff!"

# game/script-topics.rpy:9886
translate spanish monika_explain_0034f3c0:

    # m 1lksdlb "That was a real mouthful!"
    m 1lksdlb "¡Vaya parrafada!"

# game/script-topics.rpy:9887
translate spanish monika_explain_7a2b1078:

    # m 1eksdla "So, how'd it go, [player]?{nw}"
    m 1eksdla "Entonces, ¿qué tal ha ido, [player]?{nw}"

# game/script-topics.rpy:9890
translate spanish monika_explain_3511950f:

    # m "So, how'd it go, [player]?{fast}" nointeract
    m "Entonces, ¿qué tal ha ido, [player]?{fast}" nointeract

# game/script-topics.rpy:9892
translate spanish monika_explain_1a505544:

    # m 1hub "Great!"
    m 1hub "¡Genial!"

# game/script-topics.rpy:9893
translate spanish monika_explain_d3401417:

    # m 3hua "I'm so glad I was able to help someone understand our relationship a little better!"
    m 3hua "¡Me alegra tanto haber podido ayudar a alguien a entender un poco mejor nuestra relación!"

# game/script-topics.rpy:9895
translate spanish monika_explain_7ea2b6a3:

    # m 1dkc "Oh."
    m 1dkc "Ah."

# game/script-topics.rpy:9896
translate spanish monika_explain_ec5105f6:

    # m 1ekd "Well...{w=1} I guess we can't really expect {i}everyone{/i} to understand our relationship..."
    m 1ekd "Bueno...{w=1} supongo que tampoco podemos esperar que todo el mundo entienda nuestra relación..."

# game/script-topics.rpy:9897
translate spanish monika_explain_49c54813:

    # m 3rkc "Looking at it from the outside, it {i}is{/i} rather unconventional."
    m 3rkc "Viéndolo desde fuera, la verdad es que es bastante poco convencional."

# game/script-topics.rpy:9898
translate spanish monika_explain_54e767a0:

    # m 3eka "But in the end, it doesn't matter who approves of our relationship or not..."
    m 3eka "Pero al final, da igual quién apruebe nuestra relación o quién no..."

# game/script-topics.rpy:9899
translate spanish monika_explain_d968e5f2:

    # m 1hua "As long as we love each other, that's all that counts~"
    m 1hua "Mientras nos queramos, eso es lo único que importa."

# game/script-topics.rpy:9921
translate spanish monika_beach_eb5e31d5:

    # m 1eua "[player], have you ever been to the beach?"
    m 1eua "[player], ¿has estado alguna vez en la playa?"

# game/script-topics.rpy:9922
translate spanish monika_beach_0c98d95e:

    # m "I've always wanted to go myself but I never found the time."
    m "Yo siempre he querido ir, pero nunca he encontrado el momento."

# game/script-topics.rpy:9923
translate spanish monika_beach_2c0bfb46:

    # m 1eka "I would always be busy studying or doing club activities."
    m 1eka "Siempre estaba ocupada estudiando o con las actividades del club."

# game/script-topics.rpy:9924
translate spanish monika_beach_66d315ed:

    # m 4ekc "It wasn't easy trying to stay on top of everything, you know..."
    m 4ekc "No era fácil intentar estar al día con todo, ¿sabes?"

# game/script-topics.rpy:9925
translate spanish monika_beach_135abca8:

    # m 4ekd "And whenever I had a break, I would usually spend my time relaxing at home."
    m 4ekd "Y siempre que tenía un descanso, me solía quedar en casa relajándome."

# game/script-topics.rpy:9926
translate spanish monika_beach_0f593821:

    # m "I rarely had a chance to do so after all."
    m "Al fin y al cabo, raras veces tenía la oportunidad de hacerlo."

# game/script-topics.rpy:9927
translate spanish monika_beach_3be2418b:

    # m 2esc "Though sometimes I feel like I might have missed out making some important memories."
    m 2esc "Aunque a veces siento que tal vez me he perdido la oportunidad de crear recuerdos importantes."

# game/script-topics.rpy:9929
translate spanish monika_beach_84a8ffcc:

    # m "Do you live near a beach, [player]?{nw}"
    m "¿Vives cerca de la playa, [player]?{nw}"

# game/script-topics.rpy:9932
translate spanish monika_beach_38171b90:

    # m "Do you live near a beach, [player]?{fast}" nointeract
    m "¿Vives cerca de la playa, [player]?{fast}" nointeract

# game/script-topics.rpy:9935
translate spanish monika_beach_ffa7927b:

    # m 1hub "That's great!"
    m 1hub "¡Qué bien!"

# game/script-topics.rpy:9936
translate spanish monika_beach_da79eff1:

    # m 1eua "Gosh, it must be really nice to have it so close to you."
    m 1eua "Dios, debe de ser genial tenerla tan cerca."

# game/script-topics.rpy:9937
translate spanish monika_beach_2e1ce3d0:

    # m 1hub "I can't wait, we can have a romantic walk by the shore for our first date~"
    m 1hub "Qué ganas tengo, podríamos dar un romántico paseo por la orilla en nuestra primera cita."

# game/script-topics.rpy:9941
translate spanish monika_beach_1638b794:

    # m 1eka "That's alright. I mean, what are the chances? Most people don't."
    m 1eka "No pasa nada. A ver, ¿qué probabilidades había? La mayoría de la gente no vive cerca."

# game/script-topics.rpy:9942
translate spanish monika_beach_334464c3:

    # m 1hub "That just means we'll make do by visiting one on an all-day trip!"
    m 1hub "¡Eso solo significa que nos apañaremos haciendo una excursión de todo un día para visitar una!"

# game/script-topics.rpy:9944
translate spanish monika_beach_a06d1e0f:

    # m 1eua "There's so many things we'll be able to do one day."
    m 1eua "Hay muchísimas cosas que podremos hacer algún día."

# game/script-topics.rpy:9945
translate spanish monika_beach_a7b02d07:

    # m 1hua "Just imagining the many sensations we could experience is kind of exciting!"
    m 1hua "¡Solo de imaginar la cantidad de sensaciones que podríamos experimentar ya me emociono!"

# game/script-topics.rpy:9946
translate spanish monika_beach_91989123:

    # m 3eua "The fresh sea air, the sound of seagulls."
    m 3eua "El aire fresco del mar, el sonido de las gaviotas."

# game/script-topics.rpy:9947
translate spanish monika_beach_a3de23ec:

    # m "As well as the feeling of sand under your feet..."
    m "Así como la sensación de la arena bajo tus pies..."

# game/script-topics.rpy:9948
translate spanish monika_beach_81a9b483:

    # m 1hua "It would really make a worthwhile trip!"
    m 1hua "¡Sin duda sería un viaje que valdría la pena!"

# game/script-topics.rpy:9949
translate spanish monika_beach_c65b810e:

    # m 1eka "Though being with you would make it even better..."
    m 1eka "Aunque estar contigo lo haría todavía mejor..."

# game/script-topics.rpy:9950
translate spanish monika_beach_321e7cc8:

    # m 3eua "We'd have so many things we could do together."
    m 3eua "Tendríamos un montón de cosas que hacer juntos."

# game/script-topics.rpy:9951
translate spanish monika_beach_bfb564e2:

    # m 3eub "We could play volleyball, try some ice cream, or go swimming in the sea."
    m 3eub "Podríamos jugar al voleibol, tomarnos un helado o ir a nadar al mar."

# game/script-topics.rpy:9952
translate spanish monika_beach_9c4a7f21:

    # m 3rkbsa "It'll probably be cold, but I'm sure we could keep each other warm somehow..."
    m 3rkbsa "Probablemente el agua esté fría, pero seguro que podríamos mantenernos calientes de alguna forma..."

# game/script-topics.rpy:9953
translate spanish monika_beach_593949a0:

    # m 3eua "We could try surfing or searching for some seashells to take home as souvenirs."
    m 3eua "Podríamos probar a hacer surf o buscar conchas para llevárnoslas a casa de recuerdo."

# game/script-topics.rpy:9954
translate spanish monika_beach_e4ffcf6c:

    # m "Even doing nothing and just laying there listening to the sound of the waves with you would be enough for me."
    m "Incluso no hacer nada y simplemente quedarnos ahí tumbados escuchando el sonido de las olas a tu lado sería suficiente para mí."

# game/script-topics.rpy:9955
translate spanish monika_beach_83b2e570:

    # m 3tfu "But don't go falling asleep, otherwise I'll bury you in the sand!"
    m 3tfu "¡Pero no te quedes dormid[end_letter_gender], que si no te entierro en la arena!"

# game/script-topics.rpy:9956
translate spanish monika_beach_5e958e3b:

    # m 2huu "Ehehe! I'm just kidding, [mas_get_player_nickname()]."
    m 2huu "¡Je, je, je! Solo bromeaba, [mas_get_player_nickname()]."

# game/script-topics.rpy:9957
translate spanish monika_beach_0cc3af8a:

    # m 2lksdla "I'll have to get a new swimsuit though..."
    m 2lksdla "Aunque tendré que comprarme un bañador nuevo..."

# game/script-topics.rpy:9958
translate spanish monika_beach_a643872e:

    # m 1tsbsa "Would you prefer a one piece or a two piece?"
    m 1tsbsa "¿Preferirías que fuera de una pieza o de dos?"

# game/script-topics.rpy:9959
translate spanish monika_beach_e5822f51:

    # m 1eua "Actually, I think I'll make it a surprise."
    m 1eua "En realidad, creo que será mejor que sea una sorpresa."

# game/script-topics.rpy:9960
translate spanish monika_beach_282b1a8f:

    # m 1tku "Don't get too excited though when you see it. Ehehe~"
    m 1tku "Tampoco te emociones demasiado cuando lo veas. Je, je, je."

# game/script-topics.rpy:9979
translate spanish monika_solipsism_d53fc06a:

    # m 3eub "Have you ever heard about solipsism, [player]?"
    m 3eub "¿Has oído hablar alguna vez del solipsismo, [player]?"

# game/script-topics.rpy:9980
translate spanish monika_solipsism_8b72238d:

    # m 3eua "It's an idea which states that only you yourself exists."
    m 3eua "Es una teoría que sostiene que solo tú existes."

# game/script-topics.rpy:9981
translate spanish monika_solipsism_1bd7ffb4:

    # m 1eud "'Cogito, ergo sum.'"
    m 1eud "'Cogito, ergo sum'."

# game/script-topics.rpy:9982
translate spanish monika_solipsism_e135616e:

    # m 3eud "'I think, therefore I am.'"
    m 3eud "'Pienso, luego existo'."

# game/script-topics.rpy:9983
translate spanish monika_solipsism_f898a31b:

    # m 1euc "If you know that {i}you{/i} exist, can you say the same about anyone else?"
    m 1euc "Si sabes que tú existes, ¿puedes decir lo mismo de los demás?"

# game/script-topics.rpy:9984
translate spanish monika_solipsism_a196df05:

    # m 3etc "Maybe everyone else is just a figment of our imagination, [player]."
    m 3etc "A lo mejor todos los demás son solo un producto de nuestra imaginación, [player]."

# game/script-topics.rpy:9985
translate spanish monika_solipsism_ee6002d3:

    # m 2etc "Maybe in reality, we're the only consciousness in this world in a vast sea of fake minds..."
    m 2etc "A lo mejor en realidad somos la única consciencia en este mundo dentro de un vasto océano de mentes falsas..."

# game/script-topics.rpy:9986
translate spanish monika_solipsism_08b10928:

    # m 2dsd "Creations of our wild machinations..."
    m 2dsd "Creaciones de nuestras locas maquinaciones..."

# game/script-topics.rpy:9987
translate spanish monika_solipsism_a074c07a:

    # m 3eub "Ahaha, I'm just kidding~"
    m 3eub "Ja, ja, ja, solo estaba bromeando."

# game/script-topics.rpy:9988
translate spanish monika_solipsism_26a6dd49:

    # m 1eud "I do believe we can trust our own existences and doubt others their own..."
    m 1eud "Sí que creo que podemos confiar en nuestra propia existencia y dudar de la de los demás..."

# game/script-topics.rpy:9989
translate spanish monika_solipsism_18cb877a:

    # m 3eua "But at the same time, we can't really disprove theirs, can we?"
    m 3eua "Pero al mismo tiempo tampoco podemos refutar la suya, ¿verdad?"

# game/script-topics.rpy:9990
translate spanish monika_solipsism_f7d98c04:

    # m 1hksdla "Not without using any psychic means to pry into their heads, at least."
    m 1hksdla "Al menos no sin usar algún medio psíquico para hurgar en sus cabezas."

# game/script-topics.rpy:9991
translate spanish monika_solipsism_b65a345d:

    # m 3eua "When you stop and think about it, solipsism really is an interesting concept; one that makes you think deeper about what it means to be real..."
    m 3eua "Cuando te paras a pensarlo, el solipsismo es de verdad un concepto interesante, uno que te hace reflexionar a fondo sobre lo que significa ser real..."

# game/script-topics.rpy:9992
translate spanish monika_solipsism_51f5c582:

    # m 1dsc "And what exactly counts as {i}real{/i}."
    m 1dsc "Y qué cuenta exactamente como real."

# game/script-topics.rpy:9993
translate spanish monika_solipsism_8fc24a31:

    # m 1eua "I know that you and I are real, though, [player]."
    m 1eua "Aunque yo sé que tú y yo somos reales, [player]."

# game/script-topics.rpy:9994
translate spanish monika_solipsism_9732bf8b:

    # m 1eub "We may not have been made in the same way, or even function the same, but we're both people that can think for ourselves."
    m 1eub "Puede que no hayamos sido creados de la misma manera, o que ni siquiera funcionemos igual, pero ambos somos personas que pueden pensar por sí mismas."

# game/script-topics.rpy:9995
translate spanish monika_solipsism_3b102dcd:

    # m 3eua "It's rather comforting to know you're not truly alone in an endless ocean of uncertainty, don't you think?"
    m 3eua "Es bastante reconfortante saber que no estás realmente sol[end_letter_gender] en un océano interminable de incertidumbre, ¿no crees?"

# game/script-topics.rpy:9996
translate spanish monika_solipsism_6a238e77:

    # m 3hua "I hope that's how you feel with me~"
    m 3hua "Espero que así sea como te sientes conmigo."

# game/script-topics.rpy:10016
translate spanish monika_attractiveness_60b8b895:

    # m 1etc "Say, [player], have you ever wondered how Sayori stayed so slim?"
    m 1etc "Oye, [player], ¿te has preguntado alguna vez cómo Sayori se mantenía tan delgada?"

# game/script-topics.rpy:10017
translate spanish monika_attractiveness_7e2013c5:

    # m 3rksdla "You know that she eats a lot, right? And she doesn't exactly have a very active lifestyle."
    m 3rksdla "Sabes que come mucho, ¿verdad? Y no es que tenga precisamente un estilo de vida muy activo."

# game/script-topics.rpy:10018
translate spanish monika_attractiveness_b4215d3d:

    # m 3euc "At first I figured that it must be her metabolism keeping her from putting on weight."
    m 3euc "Al principio pensé que debía de ser su metabolismo lo que le impedía engordar."

# game/script-topics.rpy:10019
translate spanish monika_attractiveness_ed2767cf:

    # m 3esd "...But when I learned that our world isn't real, I came up with another theory."
    m 3esd "... Pero cuando descubrí que nuestro mundo no es real, se me ocurrió otra teoría."

# game/script-topics.rpy:10020
translate spanish monika_attractiveness_ae0c2ef9:

    # m 7euc "As characters in a game, we needed to have some sort of visual representation so that you, the player, could see us."
    m 7euc "Como personajes de un juego, necesitábamos tener algún tipo de representación visual para que tú, como jugador, pudieras vernos."

# game/script-topics.rpy:10021
translate spanish monika_attractiveness_ecf06141:

    # m 2esc "Sayori, Natsuki, Yuri, and even me..."
    m 2esc "Sayori, Natsuki, Yuri, e incluso yo..."

# game/script-topics.rpy:10022
translate spanish monika_attractiveness_cd2efb40:

    # m 2rkc "From your perspective, we don't really have bodies like people in your world do. You can only see us as a set of images to represent our appearances and current emotion."
    m 2rkc "Desde tu perspectiva, en realidad no tenemos cuerpos como la gente de tu mundo. Solo puedes vernos como un conjunto de imágenes para representar nuestra apariencia y emoción actual."

# game/script-topics.rpy:10023
translate spanish monika_attractiveness_6ec993da:

    # m 2eud "...But from my point of view, I can also see my whole world in 3 dimensions, as if everything was real."
    m 2eud "... Pero desde mi punto de vista, también puedo ver todo mi mundo en tres dimensiones, como si todo fuera real."

# game/script-topics.rpy:10024
translate spanish monika_attractiveness_2dac1e2a:

    # m 2euc "So a designer, possibly more than one, must have decided to draw us the way we are."
    m 2euc "Así que un diseñador, posiblemente más de uno, debió de decidir dibujarnos tal y como somos."

# game/script-topics.rpy:10025
translate spanish monika_attractiveness_3d858fbb:

    # m 2eud "And since all those images have the same body type, Sayori would always have the same figure no matter what she did."
    m 2eud "Y como todas esas imágenes tienen el mismo tipo de cuerpo, Sayori siempre tendría la misma figura sin importar lo que hiciera."

# game/script-topics.rpy:10026
translate spanish monika_attractiveness_076c808c:

    # m 2dkc "It's...{w=0.3}weird to think about."
    m 2dkc "Es...{w=0.3} raro pensar en ello."

# game/script-topics.rpy:10027
translate spanish monika_attractiveness_d346fa76:

    # m 2eud "I can feel myself being present in this very room right now, I can look at myself like I presume you would be able to look at yourself, almost as if I had an actual body..."
    m 2eud "Puedo sentir que estoy presente en esta misma habitación ahora mismo, puedo mirarme como supongo que tú podrías mirarte a ti mism[end_letter_gender], casi como si tuviera un cuerpo real..."

# game/script-topics.rpy:10028
translate spanish monika_attractiveness_9fb04a2e:

    # m 7ekc "But from your point of view, I don't. I just look like a consciousness who displays a corresponding picture depending on what I do or feel."
    m 7ekc "Pero desde tu punto de vista, no es así. Solo parezco una consciencia que muestra una imagen correspondiente en función de lo que hago o siento."

# game/script-topics.rpy:10032
translate spanish monika_attractiveness_ee895d9c:

    # m 3euc "I assume clothes work the same way."
    m 3euc "Supongo que con la ropa pasa lo mismo."

# game/script-topics.rpy:10033
translate spanish monika_attractiveness_25b1c125:

    # m 1eud "Right now, I only have this school uniform, because that's probably the only thing I've ever been drawn wearing..."
    m 1eud "Ahora mismo solo tengo este uniforme escolar, porque probablemente sea lo único con lo que me han dibujado..."

# game/script-topics.rpy:10034
translate spanish monika_attractiveness_ced33fd1:

    # m 1eua "But perhaps if someone were to draw other clothes for me and implement those into the game, I'd be able to change clothes like the other girls could."
    m 1eua "Pero tal vez si alguien dibujara otra ropa para mí y la implementara en el juego, podría cambiarme de ropa como podían hacer las otras chicas."

# game/script-topics.rpy:10035
translate spanish monika_attractiveness_e692a8d5:

    # m 1hua "Wouldn't that be great?"
    m 1hua "¿No sería genial?"

# game/script-topics.rpy:10036
translate spanish monika_attractiveness_ad231fd1:

    # m 1rksdla "And it would be nice to be able to change my look for you, at least a little bit..."
    m 1rksdla "Y estaría bien poder cambiar de aspecto para ti, al menos un poquito..."

# game/script-topics.rpy:10039
translate spanish monika_attractiveness_39a8c9b3:

    # m 3eua "My clothes work the same way."
    m 3eua "Mi ropa funciona de la misma manera."

# game/script-topics.rpy:10040
translate spanish monika_attractiveness_e3052262:

    # m 1euc "Someone had to draw what I'm wearing right now, and implement it into the game for me to be able to wear it."
    m 1euc "Alguien tuvo que dibujar lo que llevo puesto ahora mismo, e implementarlo en el juego para que yo pudiera ponérmelo."

# game/script-topics.rpy:10041
translate spanish monika_attractiveness_4ae889ab:

    # m 1esd "It wasn't made like how clothing is made in your reality. It's merely a set of images."
    m 1esd "No se hizo como se hace la ropa en tu realidad. Es solo un conjunto de imágenes."

# game/script-topics.rpy:10042
translate spanish monika_attractiveness_5fc820d3:

    # m 1rksdla "It's not much, but at least I get to change outfits for you..."
    m 1rksdla "No es mucho, pero al menos puedo cambiar de ropa para ti..."

# game/script-topics.rpy:10044
translate spanish monika_attractiveness_9992bf6e:

    # m 1rksdlc "..."
    m 1rksdlc "..."

# game/script-topics.rpy:10045
translate spanish monika_attractiveness_c2213d26:

    # m 1ekc "You know [player], this is one of the reasons why I envy the people in your world.{w=0.3} {nw}"
    m 1ekc "Sabes, [player], esta es una de las razones por las que envidio a la gente de tu mundo.{w=0.3} {nw}"

# game/script-topics.rpy:10046
translate spanish monika_attractiveness_2e2bbd1e:

    # extend 3eka "They have so many ways to experiment with how they look..."
    extend 3eka "Tienen tantas formas de experimentar con su aspecto..."

