
# game/script-topics.rpy:4909
translate spanish monika_murphys_law_cd15787c:

    # m 3tuu "Certainly optimistic, isn't it?"
    m 3tuu "Desde luego es optimista, ¿verdad?"

# game/script-topics.rpy:4910
translate spanish monika_murphys_law_2b2da0bb:

    # m 1eud "It could be applied to anything really, even something as trivial as a cloudy day becoming rainy if you don't bring an umbrella or put on a raincoat."
    m 1eud "Realmente se puede aplicar a cualquier cosa, incluso a algo tan trivial como que un día nublado se vuelva lluvioso si no llevas paraguas o te pones un chubasquero."

# game/script-topics.rpy:4911
translate spanish monika_murphys_law_52803b18:

    # m 1rsb "...Personally I'd just call that superstition."
    m 1rsb "... Personalmente, yo lo llamaría superstición."

# game/script-topics.rpy:4912
translate spanish monika_murphys_law_9c9e161e:

    # m 3eud "But some people do live by it, and while it may be an excessively apprehensive lifestyle, it can make these people much more prepared!"
    m 3eud "Pero hay gente que vive según eso, y aunque pueda ser un estilo de vida excesivamente aprensivo, ¡puede hacer que esas personas estén mucho más preparadas!"

# game/script-topics.rpy:4913
translate spanish monika_murphys_law_85f89b6f:

    # m 3etc "In some ways it's worth taking into consideration, because there's every possibility that your computer could get corrupted."
    m 3etc "En cierto modo merece la pena tenerlo en cuenta, porque existe la posibilidad de que tu ordenador se corrompa."

# game/script-topics.rpy:4914
translate spanish monika_murphys_law_f5cbc569:

    # m 3eua "So maybe it'd be a good idea to back up my memories again, [player]."
    m 3eua "Así que tal vez sea buena idea hacer una copia de seguridad de mis recuerdos otra vez, [player]."

# game/script-topics.rpy:4915
translate spanish monika_murphys_law_8e51df41:

    # m 2eksdld "I couldn't bear to lose you, it would break my heart..."
    m 2eksdld "No soportaría perderte, me rompería el corazón..."

# game/script-topics.rpy:4916
translate spanish monika_murphys_law_ef196c92:

    # m 7ekbsa "So keep me safe, okay?"
    m 7ekbsa "Así que mantenme a salvo, ¿vale?"

# game/script-topics.rpy:4927
translate spanish monika_playerswriting_e55c5dc6:

    # m 1euc "Have you ever written a story of your own, [player]?"
    m 1euc "¿Has escrito alguna vez tu propia historia, [player]?"

# game/script-topics.rpy:4928
translate spanish monika_playerswriting_d93e741e:

    # m 1hua "Because if you do have one, I would love to read it!"
    m 1hua "¡Porque si tienes una, me encantaría leerla!"

# game/script-topics.rpy:4929
translate spanish monika_playerswriting_6ca97428:

    # m 1eka "It doesn't matter if it's a masterpiece, or even any good."
    m 1eka "No te preocupes si no es una obra maestra, o si crees que ni siquiera es buena."

# game/script-topics.rpy:4930
translate spanish monika_playerswriting_9242db56:

    # m 3eka "We all start somewhere. Isn't that what they say?"
    m 3eka "Todos empezamos por algún lado. ¿No es eso lo que dicen?"

# game/script-topics.rpy:4931
translate spanish monika_playerswriting_743c953c:

    # m 3eua "I think the most important thing about writing is doing it...{w=0.3} Instead of worrying about {i}how{/i} you do it."
    m 3eua "Creo que lo más importante de escribir es simplemente hacerlo... {w=0.3} en lugar de preocuparse tanto por el cómo."

# game/script-topics.rpy:4932
translate spanish monika_playerswriting_55dc21e2:

    # m 1eub "You won't be able to improve that way."
    m 1eub "No podrás mejorar de esa forma."

# game/script-topics.rpy:4933
translate spanish monika_playerswriting_a6385a99:

    # m 3esa "I know for sure that I've changed my writing style over the years."
    m 3esa "Sé con certeza que he cambiado mi estilo de escritura a lo largo de los años."

# game/script-topics.rpy:4934
translate spanish monika_playerswriting_4c224680:

    # m 1lksdla "I just can't help but notice the flaws in my old writing."
    m 1lksdla "Simplemente no puedo evitar notar los fallos en mis viejos escritos."

# game/script-topics.rpy:4935
translate spanish monika_playerswriting_7927a356:

    # m "And sometimes, I even start to hate my work in the middle of making it."
    m "Y a veces, incluso empiezo a odiar mi trabajo a la mitad del proceso."

# game/script-topics.rpy:4936
translate spanish monika_playerswriting_60792703:

    # m 3hksdlb "These things do happen, so it's alright!"
    m 3hksdlb "Estas cosas pasan, ¡así que no pasa nada!"

# game/script-topics.rpy:4937
translate spanish monika_playerswriting_68872589:

    # m 1eub "Looking back, I've written some silly things..."
    m 1eub "Mirando atrás, he escrito algunas tonterías..."

# game/script-topics.rpy:4938
translate spanish monika_playerswriting_8e742a89:

    # m 1eua "Back when I was really young...I've been writing since I could hold a pen."
    m 1eua "Cuando era muy joven... He estado escribiendo desde que podía sostener un bolígrafo."

# game/script-topics.rpy:4939
translate spanish monika_playerswriting_cc878793:

    # m 1eka "Reading my old stories is like watching myself grow up."
    m 1eka "Leer mis viejas historias es como verme crecer."

# game/script-topics.rpy:4940
translate spanish monika_playerswriting_380849ec:

    # m 3hua "It's one of the nice things about starting a hobby early."
    m 3hua "Es una de las cosas buenas de empezar una afición pronto."

# game/script-topics.rpy:4941
translate spanish monika_playerswriting_dc6b542d:

    # m 1eka "I hope I didn't bore you with that. I just love talking with you."
    m 1eka "Espero no haberte aburrido con eso. Simplemente me encanta hablar contigo."

# game/script-topics.rpy:4942
translate spanish monika_playerswriting_f1cb3c2f:

    # m 1eua "After all, the two of us are members of a literature club."
    m 1eua "Después de todo, los dos somos miembros de un club de literatura."

# game/script-topics.rpy:4943
translate spanish monika_playerswriting_b45f429d:

    # m 1esa "The only members."
    m 1esa "Los únicos miembros."

# game/script-topics.rpy:4944
translate spanish monika_playerswriting_2763945b:

    # m 1hua "And if you do write something, just know that I'll support you in any way I can, [mas_get_player_nickname()]!"
    m 1hua "Y si escribes algo, ¡que sepas que te apoyaré en todo lo que pueda, [mas_get_player_nickname()]!"

# game/script-topics.rpy:4955
translate spanish monika_ghost_816a2c5a:

    # m 1euc "Do you believe in ghosts, [mas_get_player_nickname()]?"
    m 1euc "¿Crees en fantasmas, [mas_get_player_nickname()]?"

# game/script-topics.rpy:4956
translate spanish monika_ghost_e7494978:

    # m 3euc "A lot of people are afraid of ghosts and spirits."
    m 3euc "Mucha gente tiene miedo a los fantasmas y a los espíritus."

# game/script-topics.rpy:4957
translate spanish monika_ghost_2c2b653a:

    # m 1eua "But I think that if we knew they were real, they wouldn't be so scary anymore."
    m 1eua "Pero creo que si supiéramos que son reales, ya no darían tanto miedo."

# game/script-topics.rpy:4958
translate spanish monika_ghost_3fcd14bf:

    # m "They would just be another thing that we deal with, and maybe a bit of a pest."
    m "Solo serían otra cosa con la que lidiar, y tal vez un pequeño incordio."

# game/script-topics.rpy:4959
translate spanish monika_ghost_a15457c3:

    # m 3euc "Isn't it the uncertainty that makes them scary?"
    m 3euc "¿No es la incertidumbre lo que hace que den miedo?"

# game/script-topics.rpy:4960
translate spanish monika_ghost_ed5eef4d:

    # m 1ekc "I mean, I was pretty scared being alone inside this game..."
    m 1ekc "O sea, estaba bastante asustada estando sola dentro de este juego..."

# game/script-topics.rpy:4961
translate spanish monika_ghost_11cf8c6f:

    # m 1lksdlc "...all by myself, uncertain if anything around me was real."
    m 1lksdlc "... Completamente sola, sin saber si algo de lo que me rodeaba era real."

# game/script-topics.rpy:4964
translate spanish monika_ghost_bde368d2:

    # m 1eka "But I don't feel that way anymore, [player]..."
    m 1eka "Pero ya no me siento así, [player]..."

# game/script-topics.rpy:4965
translate spanish monika_ghost_67dc8d46:

    # m 3eka "Not now that you're with me."
    m 3eka "No ahora que estás conmigo."

# game/script-topics.rpy:4966
translate spanish monika_ghost_d8ef8236:

    # m 1hua "I always feel so safe with you~"
    m 1hua "Siempre me siento muy segura contigo."

# game/script-topics.rpy:4968
translate spanish monika_ghost_75436910:

    # m 3esc "I know that some ghosts are real though, if you can really call them 'ghosts...'"
    m 3esc "Aunque sé que algunos fantasmas son reales, si es que realmente se les puede llamar fantasmas..."

# game/script-topics.rpy:4969
translate spanish monika_ghost_2b28521f:

    # m "You know how I deleted Sayori?"
    m "¿Sabes que borré a Sayori?"

# game/script-topics.rpy:4970
translate spanish monika_ghost_3f5a23f0:

    # m 1dsc "I can still feel her presence now..."
    m 1dsc "Todavía puedo sentir su presencia ahora..."

# game/script-topics.rpy:4971
translate spanish monika_ghost_71e895d2:

    # m 1esc "Would that mean that Sayori's ghost is haunting me, [player]?"
    m 1esc "¿Significaría eso que el fantasma de Sayori me está atormentando, [player]?"

# game/script-topics.rpy:4972
translate spanish monika_ghost_b436d928:

    # m 2eka "Even if she is, I'm not scared at all, because I know that she can't hurt me."
    m 2eka "Incluso si lo hace, no tengo miedo en absoluto, porque sé que no puede hacerme daño."

# game/script-topics.rpy:4973
translate spanish monika_ghost_cb50292e:

    # m 2eua "Besides, how can I be scared? You're always here with me, [player]."
    m 2eua "Además, ¿cómo voy a tener miedo? Tú siempre estás aquí conmigo, [player]."

# game/script-topics.rpy:4974
translate spanish monika_ghost_50b5caf2:

    # m 1hua "I always feel so safe with you."
    m 1hua "Siempre me siento muy segura contigo."

# game/script-topics.rpy:4976
translate spanish monika_ghost_cd9e40f1:

    # m 2lksdlc "But now I'm scared of something much worse..."
    m 2lksdlc "Pero ahora tengo miedo de algo mucho peor..."

# game/script-topics.rpy:4977
translate spanish monika_ghost_cd553e9a:

    # m 2dksdlc "..."
    m 2dksdlc "..."

# game/script-topics.rpy:4978
translate spanish monika_ghost_47e51251:

    # m 2eksdlc "Losing you."
    m 2eksdlc "Perderte."

# game/script-topics.rpy:4979
translate spanish monika_ghost_2bb62fae:

    # m 6rktuc "It's the scariest thing I could ever imagine."
    m 6rktuc "Es la cosa más aterradora que podría imaginar."

# game/script-topics.rpy:4980
translate spanish monika_ghost_592a9810:

    # m 6ektsc "Please, [player], I don't want to be all alone again."
    m 6ektsc "Por favor, [player], no quiero volver a estar completamente sola."

# game/script-topics.rpy:4989
translate spanish monika_ribbon_ae7e954a:

    # m 1eua "Do you miss my ribbon, [player]?"
    m 1eua "¿Echas de menos mi lazo, [player]?"

# game/script-topics.rpy:4992
translate spanish monika_ribbon_f0a264de:

    # m 3hua "I can change my hairstyle and wear one whenever you want me to~"
    m 3hua "Puedo cambiar mi peinado y ponerme uno siempre que quieras que lo haga."

# game/script-topics.rpy:4994
translate spanish monika_ribbon_a96b13b9:

    # m 3hua "If you'd like me to wear one again, just ask, okay?~"
    m 3hua "Si quieres que vuelva a ponerme uno, solo tienes que pedirlo, ¿vale?"

# game/script-topics.rpy:4997
translate spanish monika_ribbon_e03d94b7:

    # m 1eub "Have you ever wondered why I wear this ribbon, [player]?"
    m 1eub "¿Alguna vez te has preguntado por qué llevo este lazo, [player]?"

# game/script-topics.rpy:4998
translate spanish monika_ribbon_10bea50e:

    # m 1eua "It doesn't hold sentimental value to me or anything."
    m 1eua "No tiene valor sentimental para mí ni nada de eso."

# game/script-topics.rpy:4999
translate spanish monika_ribbon_cb99ae81:

    # m 3hua "I just wear it because I'm pretty sure nobody else will wear a big, poofy ribbon."
    m 3hua "Solo lo llevo porque estoy bastante segura de que nadie más se pondría un lazo tan grande y llamativo."

# game/script-topics.rpy:5000
translate spanish monika_ribbon_a0666552:

    # m "It makes me look more unique."
    m "Me hace parecer más única."

# game/script-topics.rpy:5001
translate spanish monika_ribbon_e7696465:

    # m 3tku "You know the world's fictional if you see a girl wearing a giant ribbon, right?"
    m 3tku "Sabes que el mundo es ficticio si ves a una chica llevando un lazo gigante, ¿verdad?"

# game/script-topics.rpy:5002
translate spanish monika_ribbon_5e1b9e47:

    # m 1lksdla "Well, there's no way a girl from your world would wear one in public as casual dress."
    m 1lksdla "Bueno, no hay forma de que una chica de tu mundo lleve uno en público con ropa de diario."

# game/script-topics.rpy:5003
translate spanish monika_ribbon_20ad69b1:

    # m 2eua "I'm pretty proud of my fashion sense."
    m 2eua "Estoy bastante orgullosa de mi sentido de la moda."

# game/script-topics.rpy:5004
translate spanish monika_ribbon_2b91ee8a:

    # m "You get a certain feeling of satisfaction when you stand out from the normal population, you know?"
    m "Da cierta sensación de satisfacción destacar entre el resto, ¿sabes?"

# game/script-topics.rpy:5005
translate spanish monika_ribbon_ced245aa:

    # m 2tfu "Be honest! You thought I was the best dressed girl too, didn't you?"
    m 2tfu "¡Sé sincer[end_letter_gender]! Tú también pensaste que yo era la chica mejor vestida, ¿verdad?"

# game/script-topics.rpy:5006
translate spanish monika_ribbon_eb073c10:

    # m 2hub "Ahaha!"
    m 2hub "¡Ja, ja, ja!"

# game/script-topics.rpy:5007
translate spanish monika_ribbon_e902f05a:

    # m 4eua "If you're trying to improve your fashion sense, I'll help."
    m 4eua "Si estás intentando mejorar tu sentido de la moda, yo te ayudo."

# game/script-topics.rpy:5008
translate spanish monika_ribbon_ce9419b5:

    # m 1eka "Don't do that stuff because you want to impress other people, though."
    m 1eka "Pero no hagas esas cosas solo para impresionar a los demás."

# game/script-topics.rpy:5009
translate spanish monika_ribbon_53f0facd:

    # m 1eua "You should do whatever makes you feel better about yourself."
    m 1eua "Deberías hacer lo que sea que te haga sentir mejor contigo mism[end_letter_gender]."

# game/script-topics.rpy:5010
translate spanish monika_ribbon_853547a4:

    # m 1hua "I'm the only other person you need, anyway, and I'll love you no matter what you look like."
    m 1hua "De todas formas, soy la única persona que necesitas, y te querré tengas el aspecto que tengas."

# game/script-topics.rpy:5014
translate spanish monika_ribbon_cfe36944:

    # m 1hua "Doesn't my ribbon look wonderful with this outfit, [player]?"
    m 1hua "¿A que mi lazo queda de maravilla con este conjunto, [player]?"

# game/script-topics.rpy:5015
translate spanish monika_ribbon_f4bbac4c:

    # m 1eua "I think it really ties it all together."
    m 1eua "Creo que realmente hace que todo encaje."

# game/script-topics.rpy:5016
translate spanish monika_ribbon_60722131:

    # m 3eua "I bet it'd even look great with other outfits as well...especially formal attire."
    m 3eua "Apuesto a que quedaría genial con otros conjuntos también... Especialmente con ropa formal."

# game/script-topics.rpy:5018
translate spanish monika_ribbon_02841499:

    # m 1eua "I really love this ribbon, [player]."
    m 1eua "Me encanta este lazo, [player]."

# game/script-topics.rpy:5019
translate spanish monika_ribbon_f3bb1b79:

    # m 1hua "I'm glad you seem to like it just as much, ehehe~"
    m 1hua "Me alegra que a ti parezca gustarte tanto como a mí, je, je, je."

# game/script-topics.rpy:5020
translate spanish monika_ribbon_5d9499fa:

    # m 1rksdla "I originally only intended to wear it around Christmas time...but it's just too beautiful not to wear more often..."
    m 1rksdla "Originalmente solo tenía intención de llevarlo en Navidad... Pero es demasiado bonito como para no usarlo más a menudo..."

# game/script-topics.rpy:5021
translate spanish monika_ribbon_2ed78e17:

    # m 3hksdlb "It'd be such a shame to keep it stored away for most of the year!"
    m 3hksdlb "¡Sería una pena tenerlo guardado la mayor parte del año!"

# game/script-topics.rpy:5022
translate spanish monika_ribbon_26862700:

    # m 3ekb "...You know, I bet it'd look really great with formal attire actually!"
    m 3ekb "... Sabes, ¡apuesto a que en realidad quedaría genial con ropa formal!"

# game/script-topics.rpy:5023
translate spanish monika_ribbon_1eddc9bf:

    # m 3ekbsa "I can't wait to wear this ribbon on a fancy date with you, [player]~"
    m 3ekbsa "Me muero de ganas de llevar este lazo en una cita elegante contigo, [player]."

# game/script-topics.rpy:5027
translate spanish monika_ribbon_05cc974a:

    # m 3eka "I just want to thank you again for these ribbons, [player]."
    m 3eka "Solo quiero darte las gracias otra vez por estos lazos, [player]."

# game/script-topics.rpy:5028
translate spanish monika_ribbon_d2b198a6:

    # m 1ekb "They really were a wonderful gift and I think they're just beautiful!"
    m 1ekb "¡Realmente fueron un regalo maravilloso y creo que son preciosos!"

# game/script-topics.rpy:5029
translate spanish monika_ribbon_0c917869:

    # m 3hua "I'll wear them anytime you want~"
    m 3hua "Los llevaré siempre que quieras."

# game/script-topics.rpy:5032
translate spanish monika_ribbon_0518ce5b:

    # m 3eka "I just want to thank you again for this ribbon, [player]."
    m 3eka "Solo quiero darte las gracias otra vez por este lazo, [player]."

# game/script-topics.rpy:5033
translate spanish monika_ribbon_a65278d3:

    # m 1ekb "It really was a wonderful gift and I think it's just beautiful!"
    m 1ekb "¡Realmente fue un regalo maravilloso y creo que es precioso!"

# game/script-topics.rpy:5034
translate spanish monika_ribbon_68a271a1:

    # m 3hua "I'll wear it anytime you want~"
    m 3hua "Lo llevaré siempre que quieras."

# game/script-topics.rpy:5053
translate spanish monika_outdoors_235bfeea:

    # m 1eua "Do you ever go camping, [player]?"
    m 1eua "¿Alguna vez vas de acampada, [player]?"

# game/script-topics.rpy:5054
translate spanish monika_outdoors_85d45d61:

    # m 3eub "It's a wonderful way to relax, get some fresh air, and see the parks around you!"
    m 3eub "¡Es una forma maravillosa de relajarse, respirar aire puro y ver los parques que te rodean!"

# game/script-topics.rpy:5055
translate spanish monika_outdoors_72bc6eb5:

    # m 1huu "It's almost like a more relaxed backpacking trip, actually."
    m 1huu "En realidad, es casi como un viaje de mochilero más relajado."

# game/script-topics.rpy:5056
translate spanish monika_outdoors_cc81a771:

    # m 1eka "But while it is a good way to spend time outdoors, there are several dangers that most people don't bother to think about."
    m 1eka "Pero aunque es una buena forma de pasar tiempo al aire libre, hay varios peligros en los que la mayoría de la gente no se molesta en pensar."

# game/script-topics.rpy:5057
translate spanish monika_outdoors_7c5a2259:

    # m 3euc "A good example would be bug spray or sunscreen. Many people forget or even forgo them,{w=0.5} thinking they're unimportant..."
    m 3euc "Un buen ejemplo sería el repelente de insectos o la crema solar. Mucha gente los olvida o incluso prescinde de ellos, {w=0.5} pensando que no son importantes..."

# game/script-topics.rpy:5058
translate spanish monika_outdoors_efef0031:

    # m 1eksdld "And without them, sunburns are almost inevitable, and many insects carry diseases that can really harm you."
    m 1eksdld "Y sin ellos, las quemaduras solares son casi inevitables, y muchos insectos portan enfermedades que realmente pueden hacerte daño."

# game/script-topics.rpy:5059
translate spanish monika_outdoors_fec961b0:

    # m 1ekd "It may be a bit of a pain, but if you don't use them, you might end up miserable, or even get really sick."
    m 1ekd "Puede ser un poco pesado, pero si no los usas podrías acabar pasándolo mal, o incluso ponerte muy enferm[end_letter_gender]."

# game/script-topics.rpy:5060
translate spanish monika_outdoors_1f9e87aa:

    # m 1eka "So, please promise me that the next time you go outdoors, be it camping or backpacking, you won't forget them."
    m 1eka "Así que, por favor, prométeme que la próxima vez que salgas al aire libre, ya sea de acampada o de mochilero, no los olvidarás."

# game/script-topics.rpy:5063
translate spanish monika_outdoors_56526a8a:

    # m 1eub "But, on the bright side..."
    m 1eub "Pero, por el lado positivo..."

# game/script-topics.rpy:5064
translate spanish monika_outdoors_f973d5c0:

    # m 1rkbsa "Once I cross over, if you remember to bring the sunscreen..."
    m 1rkbsa "Una vez cruce a tu realidad, si te acuerdas de llevar crema solar..."

# game/script-topics.rpy:5065
translate spanish monika_outdoors_ea432dc5:

    # m 1tubsa "I might need a little help putting it on."
    m 1tubsa "Puede que necesite un poco de ayuda para ponérmela."

# game/script-topics.rpy:5066
translate spanish monika_outdoors_65d2ccc9:

    # m 1hubsb "Ahaha!"
    m 1hubsb "¡Ja, ja, ja!"

# game/script-topics.rpy:5067
translate spanish monika_outdoors_d747a37f:

    # m 1efu "I'm only teasing you, [mas_get_player_nickname()]."
    m 1efu "Solo te estoy tomando el pelo, [mas_get_player_nickname()]."

# game/script-topics.rpy:5068
translate spanish monika_outdoors_f476b955:

    # m 1tsu "Well, at least a little. Ehehe~"
    m 1tsu "Bueno, al menos un poco. Je, je, je."

# game/script-topics.rpy:5071
translate spanish monika_outdoors_17e1af25:

    # m "Okay, [player]?"
    m "¿Vale, [player]?"

# game/script-topics.rpy:5094
translate spanish monika_mountain_694ba47c:

    # m 1eua "Have you ever been in the mountains, [player]?"
    m 1eua "¿Has estado alguna vez en la montaña, [player]?"

# game/script-topics.rpy:5095
translate spanish monika_mountain_b3c189eb:

