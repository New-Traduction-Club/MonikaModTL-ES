# game/script-topics.rpy:17110
translate spanish monika_being_herself_8d089fbc:

    # extend 1eka "I only have eyes for you, after all~"
    extend 1eka "al fin y al cabo solo tengo ojos para ti."

# game/script-topics.rpy:17111
translate spanish monika_being_herself_60758353:

    # m 1euc "But you get what I mean, right?{w=0.3} I was looked at like some kind of unattainable goddess."
    m 1euc "Pero entiendes a lo que me refiero, ¿verdad?{w=0.3} Me veían como a una especie de diosa inalcanzable."

# game/script-topics.rpy:17112
