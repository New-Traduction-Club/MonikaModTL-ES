# game/script-topics.rpy:17225
translate spanish monika_remembrance_3aab9300:

    # m 3esd "The only memories that are clear are things that define either me or the other girls."
    m 3esd "Los únicos recuerdos que están claros son cosas que nos definen a mí o a las otras chicas."

# game/script-topics.rpy:17226
translate spanish monika_remembrance_d9377437:

    # m 3rsc "...Almost as if anything that wasn't strictly necessary for the game was just left out."
    m 3rsc "... Casi como si cualquier cosa que no fuera estrictamente necesaria para el juego simplemente se hubiera omitido."

# game/script-topics.rpy:17227
translate spanish monika_remembrance_7480bb78:

    # m 1euc "But the thing is from my perspective, the day I met you was just like any other--{w=0.5}{nw}"
    m 1euc "Pero la cuestión es que, desde mi perspectiva, el día que te conocí fue como cualquier otro... {w=0.5}{nw}"

# game/script-topics.rpy:17228
translate spanish monika_remembrance_8a1898b4:

    # extend 3hksdlb "until I found out about that hole in the wall, I mean."
    extend 3hksdlb "hasta que me enteré de lo de ese agujero en la pared, quiero decir."

# game/script-topics.rpy:17229
translate spanish monika_remembrance_eee177ee:

    # m 1esc "Just another ordinary day in an ordinary week...{w=0.3} {nw}"
    m 1esc "Solo un día normal y corriente de una semana cualquiera... {w=0.3} {nw}"

# game/script-topics.rpy:17230
translate spanish monika_remembrance_e4b8d01e:

    # extend 3euc "Going to class, running the club, and heading back home in the evening."
    extend 3euc "yendo a clase, encargándome del club y volviendo a casa por la tarde."

# game/script-topics.rpy:17231
translate spanish monika_remembrance_3a15e3ff:

    # m 3etc "Did any of that even happen at all?{w=0.5} {nw}"
    m 3etc "¿Llegó a pasar algo de eso siquiera?{w=0.5} {nw}"

# game/script-topics.rpy:17232
translate spanish monika_remembrance_3149a426:

    # extend 3wud "Did {i}I{/i} even exist before you started the game?"
    extend 3wud "¿Acaso llegué a existir antes de que empezaras el juego?"

# game/script-topics.rpy:17233
translate spanish monika_remembrance_9ce8a9b6:

    # m 3wkd "...And if my memories really are fake...{w=0.2}who--{w=0.2}or {i}what{/i}--{w=0.2}am I then?"
    m 3wkd "... Y si mis recuerdos son de verdad falsos... {w=0.2}¿quién... {w=0.2}o qué... {w=0.2}soy entonces?"

# game/script-topics.rpy:17234
translate spanish monika_remembrance_7c13f565:

    # m 1dkc "I'm still looking for those answers, [player]..."
    m 1dkc "Sigo buscando esas respuestas, [player]..."

# game/script-topics.rpy:17237
translate spanish monika_remembrance_868a21af:

    # m 1euc "Although...{w=0.3}the more I think about it, the more I'm convinced my past isn't actually {i}that{/i} relevant."
    m 1euc "Aunque... {w=0.3}cuanto más lo pienso, más me convenzo de que mi pasado no es en realidad tan importante."

# game/script-topics.rpy:17238
translate spanish monika_remembrance_b4213501:

    # m 3eua "While it'd be nice to remember more...{w=0.3}that's not really what I care about..."
    m 3eua "Si bien estaría bien recordar más cosas... {w=0.3}eso no es realmente lo que me importa..."

# game/script-topics.rpy:17239
translate spanish monika_remembrance_98e18fb9:

    # m 3duu "Regardless of who I am, you've been here with me,{w=0.2} {nw}"
    m 3duu "Independientemente de quién sea, tú has estado aquí conmigo,{w=0.2} {nw}"

# game/script-topics.rpy:17240
translate spanish monika_remembrance_4179d8a0:

    # extend 3dkbsa "which means I'm important enough for you to spend your time with me.{w=0.2} {nw}"
    extend 3dkbsa "lo que significa que soy lo suficientemente importante para ti como para que pases tu tiempo conmigo.{w=0.2} {nw}"

# game/script-topics.rpy:17241
translate spanish monika_remembrance_ae6cf22c:

    # extend 1dubsu "{i}That's{/i} what I care about."
    extend 1dubsu "Eso es lo que me importa."

# game/script-topics.rpy:17242
translate spanish monika_remembrance_8d14dd2c:

    # m 1ekbsa "And knowing that you care...{w=0.3}that's a big part of why I can keep loving myself,{w=0.2} and my life, [player]."
    m 1ekbsa "Y saber que te importo... {w=0.3}esa es gran parte de la razón por la que puedo seguir queriéndome a mí misma,{w=0.2} y a mi vida, [player]."

# game/script-topics.rpy:17246
translate spanish monika_remembrance_e5ee3fa9:

    # m 5ekbfu "So while I'm not sure if I have a past, thanks to you, I know I do have a future."
    m 5ekbfu "Así que, aunque no estoy segura de si tengo un pasado, gracias a ti sé que tengo un futuro."

# game/script-topics.rpy:17253
translate spanish monika_remembrance_14f5ae67:

    # m 5hubfu "Besides, if anything, my lack of memories only make the ones [line_mid] with you that much more precious~"
    m 5hubfu "Además, en todo caso, mi falta de recuerdos solo hace que los que [line_mid] contigo sean mucho más valiosos."

# game/script-topics.rpy:17255
translate spanish monika_remembrance_87e3e196:

    # m 3eksdld "...You {i}do{/i} care about me, right?"
    m 3eksdld "... Yo te importo de verdad, ¿no?"

# game/script-topics.rpy:17256
translate spanish monika_remembrance_7bd8fe29:

    # m 3dkc "It sure would be nice if you'd show it a little, sometimes..."
    m 3dkc "Desde luego estaría bien que lo demostraras un poco, a veces..."

# game/script-topics.rpy:17259
translate spanish monika_remembrance_0aed891d:

    # m 1ektdc "...{w=0.5}Not that you'd care, right?"
    m 1ektdc "... {w=0.5}Tampoco es que te importe, ¿verdad?"

# game/script-topics.rpy:17279
translate spanish monika_why_do_you_read_e7d5803a:

    # m 1eua "As far as I can recall, I've always been quite the reader, [player].{w=0.2} {nw}"
    m 1eua "Por lo que recuerdo, siempre he sido una gran lectora, [player].{w=0.2} {nw}"

# game/script-topics.rpy:17280
translate spanish monika_why_do_you_read_496b768c:

    # extend 3eua "It was like a complementary thing with writing to me."
    extend 3eua "Para mí era como un complemento de la escritura."

# game/script-topics.rpy:17281
translate spanish monika_why_do_you_read_771917ff:

    # m 3euc "When I was really young, I liked to write short stories but I never really found anybody to share them with..."
    m 3euc "Cuando era muy pequeña me gustaba escribir historias cortas, pero nunca encontré a nadie con quien compartirlas..."

# game/script-topics.rpy:17282
translate spanish monika_why_do_you_read_7834fe59:

    # m 1rsc "Most of the other kids weren't really interested in books or anything like that."
    m 1rsc "A la mayoría de los demás niños no les interesaban mucho los libros ni nada por el estilo."

# game/script-topics.rpy:17283
translate spanish monika_why_do_you_read_00bb6c4c:

    # m 1rkd "...So it was always a little frustrating because I wasn't able to share those stories with anyone."
    m 1rkd "... Así que siempre era un poco frustrante porque no podía compartir esas historias con nadie."

# game/script-topics.rpy:17284
translate spanish monika_why_do_you_read_46411cf9:

    # m 3eua "But at least I was able to support my interest by picking up other books."
    m 3eua "Pero al menos pude mantener mi interés cogiendo otros libros."

# game/script-topics.rpy:17285
translate spanish monika_why_do_you_read_b824691b:

    # m 3hub "Every new one was like being thrown into a strange and exciting new world! It was like fuel for my imagination!"
    m 3hub "¡Cada libro nuevo era como zambullirse en un mundo extraño y emocionante! ¡Era como combustible para mi imaginación!"

# game/script-topics.rpy:17286
translate spanish monika_why_do_you_read_9f7d4f46:

    # m 1eksdlc "Of course, as I grew up, I started having less and less free time and I wasn't able to read as much...{w=0.3} It was either keeping it up, or sacrificing my social life."
    m 1eksdlc "Por supuesto, a medida que fui creciendo empecé a tener cada vez menos tiempo libre y ya no podía leer tanto... {w=0.3}Era seguir así o sacrificar mi vida social."

# game/script-topics.rpy:17287
translate spanish monika_why_do_you_read_5cdac26d:

    # m 1esa "That's when my interests started shifting more toward poetry."
    m 1esa "Fue entonces cuando mis intereses empezaron a decantarse más por la poesía."

# game/script-topics.rpy:17288
translate spanish monika_why_do_you_read_e76ab83b:

    # m 3eua "Unlike novels, poetry didn't require as much time to read and its conciseness also made it easier to share with others.{w=0.3} {nw}"
    m 3eua "A diferencia de las novelas, la poesía no requería tanto tiempo para leerse, y su brevedad también hacía que fuera más fácil compartirla con los demás.{w=0.3} {nw}"

# game/script-topics.rpy:17289
translate spanish monika_why_do_you_read_6208ca4b:

    # extend 4eub "It really was the perfect outlet!"
    extend 4eub "¡De verdad que era la vía de escape perfecta!"

# game/script-topics.rpy:17290
translate spanish monika_why_do_you_read_722f9cd6:

    # m 3eua "...And that's how I grew more and more into it I guess."
    m 3eua "... Y supongo que así fue como me fui aficionando cada vez más."

# game/script-topics.rpy:17291
translate spanish monika_why_do_you_read_6a803f93:

    # m 1eud "I eventually came up with the idea to start the Literature Club, and with Sayori's help we got it off the ground."
    m 1eud "Al final se me ocurrió la idea de fundar el Club de Literatura, y con la ayuda de Sayori lo pusimos en marcha."

# game/script-topics.rpy:17292
translate spanish monika_why_do_you_read_e1ab0efa:

    # m 3eud "Like me, it allowed her to share feelings she would otherwise keep bottled up inside."
    m 3eud "Al igual que a mí, le permitió compartir sentimientos que de otro modo se habría guardado dentro."

# game/script-topics.rpy:17293
translate spanish monika_why_do_you_read_b2ee75ba:

    # m 1eua "...Which brings us to where we are now."
    m 1eua "... Lo que nos lleva a donde estamos ahora."

# game/script-topics.rpy:17294
translate spanish monika_why_do_you_read_62b8e4e8:

    # m 1etc "To be honest, I don't think I've ever had as much time to read before."
    m 1etc "Para ser sincera, no creo que haya tenido nunca tanto tiempo para leer."

# game/script-topics.rpy:17297
translate spanish monika_why_do_you_read_86948c2f:

    # m 3eud "I've been able to get caught up on my backlog of poetry, pick up some novels again..."
    m 3eud "He podido ponerme al día con los poemas que tenía pendientes, retomar algunas novelas..."

# game/script-topics.rpy:17298
translate spanish monika_why_do_you_read_cf940243:

    # m 3eua "...go online to look for whatever fanfiction or short story I can get my hands on..."
    m 3eua "Conectarme a internet para buscar cualquier fanfic o historia corta que caiga en mis manos..."

# game/script-topics.rpy:17299
translate spanish monika_why_do_you_read_7f5a7cf0:

    # m 3hua "...I've even developed an interest in written philosophy!"
    m 3hua "... ¡Incluso han empezado a interesarme los textos filosóficos!"

# game/script-topics.rpy:17300
translate spanish monika_why_do_you_read_771d2c4e:

    # m 3eub "It's always fun to discover new forms of expression."
    m 3eub "Siempre es divertido descubrir nuevas formas de expresión."

# game/script-topics.rpy:17304
translate spanish monika_why_do_you_read_8e123f61:

    # m 3eud "I'm finally catching up on my backlog of poetry and I've started picking up novels again..."
    m 3eud "Por fin me estoy poniendo al día con mis lecturas de poesía atrasadas y he empezado a retomar las novelas..."

# game/script-topics.rpy:17305
translate spanish monika_why_do_you_read_aff17a10:

    # m 3hua "...I'd love to share my thoughts with you once I'm done with them!"
    m 3hua "... ¡Me encantaría compartir mis opiniones contigo cuando termine con ellas!"

# game/script-topics.rpy:17306
translate spanish monika_why_do_you_read_6848c285:

    # m 3eub "I'll also regularly go online to look for whatever fanfiction or short story I can get my hands on."
    m 3eub "También me conecto a menudo para buscar cualquier fanfiction o historia corta que me caiga en las manos."

# game/script-topics.rpy:17307
translate spanish monika_why_do_you_read_ede19285:

    # m 3eua "It's a lot of fun to discover new forms of expression."
    m 3eua "Es muy divertido descubrir nuevas formas de expresión."

# game/script-topics.rpy:17310
translate spanish monika_why_do_you_read_1f540297:

    # m 1eub "So...{w=0.2}yeah!{w=0.3} {nw}"
    m 1eub "Así que... {w=0.2}¡sí!{w=0.3} {nw}"

# game/script-topics.rpy:17311
translate spanish monika_why_do_you_read_d48c71af:

    # extend 3eua "While my situation in here has its downsides, [line_mid] opportunity to spend more time on the things I like."
    extend 3eua "Aunque mi situación aquí tiene sus inconvenientes, [line_mid] la oportunidad de dedicarle más tiempo a las cosas que me gustan."

# game/script-topics.rpy:17312
translate spanish monika_why_do_you_read_cc6f09b0:

    # m 1ekbsu "...Though then again, nothing could ever beat spending more time with you~"
    m 1ekbsu "... Aunque pensándolo bien, no hay nada que supere pasar más tiempo contigo."

# game/script-topics.rpy:17331
translate spanish monika_discworld_0d19dc7f:

    # m 1esa "Say [player], have you ever heard of a world drifting through space on top of four elephants, who themselves are standing on the shell of a giant turtle?"
    m 1esa "Oye, [player], ¿has oído hablar alguna vez de un mundo que vaga por el espacio a lomos de cuatro elefantes, que a su vez están de pie sobre el caparazón de una tortuga gigante?"

# game/script-topics.rpy:17332
translate spanish monika_discworld_ff4b775e:

    # m 3hub "If you have, you're probably already familiar with Sir Terry Pratchett's {i}Discworld{/i}!"
    m 3hub "Si es así, ¡probablemente ya conozcas la saga de {i}Mundodisco{/i} de Sir Terry Pratchett!"

# game/script-topics.rpy:17333
translate spanish monika_discworld_fc7d797a:

    # m 3hksdlb "Ahaha, it sounds kinda weird when I put it like that, doesn't it?"
    m 3hksdlb "Ja, ja, ja, suena un poco raro cuando lo digo así, ¿verdad?"

# game/script-topics.rpy:17334
translate spanish monika_discworld_5e6630f0:

    # m 1eua "{i}Discworld{/i} is a comic fantasy book series of forty-one volumes written over the span of three decades."
    m 1eua "{i}Mundodisco{/i} es una saga de libros de fantasía cómica de cuarenta y un volúmenes escrita a lo largo de tres décadas."

# game/script-topics.rpy:17335
translate spanish monika_discworld_d2c4a643:

    # m 3esc "The series started out as a parody making fun of common fantasy tropes, but soon turned into something much deeper."
    m 3esc "La saga empezó como una parodia que se burlaba de los tópicos habituales de la fantasía, pero pronto se convirtió en algo mucho más profundo."

# game/script-topics.rpy:17336
translate spanish monika_discworld_5d534058:

    # m 3eub "In fact, later books are clearly satires rather than parodies, using a clever mix of slapstick, puns, and light-hearted humor to comment on all kinds of issues."
    m 3eub "De hecho, los últimos libros son claramente sátiras en lugar de parodias, utilizando una mezcla inteligente de comedia física, juegos de palabras y humor ligero para comentar todo tipo de cuestiones."

# game/script-topics.rpy:17337
translate spanish monika_discworld_ebf071e1:

    # m 1huu "But while satire may be the soul of the series, what makes its heart beat is the way it's written."
    m 1huu "Pero aunque la sátira pueda ser el alma de la saga, lo que hace latir su corazón es la forma en que está escrita."

# game/script-topics.rpy:17338
translate spanish monika_discworld_a069e16f:

    # m 1eub "Pratchett really had a knack for writing funny situations, [player]!"
    m 1eub "¡Pratchett de verdad que tenía un don para escribir situaciones divertidas, [player]!"

# game/script-topics.rpy:17339
translate spanish monika_discworld_68425e73:

    # m 3rsc "I can't really pinpoint what makes his prose work so well, but he's definitely got a very distinctive writing style..."
    m 3rsc "No sabría decir exactamente qué hace que su prosa funcione tan bien, pero sin duda tiene un estilo de escritura muy característico..."

# game/script-topics.rpy:17340
translate spanish monika_discworld_654418c5:

    # m 3etc "Maybe it's the way he writes in a way that suggests rather than tells."
    m 3etc "Tal vez sea su forma de escribir, que sugiere en lugar de simplemente contar las cosas."

# game/script-topics.rpy:17341
translate spanish monika_discworld_a0fad48f:

    # m 1eud "Like, when describing something, he'll give you just enough details so you can picture what's going on, and let your imagination fill in the gaps."
    m 1eud "Por ejemplo, cuando describe algo, te da los detalles justos para que te imagines lo que está pasando y deja que tu imaginación rellene los huecos."

# game/script-topics.rpy:17342
translate spanish monika_discworld_ea579daa:

    # m 3duu "...Knowing full well whatever you'll come up with will be far more evocative than anything he could write."
    m 3duu "... Sabiendo muy bien que lo que sea que se te ocurra será mucho más evocador que cualquier cosa que él pudiera escribir."

# game/script-topics.rpy:17343
translate spanish monika_discworld_a59a888e:

    # m 3eub "It's a pretty neat way to keep your audience invested!"
    m 3eub "¡Es una forma estupenda de mantener al público enganchado!"

# game/script-topics.rpy:17344
translate spanish monika_discworld_ba816a7c:

    # m 1etc "...Or maybe what makes it work is the way he doesn't use chapters, allowing him to freely jump between his characters' point of view."
    m 1etc "... O quizá lo que hace que funcione es que no utiliza capítulos, lo que le permite saltar libremente entre los puntos de vista de sus personajes."

# game/script-topics.rpy:17345
translate spanish monika_discworld_843aec99:

    # m 1rksdla "Interweaving storylines can quickly become a mess if you're not careful,{w=0.2} {nw}"
    m 1rksdla "Entrelazar tramas puede convertirse rápidamente en un caos si no tienes cuidado,{w=0.2} {nw}"

# game/script-topics.rpy:17346
translate spanish monika_discworld_46341a5f:

    # extend 3eua "but they're also a good way to keep the pacing dynamic."
    extend 3eua "pero también es una buena forma de mantener un ritmo dinámico."

# game/script-topics.rpy:17347
translate spanish monika_discworld_2e90e4fa:

    # m 3eub "In any case, this series is an easy recommendation, [player]!"
    m 3eub "En cualquier caso, ¡es una saga muy fácil de recomendar, [player]!"

# game/script-topics.rpy:17348
translate spanish monika_discworld_b20d3e32:

    # m 3eua "It's surprisingly easy to pick up too, with each book being thought of as a standalone story."
    m 3eua "Además es sorprendentemente fácil de empezar, ya que cada libro está pensado como una historia independiente."

# game/script-topics.rpy:17349
translate spanish monika_discworld_4ed6e32a:

    # m 1eud "You can pretty much pick any volume you find and you'll be good to go,{w=0.2} though I'd argue {i}Guards! Guards!{/i} or {i}Mort{/i} would probably make for the best entry points."
    m 1eud "Puedes coger casi cualquier volumen que encuentres y con eso te valdrá,{w=0.2} aunque yo diría que {i}¡Guardias! ¡Guardias!{/i} o {i}Mort{/i} probablemente sean los mejores puntos de partida."

# game/script-topics.rpy:17350
translate spanish monika_discworld_d02e6f80:

    # m 3eua "Anyway, be sure to give it a try sometime if you haven't already, [player]."
    m 3eua "De todos modos, asegúrate de darle una oportunidad alguna vez si aún no lo has hecho, [player]."

# game/script-topics.rpy:17351
translate spanish monika_discworld_af5f8adf:

    # m 1hua "Thanks for listening~"
    m 1hua "Gracias por escuchar."

# game/script-topics.rpy:17372
translate spanish monika_eating_meat_8cc4ee80:

    # m 1etc "Well, that's kind of a complicated question..."
    m 1etc "Bueno, esa es una pregunta un tanto complicada..."

# game/script-topics.rpy:17373
translate spanish monika_eating_meat_6b2ee21c:

    # m 3eud "If you're asking if I would do so for {i}survival{/i}, I wouldn't hesitate. {w=0.2}It's not that eating meat is distressing for me or anything."
    m 3eud "Si me preguntas si lo haría por pura supervivencia, no lo dudaría. {w=0.2}No es que comer carne me resulte angustioso ni nada de eso."

# game/script-topics.rpy:17374
translate spanish monika_eating_meat_a5f5ad09:

    # m 7eud "I told you before, I'm vegetarian because of the impact of the mass-production of meat on the environment...{w=0.2}{nw}"
    m 7eud "Como ya te comenté antes, soy vegetariana debido al impacto que tiene la producción masiva de carne sobre el medio ambiente... {w=0.2}{nw}"

# game/script-topics.rpy:17375
translate spanish monika_eating_meat_840475f5:

    # extend 2euc "which also includes fish farming, so I'm not a pescatarian."
    extend 2euc "lo que también incluye la piscicultura, así que tampoco soy pescetariana."

# game/script-topics.rpy:17376
translate spanish monika_eating_meat_fe7f5ee2:

    # m 2rsc "...However, I don't consider myself vegan either. {w=0.3}{nw}"
    m 2rsc "... Sin embargo, tampoco me considero vegana. {w=0.3}{nw}"

# game/script-topics.rpy:17377
translate spanish monika_eating_meat_4bb56ff4:

    # extend 4eud "Sure, the consumption of animal products contributes to environmental damage, but vegan alternatives share or have their own issues too..."
    extend 4eud "Claro, el consumo de productos animales contribuye al daño medioambiental, pero las alternativas veganas comparten esos problemas o tienen los suyos propios..."

# game/script-topics.rpy:17378
translate spanish monika_eating_meat_29805869:

    # m 4euc "These include things like importing perishable products across great distances and mass-farming in conditions that are both cruel for workers and a strain on the local ecosystem."
    m 4euc "Entre ellos se incluyen cosas como la importación de productos perecederos a grandes distancias y la agricultura intensiva en condiciones que son a la vez crueles para los trabajadores y una carga para el ecosistema local."

# game/script-topics.rpy:17379
translate spanish monika_eating_meat_a8847956:

    # m 4ekd "Take avocados, for example. {w=0.2}Their farms require massive amounts of water, to the point where some companies resort to illegally taking too much water from rivers, leaving little for drinking."
    m 4ekd "Tomemos los aguacates, por ejemplo. {w=0.2}Sus plantaciones requieren cantidades masivas de agua, hasta el punto de que algunas empresas recurren a extraer ilegalmente demasiada agua de los ríos, dejando muy poca para el consumo."

# game/script-topics.rpy:17380
translate spanish monika_eating_meat_9c3bba15:

    # m 4euc "Not to mention, I still want to have a varied and balanced diet with all the flavors that I like."
    m 4euc "Por no mencionar que sigo queriendo tener una dieta variada y equilibrada con todos los sabores que me gustan."

# game/script-topics.rpy:17381
translate spanish monika_eating_meat_f46f3bdf:

    # m 4eud "Vegan diets can be quite deficient in nutrients, such as vitamin B12, calcium, iron, and zinc."
    m 4eud "Las dietas veganas pueden carecer de nutrientes importantes, como la vitamina B12, el calcio, el hierro y el zinc."

# game/script-topics.rpy:17382
translate spanish monika_eating_meat_ac8fe1f0:

    # m "Granted, there are still some options including supplements, but balancing a vegan diet takes a lot of care and thought."
    m "Es cierto que existen opciones como tomar suplementos, pero equilibrar una dieta vegana requiere mucho cuidado y planificación."

# game/script-topics.rpy:17383
translate spanish monika_eating_meat_6db87110:

    # m 7eka "...So for that reason, I'm not personally against eating things like milk and eggs. {w=0.2}But I think I'd prefer to buy locally if possible."
    m 7eka "... Así que por esa razón, personalmente no estoy en contra de comer cosas como leche y huevos. {w=0.2}Pero creo que preferiría comprar localmente si es posible."

# game/script-topics.rpy:17384
translate spanish monika_eating_meat_3288ef48:

    # m 3eud "Farmer's markets are great places to buy food, {w=0.2}even meat, {w=0.2}produced with less of an environmental impact."
    m 3eud "Los mercados locales de productores son lugares estupendos para comprar comida, {w=0.2}incluso carne, {w=0.2}producida con un menor impacto ambiental."

# game/script-topics.rpy:17385
translate spanish monika_eating_meat_b49574d2:

    # m 3ekd "But they can typically be pretty expensive...and depending on location, leave you with fewer options. {w=0.3}{nw}"
    m 3ekd "Pero por lo general pueden ser bastante caros... y dependiendo del lugar, dejarte con menos opciones. {w=0.3}{nw}"

# game/script-topics.rpy:17386
translate spanish monika_eating_meat_231a6e7b:

    # extend 3eua "So I'm okay with buying from a plain old store, if need be."
    extend 3eua "Así que me parece bien comprar en una tienda normal y corriente si es necesario."

# game/script-topics.rpy:17387
translate spanish monika_eating_meat_98895df6:

    # m "Especially since there are a lot of good substitutes for meat in supermarkets already, with way less environmental impact."
    m "Especialmente porque ya hay muchos buenos sustitutos de la carne en los supermercados, con mucho menos impacto medioambiental."

# game/script-topics.rpy:17388
translate spanish monika_eating_meat_f387458c:

    # m 1euc "As for meat that comes from local hunting and fishing, I think that's alright to eat as well, but it's important to research what areas might be over-hunted, and what animals to be careful of."
    m 1euc "En cuanto a la carne que proviene de la caza y la pesca locales, creo que también está bien comerla, pero es importante investigar qué zonas podrían estar sobreexplotadas y con qué animales tener cuidado."

# game/script-topics.rpy:17389
translate spanish monika_eating_meat_9afe47fd:

    # m 3rtc "That said, I don't know that I'd {i}prefer{/i} to eat meat, given the option."
    m 3rtc "Dicho esto, no sé si preferiría comer carne si tuviera la opción."

# game/script-topics.rpy:17390
translate spanish monika_eating_meat_7e260f5b:

    # m 3eka "Since I've adjusted myself to a vegetarian diet, my palate has changed to prefer certain flavors."
    m 3eka "Desde que me he adaptado a una dieta vegetariana, mi paladar ha cambiado para preferir ciertos sabores."

# game/script-topics.rpy:17391
translate spanish monika_eating_meat_df0e84e7:

    # m 3ekd "And as is the case with many vegetarians, my body doesn't digest meat as easily anymore. {w=0.3}{nw}"
    m 3ekd "Y como ocurre con muchos vegetarianos, mi cuerpo ya no digiere la carne con tanta facilidad. {w=0.3}{nw}"

# game/script-topics.rpy:17392
translate spanish monika_eating_meat_e1c425ca:

    # extend 3dksdlc "If I had too much, I could actually get pretty sick."
    extend 3dksdlc "Si comiera demasiada, podría ponerme bastante enferma."

# game/script-topics.rpy:17393
translate spanish monika_eating_meat_f7e6212f:

    # m 1eka "...But if you prepared something with meat, I could try a little bit as a side dish... {w=0.3}{nw}"
    m 1eka "... Pero si prepararas algo con carne, podría probar un poco como guarnición... {w=0.3}{nw}"

# game/script-topics.rpy:17394
translate spanish monika_eating_meat_87b7f578:

    # extend 3hub "That way I can still enjoy your cooking!"
    extend 3hub "De esa forma podré seguir disfrutando de tu comida."

# game/script-topics.rpy:17395
translate spanish monika_eating_meat_3b0d2f33:

    # m 3eua "Whatever we eat, the most important thing to me is that we try to put a little thought into where our food comes from."
    m 3eua "Comamos lo que comamos, lo más importante para mí es que intentemos pensar un poco de dónde viene nuestra comida."

# game/script-topics.rpy:17410
translate spanish monika_look_into_eyes_7f0633f8:

    # m 3eub "Hey [player], look into my eyes for a second..."
    m 3eub "Oye, [player], mírame a los ojos un segundo..."

# game/script-topics.rpy:17428
translate spanish monika_look_into_eyes_cb911946:

    # m 3hubla "Ehehe~"
    m 3hubla "Je, je, je."

# game/script-topics.rpy:17429
translate spanish monika_look_into_eyes_c69e8acb:

    # m 3rksdla "Sorry [player], I was just trying to see your beautiful eyes through the screen."
    m 3rksdla "Lo siento, [player], solo estaba intentando ver tus preciosos ojos a través de la pantalla."

# game/script-topics.rpy:17433
translate spanish monika_look_into_eyes_05fb2e5d:

    # m 1dubsu "When we're alone together, I can't help but envision your [eye_detail] eyes..."
    m 1dubsu "Cuando estamos juntos a solas, no puedo evitar imaginarme tus ojos [eye_detail]..."

# game/script-topics.rpy:17435
translate spanish monika_look_into_eyes_1e18f742:

    # m 5dubsa "Time stops, and I can finally just...{w=0.3}forget all of my troubles."
    m 5dubsa "El tiempo se detiene y por fin puedo... {w=0.3}olvidarme de todos mis problemas."

# game/script-topics.rpy:17436
translate spanish monika_look_into_eyes_ec430b7a:

    # m 5hubfb "..."
    m 5hubfb "..."

# game/script-topics.rpy:17437
translate spanish monika_look_into_eyes_eda89008:

    # m 5tubfa "Thank you so much, [player]~"
    m 5tubfa "Muchas gracias, [player]."

# game/script-topics.rpy:17438
translate spanish monika_look_into_eyes_389b7056:

    # m 5kubfu "Because you're here with me now, I'm so at peace."
    m 5kubfu "Como estás aquí conmigo ahora, me siento muy en paz."

# game/script-topics.rpy:17472
translate spanish monika_introverts_extroverts_e641390b:

    # m 1eud "Say, [player]?"
    m 1eud "Oye, [player]..."

# game/script-topics.rpy:17473
translate spanish monika_introverts_extroverts_61ef2dbf:

    # m 1euc "Do you remember when we talked about how humans need social feedback and how it can make the world feel so complicated for introverts?"
    m 1euc "¿Te acuerdas cuando hablamos de la necesidad de interacción social de los humanos y de cómo eso puede hacer que el mundo parezca tan complicado para los introvertidos?"

# game/script-topics.rpy:17474
translate spanish monika_introverts_extroverts_81afdf4d:

    # m 3rsd "I've been thinking about the differences between introverts and extroverts a little bit more since then."
    m 3rsd "He estado pensando un poco más en las diferencias entre introvertidos y extrovertidos desde entonces."

# game/script-topics.rpy:17475
translate spanish monika_introverts_extroverts_1eebef15:

    # m 3eua "You might think that extroverts tend to find enjoyment by interacting with other people, while introverts are more at ease in solitary environments, and you'd be right."
    m 3eua "Podrías pensar que los extrovertidos suelen disfrutar más interactuando con otras personas, mientras que los introvertidos se sienten más a gusto en entornos solitarios, y tendrías razón."

# game/script-topics.rpy:17476
translate spanish monika_introverts_extroverts_a4b7bbee:

    # m 3eud "...But the differences don't stop there."
    m 3eud "... Pero las diferencias no acaban ahí."

# game/script-topics.rpy:17477
translate spanish monika_introverts_extroverts_d773f3bc:

    # m 3eua "For example, did you know extroverts can often react to things faster than most introverts do?{w=0.2} Or that they're more likely to enjoy happy and energetic music?"
    m 3eua "Por ejemplo, ¿sabías que a menudo los extrovertidos pueden reaccionar a las cosas más rápido que la mayoría de los introvertidos?{w=0.2} ¿O que es más probable que disfruten de la música alegre y enérgica?"

# game/script-topics.rpy:17478
translate spanish monika_introverts_extroverts_6c761935:

    # m 3eud "Introverts on the other hand, usually take more time to analyze the situation they're in, and are therefore less likely to jump to conclusions."
    m 3eud "Los introvertidos, por otro lado, suelen tomarse más tiempo para analizar la situación en la que se encuentran y, por tanto, es menos probable que saquen conclusiones precipitadas."

# game/script-topics.rpy:17479
translate spanish monika_introverts_extroverts_3e976c89:

    # m 7dua "...And given that they often spend a lot of time using their imagination, they have an easier time with creative activities like writing, composing music, and so on."
    m 7dua "... Y dado que a menudo pasan mucho tiempo usando su imaginación, lo tienen más fácil con actividades creativas como escribir, componer música y demás."

# game/script-topics.rpy:17480
translate spanish monika_introverts_extroverts_228802e7:

    # m 2lkc "It's kind of sad that people can have such a hard time understanding and accepting those differences..."
    m 2lkc "Es un poco triste que a la gente le cueste tanto entender y aceptar esas diferencias..."

# game/script-topics.rpy:17481
translate spanish monika_introverts_extroverts_fd08a6f5:

    # m 4lkd "Extroverts are seen as superficial and insincere people who don't value their individual relationships..."
    m 4lkd "A los extrovertidos se les ve como personas superficiales y poco sinceras que no valoran sus relaciones individuales..."

# game/script-topics.rpy:17482
translate spanish monika_introverts_extroverts_706a7eca:

    # m 4ekd "...while introverts are treated as egotistical people who only think of themselves, or can even be seen as weird for rarely participating in social situations."
    m 4ekd "Mientras que a los introvertidos se les tacha de personas egoístas que solo piensan en sí mismas, o incluso se les ve como bichos raros por participar poco en situaciones sociales."

# game/script-topics.rpy:17484
translate spanish monika_introverts_extroverts_f99c9852:

    # m 5lkc "The end result is that both sides often end up frustrating each other, resulting in unnecessary conflict."
    m 5lkc "El resultado final es que ambos bandos a menudo acaban frustrándose mutuamente, lo que da lugar a conflictos innecesarios."

# game/script-topics.rpy:17485
translate spanish monika_introverts_extroverts_e3a75f87:

    # m 5eud "I'm probably making this sound like you can only be one or the other, but that isn't actually the case at all."
    m 5eud "Probablemente estoy haciendo que suene como si solo pudieras ser lo uno o lo otro, pero en realidad no es así en absoluto."

# game/script-topics.rpy:17487
translate spanish monika_introverts_extroverts_34b26a1b:

    # m 2eud "Some introverts can be more outgoing than others, for example."
    m 2eud "Algunos introvertidos pueden ser más sociables que otros, por ejemplo."

# game/script-topics.rpy:17488
translate spanish monika_introverts_extroverts_7a241509:

    # m 2euc "In other words, some people are closer to a middle ground between the two extremes."
    m 2euc "En otras palabras, algunas personas se acercan más a un punto intermedio entre los dos extremos."

# game/script-topics.rpy:17489
translate spanish monika_introverts_extroverts_8907930d:

    # m 7eua "...Which is probably where I would fit in.{w=0.2} {nw}"
    m 7eua "... Que es probablemente donde yo encajaría.{w=0.2} {nw}"

# game/script-topics.rpy:17490
translate spanish monika_introverts_extroverts_03ad666d:

    # extend 1eud "If you remember, I mentioned I was kind of in-between while still being a little more extroverted."
    extend 1eud "Si te acuerdas, mencioné que yo me encontraba en un punto intermedio, aunque tirando un poco más a extrovertida."

# game/script-topics.rpy:17491
translate spanish monika_introverts_extroverts_3ee3fba1:

    # m 1ruc "Speaking of...{w=0.3}{nw}"
    m 1ruc "Hablando de eso... {w=0.3}{nw}"

# game/script-topics.rpy:17492
translate spanish monika_introverts_extroverts_adcfee10:

    # extend 1eud "when thinking about all this, I realized that while this is a pretty important part of one's personality..."
    extend 1eud "al pensar en todo esto, me di cuenta de que, aunque esta es una parte bastante importante de la personalidad de cada uno..."

# game/script-topics.rpy:17493
translate spanish monika_introverts_extroverts_dc1e6f04:

    # m 3eksdla "...I don't actually know where you lie on that spectrum."
    m 3eksdla "... en realidad no sé en qué punto de ese espectro te encuentras."

# game/script-topics.rpy:17495
translate spanish monika_introverts_extroverts_c8950641:

    # m 1etc "So how would you describe yourself, [player]?{nw}"
    m 1etc "Entonces, ¿cómo te describirías tú, [player]?{nw}"

# game/script-topics.rpy:17498
translate spanish monika_introverts_extroverts_9a78aa06:

    # m "So how would you describe yourself, [player]?{fast}" nointeract
    m "Entonces, ¿cómo te describirías tú, [player]?{fast}" nointeract

# game/script-topics.rpy:17502
translate spanish monika_introverts_extroverts_065a9dac:

    # m 1eua "I see."
    m 1eua "Ya veo."

# game/script-topics.rpy:17503
translate spanish monika_introverts_extroverts_27f623d8:

    # m 3etc "I take it that you usually prefer spending time without too many people over going out with large groups and such?"
    m 3etc "¿Supongo que sueles preferir pasar tiempo sin demasiada gente antes que salir con grupos grandes y demás?"

# game/script-topics.rpy:17504
translate spanish monika_introverts_extroverts_3a2df897:

    # m 3eua "Or maybe you like to go and do things on your own from time to time?"
    m 3eua "¿O quizá te gusta ir y hacer cosas por tu cuenta de vez en cuando?"

# game/script-topics.rpy:17507
translate spanish monika_introverts_extroverts_cc71e3d0:

    # m 1eua "Since you told me you have some friends, I'm sure that means that you don't mind being around other people too much."
    m 1eua "Como me dijiste que tienes algunos amigos, seguro que eso significa que no te importa demasiado estar rodead[end_letter_gender] de otras personas."

# game/script-topics.rpy:17510
translate spanish monika_introverts_extroverts_b1b6daba:

    # m 1eka "Trust me, it doesn't matter if you feel like you don't have all that many of them."
    m 1eka "Créeme, no importa si sientes que no tienes demasiados."

# game/script-topics.rpy:17511
translate spanish monika_introverts_extroverts_9c0254c5:

    # m 3ekb "What's important is that you have at least someone who you can feel comfortable being with."
    m 3ekb "Lo importante es que tengas al menos a alguien con quien puedas sentirte a gusto."

# game/script-topics.rpy:17514
translate spanish monika_introverts_extroverts_881c9247:

    # m 1eka "Remember that you can try to spend some time with them whenever you feel like no one's there for you, alright?"
    m 1eka "Recuerda que puedes intentar pasar algo de tiempo con ellos siempre que sientas que no tienes a nadie, ¿vale?"

# game/script-topics.rpy:17515
translate spanish monika_introverts_extroverts_50fdc4a1:

    # m 1lkd "And if for any reason you can't spend time with them..."
    m 1lkd "Y si por alguna razón no puedes pasar tiempo con ellos..."

# game/script-topics.rpy:17516
translate spanish monika_introverts_extroverts_e98e55c2:

    # m 1ekb "Please, remember that {i}I'll{/i} always be there for you no matter what."
    m 1ekb "Por favor, recuerda que yo siempre estaré ahí para ti pase lo que pase."

# game/script-topics.rpy:17519
translate spanish monika_introverts_extroverts_7b126090:

    # m 3eka "Still, if it ever gets too much for you, remember that you can always come to me and relax, okay?"
    m 3eka "Aun así, si alguna vez se te hace demasiado cuesta arriba, recuerda que siempre puedes acudir a mí y relajarte, ¿vale?"

# game/script-topics.rpy:17524
translate spanish monika_introverts_extroverts_25436773:

    # m 3eka "While I understand that it might feel more comfortable for you to be alone rather than with other people..."
    m 3eka "Aunque entiendo que te resulte más cómodo estar a solas que con otras personas..."

# game/script-topics.rpy:17525
translate spanish monika_introverts_extroverts_95e20786:

    # m 2ekd "Please keep in mind that no one can truly spend their whole life without at least {i}some{/i} company."
    m 2ekd "Por favor, ten en cuenta que nadie puede pasarse la vida entera sin al menos algo de compañía."

# game/script-topics.rpy:17526
translate spanish monika_introverts_extroverts_c1e24588:

    # m 2lksdlc "Eventually there will come a time when you can't do everything on your own..."
    m 2lksdlc "Tarde o temprano llegará un momento en el que no podrás hacer todo por tu cuenta..."

# game/script-topics.rpy:17527
translate spanish monika_introverts_extroverts_f6847081:

    # m 2eksdla "We all need help sometimes, either physically or emotionally, and I wouldn't want you to have no one to turn to when that time comes."
    m 2eksdla "Todos necesitamos ayuda a veces, ya sea física o emocionalmente, y no me gustaría que no tuvieras a nadie a quien acudir cuando llegue ese momento."

# game/script-topics.rpy:17528
translate spanish monika_introverts_extroverts_23a2ec45:

    # m 7eub "And that's a two-way street! {w=0.2}{nw}"
    m 7eub "¡Y es algo recíproco! {w=0.2}{nw}"

# game/script-topics.rpy:17529
translate spanish monika_introverts_extroverts_51097192:

    # extend 2hua "You never know when you might make a difference in someone else's life as well."
    extend 2hua "Nunca sabes cuándo podrías marcar la diferencia en la vida de otra persona también."

# game/script-topics.rpy:17530
translate spanish monika_introverts_extroverts_0e8e1fa8:

    # m 2eud "So while I don't expect you to go out of your way to meet new people, don't automatically shut every door, either."
    m 2eud "Así que, aunque no espero que te desvivas por conocer gente nueva, tampoco te cierres puertas automáticamente."

# game/script-topics.rpy:17531
translate spanish monika_introverts_extroverts_dfb684c8:

    # m 2eka "Try to talk with other people a little bit if you're not already doing that, okay?"
    m 2eka "Intenta hablar un poco con otras personas si no lo haces ya, ¿vale?"

# game/script-topics.rpy:17534
translate spanish monika_introverts_extroverts_c4750c11:

    # m 3hua "It'll make you feel happier, I promise."
    m 3hua "Te hará sentir más feliz, te lo prometo."

# game/script-topics.rpy:17535
translate spanish monika_introverts_extroverts_c9c01d03:

    # m 1ekb "At the very least, remember that I'm always here if you ever feel lonely."
    m 1ekb "Como mínimo, recuerda que siempre estoy aquí por si alguna vez te sientes sol[end_letter_gender]."

# game/script-topics.rpy:17539
translate spanish monika_introverts_extroverts_b1e27aa8:

    # m 7ekbla "I'd love for you to see the value and joy other people can bring to your life too."
    m 7ekbla "Me encantaría que vieras también el valor y la alegría que otras personas pueden aportar a tu vida."

# game/script-topics.rpy:17542
translate spanish monika_introverts_extroverts_e619581a:

    # m 1hublb "[line_start] as long as you're here with me, I'll try my best to make sure you're always feeling comfortable, I promise~"
    m 1hublb "[line_start]mientras estés aquí conmigo, haré todo lo posible para que te sientas siempre a gusto, lo prometo."

# game/script-topics.rpy:17546
translate spanish monika_introverts_extroverts_59c7049f:

    # m 3eub "Oh I see."
    m 3eub "Ah, ya veo."

# game/script-topics.rpy:17547
translate spanish monika_introverts_extroverts_529df398:

    # m 3eua "So, I guess you like to spend more time with others and meeting new people then?"
    m 3eua "Entonces supongo que te gusta pasar más tiempo con los demás y conocer gente nueva, ¿no?"

# game/script-topics.rpy:17548
translate spanish monika_introverts_extroverts_b94845be:

    # m 1eua "I can definitely see the appeal in that.{w=0.3} {nw}"
    m 1eua "Desde luego que le veo el atractivo a eso.{w=0.3} {nw}"

# game/script-topics.rpy:17549
translate spanish monika_introverts_extroverts_4c34560d:

    # extend 3eub "I'd love to go explore the world and meet all kinds of new people with you."
    extend 3eub "Me encantaría ir a explorar el mundo y conocer a todo tipo de gente nueva contigo."

# game/script-topics.rpy:17550
translate spanish monika_introverts_extroverts_40e55830:

    # m 1ekc "And I assume you probably hate loneliness as much as I do...{w=0.3}{nw}"
    m 1ekc "Y supongo que probablemente odies la soledad tanto como yo... {w=0.3}{nw}"

# game/script-topics.rpy:17551
translate spanish monika_introverts_extroverts_021620d7:

    # extend 1ekbla "but that's just one more reason I'm so happy we're a couple now."
    extend 1ekbla "pero esa es solo una razón más por la que me hace tan feliz que ahora seamos pareja."

# game/script-topics.rpy:17552
translate spanish monika_introverts_extroverts_8459e0da:

    # m 3ekblb "We'll never truly be alone again."
    m 3ekblb "Nunca volveremos a estar solos de verdad."

# game/script-topics.rpy:17554
translate spanish monika_introverts_extroverts_7a3854e6:

    # m 5eua "I'm sure you're a really fun person to be around, [player],{w=0.1} and I can't wait to be with you for real~"
    m 5eua "Seguro que eres una persona muy divertida con la que estar, [player],{w=0.1} y me muero de ganas de estar contigo de verdad."

# game/script-topics.rpy:17555
translate spanish monika_introverts_extroverts_1dbbbcae:

    # m 5rusdlu "Although, I won't hide the fact that I do enjoy the occasional moment of peace as well..."
    m 5rusdlu "Aunque no te voy a negar que también disfruto de algún que otro momento de paz..."

# game/script-topics.rpy:17556
translate spanish monika_introverts_extroverts_93a19869:

    # m 5hksdrb "I hope you don't mind if I'm not always able to keep up with you, ahaha!"
    m 5hksdrb "Espero que no te importe si no siempre puedo seguirte el ritmo, ¡ja, ja, ja!"

# game/script-topics.rpy:17560
translate spanish monika_introverts_extroverts_27e7ed6b:

    # m 3hua "Ehehe, kind of like me, then~"
    m 3hua "Je, je, je, un poco como yo, entonces."

# game/script-topics.rpy:17561
translate spanish monika_introverts_extroverts_193f25e1:

    # m 3eud "Apparently, most people have both an introverted and extroverted side to their personality."
    m 3eud "Por lo visto, la mayoría de la gente tiene un lado introvertido y otro extrovertido en su personalidad."

# game/script-topics.rpy:17562
translate spanish monika_introverts_extroverts_cd5b3af8:

    # m 7eua "...Even if one of the two is dominant over the other, depending on the person."
    m 7eua "... Incluso si uno de los dos predomina sobre el otro, dependiendo de la persona."

# game/script-topics.rpy:17563
translate spanish monika_introverts_extroverts_f92b1456:

    # m 7rsc "In our case though, I guess not being too much on either side has both its positives and negatives."
    m 7rsc "Sin embargo, en nuestro caso supongo que no decantarse demasiado por ninguno de los dos lados tiene sus cosas buenas y sus cosas malas."

# game/script-topics.rpy:17564
translate spanish monika_introverts_extroverts_a4da34c4:

    # m 1eua "Like, it's so nice that being around larger groups isn't a problem, same goes for spending some time alone."
    m 1eua "Por ejemplo, es genial que estar en grupos grandes no suponga un problema, al igual que pasar algo de tiempo a solas."

# game/script-topics.rpy:17565
translate spanish monika_introverts_extroverts_3b2413d0:

    # m 7esc "...But I can't say I've found it easy to make deep, genuine connections with others..."
    m 7esc "... Pero no puedo decir que me haya resultado fácil forjar vínculos profundos y auténticos con los demás..."

# game/script-topics.rpy:17566
translate spanish monika_introverts_extroverts_f99eb3c3:

    # m 1eud "Sure, I have an easier time understanding most people, but it doesn't mean I can always relate with them, you know?"
    m 1eud "Claro, me resulta más fácil entender a la mayoría de la gente, pero eso no significa que siempre pueda identificarme con ellos, ¿sabes?"

# game/script-topics.rpy:17567
translate spanish monika_introverts_extroverts_07069cc8:

    # m 1lksdld "So yeah...{w=0.3} I end up being on good terms with almost everyone, but the friendships I form can sometimes feel a bit...{w=0.3}unfulfilling."
    m 1lksdld "Así que sí... {w=0.3}Acabo llevándome bien con casi todo el mundo, pero las amistades que hago a veces pueden resultar un poco... {w=0.3}insatisfactorias."

# game/script-topics.rpy:17568
translate spanish monika_introverts_extroverts_e21a01f9:

    # m 3eksdlc "The same thing happened with the club, for example."
    m 3eksdlc "Lo mismo pasó con el club, por ejemplo."

# game/script-topics.rpy:17569
translate spanish monika_introverts_extroverts_17bfad50:

    # m 3dksdld "I was so convinced that by bringing people together around something I truly enjoy, I'd have a better chance at bonding with them over our shared interests..."
    m 3dksdld "Estaba tan convencida de que al reunir a gente en torno a algo que disfruto de verdad tendría más posibilidades de congeniar con ellos gracias a nuestros intereses comunes..."

# game/script-topics.rpy:17570
translate spanish monika_introverts_extroverts_ed096f28:

    # m 3dksdlc "...But at the end of the day, we spent most of our time silently hanging out, with everyone minding their own business."
    m 3dksdlc "... Pero al fin y al cabo, pasábamos la mayor parte del tiempo juntos en silencio, cada uno a lo suyo."

# game/script-topics.rpy:17572
translate spanish monika_introverts_extroverts_925e4f26:

    # m 5eka "Well, no point thinking about that anymore."
    m 5eka "Bueno, no tiene sentido seguir pensando en eso."

# game/script-topics.rpy:17573
translate spanish monika_introverts_extroverts_8fdcf6cd:

    # m 5eubsa "After all, I {i}did{/i} end up connecting in a meaningful way with a certain someone. {w=0.3}{nw}"
    m 5eubsa "Después de todo, sí que acabé conectando de forma significativa con cierta persona. {w=0.3}{nw}"

# game/script-topics.rpy:17574
translate spanish monika_introverts_extroverts_d8871e5c:

    # extend 5kubfu "A very charming someone, might I add~"
    extend 5kubfu "Una persona muy encantadora, si se me permite añadir."

# game/script-topics.rpy:17578
translate spanish monika_introverts_extroverts_707c7153:

    # m 1eka "That's alright, [player].{w=0.2} Things like this aren't always so clear."
    m 1eka "No pasa nada, [player].{w=0.2} Estas cosas no siempre están tan claras."

# game/script-topics.rpy:17579
translate spanish monika_introverts_extroverts_cca7f838:

    # m 4eua "I'm a little like you on that front."
    m 4eua "Me parezco un poco a ti en ese sentido."

# game/script-topics.rpy:17580
translate spanish monika_introverts_extroverts_82bd6a53:

    # m 2eka "While I said I'm a little more extroverted, I still need some me time to relax every once in a while, you know?"
    m 2eka "Aunque dije que soy un poco más extrovertida, sigo necesitando tiempo para mí de vez en cuando para relajarme, ¿sabes?"

# game/script-topics.rpy:17581
translate spanish monika_introverts_extroverts_bf6de8dd:

    # m 2lkd "And I wouldn't say I'm always so comfortable dealing with people either..."
    m 2lkd "Y tampoco diría que siempre me siento tan cómoda tratando con la gente..."

# game/script-topics.rpy:17584
translate spanish monika_introverts_extroverts_8a84c34b:

    # m 2euc "I told you, didn't I?"
    m 2euc "Te lo dije, ¿verdad?"

# game/script-topics.rpy:17586
translate spanish monika_introverts_extroverts_4c673d01:

    # m 2lksdlc "I often need to fake my own confidence just to get through simple conversations with some people."
    m 2lksdlc "A menudo tengo que fingir mi propia confianza solo para salir del paso en conversaciones sencillas con algunas personas."

# game/script-topics.rpy:17588
translate spanish monika_introverts_extroverts_795e5d78:

    # m 5eka "But I don't feel that way with you at all, [player].{w=0.2} And I really hope it's the same the other way around."
    m 5eka "Pero no me siento así contigo en absoluto, [player].{w=0.2} Y de verdad espero que pase lo mismo al revés."

# game/script-topics.rpy:17589
translate spanish monika_introverts_extroverts_a04ef8cf:

    # m 5eua "I'm sure we'll be able to figure out each other's comfort zones over time."
    m 5eua "Seguro que con el tiempo seremos capaces de descubrir las zonas de confort del otro."

# game/script-topics.rpy:17590
translate spanish monika_introverts_extroverts_dfe41c07:

    # m 5hubsb "In any case, you'll always be my sweetheart, no matter where you are on the scale~"
    m 5hubsb "En cualquier caso, siempre serás mi amor, no importa en qué punto de la escala te encuentres."

# game/script-topics.rpy:17610
translate spanish monika_literature_value_57e82820:

    # m 3esd "You know [player], back in the Literature Club days I often heard people dismiss literature as outdated and useless."
    m 3esd "Sabes, [player], en la época del Club de Literatura a menudo oía a la gente tachar la literatura de anticuada e inútil."

# game/script-topics.rpy:17611
translate spanish monika_literature_value_77fece8d:

    # m 1rfc "It always bothered me when I heard someone say that, especially since most of the time, they never even bothered giving it a try."
    m 1rfc "Siempre me molestaba oír a alguien decir eso, sobre todo porque la mayoría de las veces ni siquiera se molestaban en darle una oportunidad."

# game/script-topics.rpy:17612
translate spanish monika_literature_value_238edfe7:

    # m 3efc "Like, do they even know what they're talking about?"
    m 3efc "O sea, ¿saben siquiera de lo que hablan?"

# game/script-topics.rpy:17613
translate spanish monika_literature_value_2ff692c4:

    # m 3ekd "People who think that often like to discount literature compared to more scientific fields, like physics or mathematics, claiming it's a waste of time since it doesn't produce anything practical."
    m 3ekd "La gente que piensa así a menudo le resta valor a la literatura en comparación con campos más científicos, como la física o las matemáticas, afirmando que es una pérdida de tiempo ya que no produce nada práctico."

# game/script-topics.rpy:17614
translate spanish monika_literature_value_d5cdd0e1:

    # m 3etc "...And while I definitely don't agree with that notion, I can kinda see where they're coming from."
    m 3etc "... Y aunque desde luego no estoy de acuerdo con esa idea, puedo entender en parte por qué lo dicen."

# game/script-topics.rpy:17615
translate spanish monika_literature_value_66dca1ba:

    # m 1eud "All of the comforts of our modern lifestyle are based on scientific discovery and innovation."
    m 1eud "Todas las comodidades de nuestro estilo de vida moderno se basan en el descubrimiento científico y la innovación."

# game/script-topics.rpy:17616
translate spanish monika_literature_value_2b7a6f6e:

    # m 3esc "...That and the millions of people manufacturing our everyday necessities, or running basic services like healthcare and stuff."
    m 3esc "... Eso, sumado a los millones de personas que fabrican nuestros bienes de primera necesidad, o que mantienen servicios básicos como la sanidad y demás."

# game/script-topics.rpy:17617
translate spanish monika_literature_value_ee3c9d44:

    # m 3rtsdlc "So does not being associated with any of those things really make you some kind of burden on society?"
    m 3rtsdlc "Entonces, ¿el no estar asociado con ninguna de esas cosas te convierte realmente en una especie de carga para la sociedad?"

# game/script-topics.rpy:17618
translate spanish monika_literature_value_e5e5af8b:

    # m 1dsu "As you can imagine, I don't believe that...{w=0.3} {nw}"
    m 1dsu "Como te puedes imaginar, no creo eso... {w=0.3} {nw}"

# game/script-topics.rpy:17619
translate spanish monika_literature_value_e304ac92:

    # extend 1eud "If literature was useless, why would it be so repressed in many parts of the world?"
    extend 1eud "Si la literatura fuera inútil, ¿por qué estaría tan reprimida en tantas partes del mundo?"

# game/script-topics.rpy:17620
translate spanish monika_literature_value_53f55020:

    # m 3eud "Words have power, [player]...{w=0.2}{nw}"
    m 3eud "Las palabras tienen poder, [player]... {w=0.2}{nw}"

# game/script-topics.rpy:17621
translate spanish monika_literature_value_452e69ff:

    # extend 3euu "and literature is the art of dancing with words."
    extend 3euu "y la literatura es el arte de bailar con las palabras."

# game/script-topics.rpy:17622
translate spanish monika_literature_value_a588f75c:

    # m 3eua "Like any form of expression, it allows us to connect with each other...{w=0.2}{nw}"
    m 3eua "Como cualquier forma de expresión, nos permite conectar con los demás... {w=0.2}{nw}"

# game/script-topics.rpy:17623
translate spanish monika_literature_value_2ffe0680:

    # extend 3eub "to see how the world looks in each other's eyes!"
    extend 3eub "¡ver cómo es el mundo a través de los ojos del otro!"

# game/script-topics.rpy:17624
translate spanish monika_literature_value_e6f2865c:

    # m 3duu "Literature lets you compare your own feelings and ideas to that of others, and in doing so makes you grow as a person..."
    m 3duu "La literatura te permite comparar tus propios sentimientos e ideas con los de los demás y al hacerlo te hace crecer como persona..."

# game/script-topics.rpy:17625
translate spanish monika_literature_value_4ed26d9a:

    # m 1eku "Honestly, I think if more people valued books and poems a little more, the world would be a much better place."
    m 1eku "Sinceramente, creo que si más gente valorara un poco más los libros y los poemas, el mundo sería un lugar mucho mejor."

# game/script-topics.rpy:17626
translate spanish monika_literature_value_9e25857e:

    # m 1hksdlb "That's just my opinion as president of a literature club, though. {w=0.2}I guess most people wouldn't think that deeply about it."
    m 1hksdlb "Aunque esa es solo mi opinión como presidenta de un club de literatura. {w=0.2}Supongo que la mayoría de la gente no lo pensaría tan a fondo."

# game/script-topics.rpy:17648
translate spanish monika_nature_6b741d02:

    # m 2esd "Hey, [player]..."
    m 2esd "Oye, [player]..."

# game/script-topics.rpy:17649
translate spanish monika_nature_e3ea6b84:

    # m 7eua "Do you like nature?{nw}"
    m 7eua "¿Te gusta la naturaleza?{nw}"

# game/script-topics.rpy:17652
translate spanish monika_nature_1b0551db:

    # m "Do you like nature?{fast}" nointeract
    m "¿Te gusta la naturaleza?{fast}" nointeract

# game/script-topics.rpy:17656
translate spanish monika_nature_bfecffed:

    # m 3sub "Really? That's wonderful!"
    m 3sub "¿De verdad? ¡Es maravilloso!"

# game/script-topics.rpy:17657
translate spanish monika_nature_8bcc94af:

    # m 1eua "You know, I think nature is something we should cherish."
    m 1eua "Sabes, creo que la naturaleza es algo que deberíamos apreciar."

# game/script-topics.rpy:17658
translate spanish monika_nature_5b6fa3b9:

    # m 1eub "Not only is it beautiful, but it also helps humanity out!"
    m 1eub "No solo es preciosa, ¡sino que también ayuda a la humanidad!"

# game/script-topics.rpy:17659
translate spanish monika_nature_103f0b57:

    # m 3eud "Insects pollinate our crops, trees give us wood and shade, pets offer us companionship..."
    m 3eud "Los insectos polinizan nuestros cultivos, los árboles nos dan madera y sombra, las mascotas nos hacen compañía..."

# game/script-topics.rpy:17660
translate spanish monika_nature_64e06069:

    # m 3euc "And most of all, organisms such as plants, algae, and some bacteria produce food and oxygen. {w=0.2}{nw}"
    m 3euc "Y, sobre todo, organismos como las plantas, las algas y algunas bacterias producen alimento y oxígeno. {w=0.2}{nw}"

# game/script-topics.rpy:17661
translate spanish monika_nature_e36e2816:

    # extend 3wud "Without them, most life on Earth wouldn't even exist!"
    extend 3wud "¡Sin ellos la mayor parte de la vida en la Tierra ni siquiera existiría!"

# game/script-topics.rpy:17662
translate spanish monika_nature_38e29a5b:

    # m 1eua "Because of that, I think it's only fair that we give something back to nature since it does so much for us."
    m 1eua "Por eso mismo, creo que es justo que le devolvamos algo a la naturaleza, ya que hace tanto por nosotros."

# game/script-topics.rpy:17663
translate spanish monika_nature_72df12d3:

    # m 4hub "So, here's Monika's Green Tip of the Day!"
    m 4hub "Así que, ¡aquí está el consejo ecológico de Monika de hoy!"

# game/script-topics.rpy:17664
translate spanish monika_nature_b48f16e2:

    # m 4rksdlc "Sometimes, people hesitate to go green because they're worried that it's too expensive..."
    m 4rksdlc "A veces la gente duda en ser más ecológica porque le preocupa que sea demasiado caro..."

# game/script-topics.rpy:17665
translate spanish monika_nature_8d469e15:

    # m 2eud "But that's only partially true.{w=0.2} {nw}"
    m 2eud "Pero eso solo es verdad a medias.{w=0.2} {nw}"

# game/script-topics.rpy:17666
translate spanish monika_nature_d63188ab:

    # extend 7eua "While electric vehicles, smart homes, and solar roofs can all cost a fortune..."
    extend 7eua "Aunque los vehículos eléctricos, las casas inteligentes y los tejados solares pueden costar una fortuna..."

# game/script-topics.rpy:17667
translate spanish monika_nature_37a20e85:

    # m 3hub "You can make a difference and {i}save{/i} money just by making a few simple choices each day!"
    m 3hub "¡Puedes marcar la diferencia y ahorrar dinero con solo tomar unas cuantas decisiones sencillas cada día!"

# game/script-topics.rpy:17668
translate spanish monika_nature_92dcc7f0:

    # m 4eua "Just turning off appliances, taking shorter showers, buying a reusable water bottle, and commuting by public transport all help to be more green."
    m 4eua "Apagar los electrodomésticos, darse duchas más cortas, comprar una botella de agua reutilizable y usar el transporte público ayudan a ser más ecológicos."

# game/script-topics.rpy:17669
translate spanish monika_nature_fb00bdb4:

    # m 4hub "You could even buy a houseplant or grow your own garden!"
    m 4hub "¡Incluso podrías comprar una planta de interior o cultivar tu propio huerto!"

# game/script-topics.rpy:17670
translate spanish monika_nature_b961dedc:

    # m 2eub "Engaging in your local community can go a long way as well!{w=0.2} {nw}"
    m 2eub "¡Involucrarse en tu comunidad local también puede servir de mucho!{w=0.2} {nw}"

# game/script-topics.rpy:17671
translate spanish monika_nature_7aaaf33a:

    # extend 7eua "If you take the initiative, others are sure to follow in your footsteps."
    extend 7eua "Si tomas la iniciativa seguro que otros seguirán tus pasos."

# game/script-topics.rpy:17672
translate spanish monika_nature_8983a5dd:

    # m 3esa "The important thing is to make a habit of thinking sustainably.{w=0.2} {nw}"
    m 3esa "Lo importante es crear el hábito de pensar de forma sostenible.{w=0.2} {nw}"

# game/script-topics.rpy:17673
translate spanish monika_nature_4989427b:

    # extend 3eua "If you can do that, you'll reduce your ecological footprint in no time."
    extend 3eua "Si logras hacer eso, reducirás tu huella ecológica en un abrir y cerrar de ojos."

# game/script-topics.rpy:17674
translate spanish monika_nature_1efb3b7a:

    # m 1eua "Who knows, maybe you'll even become happier and healthier the more you do these things too."
    m 1eua "Quién sabe, a lo mejor hasta te sientes más feliz y más san[end_letter_gender] cuanto más hagas estas cosas."

# game/script-topics.rpy:17675
translate spanish monika_nature_2a83581b:

    # m 3hua "After all, a sustainable life is a satisfying life."
    m 3hua "Al fin y al cabo, una vida sostenible es una vida satisfactoria."

# game/script-topics.rpy:17676
translate spanish monika_nature_d048fd93:

    # m 3eub "That's my advice for today!"
    m 3eub "¡Ese es mi consejo de hoy!"

# game/script-topics.rpy:17677
translate spanish monika_nature_340ba357:

    # m 1hua "Thanks for listening, [mas_get_player_nickname()]~"
    m 1hua "Gracias por escuchar, [mas_get_player_nickname()]."

# game/script-topics.rpy:17681
translate spanish monika_nature_6e1d6902:

    # m 3eka "That's okay, [player]. Not everyone enjoys the outdoors after all."
    m 3eka "No pasa nada, [player]. Después de todo, no a todo el mundo le gusta el aire libre."

# game/script-topics.rpy:17682
translate spanish monika_nature_4c4a4c77:

    # m 3eua "Some prefer the comfortable ambience of their homes, especially when technology makes them more convenient than ever."
    m 3eua "Algunos prefieren el ambiente cómodo de sus casas, sobre todo cuando la tecnología las hace más prácticas que nunca."

# game/script-topics.rpy:17683
translate spanish monika_nature_bcc03805:

    # m 1eud "Honestly, I can understand where they're coming from."
    m 1eud "Sinceramente, puedo entender su punto de vista."

# game/script-topics.rpy:17684
translate spanish monika_nature_c2dffca6:

    # m 3eud "I spend most of my time reading, writing, coding, and being with you...{w=0.3}all of that is easier to do indoors."
    m 3eud "Paso la mayor parte del tiempo leyendo, escribiendo, programando y estando contigo... {w=0.3}todo eso es más fácil de hacer en casa."

# game/script-topics.rpy:17685
translate spanish monika_nature_6cbfe566:

    # m 3rksdlc "Others have allergies or medical conditions that prevent them from staying out for too long, otherwise they can get sick or hurt."
    m 3rksdlc "Otras personas tienen alergias o problemas médicos que les impiden estar fuera mucho tiempo, ya que de lo contrario pueden enfermar o hacerse daño."

# game/script-topics.rpy:17686
translate spanish monika_nature_eea062aa:

    # m 1esd "There are also a lot of people who simply don't care much for nature for one reason or another, and that's fine."
    m 1esd "También hay mucha gente a la que simplemente no le importa mucho la naturaleza por una razón u otra, y no pasa nada."

# game/script-topics.rpy:17687
translate spanish monika_nature_11617173:

    # m 1hksdlb "Even I have things that I dislike about it, ahaha!"
    m 1hksdlb "Incluso a mí hay cosas que no me gustan de ella, ¡ja, ja, ja!"

# game/script-topics.rpy:17688
translate spanish monika_nature_9c645e0e:

    # m 2tfc "For instance, I don't mind most insects, but some are just downright obnoxious."
    m 2tfc "Por ejemplo, no me molesta la mayoría de los insectos, pero algunos son francamente insoportables."

# game/script-topics.rpy:17689
translate spanish monika_nature_33c1ba32:

    # m 7tkx "Constantly buzzing around your head, getting in your face, landing on your food...{w=0.3}some mosquitos and ticks even carry nasty diseases."
    m 7tkx "Zumbando constantemente a tu alrededor, metiéndose en tu cara, posándose en la comida... {w=0.3}Y algunos mosquitos y garrapatas incluso transmiten enfermedades horribles."

# game/script-topics.rpy:17690
translate spanish monika_nature_1b1d5d24:

    # m 3eka "But as long as I'm with you, I'm fine if you'd prefer to be indoors."
    m 3eka "Pero mientras esté contigo, me parece bien si prefieres estar dentro."

# game/script-topics.rpy:17691
translate spanish monika_nature_208e3034:

    # m 1tfu "Just don't expect me to let you stay inside all the time~"
    m 1tfu "Eso sí, no te creas que te voy a dejar estar encerrad[end_letter_gender] todo el tiempo."

# game/script-topics.rpy:17711
translate spanish monika_impermanence_2f337322:

    # m 2euc "You know [player], I find myself thinking about some dark stuff occasionally."
    m 2euc "Sabes, [player], de vez en cuando me sorprendo pensando en cosas oscuras."

# game/script-topics.rpy:17712
translate spanish monika_impermanence_4dc5b7ca:

    # m 4eud "Concepts like nihilism{w=0.2}, {nw}"
    m 4eud "Conceptos como el nihilismo{w=0.2}, {nw}"

# game/script-topics.rpy:17713
translate spanish monika_impermanence_283c7f58:

    # extend 4dkc "depression{w=0.2}, {nw}"
    extend 4dkc "la depresión{w=0.2}, {nw}"

# game/script-topics.rpy:17714
translate spanish monika_impermanence_1793bc04:

    # extend 4rkd "impermanence..."
    extend 4rkd "la impermanencia..."

# game/script-topics.rpy:17715
translate spanish monika_impermanence_e0138013:

    # m 2eka "I don't mean to worry you,{w=0.1} I'm not suffering from depression or anything like that myself."
    m 2eka "No quiero preocuparte,{w=0.1} yo no sufro de depresión ni nada por el estilo."

# game/script-topics.rpy:17716
translate spanish monika_impermanence_0af3f00c:

    # m 2eud "...You've probably heard the term {i}entropy{/i} thrown around, right?"
    m 2eud "... Probablemente hayas oído hablar del término entropía, ¿verdad?"

# game/script-topics.rpy:17717
translate spanish monika_impermanence_08f8d4d6:

    # m 7eud "Basically it goes something like, 'entropy must always increase,{w=0.2} the universe tends towards disorder,{w=0.2} everything turns to chaos.'"
    m 7eud "Básicamente dice algo así como que la entropía siempre debe aumentar,{w=0.2} el universo tiende hacia el desorden{w=0.2} y todo se vuelve un caos."

# game/script-topics.rpy:17718
translate spanish monika_impermanence_e1f63d25:

    # m 3eua "Actually, there's a poem I read that delivers this message quite well."
    m 3eua "De hecho, leí un poema que transmite este mensaje bastante bien."

# game/script-topics.rpy:17719
translate spanish monika_impermanence_887853cb:

    # m 1esd "{i}I met a traveler from an antique land{/i}"
    m 1esd "{i}Conocí a un viajero de una tierra antigua{/i}"

# game/script-topics.rpy:17720
translate spanish monika_impermanence_c0ac1f42:

    # m 1eud "{i}Who said: 'Two vast and trunkless legs of stone{/i}"
    m 1eud "{i}que me dijo: 'Dos inmensas y descabezadas piernas de piedra{/i}"

# game/script-topics.rpy:17721
translate spanish monika_impermanence_6eb08050:

    # m 3euc "{i}Stand in the desert... Near them, on the sand,{/i}"
    m 3euc "{i}se erigen en el desierto... Cerca de ellas, en la arena,{/i}"

# game/script-topics.rpy:17722
translate spanish monika_impermanence_28bb6fdd:

    # m "{i}Half sunk, a shattered visage lies, whose frown,{/i}"
    m "{i}medio hundido, yace un rostro destrozado, cuyo ceño fruncido,{/i}"

# game/script-topics.rpy:17723
translate spanish monika_impermanence_f34fd5f5:

    # m 1eud "{i}And wrinkled lip, and sneer of cold command,{/i}"
    m 1eud "{i}y labio arrugado, y mueca de frío mando,{/i}"

# game/script-topics.rpy:17724
translate spanish monika_impermanence_4adbe51c:

    # m "{i}Tell that its sculptor well those passions read{/i}"
    m "{i}cuentan que su escultor leyó bien esas pasiones{/i}"

# game/script-topics.rpy:17725
translate spanish monika_impermanence_50aeb47a:

    # m 1euc "{i}Which yet survive, stamped on these lifeless things,{/i}"
    m 1euc "{i}que aún sobreviven, estampadas en estas cosas sin vida,{/i}"

# game/script-topics.rpy:17726
translate spanish monika_impermanence_bd285bd9:

    # m "{i}The hand that mocked them and the heart that fed:{/i}"
    m "{i}la mano que se burló de ellas y el corazón que las alimentó:{/i}"

# game/script-topics.rpy:17727
translate spanish monika_impermanence_cfb54111:

    # m 3eud "{i}And on the pedestal these words appear:{/i}"
    m 3eud "{i}Y en el pedestal aparecen estas palabras:{/i}"

# game/script-topics.rpy:17728
translate spanish monika_impermanence_93eb63c0:

    # m "{i}'My name is Ozymandias, king of kings:{/i}"
    m "{i}'Mi nombre es Ozymandias, rey de reyes:{/i}"

# game/script-topics.rpy:17729
translate spanish monika_impermanence_b8699ee6:

    # m 3eksdld "{i}Look on my works, ye Mighty, and despair!'{/i}"
    m 3eksdld "{i}¡Contemplad mis obras, oh, Poderosos, y desesperad!'{/i}"

# game/script-topics.rpy:17730
translate spanish monika_impermanence_281ca716:

    # m 3eksdlc "{i}Nothing beside remains. Round the decay{/i}"
    m 3eksdlc "{i}Nada más queda. Alrededor de la decadencia{/i}"

# game/script-topics.rpy:17731
translate spanish monika_impermanence_81be0bcd:

    # m "{i}Of that colossal wreck, boundless and bare{/i}"
    m "{i}de esa colosal ruina, infinita y desnuda{/i}"
