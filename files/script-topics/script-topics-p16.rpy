# game/script-topics.rpy:12292
translate spanish monika_grad_speech_a89633be:

    # m 4eka "{w=0.2}It is truly inspiring.{w=0.6}{nw}"
    m 4eka "{w=0.2}Es verdaderamente inspirador.{w=0.6}{nw}"

# game/script-topics.rpy:12293
