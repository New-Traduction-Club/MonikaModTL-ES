    m 4eka "{w=0.2}En este mundo de infinitas opciones,{w=0.3} creo que todos tenéis lo que hay que tener para alcanzar vuestros sueños.{w=0.6}{nw}"

# game/script-topics.rpy:12300
translate spanish monika_grad_speech_2e2aa2b5:

    # m 4hub "{w=0.2}Thank you all for making these four short years the best they could have been.{w=0.6}{nw}"
    m 4hub "{w=0.2}Gracias a todos por hacer que estos cuatro cortos años hayan sido los mejores que podrían haber sido.{w=0.6}{nw}"

# game/script-topics.rpy:12301
translate spanish monika_grad_speech_d4a76585:

