    m 2duu "{w=0.2}.{w=0.3}.{w=0.3}.{w=0.6}{nw}"

# game/script-topics.rpy:12276
translate spanish monika_grad_speech_885d4372:

    # m 2eua "{w=0.2}I know I can't speak for everyone here,{w=0.3} but there is one thing I can say for sure:{w=0.7} my experience in high school wouldn't be complete without the clubs I was a part of.{w=0.6}{nw}"
    m 2eua "{w=0.2}Sé que no puedo hablar por todos los presentes,{w=0.3} pero hay algo que puedo afirmar con seguridad:{w=0.7} mi experiencia en el instituto no estaría completa sin los clubes de los que formé parte.{w=0.6}{nw}"

# game/script-topics.rpy:12277
translate spanish monika_grad_speech_caf58725:

    # m 4eua "{w=0.2}Debate club taught me a lot about dealing with people and how to properly handle heated situations.{w=0.6}{nw}"
    m 4eua "{w=0.2}El club de debate me enseñó mucho sobre el trato con la gente y sobre cómo manejar adecuadamente las situaciones tensas.{w=0.6}{nw}"

# game/script-topics.rpy:12278
translate spanish monika_grad_speech_3be5c0f6:

    # m 4eub "Starting the Literature Club,{w=0.7} however,{w=0.7} was one of the best things I ever did.{w=0.6}{nw}"
    m 4eub "Sin embargo,{w=0.7} fundar el Club de Literatura{w=0.7} fue una de las mejores cosas que he hecho nunca.{w=0.6}{nw}"

# game/script-topics.rpy:12279
translate spanish monika_grad_speech_e2353b54:

    # m 4hub "{w=0.2}I met the best friends I could have possibly imagined,{w=0.3} and I learned a lot about leadership.{w=0.6}{nw}"
    m 4hub "{w=0.2}Conocí a los mejores amigos que jamás hubiera podido imaginar,{w=0.3} y aprendí muchísimo sobre liderazgo.{w=0.6}{nw}"

# game/script-topics.rpy:12280
translate spanish monika_grad_speech_4a57741b:

    # m 2eka "{w=0.2}Sure,{w=0.3} not all of you may have decided to start your own clubs,{w=0.3} but I'm sure plenty of you had the opportunities to learn these values nonetheless.{w=0.6}{nw}"
    m 2eka "{w=0.2}Está claro que{w=0.3} no todos habréis decidido fundar vuestros propios clubes,{w=0.3} pero estoy segura de que muchos habréis tenido la oportunidad de aprender estos valores de todos modos.{w=0.6}{nw}"

# game/script-topics.rpy:12281
translate spanish monika_grad_speech_f907f5ba:

    # m 4eub "{w=0.2}Maybe you yourself got into a position in band where you had to lead your instrument section,{w=0.3} or maybe you were the captain of a sports team!{w=0.6}{nw}"
    m 4eub "{w=0.2}A lo mejor conseguisteis un puesto en la banda en el que tuvisteis que dirigir vuestra sección de instrumentos,{w=0.3} ¡o a lo mejor fuisteis los capitanes de un equipo deportivo!{w=0.6}{nw}"

# game/script-topics.rpy:12282
translate spanish monika_grad_speech_c14d983d:

    # m 2eka "{w=0.2}All these small roles teach you so much about the future and how to manage both{w=0.3} projects and people,{w=0.3} in an environment you enjoy, nonetheless.{w=0.6}{nw}"
    m 2eka "{w=0.2}Todos estos pequeños papeles os enseñan mucho sobre el futuro y sobre cómo gestionar tanto{w=0.3} proyectos como personas,{w=0.3} y además en un entorno del que disfrutáis.{w=0.6}{nw}"

# game/script-topics.rpy:12283
translate spanish monika_grad_speech_35c38c41:

    # m "{w=0.2}If you didn't join a club,{w=0.3} I encourage you to at least try something in your future paths.{w=0.6}{nw}"
    m "{w=0.2}Si no os unisteis a un club,{w=0.3} os animo a que al menos intentéis algo en vuestro camino futuro.{w=0.6}{nw}"

# game/script-topics.rpy:12284
translate spanish monika_grad_speech_6b70aa31:

    # m 4eua "{w=0.2}I can assure you that you won't regret it.{w=0.6}{nw}"
    m 4eua "{w=0.2}Os puedo asegurar que no os arrepentiréis.{w=0.6}{nw}"

# game/script-topics.rpy:12285
translate spanish monika_grad_speech_db7fdb51_3:

    # m 2duu "{w=0.2}.{w=0.3}.{w=0.3}.{w=0.6}{nw}"
    m 2duu "{w=0.2}.{w=0.3}.{w=0.3}.{w=0.6}{nw}"

# game/script-topics.rpy:12286
translate spanish monika_grad_speech_2d2a8747:

    # m 2eua "{w=0.2}As of today,{w=0.3} it may seem like we're at the top of the world.{w=0.7}{nw}"
    m 2eua "{w=0.2}A día de hoy,{w=0.3} puede parecer que estamos en la cima del mundo.{w=0.7}{nw}"

# game/script-topics.rpy:12287
translate spanish monika_grad_speech_80bca2aa:

