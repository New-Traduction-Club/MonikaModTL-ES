    # m 2eua "{w=0.2}The ambition in all of you will surely lead to greatness.{w=0.6}{nw}"
    m 2eua "{w=0.2}La ambición que hay en todos vosotros seguramente os llevará a la grandeza.{w=0.6}{nw}"

# game/script-topics.rpy:12274
translate spanish monika_grad_speech_86ba2fa8:

    # m 4hub "I can see it.{w=0.6}{nw}"
