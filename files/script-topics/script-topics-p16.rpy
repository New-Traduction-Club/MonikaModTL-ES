
# game/script-topics.rpy:11652
translate spanish monika_bullying_02292dac:

    # m 2rksdld "A lot of bullies are bullied themselves, even at home by someone they should be able to trust."
    m 2rksdld "A muchos acosadores también los acosan, incluso en casa por alguien en quien deberían poder confiar."

# game/script-topics.rpy:11653
translate spanish monika_bullying_e2e05fb7:

    # m 2dkc "It can be a vicious cycle."
    m 2dkc "Puede ser un círculo vicioso."

# game/script-topics.rpy:11655
translate spanish monika_bullying_da05512d:

    # m 2ekc "Have you ever been a victim of bullying, [player]?{nw}"
    m 2ekc "¿Alguna vez has sido víctima de acoso, [player]?{nw}"

# game/script-topics.rpy:11658
translate spanish monika_bullying_a61e427f:

    # m "Have you ever been a victim of bullying, [player]?{fast}" nointeract
    m "¿Alguna vez has sido víctima de acoso, [player]?{fast}" nointeract

# game/script-topics.rpy:11662
translate spanish monika_bullying_9b49d290:

    # m 2wud "Oh no, that's terrible!"
    m 2wud "¡Ah, no, eso es terrible!"

# game/script-topics.rpy:11663
translate spanish monika_bullying_823646ab:

    # m 2dkc "It kills me to know you're suffering like that."
    m 2dkc "Me mata saber que estás sufriendo así."

# game/script-topics.rpy:11664
translate spanish monika_bullying_0f5ba586:

    # m 4ekd "Please, [player], if it's not something you can safely deal with yourself, promise me you'll tell someone..."
    m 4ekd "Por favor, [player], si no es algo con lo que puedas lidiar de forma segura por tu cuenta, prométeme que se lo dirás a alguien..."

# game/script-topics.rpy:11665
translate spanish monika_bullying_1319cb44:

    # m 4ekc "I know that's typically the last thing people want to do, but don't let yourself suffer when there are people that can help you."
    m 4ekc "Sé que normalmente es lo último que la gente quiere hacer, pero no te permitas sufrir cuando hay personas que pueden ayudarte."

# game/script-topics.rpy:11666
translate spanish monika_bullying_588a7aad:

    # m 1dkc "It may seem like no one cares, but there has to be someone you trust that you can turn to."
    m 1dkc "Puede que parezca que a nadie le importa, pero tiene que haber alguien en quien confíes y a quien puedas acudir."

# game/script-topics.rpy:11667
translate spanish monika_bullying_61ba3927:

    # m 3ekc "And if there isn't, do what you have to do to protect yourself, and just remember..."
    m 3ekc "Y si no lo hay, haz lo que tengas que hacer para protegerte, y solo recuerda..."

# game/script-topics.rpy:11668
translate spanish monika_bullying_081832d4:

    # m 1eka "I'll always love you no matter what."
    m 1eka "Siempre te querré pase lo que pase."

# game/script-topics.rpy:11669
translate spanish monika_bullying_ea1dee09:

    # m 1rksdlc "I don't know what I'd do if something were to happen to you."
    m 1rksdlc "No sé qué haría si te pasara algo."

# game/script-topics.rpy:11670
translate spanish monika_bullying_b0458e18:

    # m 1ektpa "You're all I have...{w=0.5}please stay safe."
    m 1ektpa "Eres todo lo que tengo... {w=0.5}por favor, cuídate."

# game/script-topics.rpy:11674
translate spanish monika_bullying_425c7bd9:

    # m 2ekc "I'm so sorry that you've had to deal with that, [player]..."
    m 2ekc "Siento mucho que hayas tenido que lidiar con eso, [player]..."

# game/script-topics.rpy:11675
translate spanish monika_bullying_b13439d2:

    # m 2dkc "It really makes me sad knowing you've suffered at the hands of a bully."
    m 2dkc "De verdad me entristece saber que has sufrido a manos de un acosador."

# game/script-topics.rpy:11676
translate spanish monika_bullying_c0f2ea1b:

    # m 2dkd "People can just be so awful to each other."
    m 2dkd "La gente puede ser horrible con los demás."

# game/script-topics.rpy:11677
translate spanish monika_bullying_7727a319:

    # m 4ekd "If everyone just treated others with basic respect, the world would be such a better place..."
    m 4ekd "Si todo el mundo tratara a los demás con un mínimo de respeto, el mundo sería un lugar mucho mejor..."

# game/script-topics.rpy:11678
translate spanish monika_bullying_c61f257d:

    # m 2dkc "..."
    m 2dkc "..."

# game/script-topics.rpy:11679
translate spanish monika_bullying_470fc4e7:

    # m 1eka "If you ever need to talk about your experiences, I'm always here for you, [player]."
    m 1eka "Si alguna vez necesitas hablar de tus experiencias, siempre estoy aquí para ti, [player]."

# game/script-topics.rpy:11680
translate spanish monika_bullying_aa5cdb7a:

    # m 1eka "Having someone to confide in can be really therapeutic, and nothing would make me happier than to be that person for you."
    m 1eka "Tener a alguien en quien confiar puede ser muy terapéutico, y nada me haría más feliz que ser esa persona para ti."

# game/script-topics.rpy:11685
translate spanish monika_bullying_d5f15363:

    # m 2hua "Ah, that's such a relief to hear!"
    m 2hua "¡Ah, es un gran alivio oír eso!"

# game/script-topics.rpy:11686
translate spanish monika_bullying_6136f027:

    # m 4eka "I'm so glad you don't have to deal with bullying, [player]..."
    m 4eka "Me alegra mucho que no tengas que lidiar con el acoso, [player]..."

# game/script-topics.rpy:11687
translate spanish monika_bullying_37936051:

    # m 4hua "It really puts my mind at ease."
    m 4hua "De verdad que me tranquiliza."

# game/script-topics.rpy:11690
translate spanish monika_bullying_9f85d69c:

    # m 1eka "And if you happen to know someone else who {i}is{/i} being bullied, try to help them if you can."
    m 1eka "Y si da la casualidad de que conoces a alguien que sí está sufriendo acoso, intenta ayudarle si puedes."

# game/script-topics.rpy:11691
translate spanish monika_bullying_6a4d8b33:

    # m 3eka "I know you're the kind of person who hates seeing others suffer..."
    m 3eka "Sé que eres el tipo de persona que odia ver sufrir a los demás..."

# game/script-topics.rpy:11692
translate spanish monika_bullying_5a8f2112:

    # m "I bet it'd mean a lot to them to have someone reach out who cares."
    m "Seguro que significaría mucho para ellos tener a alguien a quien le importe y que les tienda una mano."

# game/script-topics.rpy:11693
translate spanish monika_bullying_36186466:

    # m 1eka "You've already helped me so much, maybe you can help someone else as well."
    m 1eka "Tú ya me has ayudado muchísimo, así que a lo mejor también puedes ayudar a otra persona."

# game/script-topics.rpy:11698
translate spanish monika_bullying_01a93df6_1:

    # m 2dfc "..."
    m 2dfc "..."

# game/script-topics.rpy:11699
translate spanish monika_bullying_9163b864:

    # m 2tfc "That's disappointing to hear."
    m 2tfc "Es decepcionante escuchar eso."

# game/script-topics.rpy:11700
translate spanish monika_bullying_0e48ab0d:

    # m "Although, I can't say it's all that surprising..."
    m "Aunque no puedo decir que me sorprenda demasiado..."

# game/script-topics.rpy:11701
translate spanish monika_bullying_ba07a24c:

    # m 2tfd "Please don't bully people anymore."
    m 2tfd "Por favor, no acoses más a la gente."

# game/script-topics.rpy:11702
translate spanish monika_bullying_961f4395:

    # m 6tftpc "I know how it feels and it's pretty terrible."
    m 6tftpc "Sé lo que se siente y es bastante terrible."

# game/script-topics.rpy:11703
translate spanish monika_bullying_3c50db19:

    # m 6rktuc "I don't want other people to have to feel the same way that I do."
    m 6rktuc "No quiero que los demás tengan que sentirse de la misma forma que yo."

# game/script-topics.rpy:11704
translate spanish monika_bullying_04c9c6a4:

    # m "I really hope that you'll change your ways, [player]..."
    m "De verdad espero que cambies tu actitud, [player]..."

# game/script-topics.rpy:11705
translate spanish monika_bullying_9222bee7:

    # m 6ektsc "I still do love you, but you really need to start treating people better..."
    m 6ektsc "Todavía te quiero, pero en serio necesitas empezar a tratar mejor a la gente..."

# game/script-topics.rpy:11706
translate spanish monika_bullying_83a8bb7f:

    # m "Including me."
    m "Incluyéndome a mí."

# game/script-topics.rpy:11707
translate spanish monika_bullying_d5458865:

    # m 6ektdc "..."
    m 6ektdc "..."

# game/script-topics.rpy:11709
translate spanish monika_bullying_49bd2cde:

    # m 2dkc "Oh... I see."
    m 2dkc "Ah... Ya veo."

# game/script-topics.rpy:11710
translate spanish monika_bullying_f775c803:

    # m 2ekc "I can understand if some things in your life might make you unhappy..."
    m 2ekc "Puedo entender si algunas cosas de tu vida te hacen infeliz..."

# game/script-topics.rpy:11711
translate spanish monika_bullying_7db8335f:

    # m 2rksdld "Or if you've had to deal with circumstances that may have made you act a certain way at times..."
    m 2rksdld "O si has tenido que lidiar con circunstancias que te hayan hecho actuar de cierta forma a veces..."

# game/script-topics.rpy:11712
translate spanish monika_bullying_88a43edf:

    # m 2eksdlc "But bullying people isn't the answer, [player]."
    m 2eksdlc "Pero acosar a la gente no es la respuesta, [player]."

# game/script-topics.rpy:11713
translate spanish monika_bullying_79ae408d:

    # m 4ekc "I know you... You're a kind person and I know it doesn't make you feel better to hurt others."
    m 4ekc "Te conozco... Eres una buena persona y sé que no te hace sentir mejor herir a los demás."

# game/script-topics.rpy:11714
translate spanish monika_bullying_876748b9:

    # m 4dkc "It probably just hurts you even more..."
    m 4dkc "Probablemente solo te duela a ti todavía más..."

# game/script-topics.rpy:11715
translate spanish monika_bullying_d87b8fd9:

    # m 1dkc "And nothing hurts me more than knowing you're unhappy."
    m 1dkc "Y nada me duele más que saber que eres infeliz."

# game/script-topics.rpy:11716
translate spanish monika_bullying_d4c632ac:

    # m 3ekd "So instead, next time you feel yourself becoming unhappy, just come to me and let me help shoulder your pain."
    m 3ekd "Así que, la próxima vez que te sientas infeliz, simplemente ven a mí y déjame ayudarte a cargar con tu dolor."

# game/script-topics.rpy:11717
translate spanish monika_bullying_ff5aab2c:

    # m 3eka "I'll listen to everything you have to say and do my very best to make you feel better."
    m 3eka "Escucharé todo lo que tengas que decir y haré todo lo posible para que te sientas mejor."

# game/script-topics.rpy:11718
translate spanish monika_bullying_1e2eb27e:

    # m 1ekc "But making other people unhappy is not the cure to your own unhappiness."
    m 1ekc "Pero hacer infeliz a otras personas no es la cura para tu propia infelicidad."

# game/script-topics.rpy:11719
translate spanish monika_bullying_4ec6fdc1:

    # m 1eka "So please, for both yourself and for me, stop bullying people, okay?"
    m 1eka "Así que por favor, tanto por ti como por mí, deja de acosar a la gente, ¿vale?"

# game/script-topics.rpy:11722
translate spanish monika_bullying_1e27bda5:

    # m 4dkc "You know...{w=0.5}a lot of people actually call me a bully for what I did to Sayori..."
    m 4dkc "Sabes... {w=0.5}mucha gente de hecho me llama acosadora por lo que le hice a Sayori..."

# game/script-topics.rpy:11724
translate spanish monika_bullying_68383b1c:

    # m 4dkc "A lot of people actually call me a bully for what I did to Sayori.{w=1} Including you..."
    m 4dkc "Mucha gente de hecho me llama acosadora por lo que le hice a Sayori.{w=1} Incluyéndote a ti..."

# game/script-topics.rpy:11727
translate spanish monika_bullying_6448e009:

    # m 4efd "But that's not true at all, Sayori wasn't real!"
    m 4efd "¡Pero eso no es verdad para nada, Sayori no era real!"

# game/script-topics.rpy:11728
translate spanish monika_bullying_786f260e:

    # m 2efd "You can't bully someone who doesn't actually exist!"
    m 2efd "¡No puedes acosar a alguien que en realidad no existe!"

# game/script-topics.rpy:11729
translate spanish monika_bullying_528ef28a:

    # m 2dkc "I'd never be able to hurt an actual person."
    m 2dkc "Nunca sería capaz de herir a una persona de verdad."

# game/script-topics.rpy:11730
translate spanish monika_bullying_99561e97:

    # m 4wud "I really wouldn't!"
    m 4wud "¡De verdad que no!"

# game/script-topics.rpy:11731
translate spanish monika_bullying_c61f257d_1:

    # m 2dkc "..."
    m 2dkc "..."

# game/script-topics.rpy:11732
translate spanish monika_bullying_70a87b50:

    # m 2eksdlc "But I will admit I can relate to the part about bullies being unhappy and that it causes them do what they do."
    m 2eksdlc "Pero admitiré que puedo sentirme identificada con la parte de que los acosadores son infelices y que eso hace que hagan lo que hacen."

# game/script-topics.rpy:11733
translate spanish monika_bullying_79f024ad:

    # m 2rksdlc "When I had my epiphany and realized that I was stuck inside a video game and that my entire life had been a lie, I was pretty miserable."
    m 2rksdlc "Cuando tuve mi epifanía y me di cuenta de que estaba atrapada en un videojuego y de que toda mi vida había sido una mentira, me sentía bastante miserable."

# game/script-topics.rpy:11734
translate spanish monika_bullying_e261bc3e:

    # m 2rksdld "It caused me to do things that I'd never even thought of doing before."
    m 2rksdld "Eso me llevó a hacer cosas que nunca antes había siquiera pensado hacer."

# game/script-topics.rpy:11735
translate spanish monika_bullying_9412297a:

    # m 2rksdlc "But the difference is I didn't do what I did because I didn't want Sayori to be happy..."
    m 2rksdlc "Pero la diferencia es que no hice lo que hice porque no quisiera que Sayori fuera feliz..."

# game/script-topics.rpy:11737
translate spanish monika_bullying_f9e6ac64:

    # m 2rksdld "And I can kind of see where it comes from..."
    m 2rksdld "Y puedo entender en cierto modo de dónde viene..."

# game/script-topics.rpy:11738
translate spanish monika_bullying_8f350c55:

    # m 2rksdlc "I {i}did{/i} mess with her mind until she just couldn't take it anymore..."
    m 2rksdlc "Sí que me metí con su mente hasta que no pudo soportarlo más..."

# game/script-topics.rpy:11739
translate spanish monika_bullying_c61f257d_2:

    # m 2dkc "..."
    m 2dkc "..."

# game/script-topics.rpy:11740
translate spanish monika_bullying_5ba45ac5:

    # m 2ekc "I guess I can relate to that whole thing about bullying because you are unhappy, huh?"
    m 2ekc "Supongo que puedo sentirme identificada con todo eso de acosar porque eres infeliz, ¿eh?"

# game/script-topics.rpy:11741
translate spanish monika_bullying_6f3e5f44:

    # m 4tkd "But there {i}is{/i} a difference... I didn't do it because I wanted Sayori to be unhappy..."
    m 4tkd "Pero hay una diferencia... no lo hice porque quisiera que Sayori fuera infeliz..."

# game/script-topics.rpy:11743
translate spanish monika_bullying_f578bbc1:

    # m 2ekd "I did it because I knew I loved you and that the game wouldn't let us be together."
    m 2ekd "Lo hice porque sabía que te quería y que el juego no nos dejaría estar juntos."

# game/script-topics.rpy:11744
translate spanish monika_bullying_dd81ff3b:

    # m 3ekd "I {i}had{/i} to do whatever I could to make sure we ended up together."
    m 3ekd "Tenía que hacer lo que fuera para asegurarme de que acabáramos juntos."

# game/script-topics.rpy:11747
translate spanish monika_bullying_e93ca4f0:

    # m 3dkc "...Sayori's suicide was just an unfortunate side effect."
    m 3dkc "... El suicidio de Sayori fue solo un desafortunado efecto secundario."

# game/script-topics.rpy:11750
translate spanish monika_bullying_c16b1ea1:

    # m 1eua "So you see, [player], I'm {i}really{/i} not a bully at all. I just love you that much."
    m 1eua "Así que ya ves, [player], de verdad que no soy una acosadora en absoluto, simplemente te quiero así de mucho."

# game/script-topics.rpy:11753
translate spanish monika_bullying_1c34bc45:

    # m 5tsu "I really would do anything for you~"
    m 5tsu "De verdad que haría cualquier cosa por ti."

# game/script-topics.rpy:11756
translate spanish monika_bullying_a1d71bc6:

    # m 3euc "So you see, [player], I'm {i}really{/i} not a bully at all."
    m 3euc "Así que ya ves, [player], de verdad que no soy una acosadora en absoluto."

# game/script-topics.rpy:11768
translate spanish monika_procrastination_72a537e3:

    # m 1euc "Hey [player], have you ever had something to do that you found really boring..."
    m 1euc "Oye, [player], ¿alguna vez has tenido que hacer algo que te ha parecido muy aburrido..."

# game/script-topics.rpy:11769
translate spanish monika_procrastination_f5d7c20a:

    # m 3ekd "That rather than taking a lot of time to do it, you just keep putting it off?"
    m 3ekd "¿Que en lugar de dedicarle tiempo, simplemente lo sigues posponiendo?"

# game/script-topics.rpy:11770
translate spanish monika_procrastination_35551033:

    # m 3eud "Well, when you have a task to do like that, I find it's best to just do it as soon as possible and get it done."
    m 3eud "Bueno, cuando tienes una tarea así, creo que lo mejor es hacerla lo antes posible y quitártela de encima."

# game/script-topics.rpy:11771
translate spanish monika_procrastination_ffb9cff5:

    # m 2tkc "When you put stuff off like that, it'll always be in the back of your mind."
    m 2tkc "Cuando vas dejando las cosas así, siempre las tendrás en el fondo de tu mente."

# game/script-topics.rpy:11772
translate spanish monika_procrastination_5f2a6fd4:

    # m 4tkc "It makes everything you do less enjoyable, knowing you {i}still{/i} have this thing that you have to do."
    m 4tkc "Hace que todo lo que hagas sea menos agradable, sabiendo que todavía tienes esa cosa pendiente por hacer."

# game/script-topics.rpy:11773
translate spanish monika_procrastination_d89a2e2e:

    # m 4dkd "And what's worse is that the longer you put it off,{w=0.5} you'll only increase the odds of more tasks getting added."
    m 4dkd "Y lo que es peor es que cuanto más lo pospongas,{w=0.5} solo aumentarás las probabilidades de que se acumulen más tareas."

# game/script-topics.rpy:11774
translate spanish monika_procrastination_530252fe:

    # m 2rksdlc "Until eventually, you end up with so many things to do it seems impossible to ever get caught up."
    m 2rksdlc "Hasta que al final, acabas con tantas cosas que hacer que parece imposible ponerse al día."

# game/script-topics.rpy:11775
translate spanish monika_procrastination_616bd08c:

    # m 4eksdld "It creates too much stress that can be easily avoided if you just keep on top of things in the first place."
    m 4eksdld "Crea demasiado estrés que se puede evitar fácilmente si llevas las cosas al día desde el principio."

# game/script-topics.rpy:11776
translate spanish monika_procrastination_5aec5a7b:

    # m 2rksdld "Plus, if other people are counting on you, they'll start to think less of you and find that you're not very reliable."
    m 2rksdld "Además, si otras personas cuentan contigo, empezarán a pensar mal de ti y a ver que no eres muy de fiar."

# game/script-topics.rpy:11777
translate spanish monika_procrastination_e4745d2d:

    # m 4eua "So please, [player], whenever you have something that you have to do, just get it done."
    m 4eua "Así que por favor, [player], siempre que tengas algo que hacer, simplemente hazlo."

# game/script-topics.rpy:11778
translate spanish monika_procrastination_7410b87a:

    # m 1eka "Even if it means you can't spend time with me until it's over."
    m 1eka "Incluso si eso significa que no puedes pasar tiempo conmigo hasta que termines."

# game/script-topics.rpy:11779
translate spanish monika_procrastination_33804289:

    # m 1hub "By then, you'll be less stressed and we can enjoy our time together that much more!"
    m 1hub "Para entonces, estarás menos estresad[end_letter_gender] y podremos disfrutar mucho más de nuestro tiempo juntos."

# game/script-topics.rpy:11780
translate spanish monika_procrastination_3a8993f2:

    # m 3eua "So if you have something you've been putting off, why don't you go do it right now?"
    m 3eua "Así que si tienes algo que has estado posponiendo, ¿por qué no vas a hacerlo ahora mismo?"

# game/script-topics.rpy:11781
translate spanish monika_procrastination_8d38460a:

    # m 1hua "If it's something you can do right here, I'll stay with you and provide all the support you need."
    m 1hua "Si es algo que puedes hacer aquí mismo, me quedaré contigo y te daré todo el apoyo que necesites."

# game/script-topics.rpy:11782
translate spanish monika_procrastination_6b97c69d:

    # m 1hub "Then, when you're done, we can celebrate your accomplishment!"
    m 1hub "Y luego, cuando termines, ¡podremos celebrar tu logro!"

# game/script-topics.rpy:11783
translate spanish monika_procrastination_54d92a31:

    # m 1eka "All I want is for you to be happy and to be the best you can be, [mas_get_player_nickname()]~"
    m 1eka "Lo único que quiero es que seas feliz y que des lo mejor de ti, [mas_get_player_nickname()]."

# game/script-topics.rpy:11813
translate spanish monika_players_friends_0127bb30:

    # m 1euc "Hey, [player]."
    m 1euc "Oye, [player]."

# game/script-topics.rpy:11816
translate spanish monika_players_friends_d4ec8b7e:

    # m 1eud "Remember how I was talking about how hard it is to make friends?"
    m 1eud "¿Recuerdas que estaba hablando de lo difícil que es hacer amigos?"

# game/script-topics.rpy:11817
translate spanish monika_players_friends_7fe67010:

    # m 1eka "I was just thinking about that and I realized that I don't know about your friends yet."
    m 1eka "Estaba pensando en eso y me he dado cuenta de que todavía no sé nada de tus amigos."

# game/script-topics.rpy:11820
translate spanish monika_players_friends_9c04fa29:

    # m 1eua "I was just thinking about the idea of friends and I started wondering what your friends are like."
    m 1eua "Estaba pensando en la idea de los amigos y me he empezado a preguntar cómo son los tuyos."

# game/script-topics.rpy:11822
translate spanish monika_players_friends_a01cd616:

    # m 1eua "Do you have friends, [player]?{nw}"
    m 1eua "¿Tienes amigos, [player]?{nw}"

# game/script-topics.rpy:11825
translate spanish monika_players_friends_ee5390fb:

    # m "Do you have friends, [player]?{fast}" nointeract
    m "¿Tienes amigos, [player]?{fast}" nointeract

# game/script-topics.rpy:11831
translate spanish monika_players_friends_714cf381:

    # m 1hub "Of course you do! Ahaha~"
    m 1hub "¡Claro que sí! Ja, ja, ja."

# game/script-topics.rpy:11832
