# game/script-topics.rpy:12270
translate spanish monika_grad_speech_f16628ec:

    # m 2eud "{w=0.2}Some of us have gone from being quiet and reserved,{w=0.3} to expressive and outgoing.{w=0.6}{nw}"
    m 2eud "{w=0.2}Algunos han pasado de ser callados y reservados,{w=0.3} a ser expresivos y extrovertidos.{w=0.6}{nw}"

# game/script-topics.rpy:12271
