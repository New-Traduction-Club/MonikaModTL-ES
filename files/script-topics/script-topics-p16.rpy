    m 2esa "{w=0.2}Cada uno de vosotros ha demostrado de lo que es capaz{w=0.3} y todos habéis demostrado que podéis trabajar duro por vuestros sueños.{w=0.6}{nw}"

# game/script-topics.rpy:12297
translate spanish monika_grad_speech_abcdff31:

    # m 2hub "{w=0.2}I hope you are as proud of yourselves as I am.{w=0.7}{nw}"
    m 2hub "{w=0.2}Espero que estéis tan orgullosos de vosotros mismos como lo estoy yo.{w=0.7}{nw}"

# game/script-topics.rpy:12298
translate spanish monika_grad_speech_bce98771:

    # m 2ekd "{w=0.2}Now that this entire chapter of our lives--{w=0.3}step one,{w=0.3} has come to an end,{w=0.3} it is now time for us to part ways.{w=0.6}{nw}"
