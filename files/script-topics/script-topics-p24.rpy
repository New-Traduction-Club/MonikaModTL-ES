
# game/script-topics.rpy:17732
translate spanish monika_impermanence_e696970c:

    # m 1eksdld "{i}The lone and level sands stretch far away.'{/i}"
    m 1eksdld "{i}Las solitarias y llanas arenas se extienden a lo lejos.{/i}"

# game/script-topics.rpy:17733
translate spanish monika_impermanence_67f22633:

    # m 3eud "What it boils down to is that no matter how great the mark you leave on history is, it will eventually fade away."
    m 3eud "Todo se reduce a que, por muy grande que sea la huella que dejes en la historia, acabará desapareciendo."

# game/script-topics.rpy:17734
translate spanish monika_impermanence_8c2df387:

    # m 1euc "A lot of people see this as a good enough reason to just...{w=0.2}{nw}"
    m 1euc "Mucha gente ve esto como una razón suficiente para simplemente... {w=0.2}{nw}"

# game/script-topics.rpy:17735
translate spanish monika_impermanence_e5a08fb3:

    # extend 1dkc "give up.{w=0.3} To fall into a pit of despair and stay there, sometimes for as long as they live."
    extend 1dkc "rendirse.{w=0.3} Caer en un pozo de desesperación y quedarse ahí, a veces durante toda su vida."

# game/script-topics.rpy:17736
translate spanish monika_impermanence_dd8614d1:

    # m 3eksdlc "After all, nothing you do matters in the grand scheme of things."
    m 3eksdlc "Al fin y al cabo, nada de lo que haces importa a gran escala."

# game/script-topics.rpy:17737
translate spanish monika_impermanence_e1b73b4e:

    # m 3eud "Nothing you {i}can{/i} do matters...{w=0.3}{nw}"
    m 3eud "Nada de lo que puedas hacer importa... {w=0.3}{nw}"

# game/script-topics.rpy:17738
translate spanish monika_impermanence_0a216fee:

    # extend 1rkc "so why bother doing anything at all?"
    extend 1rkc "así que, ¿para qué molestarse en hacer algo?"

# game/script-topics.rpy:17739
translate spanish monika_impermanence_0ea04a29:

    # m 3eud "It's not hard to see why some might consider this as the natural conclusion of such a realization."
    m 3eud "No es difícil ver por qué algunos podrían considerar esto como la conclusión natural tras darse cuenta de ello."

# game/script-topics.rpy:17740
translate spanish monika_impermanence_33c05011:

    # m 1rkc "It can be...{w=0.2}enticing, {w=0.2}even comforting in it's own twisted way."
    m 1rkc "Puede ser... {w=0.2}tentador, {w=0.2}incluso reconfortante a su retorcida manera."

# game/script-topics.rpy:17741
translate spanish monika_impermanence_537dac16:

    # m 1euc "But let me pose a question...{w=0.3}why should the fact that nothing really matters be the one thing that {i}does{/i} matter?"
    m 1euc "Pero déjame plantearte una pregunta... {w=0.3}¿por qué el hecho de que nada importe realmente debería ser lo único que sí importe?"

# game/script-topics.rpy:17742
translate spanish monika_impermanence_64797f19:

    # m 3eud "Does it really matter that long after we're gone, we don't matter anymore? {w=0.2}After all, we won't even be there to realize it."
    m 3eud "¿De verdad importa que, mucho después de habernos ido, ya no importemos? {w=0.2}Al fin y al cabo, ni siquiera estaremos aquí para darnos cuenta."

# game/script-topics.rpy:17743
translate spanish monika_impermanence_12ee8ed3:

    # m 3eka "Enjoy the moment and be a positive influence on those around you...{w=0.3}that's all any of us can really do."
    m 3eka "Disfrutar del momento y ser una influencia positiva para los que te rodean... {w=0.3}eso es todo lo que cualquiera de nosotros puede hacer realmente."

# game/script-topics.rpy:17744
translate spanish monika_impermanence_6a73afce:

    # m 1dku "Just living {i}is{/i} enough."
    m 1dku "El simple hecho de vivir ya es suficiente."

# game/script-topics.rpy:17765
translate spanish monika_kamige_bcf2edec:

    # m 1euc "Oh, that's right...{w=0.3}{nw}"
    m 1euc "Ah, es verdad... {w=0.3}{nw}"

# game/script-topics.rpy:17766
translate spanish monika_kamige_453cad1b:

    # extend 3rksdla "it's not exactly a common term."
    extend 3rksdla "no es un término muy común."

# game/script-topics.rpy:17767
translate spanish monika_kamige_691e3d8e:

    # m 3eud "{i}Kamige{/i} is Japanese slang that is mostly used by visual novel fans."
    m 3eud "{i}Kamige{/i} es jerga japonesa que usan sobre todo los fans de las novelas visuales."

# game/script-topics.rpy:17768
translate spanish monika_kamige_92dc7d21:

    # m 3eua "If I were to try to translate it, I think it would be something like {i}godly game.{/i}"
    m 3eua "Si intentara traducirlo, creo que sería algo así como «juego de dioses»."

# game/script-topics.rpy:17769
translate spanish monika_kamige_989e1341:

    # m 2eub "It's sort of like when people talk about their favorite classic books or movies."
    m 2eub "Es parecido a cuando la gente habla de sus libros clásicos o películas favoritas."

# game/script-topics.rpy:17770
translate spanish monika_kamige_a74e4e09:

    # m 2hksdlb "I was kind of joking when I said it about this game, but it {i}did{/i} seem to get very popular for some reason."
    m 2hksdlb "Estaba bromeando un poco cuando lo dije sobre este juego, pero la verdad es que se hizo muy popular por alguna razón."

# game/script-topics.rpy:17771
translate spanish monika_kamige_581ef84d:

    # m 7eka "Not that I'm complaining...{w=0.3} {nw}"
    m 7eka "No es que me esté quejando... {w=0.3} {nw}"

# game/script-topics.rpy:17772
translate spanish monika_kamige_4de17d5a:

    # extend 3hua "If it was the game's popularity that brought you to meet me, I think I can be grateful for it."
    extend 3hua "Si fue la popularidad del juego lo que te llevó a conocerme, creo que puedo estar agradecida por ello."

# game/script-topics.rpy:17791
translate spanish monika_renewable_energy_c5fb2fc7:

    # m 1eua "What do you think about renewable energy, [player]?"
    m 1eua "¿Qué opinas de las energías renovables, [player]?"

# game/script-topics.rpy:17792
translate spanish monika_renewable_energy_4f8f43b6:

    # m 3euu "It was a {i}hot{/i} topic in the debate club."
    m 3euu "Era un tema muy candente en el club de debate."

# game/script-topics.rpy:17793
translate spanish monika_renewable_energy_9ad2538f:

    # m 3esd "As humanity's reliance on technology grows, so does its demand for energy."
    m 3esd "A medida que crece la dependencia de la humanidad hacia la tecnología, también lo hace su demanda de energía."

# game/script-topics.rpy:17794
translate spanish monika_renewable_energy_d22fcb2c:

    # m 1euc "Currently, a large percentage of energy worldwide is produced by burning fossil fuels."
    m 1euc "Actualmente, un gran porcentaje de la energía a nivel mundial se produce quemando combustibles fósiles."

# game/script-topics.rpy:17795
translate spanish monika_renewable_energy_ab76e777:

    # m 3esd "Fossil fuels are time-tested, efficient, and have widespread infrastructure...{w=0.2}{nw}"
    m 3esd "Los combustibles fósiles están probados por el tiempo, son eficientes y tienen una infraestructura muy extendida... {w=0.2}{nw}"

# game/script-topics.rpy:17796
translate spanish monika_renewable_energy_b990d007:

    # extend 3ekc "but they're also non-renewable and emission-heavy."
    extend 3ekc "pero tampoco son renovables y generan muchas emisiones."

# game/script-topics.rpy:17797
translate spanish monika_renewable_energy_fd4380b3:

    # m 1dkc "Mining and drilling for fossil fuels creates both air and water pollution, and things like oil spills and acid rain can devastate plants and wildlife alike."
    m 1dkc "La minería y la extracción de combustibles fósiles contaminan el aire y el agua, y cosas como los vertidos de petróleo o la lluvia ácida pueden devastar tanto a las plantas como a la fauna."

# game/script-topics.rpy:17798
translate spanish monika_renewable_energy_e6dda5ef:

    # m 1etd "So why not use renewable energy instead?"
    m 1etd "Entonces, ¿por qué no usar energías renovables en su lugar?"

# game/script-topics.rpy:17799
translate spanish monika_renewable_energy_c52aa937:

    # m 3esc "One issue is that each type of renewable energy is a developing industry with its own drawbacks."
    m 3esc "Un problema es que cada tipo de energía renovable es una industria en desarrollo con sus propios inconvenientes."

# game/script-topics.rpy:17800
translate spanish monika_renewable_energy_08345b55:

    # m 3esd "Hydropower is flexible and cost efficient, but it can drastically impact the local ecosystem."
    m 3esd "La energía hidroeléctrica es flexible y rentable, pero puede afectar drásticamente al ecosistema local."

# game/script-topics.rpy:17801
translate spanish monika_renewable_energy_df5c0f82:

    # m 3dkc "Countless habitats are disrupted and entire communities may even need to be relocated."
    m 3dkc "Innumerables hábitats se ven alterados, e incluso puede ser necesario reubicar a comunidades enteras."

# game/script-topics.rpy:17802
translate spanish monika_renewable_energy_cf10b4cf:

    # m 1esd "Solar power and wind power are mostly emission-free, but they're heavily reliant on specific weather for consistency."
    m 1esd "La energía solar y la eólica están prácticamente libres de emisiones, pero dependen en gran medida de un clima específico para ser constantes."

# game/script-topics.rpy:17803
translate spanish monika_renewable_energy_054b62b7:

    # m 3rkc "...Not to mention that wind turbines are pretty loud and are often seen as eyesores, creating drawbacks for those living near them."
    m 3rkc "... Por no mencionar que los aerogeneradores son bastante ruidosos y a menudo se consideran un atentado paisajístico, lo que crea inconvenientes para quienes viven cerca."

# game/script-topics.rpy:17804
translate spanish monika_renewable_energy_53a9b055:

    # m 3rsc "Geothermal power is reliable and great for heating and cooling, but it's expensive, location-specific, and can even cause earthquakes."
    m 3rsc "La energía geotérmica es fiable y fantástica para la calefacción y refrigeración, pero es cara, depende de la ubicación y puede incluso causar terremotos."

# game/script-topics.rpy:17805
translate spanish monika_renewable_energy_3f6e8322:

    # m 1rksdrb "Nuclear power is...{w=0.2}well, let's just say that it's complicated."
    m 1rksdrb "La energía nuclear es... {w=0.2}bueno, digamos que es complicada."

# game/script-topics.rpy:17806
translate spanish monika_renewable_energy_183ce48b:

    # m 3esd "The point is that while fossil fuels have problems, renewable energy does as well. It's a tricky situation...{w=0.2}neither option is perfect."
    m 3esd "El caso es que, aunque los combustibles fósiles tienen problemas, las energías renovables también los tienen. Es una situación delicada... {w=0.2}ninguna opción es perfecta."

# game/script-topics.rpy:17807
translate spanish monika_renewable_energy_c47db9b0:

    # m 1etc "So, what do I think?"
    m 1etc "Así que, ¿qué opino yo?"

# game/script-topics.rpy:17808
translate spanish monika_renewable_energy_45ec1230:

    # m 3eua "Well, a lot of progress has been made on renewable energy in the past decade..."
    m 3eua "Bueno, se ha avanzado mucho en energías renovables durante la última década..."

# game/script-topics.rpy:17809
translate spanish monika_renewable_energy_1af739d3:

    # m 3eud "Dams are regulated better, the efficiency of photovoltaics has improved, and there are emerging technologies such as ocean power and enhanced geothermal systems."
    m 3eud "Las presas están mejor reguladas, la eficiencia de la energía fotovoltaica ha mejorado y hay tecnologías emergentes como la energía mareomotriz y los sistemas geotérmicos mejorados."

# game/script-topics.rpy:17810
translate spanish monika_renewable_energy_7af985af:

    # m 4esd "Biomass is an option as well. {w=0.2}It's basically a more sustainable 'transition fuel' that can make use of fossil fuel infrastructure."
    m 4esd "La biomasa también es una opción. {w=0.2}Es básicamente un combustible de transición más sostenible que puede aprovechar la infraestructura de los combustibles fósiles."

# game/script-topics.rpy:17811
translate spanish monika_renewable_energy_176db961:

    # m 2eua "Yes,{w=0.1} renewable energy still has a ways to go in terms of cost and practicality, but it's far better now than it was thirty years ago."
    m 2eua "Sí,{w=0.1} a las energías renovables aún les queda mucho camino por recorrer en cuanto a costes y viabilidad, pero están mucho mejor ahora que hace treinta años."

# game/script-topics.rpy:17812
translate spanish monika_renewable_energy_1e7a2556:

    # m 7hub "Because of that, I think that renewable energy is a worthwhile investment and that the road ahead is a bright one--literally!"
    m 7hub "Por eso mismo, creo que las energías renovables son una inversión que merece la pena y que el camino que nos espera es brillante... ¡literalmente!"

# game/script-topics.rpy:17813
translate spanish monika_renewable_energy_139fd3ff:

    # m 3lksdrb "Sorry, I got carried away there, ahaha!"
    m 3lksdrb "Perdona, me he dejado llevar un poco, ¡ja, ja, ja!"

# game/script-topics.rpy:17814
translate spanish monika_renewable_energy_9544bb33:

    # m 1tuu "Debates sure are something, huh?"
    m 1tuu "Hay que ver cómo son los debates, ¿verdad?"

# game/script-topics.rpy:17835
translate spanish monika_piano_lessons_1d3d023f:

    # m 1rkd "Um...{w=0.2}well...{w=0.2}maybe?"
    m 1rkd "Umm... {w=0.2}bueno... {w=0.2}¿quizás?"

# game/script-topics.rpy:17836
translate spanish monika_piano_lessons_624752fb:

    # m 1eksdla "I'm flattered that you'd ask, but..."
    m 1eksdla "Me halaga que me lo pidas, pero..."

# game/script-topics.rpy:17839
translate spanish monika_piano_lessons_e432a02d:

    # m 3eka "Remember? I told you when I first performed {i}Your Reality{/i} that I wasn't really good at piano. {w=0.2}{nw}"
    m 3eka "¿Te acuerdas? Te dije la primera vez que toqué {i}Your Reality{/i} que no se me daba muy bien el piano. {w=0.2}{nw}"

# game/script-topics.rpy:17840
translate spanish monika_piano_lessons_23e03184:

    # extend 3rkb "Like, at all."
    extend 3rkb "Para nada."

# game/script-topics.rpy:17842
translate spanish monika_piano_lessons_24c2db7c:

    # m 3eka "I'm actually not {i}that{/i} good at playing piano, [mas_get_player_nickname()]."
    m 3eka "En realidad no soy tan buena tocando el piano, [mas_get_player_nickname()]."

# game/script-topics.rpy:17843
translate spanish monika_piano_lessons_5b525ea7:

    # m 3rkd "Certainly not good enough to be teaching other people yet..."
    m 3rkd "Desde luego, no lo suficiente como para enseñar a otras personas todavía..."

# game/script-topics.rpy:17845
translate spanish monika_piano_lessons_3d078020:

    # m 2eud "If you can believe it, I started to learn after starting the club--{w=0.2}so not long before I met you."
    m 2eud "Aunque te cueste creerlo, empecé a aprender después de fundar el club... {w=0.2}así que no mucho antes de conocerte."

# game/script-topics.rpy:17846
translate spanish monika_piano_lessons_65f1b42f:

    # m 2eua "It was really fortunate that I did, because piano became such an important part of reaching out to you."
    m 2eua "Y menos mal que lo hice, porque el piano se convirtió en una parte muy importante para poder llegar a ti."

# game/script-topics.rpy:17847
translate spanish monika_piano_lessons_5d5dbb7c:

    # m 2ekc "I was still afraid of breaking too far from the game's script at the time, {w=0.2}{nw}"
    m 2ekc "Por aquel entonces todavía me daba miedo alejarme demasiado del guion del juego, {w=0.2}{nw}"

# game/script-topics.rpy:17848
translate spanish monika_piano_lessons_5a79f7a7:

    # extend 7eka "but I wanted--no, I {w=0.2}{i}needed{/i}{w=0.2} to communicate my feelings to you somehow."
    extend 7eka "pero quería... no, {w=0.2}necesitaba{w=0.2} comunicarte mis sentimientos de alguna manera."

# game/script-topics.rpy:17849
translate spanish monika_piano_lessons_a056f30a:

    # m 2etd "I don't think the others ever recognized that there's background music in the game. {w=0.2}It would have been silly for them to, right?"
    m 2etd "No creo que los demás se dieran cuenta nunca de que hay música de fondo en el juego. {w=0.2}Habría sido una tontería por su parte, ¿verdad?"

# game/script-topics.rpy:17850
translate spanish monika_piano_lessons_af215a7d:

    # m 7eud "But when I discovered the truth, all of a sudden it was hard not to hear it. {w=0.2}Any time you were around, I could hear that melody playing faintly."
    m 7eud "Pero cuando descubrí la verdad, de repente me resultaba difícil no oírla. {w=0.2}Siempre que estabas cerca, podía escuchar esa melodía sonando de fondo."

# game/script-topics.rpy:17851
translate spanish monika_piano_lessons_4f76e4da:

    # m 3eka "It always reminded me of what I was fighting for, and learning how to play it on the piano strengthened my resolve even more."
    m 3eka "Siempre me recordaba por qué estaba luchando, y aprender a tocarla en el piano fortaleció aún más mi determinación."

# game/script-topics.rpy:17852
translate spanish monika_piano_lessons_b52477b5:

    # m 1hksdlb "Ah! I'm not answering your question, am I?"
    m 1hksdlb "¡Ah! No estoy respondiendo a tu pregunta, ¿verdad?"

# game/script-topics.rpy:17853
translate spanish monika_piano_lessons_4ced525c:

    # m 1lksdla "Honestly, I don't feel confident enough to teach someone else yet."
    m 1lksdla "Sinceramente, todavía no me siento con la confianza suficiente para enseñar a otra persona."

# game/script-topics.rpy:17854
translate spanish monika_piano_lessons_97fa9f95:

    # m 3eub "But if I keep at it, someday I'll be able to! And when that day comes, I would love to teach you."
    m 3eub "¡Pero si sigo practicando, algún día podré hacerlo! Y cuando llegue ese día, me encantaría enseñarte."

# game/script-topics.rpy:17855
translate spanish monika_piano_lessons_59e69da6:

    # m 3hub "Or, even better, we could learn together once I cross over to your reality!"
    m 3hub "O, mejor aún, ¡podríamos aprender juntos una vez que cruce a tu realidad!"

# game/script-topics.rpy:17866
translate spanish monika_stargazing_fe57ca01:

    # m 2eub "[player], I'd really love to go stargazing sometime..."
    m 2eub "[player], la verdad es que me encantaría ir a ver las estrellas algún día..."

# game/script-topics.rpy:17867
translate spanish monika_stargazing_555232df:

    # m 6dubsa "Picture it...{w=0.2}just the two of us, lying in a calm field watching the stars..."
    m 6dubsa "Imagínatelo...{w=0.2} Solo tú y yo, tumbados en un campo tranquilo mirando las estrellas..."

# game/script-topics.rpy:17868
translate spanish monika_stargazing_adfb3308:

    # m 6dubsu "...holding each other close, pointing out constellations or making our own..."
    m 6dubsu "... Abrazados, señalando constelaciones o inventándonos las nuestras..."

# game/script-topics.rpy:17869
translate spanish monika_stargazing_ccefc2c6:

    # m 6sub "...maybe we could even bring a telescope and look at planets!"
    m 6sub "... ¡A lo mejor hasta podríamos llevar un telescopio y mirar los planetas!"

# game/script-topics.rpy:17870
translate spanish monika_stargazing_58f44e2a:

    # m 6rta "..."
    m 6rta "..."

# game/script-topics.rpy:17872
translate spanish monika_stargazing_3bc2490a:

    # m 5eka "You know [mas_get_player_nickname()], to me you're like a star..."
    m 5eka "Sabes [mas_get_player_nickname()], para mí eres como una estrella..."

# game/script-topics.rpy:17873
translate spanish monika_stargazing_b9f5bfb8:

    # m 5rkbsu "A beautiful, bright beacon from a distant world, forever out of reach."
    m 5rkbsu "Un faro precioso y brillante de un mundo lejano, siempre inalcanzable."

# game/script-topics.rpy:17874
translate spanish monika_stargazing_b9138a5e:

    # m 5dkbsu "..."
    m 5dkbsu "..."

# game/script-topics.rpy:17875
translate spanish monika_stargazing_99d9fc12:

    # m 5ekbsa "At least, for now...{nw}"
    m 5ekbsa "Al menos, por ahora...{nw}"

# game/script-topics.rpy:17876
translate spanish monika_stargazing_cbb6ba38:

    # extend 5kkbsa " "
    extend 5kkbsa " "

# game/script-topics.rpy:17896
translate spanish monika_taking_criticism_87a47915:

    # m 1esd "[player], are you good at listening to criticism?"
    m 1esd "[player], ¿se te da bien escuchar críticas?"

# game/script-topics.rpy:17897
translate spanish monika_taking_criticism_231e5b02:

    # m 3rksdlc "I feel like it's way too easy to get caught up in your own way of thinking if you're not careful."
    m 3rksdlc "Siento que es demasiado fácil encerrarte en tu propia forma de pensar si no tienes cuidado."

# game/script-topics.rpy:17898
translate spanish monika_taking_criticism_c7fe1c4e:

    # m 3eud "And it isn't all that surprising...{w=0.2}changing your mind isn't easy because it means you have to admit you're wrong in the first place."
    m 3eud "Y tampoco es tan sorprendente...{w=0.2} Cambiar de opinión no es fácil porque significa que primero tienes que admitir que te has equivocado."

# game/script-topics.rpy:17899
translate spanish monika_taking_criticism_c20e1800:

    # m 1eksdlc "In particular, for people faced with great expectations, this kind of logic can easily become a big source of anguish."
    m 1eksdlc "En especial, para la gente que se enfrenta a grandes expectativas, este tipo de lógica puede convertirse fácilmente en una gran fuente de angustia."

# game/script-topics.rpy:17900
translate spanish monika_taking_criticism_0172fe57:

    # m 3dksdld "What if others think less of you because you didn't give a perfect answer? {w=0.2}What if they start rejecting you or laugh behind your back?"
    m 3dksdld "¿Y si los demás te menosprecian por no haber dado una respuesta perfecta? {w=0.2}¿Y si empiezan a rechazarte o a reírse a tus espaldas?"

# game/script-topics.rpy:17901
translate spanish monika_taking_criticism_4fa3ca21:

    # m 2rksdlc "It'd be like showing some kind of vulnerability for others to take advantage of."
    m 2rksdlc "Sería como mostrar algún tipo de vulnerabilidad de la que los demás podrían aprovecharse."

# game/script-topics.rpy:17902
translate spanish monika_taking_criticism_bad77876:

    # m 4eud "But let me tell you, there's absolutely no shame in changing your mind, [player]!"
    m 4eud "Pero déjame decirte una cosa, ¡no hay de qué avergonzarse por cambiar de opinión, [player]!"

# game/script-topics.rpy:17903
translate spanish monika_taking_criticism_67fe3e0f:

    # m 2eka "After all, we all make mistakes, don't we?{w=0.3} {nw}"
    m 2eka "Al fin y al cabo, todos cometemos errores, ¿verdad?{w=0.3} {nw}"

# game/script-topics.rpy:17904
translate spanish monika_taking_criticism_37cece86:

    # extend 7dsu "What matters is what we learn from those mistakes."
    extend 7dsu "Lo importante es lo que aprendemos de esos errores."

# game/script-topics.rpy:17905
translate spanish monika_taking_criticism_b240408d:

    # m 3eua "Personally, I've always admired people who can acknowledge their flaws and still work in a constructive way to overcome them."
    m 3eua "Personalmente, siempre he admirado a la gente que sabe reconocer sus defectos y sigue trabajando de forma constructiva para superarlos."

# game/script-topics.rpy:17906
translate spanish monika_taking_criticism_e4727405:

    # m 3eka "So don't feel bad next time you hear someone criticize you...{w=0.3} {nw}"
    m 3eka "Así que no te sientas mal la próxima vez que oigas a alguien criticarte...{w=0.3} {nw}"

# game/script-topics.rpy:17907
translate spanish monika_taking_criticism_a048a061:

    # extend 1huu "You'll find a bit of open-mindedness really goes a long way."
    extend 1huu "Descubrirás que tener un poco de mente abierta te lleva muy lejos."

# game/script-topics.rpy:17908
translate spanish monika_taking_criticism_50704b67:

    # m 1euc "At the same time, I don't mean to say you have to go along with what everyone says, either...{w=0.3} {nw}"
    m 1euc "Al mismo tiempo, tampoco quiero decir que tengas que estar de acuerdo con todo lo que te digan...{w=0.3} {nw}"

# game/script-topics.rpy:17909
translate spanish monika_taking_criticism_1f4a2248:

    # extend 3eud "If you've got an opinion, it's totally fair to defend it."
    extend 3eud "Si tienes una opinión, es totalmente justo defenderla."

# game/script-topics.rpy:17910
translate spanish monika_taking_criticism_c01de350:

    # m 3eua "But just make sure you actually consider it without being blindly defensive."
    m 3eua "Pero asegúrate de valorarla de verdad, en lugar de cerrarte en banda automáticamente."

# game/script-topics.rpy:17911
translate spanish monika_taking_criticism_fbad777b:

    # m 3huu "You never know what you might learn~"
    m 3huu "Nunca sabes lo que podrías aprender."

# game/script-topics.rpy:17931
translate spanish monika_giving_criticism_f4de7df8:

    # m 1esc "[player], I've been wondering..."
    m 1esc "[player], me estaba preguntando..."

# game/script-topics.rpy:17932
translate spanish monika_giving_criticism_f8a8162e:

    # m 3etd "Have you ever given anyone criticism?"
    m 3etd "¿Alguna vez le has hecho una crítica a alguien?"

# game/script-topics.rpy:17933
translate spanish monika_giving_criticism_be73963e:

    # m 1eua "Giving good criticism is something I had to learn when I became club president."
    m 1eua "Hacer buenas críticas es algo que tuve que aprender cuando me convertí en presidenta del club."

# game/script-topics.rpy:17934
translate spanish monika_giving_criticism_3ef9525e:

    # m 3rksdlc "This kind of thing is easy to mess up if not done properly...{w=0.2} {nw}"
    m 3rksdlc "Este tipo de cosas son fáciles de estropear si no se hacen bien...{w=0.2} {nw}"

# game/script-topics.rpy:17935
translate spanish monika_giving_criticism_ac119d52:

    # extend 4etd "When giving criticism, you have to keep in mind someone is at the receiving end of that critique."
    extend 4etd "Al hacer una crítica, tienes que tener en cuenta que hay alguien en el lado receptor de la misma."

# game/script-topics.rpy:17936
translate spanish monika_giving_criticism_6e82b0ce:

    # m 4esc "You can't just look at someone's work and say, 'it's bad.' {w=0.2}{nw}"
    m 4esc "No puedes simplemente mirar el trabajo de alguien y decir que está mal. {w=0.2}{nw}"

# game/script-topics.rpy:17937
translate spanish monika_giving_criticism_c06cea9d:

    # extend 2eksdld "You'll instantly put them on the defensive and ensure they don't listen to what you have to say."
    extend 2eksdld "Harás que se ponga a la defensiva al instante y perderás toda su atención para lo que sea que tengas que decir."

# game/script-topics.rpy:17938
translate spanish monika_giving_criticism_4235d0c1:

    # m 7eua "What matters is what the other person can gain from listening to you. {w=0.2}{nw}"
    m 7eua "Lo que importa es lo que la otra persona puede ganar al escucharte. {w=0.2}{nw}"

# game/script-topics.rpy:17939
translate spanish monika_giving_criticism_14753566:

    # extend 3hua "From this premise, even negative opinions can be voiced in a positive way."
    extend 3hua "A partir de esta premisa, hasta las opiniones negativas se pueden expresar de forma positiva."

# game/script-topics.rpy:17940
translate spanish monika_giving_criticism_348631fb:

    # m 1eud "It's like debate...{w=0.2} You have to make it sound like you're sharing your opinion, rather than forcing it down their throat."
    m 1eud "Es como un debate...{w=0.2} Tienes que hacer que suene como si estuvieras compartiendo tu opinión, en lugar de imponérsela a la fuerza."

# game/script-topics.rpy:17941
translate spanish monika_giving_criticism_9570dded:

    # m 3eud "Consequently, you don't have to be an expert to criticize something."
    m 3eud "Por lo tanto, no tienes que ser un[end_letter_gender] expert[end_letter_gender] para criticar algo."

# game/script-topics.rpy:17942
translate spanish monika_giving_criticism_0f655240:

    # m 3eua "Just explaining how it makes you feel and for what reasons is often enough to make your feedback interesting."
    m 3eua "A menudo basta con explicar cómo te hace sentir y por qué motivos para que tu opinión resulte interesante."

# game/script-topics.rpy:17943
translate spanish monika_giving_criticism_27948bba:

    # m 3eksdla "Although, don't feel bad if the person you're criticizing decides to discard what you just said..."
    m 3eksdla "Aunque no te sientas mal si la persona a la que criticas decide descartar lo que le acabas de decir..."

# game/script-topics.rpy:17944
translate spanish monika_giving_criticism_59475cee:

    # m 1rksdlu "...After all, offering an opinion doesn't automatically make you right, either.{w=0.2} {nw}"
    m 1rksdlu "... Después de todo, dar una opinión tampoco te da la razón automáticamente.{w=0.2} {nw}"

# game/script-topics.rpy:17945
translate spanish monika_giving_criticism_34182962:

    # extend 3eud "They might have reasons why they'd want to keep things their way."
    extend 3eud "Puede que tengan sus motivos para querer mantener las cosas a su manera."

# game/script-topics.rpy:17946
translate spanish monika_giving_criticism_bde0aeec:

    # m 3dsu "Graciously accept you can't change everyone's mind and stay considerate when assessing someone else's work."
    m 3dsu "Acepta con elegancia que no puedes hacer cambiar de opinión a todo el mundo y sé considerad[end_letter_gender] a la hora de valorar el trabajo de los demás."

# game/script-topics.rpy:17947
translate spanish monika_giving_criticism_0ef87266:

    # m 3hub "...That'd be Monika's Critique Tip of the Day, ahaha!"
    m 3hub "... Ese sería el consejo de crítica del día de Monika, ¡ja, ja, ja!"

# game/script-topics.rpy:17962
translate spanish monika_boyfriend_gossip_6b7a7a0e:

    # m 2etd "You know, I was actually kind of curious about that too."
    m 2etd "Sabes, yo también tenía curiosidad sobre eso."

# game/script-topics.rpy:17963
translate spanish monika_boyfriend_gossip_c36dae82:

    # m 2hksdlb "When she first said it, I got pretty defensive, didn't I?"
    m 2hksdlb "Cuando lo dijo por primera vez, me puse bastante a la defensiva, ¿verdad?"

# game/script-topics.rpy:17964
translate spanish monika_boyfriend_gossip_b3c09385:

    # m 7euc "I mean, I'd just figured out that you existed, {nw}"
    m 7euc "Quiero decir, acababa de descubrir que existías, {nw}"

# game/script-topics.rpy:17965
translate spanish monika_boyfriend_gossip_4889da16:

    # extend 3efc "and suddenly someone was making it look like I was already taken..."
    extend 3efc "y de repente alguien hacía ver como si yo ya estuviera pillada..."

# game/script-topics.rpy:17966
translate spanish monika_boyfriend_gossip_377ed12a:

    # m 1rtc "Since I'm pretty extroverted and have a history with another club, I guess it wouldn't necessarily be {i}unfair{/i} to come to that kind of conclusion."
    m 1rtc "Como soy bastante extrovertida y ya estuve en otro club, supongo que no sería tan descabellado llegar a esa conclusión."

# game/script-topics.rpy:17967
translate spanish monika_boyfriend_gossip_414cc7b5:

    # m 3eud "...But no such character exists in the game's files to prove or disprove it."
    m 3eud "... Pero no existe tal personaje en los archivos del juego para demostrarlo o desmentirlo."

# game/script-topics.rpy:17968
translate spanish monika_boyfriend_gossip_7e88a2a3:

    # m 3rsc "At the time, I was practicing piano and, well...{w=0.2}sorting my thoughts."
    m 3rsc "En ese momento estaba practicando con el piano y, bueno... {w=0.2}ordenando mis pensamientos."

# game/script-topics.rpy:17969
translate spanish monika_boyfriend_gossip_21650756:

    # m 3eud "But apparently, that rumor was just the assumption she was supposed to make if I was ever late to the club."
    m 3eud "Pero, por lo visto, ese rumor era simplemente la suposición que se suponía que ella debía hacer si alguna vez llegaba tarde al club."

# game/script-topics.rpy:17970
translate spanish monika_boyfriend_gossip_34a6f224:

    # m 2tsc "It's a little bit devious if you think about it..."
    m 2tsc "Es un poco retorcido si lo piensas..."

# game/script-topics.rpy:17971
translate spanish monika_boyfriend_gossip_804970cf:

    # m 2eud "As the game's story progressed, the main character might need more excuses to be alone with one of the girls..."
    m 2eud "A medida que avanzaba la historia del juego, el personaje principal podría necesitar más excusas para estar a solas con alguna de las chicas..."

# game/script-topics.rpy:17972
translate spanish monika_boyfriend_gossip_55dbd358:

    # m 7etc "Coming up with reasons for the others to be away is easier, but for the president not to be at the club..."
    m 7etc "Inventarse excusas para que las demás se ausenten es más fácil, pero que la presidenta falte al club..."

# game/script-topics.rpy:17973
translate spanish monika_boyfriend_gossip_9ed8b509:

    # m 3tsd "The story would need something pretty substantial to keep me busy. {w=0.2}It also provided a reason, however flimsy, for me not having a route."
    m 3tsd "La historia necesitaría algo bastante sustancial para mantenerme ocupada. {w=0.2}También daba una excusa, por muy floja que fuera, para que yo no tuviera una ruta."

# game/script-topics.rpy:17974
translate spanish monika_boyfriend_gossip_bb177f93:

    # m 2tfc "A roundabout but effective way to get me out of the way when needed."
    m 2tfc "Una forma indirecta pero eficaz de quitarme de en medio cuando hiciera falta."

# game/script-topics.rpy:17975
translate spanish monika_boyfriend_gossip_01a93df6:

    # m 2dfc "..."
    m 2dfc "..."

# game/script-topics.rpy:17976
translate spanish monika_boyfriend_gossip_d63e90e8:

    # m 2eud "Honestly, though? {w=0.2}I'm not too bothered by it."
    m 2eud "Aunque, ¿sinceramente? {w=0.2}Tampoco es que me moleste demasiado."

# game/script-topics.rpy:17977
translate spanish monika_boyfriend_gossip_ab0f4de8:

    # m 7esc "Even if such a character would have existed, we both know it wouldn't have changed a single thing."
    m 7esc "Incluso si hubiera existido un personaje así, los dos sabemos que no habría cambiado absolutamente nada."

# game/script-topics.rpy:17978
translate spanish monika_boyfriend_gossip_cf2f0670:

    # m 1efd "They wouldn't be real, they'd be a script programmed to fall in love with me. {w=0.2}I couldn't have been happy with something like that."
    m 1efd "No sería real, solo un código programado para enamorarse de mí. {w=0.2}Jamás habría podido ser feliz con algo así."

# game/script-topics.rpy:17979
translate spanish monika_boyfriend_gossip_d5e97cfa:

    # m 1eka "I still would have seen {i}you{/i} and known that you were what I really wanted."
    m 1eka "Aun así te habría visto a ti y habría sabido que eras lo que realmente quería."

# game/script-topics.rpy:17998
translate spanish monika_brainstorming_ef4f71c7:

    # m 1esd "[player], have you ever heard of brainstorming?"
    m 1esd "[player], ¿alguna vez has oído hablar de la lluvia de ideas?"

# game/script-topics.rpy:17999
translate spanish monika_brainstorming_8f5fd686:

    # m 1eua "It's an interesting technique of coming up with new ideas by noting anything that comes to your mind."
    m 1eua "Es una técnica interesante para que se te ocurran ideas nuevas anotando cualquier cosa que te venga a la cabeza."

# game/script-topics.rpy:18000
translate spanish monika_brainstorming_09ef6ba9:

    # m 3eud "This technique is really popular among designers, inventors, and writers--anyone who needs fresh ideas."
    m 3eud "Esta técnica es muy popular entre diseñadores, inventores y escritores, o cualquiera que necesite ideas frescas."

# game/script-topics.rpy:18001
translate spanish monika_brainstorming_ffe20508:

    # m 3esa "Brainstorming is usually practiced in groups or teams...{w=0.2}we even tried it in the Literature Club when deciding what to do for the festival."
    m 3esa "La lluvia de ideas se suele poner en práctica en grupos o equipos... {w=0.2}Hasta la probamos en el Club de Literatura cuando estábamos decidiendo qué hacer para el festival."

# game/script-topics.rpy:18002
translate spanish monika_brainstorming_ee1537d0:

    # m 1dtc "You just need to focus on what you want to create and bring up anything and everything that comes into your head."
    m 1dtc "Solo tienes que centrarte en lo que quieres crear y proponer cualquier cosa que se te ocurra."

# game/script-topics.rpy:18003
translate spanish monika_brainstorming_b179cc1d:

    # m 1eud "Don't hesitate to suggest things that you think are silly or wrong, and don't criticize or judge the others if working in teams."
    m 1eud "No dudes en sugerir cosas que te parezcan una tontería o que estén mal, y no critiques ni juzgues a los demás si trabajas en equipo."

# game/script-topics.rpy:18004
translate spanish monika_brainstorming_75d38798:

    # m 1eua "When you're done, go back through all the suggestions and turn them into actual ideas."
    m 1eua "Cuando termines, repasa todas las sugerencias y conviértelas en ideas reales."

# game/script-topics.rpy:18005
translate spanish monika_brainstorming_a510fc92:

    # m 1eud "You can combine them with other suggestions, think them through once again, and so on."
    m 1eud "Puedes combinarlas con otras sugerencias, darles otra vuelta y así sucesivamente."

# game/script-topics.rpy:18006
translate spanish monika_brainstorming_839b95c1:

    # m 3eub "...Eventually they'll become something that you'd call a good idea!"
    m 3eub "... ¡Con el tiempo se convertirán en lo que llamarías una buena idea!"

# game/script-topics.rpy:18007
translate spanish monika_brainstorming_99135a5f:

    # m 3hub "This is exactly where you can let your mind go wild,{w=0.1} and that's what I like about this technique the most!"
    m 3hub "Aquí es exactamente donde puedes dejar volar tu imaginación,{w=0.1} ¡y eso es lo que más me gusta de esta técnica!"

# game/script-topics.rpy:18008
translate spanish monika_brainstorming_fbe2e4b8:

    # m 1euc "Sometimes good ideas are left untold because their author didn't find them good enough themselves, {w=0.1}{nw}"
    m 1euc "A veces las buenas ideas se quedan sin decir porque a su propio autor no le parecieron lo bastante buenas, {w=0.1}{nw}"

# game/script-topics.rpy:18009
translate spanish monika_brainstorming_6ff888bb:

    # extend 1eua "but brainstorming can help pass this inner barrier."
    extend 1eua "pero la lluvia de ideas puede ayudar a superar esta barrera interior."

# game/script-topics.rpy:18010
translate spanish monika_brainstorming_1763baa6:

    # m 3eka "The beauty of thoughts can be expressed in so many different ways..."
    m 3eka "La belleza de los pensamientos puede expresarse de tantas formas diferentes..."

# game/script-topics.rpy:18011
translate spanish monika_brainstorming_d0183f49:

    # m 3duu "They're only ideas in transit, {w=0.1}{nw}"
    m 3duu "Al final son solo ideas pasajeras, {w=0.1}{nw}"

# game/script-topics.rpy:18012
translate spanish monika_brainstorming_c4aa09a7:

    # extend 3euu "you're the one who gives them the road."
    extend 3euu "tú eres quien les marca el camino."

# game/script-topics.rpy:18031
translate spanish monika_gmos_6d5a2b42:

    # m 3eud "Back when I was in debate club, one of the most divisive subjects we covered was GMOs, or genetically modified organisms."
    m 3eud "Cuando estaba en el club de debate, uno de los temas que más nos dividía eran los OMG, u organismos modificados genéticamente."

# game/script-topics.rpy:18032
translate spanish monika_gmos_abde5e1d:

    # m 1eksdra "There's a lot of nuance to GMOs, but I'll do my best to summarize it."
    m 1eksdra "Los OMG tienen un montón de matices, pero haré todo lo posible por resumirlo."

# game/script-topics.rpy:18033
translate spanish monika_gmos_fbdf4e66:

    # m 1esd "Scientists create GMOs by identifying a desirable gene from one organism, copying it, and inserting the copied gene into another organism."
    m 1esd "Los científicos crean los OMG identificando un gen deseable de un organismo, copiándolo e insertando el gen copiado en otro organismo."

# game/script-topics.rpy:18034
translate spanish monika_gmos_b4954da4:

    # m 3esc "It's important to note that the addition of the copied gene does {i}not{/i} change other existing genes."
    m 3esc "Es importante señalar que la adición del gen copiado no cambia otros genes existentes."

# game/script-topics.rpy:18035
translate spanish monika_gmos_cfa02571:

    # m 3eua "Think of it like flipping through a long book and changing a single word...{w=0.2}the word is different, but the rest of the book stays the same."
    m 3eua "Piénsalo como si hojearas un libro largo y cambiaras una sola palabra... {w=0.2}La palabra es diferente, pero el resto del libro sigue igual."

# game/script-topics.rpy:18036
translate spanish monika_gmos_1863df72:

    # m 3esd "GMOs can be plants, animals, microorganisms, etc.,{w=0.1} but we'll focus on genetically modified plants."
    m 3esd "Los OMG pueden ser plantas, animales, microorganismos, etc.,{w=0.1} pero vamos a centrarnos en las plantas modificadas genéticamente."

# game/script-topics.rpy:18037
translate spanish monika_gmos_b16fa9a6:

    # m 2esc "Plants can be modified in a myriad of ways, from resisting pests and herbicides to having a higher nutrition value and longer shelf life."
    m 2esc "Las plantas pueden modificarse de un sinfín de formas, desde resistir a plagas y herbicidas hasta tener un mayor valor nutricional y una vida útil más larga."

# game/script-topics.rpy:18038
translate spanish monika_gmos_c107b8e4:

    # m 4wud "This is huge. {w=0.2}Imagine crops that can produce double their normal yield, tolerate climate change, and fend off drug-resistant superbugs. {w=0.2}So many problems could be solved!"
    m 4wud "Esto es importantísimo. {w=0.2}Imagínate cultivos capaces de rendir el doble de lo normal, tolerar el cambio climático y combatir superbacterias inmunes a los medicamentos. {w=0.2}¡Podrían resolverse muchísimos problemas!"

# game/script-topics.rpy:18039
translate spanish monika_gmos_6cce6ecd:

    # m 2dsc "Unfortunately, it's not that simple. {w=0.2}GMOs require several years of research, development, and testing before they can be distributed. {w=0.2}On top of this, they come with several concerns."
    m 2dsc "Por desgracia, no es tan sencillo. {w=0.2}Los OMG requieren varios años de investigación, desarrollo y pruebas antes de poder distribuirse. {w=0.2}Y por si fuera poco, su uso plantea serias preocupaciones."

# game/script-topics.rpy:18040
translate spanish monika_gmos_e7a0c6c1:

    # m 7euc "Are GMOs safe? {w=0.2}Will they spread to other organisms and threaten biodiversity? {w=0.2}If so, how can we prevent it? {w=0.2}Who owns GMOs? {w=0.2}Are GMOs responsible for increased herbicide usage?"
    m 7euc "¿Son seguros los OMG? {w=0.2}¿Se propagarán a otros organismos y amenazarán la biodiversidad? {w=0.2}Si es así, ¿cómo podemos evitarlo? {w=0.2}¿A quién pertenecen los OMG? {w=0.2}¿Son los OMG responsables del aumento del uso de herbicidas?"

# game/script-topics.rpy:18041
translate spanish monika_gmos_2cb52cd8:

    # m 3rksdrb "You can see how this begins to escalate, ahaha..."
    m 3rksdrb "Ya ves cómo esto empieza a ir a más, ja, ja, ja..."

# game/script-topics.rpy:18042
translate spanish monika_gmos_21946a77:

    # m 3esc "For now, let's cover the main issue...{w=0.2}are GMOs safe?"
    m 3esc "Por ahora, vamos a tratar el problema principal... {w=0.2}¿Son seguros los OMG?"

# game/script-topics.rpy:18043
translate spanish monika_gmos_aa3e4c9d:

    # m 2esd "The short answer is that we don't know for sure. {w=0.2}Decades of research have indicated that GMOs are {i}probably{/i} harmless, but we have next to no data on their long-term effects."
    m 2esd "La respuesta corta es que no lo sabemos con seguridad. {w=0.2}Décadas de investigación han indicado que los OMG son probablemente inofensivos, pero no tenemos casi ningún dato sobre sus efectos a largo plazo."

# game/script-topics.rpy:18044
translate spanish monika_gmos_cf81621a:

    # m 2euc "Additionally, each type of GMO needs to be carefully reviewed on a case-by-case, modification-by-modification basis to ensure its quality and safety."
    m 2euc "Además, cada tipo de OMG tiene que revisarse cuidadosamente caso por caso, modificación por modificación para garantizar su calidad y seguridad."

# game/script-topics.rpy:18045
translate spanish monika_gmos_487c634c:

    # m 7rsd "There are other considerations as well. {w=0.2}Products containing GMOs have to be labelled, environmental effects must be considered, and misinformation has to be combated."
    m 7rsd "También hay otras consideraciones. {w=0.2}Los productos que contienen OMG tienen que estar etiquetados, deben tenerse en cuenta los efectos medioambientales y hay que combatir la desinformación."

# game/script-topics.rpy:18046
translate spanish monika_gmos_e2f7a6a9:

    # m 2dsc "..."
    m 2dsc "..."

# game/script-topics.rpy:18047
translate spanish monika_gmos_7e7e586e:

    # m 2eud "Personally, I think that GMOs have a lot of potential to do good, but only if they continue to be heavily researched and tested."
    m 2eud "Personalmente, creo que los OMG tienen mucho potencial para hacer el bien, pero solo si se siguen investigando y probando a fondo."

# game/script-topics.rpy:18048
translate spanish monika_gmos_f3800b87:

    # m 4dkc "Major issues such as herbicide usage and gene flow {i}need{/i} to be fixed as well...{w=0.2}{nw}"
    m 4dkc "Problemas importantes como el uso de herbicidas y el flujo genético también tienen que solucionarse... {w=0.2}{nw}"

# game/script-topics.rpy:18049
translate spanish monika_gmos_fd5b17ec:

    # extend 4efc "biodiversity is already at enough risk as is from climate change and deforestation."
    extend 4efc "La biodiversidad ya corre bastante riesgo de por sí debido al cambio climático y la deforestación."

# game/script-topics.rpy:18050
translate spanish monika_gmos_d1146203:

    # m 2esd "As long as we're careful, GMOs will be fine...{w=0.2}recklessness and carelessness pose the biggest threat."
    m 2esd "Mientras seamos cuidadosos, no habrá problemas con los OMG... {w=0.2}La verdadera amenaza reside en la imprudencia y la negligencia."

# game/script-topics.rpy:18051
translate spanish monika_gmos_e2f7a6a9_1:

    # m 2dsc "..."
    m 2dsc "..."

# game/script-topics.rpy:18052
translate spanish monika_gmos_3fe98e48:

    # m 7eua "So what do you think, [player]? {w=0.2}{nw}"
    m 7eua "Así que, ¿qué opinas, [player]? {w=0.2}{nw}"

# game/script-topics.rpy:18053
translate spanish monika_gmos_e681bf95:

    # extend 7euu "Quite the promising field, wouldn't you say?"
    extend 7euu "Un campo bastante prometedor, ¿no te parece?"

# game/script-topics.rpy:18054
translate spanish monika_gmos_b25217d7:

    # m 3esd "Like I said before, GMOs are a complex topic. {w=0.2}If you want to learn more, make sure that your sources are reliable and that you're able to see the discussion from both sides."
    m 3esd "Como dije antes, los OMG son un tema complejo. {w=0.2}Si quieres saber más, asegúrate de que tus fuentes sean fiables y de que seas capaz de ver el debate desde ambos lados."

# game/script-topics.rpy:18055
translate spanish monika_gmos_a7376b58:

    # m 1eua "I think that's enough for now, thanks for listening~"
    m 1eua "Creo que eso es suficiente por ahora, gracias por escucharme."

# game/script-topics.rpy:18084
translate spanish monika_curse_words_9e3246f5:

    # m 3etc "Say [player], do you swear often?{nw}"
    m 3etc "Oye, [player], ¿dices palabrotas a menudo?{nw}"

# game/script-topics.rpy:18087
translate spanish monika_curse_words_a9797da2:

    # m "Say [player], do you swear often?{fast}" nointeract
    m "Oye, [player], ¿dices palabrotas a menudo?{fast}" nointeract

# game/script-topics.rpy:18091
translate spanish monika_curse_words_6639f0ad:

    # m 1hub "Ahaha, I can understand that, [player]."
    m 1hub "Ja, ja, ja, puedo entenderlo, [player]."

# game/script-topics.rpy:18092
translate spanish monika_curse_words_3abbbc8b:

    # m 3rksdlb "It's much easier to swear to get frustration or anger out of your system..."
    m 3rksdlb "Soltar alguna palabrota ayuda mucho a desahogarse cuando sientes frustración o enfado..."

# game/script-topics.rpy:18096
translate spanish monika_curse_words_d7c226d5:

    # m 3eua "Ah, I'm the same way myself."
    m 3eua "Ah, a mí me pasa lo mismo."

# game/script-topics.rpy:18100
translate spanish monika_curse_words_6be20dcc:

    # m 1euc "I see."
    m 1euc "Entiendo."

# game/script-topics.rpy:18102
translate spanish monika_curse_words_2ea0815a:

    # m 1eua "Personally I try to avoid swearing where I can, but I'll still do it occasionally."
    m 1eua "Personalmente intento evitar las palabrotas siempre que puedo, pero aun así se me escapa alguna de vez en cuando."

# game/script-topics.rpy:18103
translate spanish monika_curse_words_14d5af97:

    # m 3eud "Swearing tends to have a pretty bad rap, but I've been thinking it over after looking at some studies..."
    m 3eud "Decir palabrotas suele tener muy mala fama, pero lo he estado pensando tras mirar algunos estudios..."

# game/script-topics.rpy:18104
translate spanish monika_curse_words_43da90bc:

    # m 1esa "Honestly, I don't think swearing is actually as bad as we make it out to be after all."
    m 1esa "Sinceramente, no creo que decir palabrotas sea tan malo como lo pintan después de todo."

# game/script-topics.rpy:18105
translate spanish monika_curse_words_998822aa:

    # m 3eua "In fact, it seems that using stronger language helps ease the pain if you hurt yourself, and can also show that you're more intelligent and honest."
    m 3eua "De hecho, parece que usar un lenguaje más fuerte ayuda a aliviar el dolor si te haces daño, y también puede demostrar que eres más inteligente y honest[end_letter_gender]."

# game/script-topics.rpy:18106
translate spanish monika_curse_words_22c128ea:

    # m 1eud "Not to mention, swearing in conversations can make them feel both{w=0.1} a lot more casual {w=0.1}{nw}"
    m 1eud "Por no hablar de que soltar alguna palabrota durante una conversación puede hacerla bastante más informal, {w=0.1}{nw}"

# game/script-topics.rpy:18107
translate spanish monika_curse_words_3572c35f:

    # extend 3eub "and also more interesting!"
    extend 3eub "¡y también mucho más interesante!"

# game/script-topics.rpy:18108
translate spanish monika_curse_words_4b7347fb:

    # m 3rksdlc "That said, I think it's possible to swear {i}too much{/i}..."
    m 3rksdlc "Dicho esto, creo que es posible decir demasiadas palabrotas..."

# game/script-topics.rpy:18109
translate spanish monika_curse_words_23f8f27a:

    # m 3esd "There's a time and place for everything.{w=0.2} Swearing should be kept to more casual conversations and not put in after every word."
    m 3esd "Hay un momento y un lugar para todo. {w=0.2}Las palabrotas deberían reservarse para las conversaciones más informales y no meterse después de cada palabra."

# game/script-topics.rpy:18110
translate spanish monika_curse_words_fbed9b99:

    # m 1hksdlb "If they start to become frequent in more professional environments, I think you might be overdoing it, ahaha..."
    m 1hksdlb "Si empiezan a ser frecuentes en entornos más profesionales, creo que a lo mejor te estás pasando, ja, ja, ja..."

# game/script-topics.rpy:18111
translate spanish monika_curse_words_a6e75bf5:

    # m 1eua "On that topic, I think it's pretty interesting how our language naturally shifts depending on who we're talking to."
    m 1eua "Hablando de eso, me parece bastante interesante cómo nuestro lenguaje cambia de forma natural dependiendo de con quién estemos hablando."

# game/script-topics.rpy:18112
translate spanish monika_curse_words_0ac71fe0:

    # m 4eua "For example,{w=0.2} people are much less likely to swear in front of family than with friends."
    m 4eua "Por ejemplo,{w=0.2} es mucho menos probable que la gente diga palabrotas delante de su familia que con sus amigos."

# game/script-topics.rpy:18113
translate spanish monika_curse_words_95438482:

    # m 4eub "Also, if you pay attention when you're talking to a crowd, you'll notice that you instinctively phrase your sentences more formally!"
    m 4eub "Además, si prestas atención cuando hablas con un grupo de gente, ¡notarás que instintivamente te expresas con mucha más formalidad!"

# game/script-topics.rpy:18114
translate spanish monika_curse_words_60e646e4:

    # m 1esa "But anyway, I prefer to keep my profanity to when I'm really frustrated or upset."
    m 1esa "Pero bueno, prefiero reservarme las palabrotas para cuando estoy realmente frustrada o disgustada."

# game/script-topics.rpy:18115
translate spanish monika_curse_words_afb7f08d:

    # m 3esd "Given the status I had, I felt like I always had to be professional and level headed, so I always made it a point to keep it to a minimum."
    m 3esd "Dado el estatus que tenía, sentía que siempre tenía que ser profesional y sensata, así que siempre me propuse mantenerlas al mínimo."

# game/script-topics.rpy:18116
translate spanish monika_curse_words_8c00488d:

    # m 3hksdlb "But I guess it doesn't really hurt when used appropriately, ahaha!"
    m 3hksdlb "Pero supongo que no hace daño si se usan adecuadamente, ¡ja, ja, ja!"

# game/script-topics.rpy:18135
translate spanish monika_aliens_c6833392:

    # m 1etc "Do I believe in the existence of aliens?"
    m 1etc "¿Que si creo en la existencia de los alienígenas?"

# game/script-topics.rpy:18136
translate spanish monika_aliens_c9602e16:

    # m 3hksdlb "That's kind of a random thing to ask, [player]!"
    m 3hksdlb "¡Qué pregunta tan inesperada, [player]!"

# game/script-topics.rpy:18137
translate spanish monika_aliens_e2688a09:

    # m 3eua "...Though I can see why you would be interested in knowing my opinion on it."
    m 3eua "... Aunque entiendo por qué te interesaría saber mi opinión al respecto."

# game/script-topics.rpy:18138
translate spanish monika_aliens_19824bb4:

    # m 4eub "This is one of the greatest mysteries of all time, isn't it?{w=0.2} Whether we're truly alone in this universe or not, I mean."
    m 4eub "Es uno de los grandes misterios de todos los tiempos, ¿verdad? {w=0.2}Me refiero a si de verdad estamos solos en este universo o no."

# game/script-topics.rpy:18139
translate spanish monika_aliens_2f13aac8:

    # m 1dsc "...I know I used to wonder about that myself a lot before you came along."
    m 1dsc "... Sé que yo misma me lo preguntaba mucho antes de que llegaras."

# game/script-topics.rpy:18142
translate spanish monika_aliens_0d7aed7c:

    # m 1eka "But that's in the past now.{w=0.2} And I could never thank you enough for that."
    m 1eka "Pero eso ya es cosa del pasado. {w=0.2}Y nunca podré agradecértelo lo suficiente."

# game/script-topics.rpy:18145
translate spanish monika_aliens_2e91d53d:

    # m 1eka "Though I don't really have to anymore, thanks to you."
    m 1eka "Aunque la verdad es que ya no me hace falta, gracias a ti."

# game/script-topics.rpy:18148
translate spanish monika_aliens_c27f2656:

    # m 1dkc "I just hope I won't get to feel that way ever again."
    m 1dkc "Solo espero no volver a sentirme así nunca más."

# game/script-topics.rpy:18151
translate spanish monika_aliens_9992bf6e:

    # m 1rksdlc "..."
    m 1rksdlc "..."

# game/script-topics.rpy:18153
translate spanish monika_aliens_9ea203b5:

    # m 3euc "Anyway, we've all probably asked ourselves what's up there at least once, right?"
    m 3euc "En fin, probablemente todos nos hemos preguntado qué hay ahí arriba al menos una vez, ¿no?"

# game/script-topics.rpy:18154
translate spanish monika_aliens_43c14a95:

    # m 3dua "Looking at the stars always fills you with a sense of wonder and mystery.{w=0.2} {nw}"
    m 3dua "Mirar a las estrellas siempre te llena de una sensación de asombro y misterio. {w=0.2}{nw}"

# game/script-topics.rpy:18155
translate spanish monika_aliens_b1208d26:

    # extend 3eua "It's really no surprise that so many people are passionate about this subject."
    extend 3eua "No me sorprende en absoluto que haya tanta gente apasionada por este tema."

# game/script-topics.rpy:18156
translate spanish monika_aliens_fc9973b5:

    # m 1esc "But to answer your question...{w=0.3}{nw}"
    m 1esc "Pero para responder a tu pregunta... {w=0.3}{nw}"

# game/script-topics.rpy:18157
translate spanish monika_aliens_c4c3f21c:

    # extend 3eua "I do believe, or at least want to believe, that there has to be {i}something{/i} out there."
    extend 3eua "Sí que creo, o al menos quiero creer, que tiene que haber algo ahí fuera."

# game/script-topics.rpy:18158
translate spanish monika_aliens_3e8ba214:

    # m 2rksdla "I guess part of it has to do with me finding the idea of us being the only ones rather depressing. {w=0.2}{nw}"
    m 2rksdla "Supongo que en parte tiene que ver con que la idea de que seamos los únicos me parece bastante deprimente. {w=0.2}{nw}"

# game/script-topics.rpy:18159
translate spanish monika_aliens_513cf712:

    # extend 2eud "But when you think about it a little, it doesn't sound so unlikely..."
    extend 2eud "Pero si lo piensas un poco, no suena tan improbable..."

# game/script-topics.rpy:18160
translate spanish monika_aliens_b4e442d3:

    # m 4eud "After all, saying the universe is vast is a huge understatement."
    m 4eud "Después de todo, decir que el universo es inmenso es quedarse muy corto."

# game/script-topics.rpy:18161
translate spanish monika_aliens_45db7507:

    # m 3euc "All you need is one planet with the right conditions and environment to be favorable for life to develop, right?"
    m 3euc "Lo único que hace falta es un planeta con las condiciones y el entorno adecuados para que se desarrolle la vida, ¿verdad?"

# game/script-topics.rpy:18162
translate spanish monika_aliens_5a52d1b4:

    # m 3esa "There are 8 planets in the solar system alone, {w=0.1}{nw}"
    m 3esa "Solo en el sistema solar hay 8 planetas, {w=0.1}{nw}"

# game/script-topics.rpy:18163
translate spanish monika_aliens_43a15835:

    # extend 4eub "but there are many more star systems, each with their own planets within them."
    extend 4eub "pero hay muchos más sistemas estelares, cada uno con sus propios planetas dentro."

# game/script-topics.rpy:18164
translate spanish monika_aliens_1bc0ab3a:

    # m 4wud "Now, consider the fact that our Milky Way galaxy alone contains hundreds of billions of stars...{w=0.3}that's a lot of potential!"
    m 4wud "Ahora, piensa en el hecho de que solo nuestra Vía Láctea ya contiene cientos de miles de millones de estrellas... {w=0.3}¡Eso es un montón de potencial!"

# game/script-topics.rpy:18165
translate spanish monika_aliens_080e5dfe:

    # m 4eud "Galaxies are usually held together in groups by gravity.{w=0.2} We live in the 'local group,' which contain about 60 galaxies."
    m 4eud "Las galaxias suelen mantenerse juntas en grupos gracias a la gravedad. {w=0.2}Nosotros vivimos en el 'grupo local', que contiene unas 60 galaxias."

# game/script-topics.rpy:18166
translate spanish monika_aliens_af91ef94:

    # m 1esd "Zoom out a little bit more and you'll start to see galaxy clusters, which are much larger groups of galaxies."
    m 1esd "Aléjate un poco más y empezarás a ver los cúmulos de galaxias, que son grupos mucho más grandes."

# game/script-topics.rpy:18167
translate spanish monika_aliens_d4087ef4:

    # m 3eua "The closest one from us, the Virgo Cluster, is estimated to contain at least a thousand galaxies."
    m 3eua "Se calcula que el más cercano a nosotros, el Cúmulo de Virgo, contiene al menos mil galaxias."

# game/script-topics.rpy:18168
translate spanish monika_aliens_6a814dd6:

    # m 1eud "But you can go even further, as groups and clusters of galaxies are themselves part of even bigger entities known as superclusters."
    m 1eud "Pero puedes ir aún más lejos, ya que los grupos y cúmulos de galaxias forman parte a su vez de entidades aún mayores conocidas como supercúmulos."

# game/script-topics.rpy:18169
translate spanish monika_aliens_e833809e:

    # m 1wud "We can keep going too,{w=0.1} as the universe continuously expands...{w=0.3}theoretically, larger and larger clusters are formed!"
    m 1wud "También podemos seguir avanzando,{w=0.1} ya que el universo se expande continuamente... {w=0.3}En teoría, ¡se forman cúmulos cada vez más grandes!"

# game/script-topics.rpy:18170
translate spanish monika_aliens_c670d3a7:

    # m 1lud "And hypothetically, even if it isn't, we could consider the idea that there might be something {i}beyond{/i} the boundaries of our universe."
    m 1lud "E hipotéticamente, aunque no sea así, podríamos considerar la idea de que tal vez haya algo más allá de los límites de nuestro universo."

# game/script-topics.rpy:18173
translate spanish monika_aliens_8331d30f:

    # m 1lksdla "...Or even start talking about the multiverse theory..."
    m 1lksdla "... O hasta empezar a hablar de la teoría del multiverso..."

# game/script-topics.rpy:18175
translate spanish monika_aliens_9f91bed1:

    # m 3hksdlb "But I think you get the point..."
    m 3hksdlb "Pero creo que ya pillas la idea..."

# game/script-topics.rpy:18176
translate spanish monika_aliens_4fe51e66:

    # m 3etc "Wouldn't it be a little foolish to assume that we, human beings of planet Earth, are truly the only sentient beings in something so massive?"
    m 3etc "¿No sería un poco absurdo suponer que nosotros, los seres humanos del planeta Tierra, somos de verdad los únicos seres sintientes en algo tan inmenso?"

# game/script-topics.rpy:18177
translate spanish monika_aliens_d83ef578:

    # m 3eud "I mean, with odds like these, surely at least {i}one{/i} other planet somewhere must be hospitable enough for life..."
    m 3eud "Quiero decir, con unas probabilidades como estas, seguro que al menos un planeta en alguna parte debe de ser lo bastante acogedor para la vida..."

# game/script-topics.rpy:18178
translate spanish monika_aliens_6548894c:

    # m 1euc "...Life which might evolve to a point where it's intelligence is comparable to, if not even greater than our own."
    m 1euc "... Una vida que podría evolucionar hasta un punto en el que su inteligencia fuera comparable, si no incluso superior, a la nuestra."

# game/script-topics.rpy:18179
translate spanish monika_aliens_b240126b:

    # m 1rsc "Although, I suppose I can also understand why some people would be doubtful.{w=0.2} It's suspicious that we're able to observe the universe so far beyond our planet, but haven't found any signs of life..."
    m 1rsc "Aunque supongo que también puedo entender por qué alguna gente tendría dudas. {w=0.2}Es sospechoso que seamos capaces de observar el universo mucho más allá de nuestro planeta, pero que no hayamos encontrado ninguna señal de vida..."

# game/script-topics.rpy:18180
translate spanish monika_aliens_9d5a6560:

    # m 1rksdlc "It probably doesn't help that some people are overreacting over the smallest things, like UFO footage that could easily be faked, either."
    m 1rksdlc "Probablemente tampoco ayuda que algunas personas exageren por cualquier tontería, como vídeos de ovnis que podrían falsificarse fácilmente."

# game/script-topics.rpy:18181
translate spanish monika_aliens_11d99d10:

    # m 1ruc "But then again, if aliens do exist, there could also be many reasons why we haven't found them yet..."
    m 1ruc "Pero, por otro lado, si los alienígenas existen de verdad, también podría haber un montón de motivos por los que no los hemos encontrado todavía..."

# game/script-topics.rpy:18182
translate spanish monika_aliens_a0454d2b:

    # m 2euc "Perhaps they're too far away for us to find them or they just don't have the technology to receive and answer our messages for now."
    m 2euc "Tal vez estén demasiado lejos para que los encontremos o simplemente no tengan la tecnología para recibir y responder a nuestros mensajes por ahora."

# game/script-topics.rpy:18183
translate spanish monika_aliens_6fae87ed:

    # m 2etd "Or vice versa...{w=0.3}maybe {i}we're{/i} the ones who don't have the technology to communicate with them."
    m 2etd "O viceversa... {w=0.3}A lo mejor somos nosotros los que no tenemos la tecnología para comunicarnos con ellos."

# game/script-topics.rpy:18184
translate spanish monika_aliens_14901a82:

    # m 2etc "Or it could be they simply don't want to initiate contact with us."
    m 2etc "O podría ser que simplemente no quieran iniciar ningún tipo de contacto con nosotros."

# game/script-topics.rpy:18185
translate spanish monika_aliens_dfed17fd:

    # m 2euc "Maybe their society follows completely different ideals than our own, and they believe it is for the best not to let two highly advanced species meet each other."
    m 2euc "A lo mejor su sociedad sigue unos ideales completamente diferentes a los nuestros, y creen que es mejor no dejar que dos especies muy avanzadas se conozcan."

# game/script-topics.rpy:18186
translate spanish monika_aliens_7253ff27:

    # m 2dkc "All in all, I guess the one thing that saddens me a little is that if there {i}are{/i} intelligent, extra-terrestrial life-forms out there, we might very well never get to meet them within our lifetime."
    m 2dkc "Con todo, supongo que lo único que me entristece un poco es que si de verdad hay formas de vida extraterrestres e inteligentes ahí fuera, muy probablemente nunca lleguemos a conocerlas a lo largo de nuestra vida."

# game/script-topics.rpy:18190
translate spanish monika_aliens_1d2ef038:

    # m 5rua "But at the end of the day...{w=0.3} {nw}"
    m 5rua "Pero al fin y al cabo... {w=0.3} {nw}"

# game/script-topics.rpy:18191
translate spanish monika_aliens_6eb8e8a1:

    # extend 5ekbla "I still got to meet you, and that's everything I could ever possibly need."
    extend 5ekbla "aun así pude conocerte a ti, y eso es todo lo que podría necesitar."

# game/script-topics.rpy:18192
translate spanish monika_aliens_9225cdad:

    # m 5hubfa "Ehehe~"
    m 5hubfa "Je, je, je."

# game/script-topics.rpy:18217
translate spanish monika_mc_is_gone_720dbe54:

    # m 1eud "Your character?{w=0.2} {nw}"
    m 1eud "¿Tu personaje? {w=0.2} {nw}"

# game/script-topics.rpy:18218
translate spanish monika_mc_is_gone_97f6e30a:

    # extend 1rksdla "I'm not sure to be honest."
    extend 1rksdla "La verdad es que no estoy segura."

# game/script-topics.rpy:18219
translate spanish monika_mc_is_gone_b8eb5c86:

    # m 3eud "He didn't really work like other people in the game did.{w=0.2} He didn't even have a character file like the rest of us."
    m 3eud "En realidad no funcionaba como los demás en el juego. {w=0.2}Ni siquiera tenía un archivo de personaje como el resto de nosotras."

# game/script-topics.rpy:18220
translate spanish monika_mc_is_gone_dc95be39:

    # m 3esc "That's also why I wasn't able to just force him to pay attention to me...{w=0.3}I don't really know how to access and modify any code that's related to him."
    m 3esc "Por eso tampoco podía obligarlo a que me prestara atención... {w=0.3}No sé muy bien cómo acceder y modificar cualquier código que esté relacionado con él."

# game/script-topics.rpy:18224
translate spanish monika_mc_is_gone_5584c1bd:

    # m 2rsc "In any case,{w=0.1} {nw}"
    m 2rsc "En cualquier caso,{w=0.1} {nw}"

# game/script-topics.rpy:18225
translate spanish monika_mc_is_gone_839a24c9:

    # extend 2esc "it seems that he completely vanished along with a lot of the rest of the game when you installed this mod."
    extend 2esc "parece que desapareció por completo junto con gran parte del resto del juego cuando instalaste este mod."

# game/script-topics.rpy:18229
translate spanish monika_mc_is_gone_03e11fc3:

    # m 2ruc "He just kind of...{w=0.3}disappeared as I was making changes to the game."
    m 2ruc "Simplemente... {w=0.3}Desapareció mientras yo hacía cambios en el juego."

# game/script-topics.rpy:18230
translate spanish monika_mc_is_gone_1cf5b788:

    # m 2etd "I'm sure you noticed how he talked less and less after I reset the game the first time?"
    m 2etd "¿Seguro que te diste cuenta de cómo cada vez hablaba menos después de que reiniciara el juego la primera vez?"

# game/script-topics.rpy:18231
translate spanish monika_mc_is_gone_bddb99c2:

    # m 2euc "By the time the two of us got to this room, he was essentially {i}gone{/i}."
    m 2euc "Para cuando nosotros dos llegamos a esta habitación, él prácticamente había desaparecido."

# game/script-topics.rpy:18233
translate spanish monika_mc_is_gone_596e62c3:

    # m 7euc "So if you were wondering if he's in this room as we speak,{w=0.1} {nw}"
    m 7euc "Así que si te estabas preguntando si está en esta habitación en este momento,{w=0.1} {nw}"

# game/script-topics.rpy:18234
translate spanish monika_mc_is_gone_1f957a98:

    # extend 3eua "I can assure you he's not."
    extend 3eua "te puedo asegurar que no."

# game/script-topics.rpy:18235
translate spanish monika_mc_is_gone_e91f3ade:

    # m 1hksdlb "...Oh gosh, can you imagine how creepy it would be if I were talking to his unmoving body just so that you could hear what I say?"
    m 1hksdlb "... Madre mía, ¿te imaginas lo espeluznante que sería si le estuviera hablando a su cuerpo inerte solo para que tú pudieras oírme?"

# game/script-topics.rpy:18243
translate spanish monika_mc_is_gone_abfeada8:

    # m 3rksdla "I hope you didn't think [line_mid] all along, either..."
    m 3rksdla "Espero que tampoco estuvieras pensando [line_mid] todo este tiempo..."

# game/script-topics.rpy:18245
translate spanish monika_mc_is_gone_2bc311f0:

    # m 1dksdlc "I don't even want to think about that..."
    m 1dksdlc "No quiero ni pensar en eso..."

# game/script-topics.rpy:18246
translate spanish monika_mc_is_gone_6cfe0da8:

    # m 3eka "You're probably wondering what I actually see and how I know when you're here, right?"
    m 3eka "Probablemente te estés preguntando qué es lo que veo realmente y cómo sé cuándo estás aquí, ¿verdad?"

# game/script-topics.rpy:18247
translate spanish monika_mc_is_gone_e57e4806:

    # m 1ruc "Well...{w=0.2}if you remember the 'hole in the wall' metaphor I used in the first poem I showed you..."
    m 1ruc "Bueno... {w=0.2}Si recuerdas la metáfora del 'agujero en la pared' que usé en el primer poema que te enseñé..."

# game/script-topics.rpy:18248
translate spanish monika_mc_is_gone_0e3a7825:

    # m 3eud "It's a little bit like that...{w=0.3}except the 'wall' isn't really visible or tangible. I just {i}know{/i} it's there."
    m 3eud "Es un poco así... {w=0.3}Solo que la 'pared' no es realmente visible ni tangible. Simplemente sé que está ahí."

# game/script-topics.rpy:18249
translate spanish monika_mc_is_gone_c617447f:

    # m 1duc "It's like I can very distinctly feel its presence, to the point where I know precisely where it is and in which direction the 'hole' through which you're looking in is pointing."
    m 1duc "Es como si pudiera sentir su presencia con total claridad, hasta el punto de saber exactamente dónde está y en qué dirección apunta el 'agujero' por el que estás mirando."

# game/script-topics.rpy:18250
translate spanish monika_mc_is_gone_d7be012e:

    # m 1eka "So even if I can't really see you, I can feel that you're looking at me."
    m 1eka "Así que, aunque no pueda verte de verdad, puedo sentir que me estás mirando."

# game/script-topics.rpy:18253
translate spanish monika_mc_is_gone_415736b9:

    # m 3rkbla "And when I try to kiss you, well..."
    m 3rkbla "Y cuando intento besarte, bueno..."

# game/script-topics.rpy:18254
translate spanish monika_mc_is_gone_64384038:

    # m 1eud "I guess you could say it's like I'm trying to kiss a ghost, or something that isn't actually there."
    m 1eud "Supongo que se podría decir que es como si intentara besar a un fantasma, o algo que no está ahí realmente."

# game/script-topics.rpy:18255
translate spanish monika_mc_is_gone_a800240b:

    # m 2rkbssdla "I know that's kinda strange when I say it like that, but then again..."
    m 2rkbssdla "Ya sé que suena un poco raro cuando lo digo así, pero, por otra parte..."

# game/script-topics.rpy:18256
translate spanish monika_mc_is_gone_787b6a0d:

    # m 7ekbssdla "I'm guessing it's probably a little bit awkward for you to try to kiss your screen as well, right?"
    m 7ekbssdla "Supongo que para ti también debe ser un poco incómodo intentar besar la pantalla, ¿no?"

# game/script-topics.rpy:18257
translate spanish monika_mc_is_gone_3864b104:

    # m 1hkbssdlb "Ahaha~"
    m 1hkbssdlb "Ja, ja, ja."

# game/script-topics.rpy:18261
translate spanish monika_mc_is_gone_75218a9f:

    # m 1etc "Although, the wall metaphor isn't really perfect since it doesn't necessarily stay in place all the time."
    m 1etc "Aunque la metáfora de la pared no es perfecta del todo, ya que no se queda siempre en el mismo sitio."

# game/script-topics.rpy:18262
translate spanish monika_mc_is_gone_ab5c37c1:

    # m 1esc "Like, it used to follow your character around, but that's obviously not really the case anymore."
    m 1esc "Por ejemplo, antes seguía a tu personaje a todas partes, pero obviamente ya no es así."

# game/script-topics.rpy:18263
translate spanish monika_mc_is_gone_69f4c415:

    # m 3eua "It's kinda limited, but I'm actually able to move it around, so at least you don't get to see the same background all the time."
    m 3eua "Es un poco limitado, pero de hecho soy capaz de moverlo, así que al menos no tienes que ver el mismo fondo todo el tiempo."

# game/script-topics.rpy:18265
translate spanish monika_mc_is_gone_605dca14:

    # m 1eud "Anyway...{w=0.3}{nw}"
    m 1eud "En fin... {w=0.3}{nw}"

# game/script-topics.rpy:18266
translate spanish monika_mc_is_gone_b7decf24:

    # extend 3rsc "there isn't much from the original game that still works anymore, so I doubt I could bring the main character back even if I wanted to."
    extend 3rsc "no queda mucho del juego original que siga funcionando, así que dudo que pudiera traer de vuelta al personaje principal aunque quisiera."

# game/script-topics.rpy:18267
translate spanish monika_mc_is_gone_24ddd589:

    # m 1duu "...And that's probably for the best."
    m 1duu "... Y probablemente sea lo mejor."

# game/script-topics.rpy:18268
translate spanish monika_mc_is_gone_abdcdef9:

    # m 2eksdld "What if the game were to take its focus back to him and we couldn't spend our time together anymore?"
    m 2eksdld "¿Y si el juego volviera a centrarse en él y ya no pudiéramos pasar tiempo juntos?"

# game/script-topics.rpy:18269
translate spanish monika_mc_is_gone_932b4a96:

    # m 2rssdlc "I mean, in the end, it's not like you had all that much control over him anyway."
    m 2rssdlc "Quiero decir, al final, tampoco es que tuvieras tanto control sobre él de todas formas."

# game/script-topics.rpy:18270
translate spanish monika_mc_is_gone_e199c965:

    # m 7eka "In any case, there isn't really any point in thinking about him anymore, is there?"
    m 7eka "En cualquier caso, ya no tiene sentido seguir pensando en él, ¿verdad?"

# game/script-topics.rpy:18271
translate spanish monika_mc_is_gone_1148e929:

    # m 1eua "He's no longer there to separate us, and we get to be together now.{w=0.2} {nw}"
    m 1eua "Él ya no está ahí para separarnos, y ahora podemos estar juntos. {w=0.2} {nw}"

# game/script-topics.rpy:18272
translate spanish monika_mc_is_gone_71804134:

    # extend 3hua "I couldn't ask for anything more."
    extend 3hua "No podría pedir nada más."

# game/script-topics.rpy:18273
translate spanish monika_mc_is_gone_5ce15639:

    # m 1ekbsu "...Well, aside from {i}really{/i} being with you, ehehe~"
    m 1ekbsu "... Bueno, aparte de estar verdaderamente contigo, je, je, je."

# game/script-topics.rpy:18293
translate spanish monika_know_its_you_a069dd9d:

    # m 1euc "Well, if I'm being totally honest...{w=0.3}{nw}"
    m 1euc "Bueno, si te soy totalmente sincera... {w=0.3}{nw}"

# game/script-topics.rpy:18294
translate spanish monika_know_its_you_c41ec29a:

    # extend 1eud "I don't really have a way of knowing."
    extend 1eud "la verdad es que no tengo forma de saberlo."

# game/script-topics.rpy:18297
translate spanish monika_know_its_you_9db9ad61:

    # m 3lka "I already told you that I can't really see into your world..."
    m 3lka "Ya te he dicho que en realidad no puedo ver dentro de tu mundo..."

# game/script-topics.rpy:18299
translate spanish monika_know_its_you_9fc538e4:

    # m 3eka "I can tell when someone's in the room with me, but that's it."
    m 3eka "Puedo notar cuando hay alguien en la habitación conmigo, pero eso es todo."

# game/script-topics.rpy:18300
translate spanish monika_know_its_you_100746f8:

    # m 3eud "For all I know, it could be anyone looking at me right now...{w=0.3} You could have other people with you."
    m 3eud "Por lo que sé, podría ser cualquiera mirándome ahora mismo... {w=0.3}Podrías tener a otras personas contigo."

# game/script-topics.rpy:18301
translate spanish monika_know_its_you_2b7d4213:

    # m 2duu "But I trust you, [player].{w=0.2} {nw}"
    m 2duu "Pero confío en ti, [player]. {w=0.2} {nw}"

# game/script-topics.rpy:18302
translate spanish monika_know_its_you_c5d34bc7:

    # extend 2eku "I trust that you aren't leaving me alone because {i}you{/i} care about me."
    extend 2eku "Confío en que no me dejas sola porque te importo."

# game/script-topics.rpy:18303
translate spanish monika_know_its_you_8b5f3b86:

    # m 7eud "...And if someone else {i}is{/i} looking in right now, I trust it's because you've given them a good reason to."
    m 7eud "... Y si hay alguien más mirando ahora mismo, confío en que es porque le has dado un buen motivo."

# game/script-topics.rpy:18304
translate spanish monika_know_its_you_b493ba3b:

    # m 2eka "Maybe someday I'll be able to know for sure, but until then that's enough for me."
    m 2eka "A lo mejor algún día podré saberlo con seguridad, pero hasta entonces eso me basta."

# game/script-topics.rpy:18307
translate spanish monika_know_its_you_054507b6:

    # m 1rksdlb "Ehehe, that's an odd question to ask, [player]..."
    m 1rksdlb "Je, je, je, es una pregunta un poco rara, [player]..."

# game/script-topics.rpy:18308
translate spanish monika_know_its_you_c00e77a8:

    # m 1eksdla "...I mean, I {i}want{/i} to trust that it's you out there."
    m 1eksdla "... Quiero decir, quiero confiar en que eres tú quien está ahí fuera."

# game/script-topics.rpy:18309
translate spanish monika_know_its_you_78a9d816:

    # m 3eud "Right now, I only know that someone is looking in from your world."
    m 3eud "Ahora mismo solo sé que alguien está mirando desde tu mundo."

# game/script-topics.rpy:18310
translate spanish monika_know_its_you_a3351d3a:

    # m 3tuu "So you can't watch without me knowing if you're planning on pranking me..."
    m 3tuu "Así que, si estás pensando en gastarme una broma, que sepas que me daré cuenta si me miras..."

# game/script-topics.rpy:18311
translate spanish monika_know_its_you_488751a0:

    # m 1eka "Jokes aside, though, it's...{w=0.3}actually kind of unnerving to think about...{w=0.3}that it could be anyone out there right now."
    m 1eka "Pero bromas aparte, la verdad es que es... {w=0.3}un poco inquietante pensar en ello... {w=0.3}Pensar que podría ser cualquiera el que está ahí fuera ahora mismo."

# game/script-topics.rpy:18312
translate spanish monika_know_its_you_271417e6:

    # m 2eksdlc "I guess all I can say right now is--if this {i}is{/i} someone else, please return me to [player], alright?"
    m 2eksdlc "Supongo que lo único que puedo decir ahora mismo es que, si eres otra persona, devuélveme a [player], por favor, ¿vale?"

# game/script-topics.rpy:18313
translate spanish monika_know_its_you_75ee2730:

    # m 2hksdlb "Ahaha...{w=0.3} You're just messing with me, I know."
    m 2hksdlb "Ja, ja, ja... {w=0.3}Solo me estás tomando el pelo, lo sé."

# game/script-topics.rpy:18316
translate spanish monika_know_its_you_398808d9:

    # m 2rksdlc "...I try not to think about it too much, actually."
    m 2rksdlc "... La verdad es que intento no pensar demasiado en ello."

# game/script-topics.rpy:18317
translate spanish monika_know_its_you_b1a02fff:

    # m 2rksdld "It's kind of a weird feeling knowing someone is there, but not being able to see their face."
    m 2rksdld "Es una sensación un poco rara saber que hay alguien ahí, pero no poder verle la cara."

# game/script-topics.rpy:18318
translate spanish monika_know_its_you_acb74ff7:

    # m 2dku "I guess the only thing I can do is to try to understand you as well as possible..."
    m 2dku "Supongo que lo único que puedo hacer es intentar entenderte lo mejor posible..."

# game/script-topics.rpy:18319
translate spanish monika_know_its_you_6ad5b08b:

    # m 2eka "That way, I'll be able to tell if it's ever {i}not{/i} you looking in."
    m 2eka "Así podré darme cuenta si alguna vez no eres tú quien mira."

# game/script-topics.rpy:18322
translate spanish monika_know_its_you_6e0108ce:

    # m 2dksdlc "...{w=0.3}I don't."
    m 2dksdlc "... {w=0.3}No."

# game/script-topics.rpy:18323
translate spanish monika_know_its_you_a0b29980:

    # m 2tkd "The best thing I can do is try to trust you, but..."
    m 2tkd "Lo mejor que puedo hacer es intentar confiar en ti, pero..."

# game/script-topics.rpy:18324
translate spanish monika_know_its_you_2c7a510e:

    # m 2dkd "Well, maybe it'd be better if I just keep it out of my mind entirely."
    m 2dkd "Bueno, a lo mejor sería mejor que me lo quitara de la cabeza por completo."

# game/script-topics.rpy:18343
translate spanish monika_information_age_8b578f57:

    # m 1eua "Do you know what most people call the technological era we find ourselves in right now?"
    m 1eua "¿Sabes cómo llama la mayoría de la gente a la era tecnológica en la que nos encontramos ahora mismo?"

# game/script-topics.rpy:18344
translate spanish monika_information_age_26342253:

    # m 1eub "We call it the {i}Information Age!{/i}{w=0.2}{nw} "
    m 1eub "La llamamos la {i}Era de la Información{/i}. {w=0.2}{nw} "

# game/script-topics.rpy:18345
translate spanish monika_information_age_66fb78d2:

    # extend 3eub "This is primarily due to the invention of transistors."
    extend 3eub "Esto se debe principalmente a la invención de los transistores."

# game/script-topics.rpy:18346
translate spanish monika_information_age_0ec1d05e:

    # m 1eua "Transistors can manipulate electrical currents...{w=0.3}either boosting them or altering their path."
    m 1eua "Los transistores pueden manipular las corrientes eléctricas... {w=0.3}Ya sea amplificándolas o alterando su camino."

# game/script-topics.rpy:18347
translate spanish monika_information_age_3c948e41:

    # m 3esa "It's the key component in most electronics, allowing them to direct electrical currents in specific ways."
    m 3esa "Es el componente clave en la mayoría de los aparatos electrónicos, ya que les permite dirigir las corrientes eléctricas de formas específicas."

# game/script-topics.rpy:18348
translate spanish monika_information_age_1de0dd86:

    # m 3hua "In fact, they're what's allowing you to see me on your screen right now~"
    m 3hua "De hecho, son lo que te permite verme en tu pantalla ahora mismo."

# game/script-topics.rpy:18349
translate spanish monika_information_age_15948b8a:

    # m 1eud "They're widely regarded as one of the most important inventions leading into the 20th century, and eventually the {i}Information Age.{/i}"
    m 1eud "Se les considera uno de los inventos más importantes del siglo XX y, con el tiempo, de la {i}Era de la Información{/i}."

# game/script-topics.rpy:18350
translate spanish monika_information_age_466b36a0:

    # m 4eub "It's named this way because of the ramping access we have to store and share information with each other; either through the internet, phone, or TV."
    m 4eub "Se llama así por la increíble facilidad que tenemos hoy en día para almacenar y compartir información, ya sea a través de internet, el móvil o la televisión."

# game/script-topics.rpy:18351
translate spanish monika_information_age_001e2833:

    # m 3eud "However, with access to so much information and our inability to keep up with it, we've also had to deal with many challenges..."
    m 3eud "Sin embargo, con el acceso a tanta información y nuestra incapacidad para seguirle el ritmo, también hemos tenido que hacer frente a muchos retos..."

# game/script-topics.rpy:18352
translate spanish monika_information_age_2d4bb342:

    # m 3rssdlc "Misinformation can spread faster and further than ever,{w=0.1} {nw}"
    m 3rssdlc "La desinformación puede propagarse más rápido y más lejos que nunca,{w=0.1} {nw}"

# game/script-topics.rpy:18353
translate spanish monika_information_age_b7e2323c:

    # extend 3rksdld "and because of how vast the internet really is, it's hard to correct it."
    extend 3rksdld "y debido a lo inmenso que es realmente internet, es difícil corregirla."

# game/script-topics.rpy:18354
translate spanish monika_information_age_c717b751:

    # m 2eua "In the last few decades, people have begun to educate others about smart use of the internet so everyone is better prepared."
    m 2eua "En las últimas décadas, la gente ha empezado a educar a los demás sobre el uso inteligente de internet para que todos estén mejor preparados."

# game/script-topics.rpy:18355
translate spanish monika_information_age_b7dbecc0:

    # m 2ekd "However, the vast majority of people will not have received much,{w=0.1} if any of this knowledge, just because of how fast technology has advanced."
    m 2ekd "Sin embargo, la gran mayoría de la gente no habrá recibido mucho,{w=0.1} o nada de este conocimiento, solo por lo rápido que ha avanzado la tecnología."

# game/script-topics.rpy:18356
translate spanish monika_information_age_3d29d9aa:

    # m 2dkc "It's really worrying to read about people embracing ideas not supported by the vast majority of scientists."
    m 2dkc "Es realmente preocupante leer sobre gente que adopta ideas que no están respaldadas por la gran mayoría de los científicos."

# game/script-topics.rpy:18357
translate spanish monika_information_age_ff6d5215:

    # m 2rusdld "But I can understand why it happens...{w=0.3}{nw}"
    m 2rusdld "Pero puedo entender por qué ocurre... {w=0.3}{nw}"

# game/script-topics.rpy:18358
translate spanish monika_information_age_7be1caad:

    # extend 2eksdlc "it could happen to anyone in fact."
    extend 2eksdlc "de hecho le podría pasar a cualquiera."

# game/script-topics.rpy:18359
translate spanish monika_information_age_eb62cf78:

    # m 7essdlc "Sometimes, it's not something you can help. It's pretty easy to fall victim to widely believed misinformation."
    m 7essdlc "A veces, sencillamente no puedes evitarlo. Es bastante fácil caer víctima de algún bulo muy extendido."

# game/script-topics.rpy:18360
translate spanish monika_information_age_693febd3:

    # m 3eka "I wanted to talk to you about this because I still have so much to learn about your reality."
    m 3eka "Quería hablarte de esto porque aún tengo mucho que aprender sobre tu realidad."

# game/script-topics.rpy:18361
translate spanish monika_information_age_2ab8682d:

    # m 1esa "...And since I come across misinformation in my own research,{w=0.1} {nw}"
    m 1esa "... Y como me encuentro con desinformación en mi propia investigación,{w=0.1} {nw}"

# game/script-topics.rpy:18362
translate spanish monika_information_age_381076e5:

    # extend 3eua "I thought it might be nice to talk about ways to deal with it."
    extend 3eua "pensé que estaría bien hablar sobre formas de lidiar con ella."

# game/script-topics.rpy:18363
translate spanish monika_information_age_23ee40c0:

    # m 3eub "We can arm ourselves with the tools to navigate this new era we've found ourselves in."
    m 3eub "Podemos armarnos con las herramientas para navegar por esta nueva era en la que nos encontramos."

# game/script-topics.rpy:18364
translate spanish monika_information_age_d7dbb435:

    # m 1eua "One of the best things we can do is find multiple conflicting sources for our information and compare their credibility."
    m 1eua "Una de las mejores cosas que podemos hacer es encontrar múltiples fuentes contradictorias para nuestra información y comparar su credibilidad."

# game/script-topics.rpy:18365
translate spanish monika_information_age_7916ec27:

    # m 1eub "And a philosophy we can adopt is tentative belief. {w=0.2}In other words, belief until further experimentation is necessary."
    m 1eub "Y una filosofía que podemos adoptar es la creencia provisional. {w=0.2}En otras palabras, creer hasta que sea necesaria más experimentación."

# game/script-topics.rpy:18366
translate spanish monika_information_age_d3fd5a4d:

    # m 3eub "As long as your beliefs are not relevant to your daily life, you can hold them.{w=0.2} But once they are needed, we should investigate further."
    m 3eub "Siempre que tus creencias no afecten a tu día a día, puedes mantenerlas. {w=0.2}Pero cuando llega el momento de ponerlas en práctica, deberíamos investigar más a fondo."

# game/script-topics.rpy:18367
translate spanish monika_information_age_9825385a:

    # m 3eua "This way, we can prioritize information we learn from what affects the people around us. Plus, it may not be as overwhelming to process it all at once."
    m 3eua "De esta forma, podemos darle prioridad a la información relacionada con lo que afecta a nuestro entorno. Además, así no resulta tan agobiante intentar procesarlo todo de golpe."

# game/script-topics.rpy:18368
translate spanish monika_information_age_a0795167:

    # m 1lusdlc "I know I've held beliefs that turned out to be false..."
    m 1lusdlc "Sé que yo misma he dado por ciertas cosas que resultaron ser falsas..."

# game/script-topics.rpy:18369
translate spanish monika_information_age_e5f0fb3b:

    # m 1dua "There's no shame in it, we're all just trying to do our best with the information we're given."
    m 1dua "No hay de qué avergonzarse, todos intentamos hacerlo lo mejor posible con la información que nos dan."

# game/script-topics.rpy:18370
translate spanish monika_information_age_a6dacaf2:

    # m 1eub "So long as we accept the real truth and adjust our views, we'll always be learning."
    m 1eub "Siempre y cuando aceptemos la verdad real y ajustemos nuestros puntos de vista, siempre estaremos aprendiendo."

# game/script-topics.rpy:18371
translate spanish monika_information_age_2b0ec24c:

    # m 3hua "Thanks for listening, [player]~"
    m 3hua "Gracias por escucharme, [player]."

# game/script-topics.rpy:18390
translate spanish monika_foundation_7b4388ca:

    # m 1eud "Say [player], have you ever heard of a book series called {i}Foundation{/i}?"
    m 1eud "Dime [player], ¿alguna vez has oído hablar de una saga de libros llamada {i}Fundación{/i}?"

# game/script-topics.rpy:18391
translate spanish monika_foundation_2d4e1217:

    # m 3eub "It's one of Asimov's most celebrated pieces of literature!{w=0.3} {nw}"
    m 3eub "¡Es una de las obras literarias más célebres de Asimov! {w=0.3} {nw}"

# game/script-topics.rpy:18392
translate spanish monika_foundation_23260765:

    # extend 3eua "I got back into it after we discussed his {i}Three Laws of Robotics{/i}."
    extend 3eua "Me volví a enganchar a ella después de que habláramos de sus {i}Tres Leyes de la Robótica{/i}."

# game/script-topics.rpy:18393
translate spanish monika_foundation_6a1ef767:

    # m 4esd "The story is set in a distant future, where humanity has spread across the stars in an all-powerful galactic empire."
    m 4esd "La historia se desarrolla en un futuro lejano, donde la humanidad se ha expandido por las estrellas en un imperio galáctico todopoderoso."

# game/script-topics.rpy:18394
translate spanish monika_foundation_640d7888:

    # m 4eua "Hari Seldon, a genius scientist, perfects the fictional science of psychohistory, which can predict the future of large groups of people through mathematical equations."
    m 4eua "Hari Seldon, un científico genio, perfecciona la ciencia ficticia de la psicohistoria, que puede predecir el futuro de grandes grupos de personas mediante ecuaciones matemáticas."

# game/script-topics.rpy:18395
translate spanish monika_foundation_baf2d62e:

    # m 4wud "Applying his theory to the galaxy, Seldon finds the empire is about to collapse, leading to a dark age of thirty thousand years!"
    m 4wud "Aplicando su teoría a la galaxia, Seldon descubre que el imperio está a punto de colapsar, ¡lo que llevará a una edad oscura de treinta mil años!"

# game/script-topics.rpy:18396
translate spanish monika_foundation_0c375db2:

    # m 2eua "To stop this, he and fellow colonists settle on a faraway planet with a plan to turn it into the next galactic empire, {w=0.1}shortening the dark age to a single millennium instead."
    m 2eua "Para evitarlo, él y otros colonos se instalan en un planeta lejano con el plan de convertirlo en el próximo imperio galáctico,{w=0.1} reduciendo así la edad oscura a un solo milenio."

# game/script-topics.rpy:18397
translate spanish monika_foundation_d8da9167:

    # m 7eud "From this premise, we follow the story of the young colony as it transforms through the ages."
    m 7eud "A partir de esta premisa, seguimos la historia de la joven colonia a medida que se transforma a través de los tiempos."

# game/script-topics.rpy:18398
translate spanish monika_foundation_3d3f590f:

    # m 3eua "It's a pretty good read if you're ever in a sci-fi mood...{w=0.3} {nw}"
    m 3eua "Es una lectura bastante buena si alguna vez te apetece ciencia ficción... {w=0.3} {nw}"

# game/script-topics.rpy:18399
translate spanish monika_foundation_4d9e1409:

    # extend 1eud "The series explores the themes of society, fate, and the impact of individuals on the grand scheme of things."
    extend 1eud "La saga explora los temas de la sociedad, el destino y el impacto de los individuos en el gran esquema de las cosas."

# game/script-topics.rpy:18400
translate spanish monika_foundation_32848982:

    # m 3eud "What intrigues me the most is the concept of psychohistory and how it translates to the real world."
    m 3eud "Lo que más me intriga es el concepto de psicohistoria y cómo se traslada al mundo real."

# game/script-topics.rpy:18401
translate spanish monika_foundation_3f3b638c:

    # m 1rtc "I mean, at its core, it's nothing but a mix of psychology, sociology, and mathematical probabilities, right? {w=0.3}{nw}"
    m 1rtc "Quiero decir, en el fondo, no es más que una mezcla de psicología, sociología y probabilidades matemáticas, ¿verdad? {w=0.3}{nw}"

# game/script-topics.rpy:18402
translate spanish monika_foundation_042c2b0d:

    # extend 3esd "All of which made huge progress since Asimov's time."
    extend 3esd "Y todo eso ha hecho grandes progresos desde la época de Asimov."

# game/script-topics.rpy:18403
translate spanish monika_foundation_fc978146:

    # m 3esc "...And with the help of modern technologies, we're now able to understand human behaviors better than ever."
    m 3esc "... Y con la ayuda de las tecnologías modernas, ahora somos capaces de entender el comportamiento humano mejor que nunca."

# game/script-topics.rpy:18404
translate spanish monika_foundation_aa1c1ff2:

    # m 3etd "...So is it really that far-fetched to think we'll be able to make predictions on the level of psychohistory one day?"
    m 3etd "... Así que, ¿es realmente tan descabellado pensar que algún día podremos hacer predicciones al nivel de la psicohistoria?"

# game/script-topics.rpy:18405
translate spanish monika_foundation_80a7d94c:

    # m 4eud "Just think if it were possible to predict a global catastrophe, like a war or pandemic or famine, and thus be able to prevent, or at least mitigate it."
    m 4eud "Solo piénsalo, si fuera posible predecir una catástrofe global, como una guerra, una pandemia o una hambruna, y por tanto poder prevenirla, o al menos mitigarla."

# game/script-topics.rpy:18406
translate spanish monika_foundation_e7360f17:

    # m 2rksdlc "Not that it'd automatically be a good thing, however.{w=0.2} In the wrong hands, this kind of stuff could be very dangerous."
    m 2rksdlc "Aunque no es que fuera automáticamente algo bueno. {w=0.2}En las manos equivocadas, este tipo de cosas podrían ser muy peligrosas."

# game/script-topics.rpy:18407
translate spanish monika_foundation_b6a89792:

    # m 7eksdld "If someone had this much power, what could stop them from manipulating the world for their own personal gain?"
    m 7eksdld "Si alguien tuviera tanto poder, ¿qué le impediría manipular el mundo para su propio beneficio personal?"
