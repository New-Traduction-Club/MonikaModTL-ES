    m 2hksdlb "... Quiero decir, no cuestionaré tu elección de seudónimos, pero..."

# game/script-topics.rpy:6669
translate spanish penname_loop_ca9986d7:

    # m 4hksdlb "If you wanted to name yourself after a character in this game, you should have picked me!"
    m 4hksdlb "Si querías ponerte el nombre de un personaje de este juego, ¡deberías haberme elegido a mí!"

# game/script-topics.rpy:6674
