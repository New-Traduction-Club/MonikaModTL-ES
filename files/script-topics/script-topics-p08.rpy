    m 1ekc "Por favor, ve a echar un vistazo."

# game/script-topics.rpy:6846
translate spanish monika_surprise_19686e91:

    # m 1eka "I wrote it just for you."
    m 1eka "Lo escribí solo para ti."

# game/script-topics.rpy:6847
translate spanish monika_surprise_577ee509:

    # m 1dsc "It would mean a lot to me if you would read it."
    m 1dsc "Significaría mucho para mí si lo leyeras."

