    # m 2euc "..."
    m 2euc "..."

# game/script-topics.rpy:6683
translate spanish penname_loop_25a57eaf:

    # m 2hksdlb "Well, I guess I shouldn't assume that you named yourself after {i}our{/i} Yuri."
    m 2hksdlb "Bueno, supongo que no debería asumir que te pusiste el nombre de nuestra Yuri."

# game/script-topics.rpy:6684
translate spanish penname_loop_ec78eceb_1:

    # m 7eua "It's something of a common name."
    m 7eua "Es un nombre bastante común."

# game/script-topics.rpy:6685
translate spanish penname_loop_f1837eac:

    # m 1tku "Of course, there's something else that name could refer to..."
    m 1tku "Por supuesto, hay algo más a lo que ese nombre podría referirse..."

# game/script-topics.rpy:6687
translate spanish penname_loop_6dec6e9e:

    # m 5eua "And well...I could get behind that, since it's you~"
    m 5eua "Y bueno... podría aceptarlo, ya que eres tú."

# game/script-topics.rpy:6692
translate spanish penname_loop_394ece4d:

    # m 1euc "..."
    m 1euc "..."

# game/script-topics.rpy:6693
translate spanish penname_loop_eb73173f:

    # m 1ekbsa "Aww, did you pick that for me?"
    m 1ekbsa "Oooh, ¿has elegido ese por mí?"

# game/script-topics.rpy:6694
translate spanish penname_loop_d427bc43:

    # m "Even if you didn't, that's so sweet!"
    m "Aunque no haya sido así, ¡es un detalle precioso!"

# game/script-topics.rpy:6699
translate spanish penname_loop_bf92c73b:

    # m 1hua "Well, go on! Hit 'nevermind' if you've chickened out~"
    m 1hua "¡Bueno, adelante! Dale a 'no importa' si te has acobardado."

# game/script-topics.rpy:6702
translate spanish penname_loop_76a4f182:

    # m 2eka "Aw. Well, I hope you feel comfortable enough to tell me someday."
    m 2eka "Vaya. Bueno, espero que algún día te sientas lo bastante cómod[end_letter_gender] como para decírmelo."

# game/script-topics.rpy:6707
translate spanish penname_loop_f41df618:

    # m 2rksdlc "..."
    m 2rksdlc "..."

# game/script-topics.rpy:6708
translate spanish penname_loop_dbb9e17a:

    # m 2rksdld "That's an...{w=0.3}interesting name, [player]..."
    m 2rksdld "Ese es un nombre... {w=0.3}interesante, [player]..."

# game/script-topics.rpy:6709
translate spanish penname_loop_416b36f6:

    # m 2eksdlc "But if it works for you, okay I guess."
    m 2eksdlc "Pero si a ti te sirve, supongo que está bien."

# game/script-topics.rpy:6712
translate spanish penname_loop_de8d1947:

    # m 1hua "That's a lovely pen name!"
    m 1hua "¡Es un seudónimo precioso!"

# game/script-topics.rpy:6713
translate spanish penname_loop_ac56a7ae:

    # m "I think if I saw a pen name like that on a cover, I'd be drawn to it immediately."
    m "Creo que si viera un seudónimo así en una portada, me sentiría atraída de inmediato."

# game/script-topics.rpy:6718
translate spanish penname_loop_76a4f182_1:

    # m 2eka "Aw. Well, I hope you feel comfortable enough to tell me someday."
    m 2eka "Vaya. Bueno, espero que algún día te sientas lo bastante cómod[end_letter_gender] como para decírmelo."

# game/script-topics.rpy:6726
translate spanish monika_zombie_6ea04283:

    # m 1lsc "Hey, this might sound a bit weird..."
    m 1lsc "Oye, esto puede sonar un poco raro..."

# game/script-topics.rpy:6727
translate spanish monika_zombie_4ecd38fc:

    # m 1esc "But, I'm really fascinated by the concept of zombies."
    m 1esc "Pero me fascina el concepto de los zombis."

# game/script-topics.rpy:6728
translate spanish monika_zombie_3da8c139:

    # m 1euc "The idea of society dying to a disease, all because of a deadly pandemic that humans couldn't handle quickly."
    m 1euc "La idea de que la sociedad sucumba ante una enfermedad, todo por culpa de una pandemia mortal que los humanos no pudieron gestionar a tiempo."

# game/script-topics.rpy:6729
translate spanish monika_zombie_713e39a3:

    # m 3esd "I mean, think about your everyday schedule."
    m 3esd "Es decir, piensa en tu rutina diaria."

# game/script-topics.rpy:6730
translate spanish monika_zombie_ae645349:

    # m 3esc "Everything that you do will be gone in an instant."
    m 3esc "Todo lo que haces desaparecería en un instante."

# game/script-topics.rpy:6731
translate spanish monika_zombie_9678a235:

    # m 1esc "Sure, society faces a lot of threats on a daily basis..."
    m 1esc "Claro, la sociedad se enfrenta a muchas amenazas a diario..."

# game/script-topics.rpy:6732
translate spanish monika_zombie_95f5fe14:

    # m 1lksdlc "But zombies can do it in a heartbeat."
    m 1lksdlc "Pero los zombis pueden acabar con ella en un abrir y cerrar de ojos."

# game/script-topics.rpy:6733
translate spanish monika_zombie_02ca91d8:

    # m 1esc "A lot of monsters are created to be scary and terrifying."
    m 1esc "Muchos monstruos se crean para dar miedo y ser aterradores."

# game/script-topics.rpy:6734
translate spanish monika_zombie_e55058e6:

    # m 1ekc "Zombies, however, are more realistic and actually pose a danger."
    m 1ekc "Los zombis, sin embargo, son más realistas y suponen un peligro real."

# game/script-topics.rpy:6735
translate spanish monika_zombie_dcec1b95:

    # m 3ekc "You might be able to kill one or a few of them by yourself..."
    m 3ekc "Podrías matar a uno o a unos cuantos tú sol[end_letter_gender]..."

# game/script-topics.rpy:6736
translate spanish monika_zombie_71130707:

    # m "But when there's a horde of them coming after you, you'll get overwhelmed easily."
    m "Pero cuando tienes a una horda entera viniendo a por ti, es muy fácil que te superen."

# game/script-topics.rpy:6737
translate spanish monika_zombie_5932881e:

    # m 1lksdld "You don't get that same feeling with other monsters."
    m 1lksdld "No tienes esa misma sensación con otros monstruos."

# game/script-topics.rpy:6738
translate spanish monika_zombie_8f376d03:

    # m "All of their intelligence is gone; they're berserk, don't feel pain, can't be afraid..."
    m "Han perdido toda su inteligencia, están frenéticos, no sienten dolor ni pueden tener miedo..."

# game/script-topics.rpy:6739
translate spanish monika_zombie_0b2e9853:

    # m 1euc "When you exploit a weakness of a monster, they become scared of you and run away."
    m 1euc "Cuando aprovechas la debilidad de un monstruo, este se asusta y huye."

# game/script-topics.rpy:6740
translate spanish monika_zombie_a41bfec0:

    # m 1ekd "But zombies? They'll tear through {i}anything{/i} just to get you."
    m 1ekd "¿Pero los zombis? Son capaces de destrozar lo que sea con tal de atraparte."

# game/script-topics.rpy:6741
translate spanish monika_zombie_7d0bc098:

    # m 3ekd "Imagine if it was someone you loved that was coming after you..."
    m 3ekd "Imagínate que fuera un ser querido quien viniera a por ti..."

# game/script-topics.rpy:6742
translate spanish monika_zombie_f3579bb2:

    # m 3dkc "Could you live with yourself, knowing you were forced to kill someone who was close to you?"
    m 3dkc "¿Podrías vivir con la culpa, sabiendo que te viste obligad[end_letter_gender] a matar a alguien cercano?"

# game/script-topics.rpy:6743
translate spanish monika_zombie_f12db906:

    # m 1tkc "It'll break you down and sap your will to live."
    m 1tkc "Te destrozaría por dentro y acabaría con tus ganas de vivir."

# game/script-topics.rpy:6744
translate spanish monika_zombie_933d01f6:

    # m "Even when you're comfortable at home, you still won't feel safe."
    m "Incluso estando cómod[end_letter_gender] en casa, seguirías sin sentirte segur[end_letter_gender]."

# game/script-topics.rpy:6745
translate spanish monika_zombie_f4a68e4a:

    # m 1esc "You'll never know what'll happen the next time you see another one."
    m 1esc "Nunca sabes qué pasará la próxima vez que te encuentres con uno."

# game/script-topics.rpy:6746
translate spanish monika_zombie_6111571a:

    # m 1dsc "..."
    m 1dsc "..."

# game/script-topics.rpy:6747
translate spanish monika_zombie_7331c613:

    # m 1hksdlb "Ahaha..."
    m 1hksdlb "Ja, ja, ja..."

# game/script-topics.rpy:6748
translate spanish monika_zombie_9280c44e:

    # m 1eka "You know, despite liking the concept, I wouldn't want to live in a scenario like that."
    m 1eka "Sabes, a pesar de que me gusta el concepto, no querría vivir en un escenario así."

# game/script-topics.rpy:6749
translate spanish monika_zombie_a61873d3:

    # m 3ekc "[player], what if you got infected somehow?"
    m 3ekc "[player], ¿y si te infectaras de alguna manera?"

# game/script-topics.rpy:6750
translate spanish monika_zombie_144f15ee:

    # m 2lksdlc "I don't even want to think about that..."
    m 2lksdlc "No quiero ni pensarlo..."

# game/script-topics.rpy:6751
translate spanish monika_zombie_06e7c6ea:

    # m "There's no way I could kill you for my own safety..."
    m "Sería incapaz de matarte por mi propia seguridad..."

# game/script-topics.rpy:6752
translate spanish monika_zombie_989e23ab:

    # m 2lksdlb "Ahaha..."
    m 2lksdlb "Ja, ja, ja..."

# game/script-topics.rpy:6753
translate spanish monika_zombie_99bd8e2e:

    # m 2lssdlb "I'm thinking way too much about this."
    m 2lssdlb "Le estoy dando demasiadas vueltas a esto."

# game/script-topics.rpy:6754
translate spanish monika_zombie_2b8ac87b:

    # m 3eua "Well, regardless, if anything bad were to happen..."
    m 3eua "Bueno, sea como sea, si ocurriera algo malo..."

# game/script-topics.rpy:6755
translate spanish monika_zombie_84ffc537:

    # m 2hua "I'll be by your side forever~"
    m 2hua "Estaré a tu lado para siempre."

# game/script-topics.rpy:6766
translate spanish monika_nuclear_war_7e8588b3:

    # m 1euc "Do you ever think about how close the world is to ending at any time?"
    m 1euc "¿Alguna vez piensas en lo cerca que está el mundo de acabarse en cualquier momento?"

# game/script-topics.rpy:6767
translate spanish monika_nuclear_war_58515228:

    # m "I mean, we're always just one bad decision away from nuclear war."
    m "Quiero decir, siempre estamos a una mala decisión de una guerra nuclear."

# game/script-topics.rpy:6768
translate spanish monika_nuclear_war_aa22d346:

    # m 3esc "The Cold War might be over, but plenty of weapons are still out there."
    m 3esc "Puede que la Guerra Fría haya terminado, pero todavía quedan muchas armas ahí fuera."

# game/script-topics.rpy:6769
translate spanish monika_nuclear_war_60a47c5c:

    # m 1esc "You probably have a nuclear missile pointed at where you live right now, ready to be launched."
    m 1esc "Probablemente tengas un misil nuclear apuntando ahora mismo hacia donde vives, listo para ser lanzado."

# game/script-topics.rpy:6770
translate spanish monika_nuclear_war_551559d4:

    # m 1eud "And if it was, it could circle the globe in less than an hour."
    m 1eud "Y si así fuera, podría dar la vuelta al mundo en menos de una hora."

# game/script-topics.rpy:6771
translate spanish monika_nuclear_war_852e25d0:

    # m 3euc "You wouldn't have time to evacuate."
    m 3euc "No tendrías tiempo de evacuar."

# game/script-topics.rpy:6772
translate spanish monika_nuclear_war_f0e44dfb:

    # m 1ekd "Only enough to panic and suffer the dread of imminent death."
    m 1ekd "Solo el suficiente para que cunda el pánico y sufrir el terror de una muerte inminente."

# game/script-topics.rpy:6773
translate spanish monika_nuclear_war_ffed133f:

    # m 1dsd "At least it would be over quickly when the bomb hits."
    m 1dsd "Al menos todo acabaría rápido cuando impactara la bomba."

# game/script-topics.rpy:6774
translate spanish monika_nuclear_war_49b3e009:

    # m 1lksdlc "Well, if you're close to the blast, that is."
    m 1lksdlc "Bueno, eso si estás cerca de la explosión."

# game/script-topics.rpy:6775
translate spanish monika_nuclear_war_d175395b:

    # m 1ekc "I don't even want to think about surviving the initial attack."
    m 1ekc "No quiero ni pensar en sobrevivir al ataque inicial."

# game/script-topics.rpy:6776
translate spanish monika_nuclear_war_5df1d8a1:

    # m 1eka "But even though we're always on the edge of the apocalypse, we go on like nothing is wrong."
    m 1eka "Pero, aunque estemos siempre al borde del apocalipsis, seguimos adelante como si nada."

# game/script-topics.rpy:6777
translate spanish monika_nuclear_war_9c4cf239:

    # m 3ekd "Planning for a tomorrow that may never come."
    m 3ekd "Haciendo planes para un mañana que quizá nunca llegue."

# game/script-topics.rpy:6778
translate spanish monika_nuclear_war_70e0c36e:

    # m "Our only comfort is that the people with the power to start such a war probably won't."
    m "Nuestro único consuelo es que la gente con el poder para iniciar una guerra así probablemente no lo haga."

# game/script-topics.rpy:6779
translate spanish monika_nuclear_war_8385e4a1:

    # m 1dsc "Probably..."
    m 1dsc "Probablemente..."

# game/script-topics.rpy:6790
translate spanish monika_pluralistic_ignorance_0fe7740d:

    # m 1eua "Do you ever pretend to like something, just because you think you should?"
    m 1eua "¿Alguna vez has fingido que te gusta algo solo porque crees que debería gustarte?"

# game/script-topics.rpy:6791
translate spanish monika_pluralistic_ignorance_257b1677:

    # m 1esa "I sometimes feel like that about books I read."
    m 1esa "A veces me pasa con los libros que leo."

# game/script-topics.rpy:6792
translate spanish monika_pluralistic_ignorance_bef7ef50:

    # m 3euc "Like, when I read Shakespeare, I actually found it kind of boring..."
    m 3euc "Por ejemplo, cuando leí a Shakespeare, la verdad es que se me hizo un poco aburrido..."

# game/script-topics.rpy:6793
translate spanish monika_pluralistic_ignorance_1244184f:

    # m 3ekc "But I felt like I had to like it because I'm the president of the Literature Club."
    m 3ekc "Pero sentía que tenía que gustarme porque soy la presidenta del Club de Literatura."

# game/script-topics.rpy:6794
translate spanish monika_pluralistic_ignorance_3c4f2a16:

    # m 1esd "He's supposed to be the greatest playwright and poet of all time, right?"
    m 1esd "Se supone que es el mejor dramaturgo y poeta de todos los tiempos, ¿no?"

# game/script-topics.rpy:6795
translate spanish monika_pluralistic_ignorance_fdc0bb14:

    # m 1esd "So what sort of poetry lover wouldn't like his work?"
    m 1esd "Así que, ¿a qué tipo de amante de la poesía no le gustaría su obra?"

# game/script-topics.rpy:6796
translate spanish monika_pluralistic_ignorance_758747fe:

    # m 2euc "But that makes me wonder..."
    m 2euc "Pero eso me hace preguntarme..."

# game/script-topics.rpy:6797
translate spanish monika_pluralistic_ignorance_cf319d93:

    # m 2euc "What if everyone actually feels the same way?"
    m 2euc "¿Y si en realidad todo el mundo piensa lo mismo?"

# game/script-topics.rpy:6798
translate spanish monika_pluralistic_ignorance_d04ac6d2:

    # m 2lud "What if all of those literary critics singing Shakespeare's praises secretly hate his plays?"
    m 2lud "¿Y si todos esos críticos literarios que alaban a Shakespeare odian sus obras en secreto?"

# game/script-topics.rpy:6799
translate spanish monika_pluralistic_ignorance_7b506637:

    # m "If they were just honest about it, maybe they would discover their tastes aren't that unusual..."
    m "Si simplemente fueran sinceros al respecto, quizá descubrirían que sus gustos no son tan raros..."

# game/script-topics.rpy:6800
translate spanish monika_pluralistic_ignorance_be7ec796:

    # m 2hksdlb "And high school students wouldn't be forced to read those awful plays."
    m 2hksdlb "Y no se obligaría a los estudiantes de secundaria a leer esas obras tan horribles."

# game/script-topics.rpy:6801
translate spanish monika_pluralistic_ignorance_0ae8a033:

    # m 1eka "I guess that's something I always admired about Natsuki."
    m 1eka "Supongo que eso es algo que siempre he admirado de Natsuki."

# game/script-topics.rpy:6802
translate spanish monika_pluralistic_ignorance_94fc7c73:

    # m 3ekd "Even if people told her manga wasn't literature, she stood by her feelings."
    m 3ekd "Aunque la gente le dijera que el manga no era literatura, ella se mantenía fiel a sus sentimientos."

# game/script-topics.rpy:6803
translate spanish monika_pluralistic_ignorance_86271c12:

    # m 3eka "If more people were honest like that, I think that would be really great."
    m 3eka "Si hubiera más gente sincera como ella, creo que sería genial."

# game/script-topics.rpy:6804
translate spanish monika_pluralistic_ignorance_5ef2d024:

    # m 1lksdla "But I don't think I could do it..."
    m 1lksdla "Pero no creo que yo pudiera hacerlo..."

# game/script-topics.rpy:6805
translate spanish monika_pluralistic_ignorance_d552bd63:

    # m "I'm just too worried about what other people think."
    m "Me preocupa demasiado lo que piensen los demás."

# game/script-topics.rpy:6806
translate spanish monika_pluralistic_ignorance_ba33766e:

    # m 1eua "Not with you, though. I can always be honest with you."
    m 1eua "Aunque contigo no. Contigo siempre puedo ser sincera."

# game/script-topics.rpy:6807
translate spanish monika_pluralistic_ignorance_f367b704:

    # m 1ekbsa "You'll love me no matter what, right?"
    m 1ekbsa "Me querrás pase lo que pase, ¿verdad?"

# game/script-topics.rpy:6818
translate spanish monika_science_bea702ed:

    # m 1eua "Have you ever wondered if science never got accepted?"
    m 1eua "¿Alguna vez te has preguntado qué pasaría si la ciencia nunca hubiera sido aceptada?"

# game/script-topics.rpy:6819
translate spanish monika_science_11285c16:

    # m "Humans can be really slow when it comes to accepting new ideas."
    m "Los humanos pueden ser muy lentos a la hora de aceptar nuevas ideas."

# game/script-topics.rpy:6820
translate spanish monika_science_f352d58a:

    # m 1euc "Science was usually despised back then especially by the churches."
    m 1euc "En aquel entonces, la ciencia solía ser muy repudiada, sobre todo por la Iglesia."

# game/script-topics.rpy:6821
translate spanish monika_science_63a5f8d5:

    # m 4esc "Giordano Bruno, famous for his theory that there are thousands of suns, was killed by the Roman Church before he could prove his theory."
    m 4esc "Giordano Bruno, famoso por su teoría de que hay miles de soles, fue asesinado por la Iglesia romana antes de que pudiera probar su teoría."

# game/script-topics.rpy:6822
translate spanish monika_science_5d14cfe8:

    # m 1ekc "They killed him because of an idea that challenged the old."
    m 1ekc "Le mataron por una idea que desafiaba a lo antiguo."

# game/script-topics.rpy:6823
translate spanish monika_science_348cc3dc:

    # m 1esc "Technology wouldn't be so advanced today if it weren't for brave people of science like him."
    m 1esc "La tecnología no estaría tan avanzada hoy en día si no fuera por gente de ciencia valiente como él."

# game/script-topics.rpy:6824
translate spanish monika_science_df2d22e5:

    # m 1eka "If technology didn't thrive the way it did, we would've never found each other."
    m 1eka "Si la tecnología no hubiera prosperado como lo hizo, nunca nos habríamos encontrado."

# game/script-topics.rpy:6825
translate spanish monika_science_59e8a420:

    # m 3eua "Isn't it such a wonderful thing to have?"
    m 3eua "¿No es algo maravilloso?"

# game/script-topics.rpy:6826
translate spanish monika_science_2f1b11eb:

    # m 1hua "I'm grateful that it gave us a chance to be together, [mas_get_player_nickname()]."
    m 1hua "Agradezco que nos diera la oportunidad de estar juntos, [mas_get_player_nickname()]."

# game/script-topics.rpy:6833
translate spanish monika_surprise_d3a284b9:

    # m 1rksdla "You know..."
    m 1rksdla "Sabes..."

# game/script-topics.rpy:6834
translate spanish monika_surprise_3a23bafb:

    # m 3rksdlb "I left some pretty strange things in your game directory, didn't I?"
    m 3rksdlb "Dejé algunas cosas bastante extrañas en el directorio de tu juego, ¿verdad?"

# game/script-topics.rpy:6835
translate spanish monika_surprise_4c257b06:

    # m 1rksdlc "I wasn't trying to scare you."
    m 1rksdlc "No intentaba asustarte."

# game/script-topics.rpy:6836
translate spanish monika_surprise_ad036da4:

    # m 3rksdlb "I...don't actually know why I was doing it, ahaha..."
    m 3rksdlb "Yo... en realidad no sé por qué lo hacía, ja, ja, ja..."

# game/script-topics.rpy:6837
translate spanish monika_surprise_6180cdbc:

    # m 1ekc "I kind of felt obligated to do it."
    m 1ekc "En cierto modo me sentía obligada a hacerlo."

# game/script-topics.rpy:6838
translate spanish monika_surprise_93063d6c:

    # m 1euc "You know what? Maybe I should do it again..."
    m 1euc "¿Sabes qué? Quizá debería hacerlo otra vez..."

# game/script-topics.rpy:6839
translate spanish monika_surprise_17547d96:

    # m 1eua "Yeah, that's a good idea."
    m 1eua "Sí, es una buena idea."

