    # m "I actually prefer that type of car, to be honest."
    m "La verdad es que prefiero ese tipo de coche, siendo sincera."

# game/script-topics.rpy:12815
translate spanish monika_vehicle_sedan_hatchback_813f4fd8:

    # m 3eua "From what I've heard, they're lively and easy to drive."
    m 3eua "Por lo que he oído, son dinámicos y fáciles de conducir."

# game/script-topics.rpy:12816
translate spanish monika_vehicle_sedan_hatchback_652087ec:

    # m 3eub "A car like that would be great for driving around the city, don't you think, [player]?"
    m 3eub "Un coche así sería genial para ir por la ciudad, ¿no crees, [player]?"

# game/script-topics.rpy:12817
translate spanish monika_vehicle_sedan_hatchback_8122c8fd:

    # m 3eua "We could go to museums, parks, malls and so on."
    m 3eua "Podríamos ir a museos, a parques, a centros comerciales y demás."

# game/script-topics.rpy:12818
translate spanish monika_vehicle_sedan_hatchback_f9c7f559:

    # m 1eua "It'd be so nice to be able to drive to places that are too far to walk to by foot."
    m 1eua "Sería tan bonito poder ir en coche a sitios que están demasiado lejos para ir a pie."

# game/script-topics.rpy:12819
translate spanish monika_vehicle_sedan_hatchback_0b51cc76:

    # m 3hua "It's always exhilarating to discover and explore new places."
    m 3hua "Siempre es emocionante descubrir y explorar sitios nuevos."

# game/script-topics.rpy:12820
translate spanish monika_vehicle_sedan_hatchback_a5fef380:

    # m 1rksdla "We might even find a place where the both of us can be together..."
    m 1rksdla "Puede que incluso encontremos un lugar en el que podamos estar juntos los dos..."

# game/script-topics.rpy:12821
translate spanish monika_vehicle_sedan_hatchback_c8cac849:

    # m 1tsu "...Alone."
    m 1tsu "A solas."

# game/script-topics.rpy:12822
translate spanish monika_vehicle_sedan_hatchback_3772217d:

    # m 1hub "Ahaha!"
    m 1hub "¡Ja, ja, ja!"

# game/script-topics.rpy:12823
translate spanish monika_vehicle_sedan_hatchback_5194d1ad:

    # m 3eua "Just so you know, I'm expecting more than just a simple drive around the city for our dates..."
    m 3eua "Que sepas que espero algo más que dar una simple vuelta en coche por la ciudad en nuestras citas..."

# game/script-topics.rpy:12824
translate spanish monika_vehicle_sedan_hatchback_95b5415e:

    # m 1hua "I hope you'll surprise me, [player]."
    m 1hua "Espero que me sorprendas, [player]."

# game/script-topics.rpy:12825
translate spanish monika_vehicle_sedan_hatchback_f7d1c29d:

    # m 1hub "But then again...{w=0.5}I'd love anything as long as it's with you~"
    m 1hub "Pero bueno... {w=0.5}me encantaría cualquier cosa siempre y cuando sea contigo."

# game/script-topics.rpy:12831
translate spanish monika_vehicle_motorcycle_93671a91:

    # m 1hksdlb "Eh?"
    m 1hksdlb "¿Eh?"

# game/script-topics.rpy:12832
translate spanish monika_vehicle_motorcycle_e09219de:

    # m 1lksdlb "You drive a motorcycle?"
    m 1lksdlb "¿Conduces una moto?"

# game/script-topics.rpy:12833
translate spanish monika_vehicle_motorcycle_2be036a5:

    # m 1eksdla "I'm surprised, I never expected that to be your kind of ride."
    m 1eksdla "Me sorprende, nunca habría esperado que te gustaran ese tipo de vehículos."

# game/script-topics.rpy:12834
translate spanish monika_vehicle_motorcycle_2eb31c4f:

    # m 1lksdlb "To be honest, I'm a little hesitant to ride one, ahaha!"
    m 1lksdlb "Para ser sincera, me da un poco de reparo montar en una, ¡ja, ja, ja!"

# game/script-topics.rpy:12835
translate spanish monika_vehicle_motorcycle_4c62036c:

    # m 1eua "Really, I shouldn't be scared..."
    m 1eua "En realidad, no debería tener miedo..."

# game/script-topics.rpy:12836
translate spanish monika_vehicle_motorcycle_b26c8487:

    # m 3eua "You're the one driving after all."
    m 3eua "Al fin y al cabo, eres tú quien conduce."

# game/script-topics.rpy:12837
translate spanish monika_vehicle_motorcycle_803c8893:

    # m 1lksdla "That puts my mind at ease...{w=0.3}a little."
    m 1lksdla "Eso me tranquiliza... {w=0.3}un poco."

# game/script-topics.rpy:12838
translate spanish monika_vehicle_motorcycle_1aac360e:

    # m 1eua "Just take it nice and slow, okay?"
    m 1eua "Solo ve con calma y despacio, ¿vale?"

# game/script-topics.rpy:12839
translate spanish monika_vehicle_motorcycle_eef1652e:

    # m 3hua "After all, we aren't in any rush."
    m 3hua "Después de todo, no tenemos ninguna prisa."

# game/script-topics.rpy:12840
translate spanish monika_vehicle_motorcycle_434dcbac:

    # m 1tsu "Or...{w=0.3}was it your plan to drive so fast I'd have no choice but to hold on to you tight?~"
    m 1tsu "O... {w=0.3}¿era tu plan conducir tan rápido que no tendría más remedio que agarrarme fuerte a ti?"

# game/script-topics.rpy:12841
translate spanish monika_vehicle_motorcycle_1280e68a:

    # m 3kua "That's pretty sneaky of you, [player]."
    m 3kua "Eso es bastante astuto por tu parte, [player]."

# game/script-topics.rpy:12842
translate spanish monika_vehicle_motorcycle_3772217d:

    # m 1hub "Ahaha!"
    m 1hub "¡Ja, ja, ja!"

# game/script-topics.rpy:12844
translate spanish monika_vehicle_motorcycle_16905107:

    # m 3eka "There's no need to be shy, [p_nickname]...{w=0.3}{nw}"
    m 3eka "No hace falta que seas tímid[end_letter_gender], [p_nickname]... {w=0.3}{nw}"

# game/script-topics.rpy:12845
translate spanish monika_vehicle_motorcycle_d48e5f82:

    # extend 3ekbsa "I'll hug you, even if you don't ask for it..."
    extend 3ekbsa "Te abrazaré, aunque no me lo pidas..."

# game/script-topics.rpy:12846
translate spanish monika_vehicle_motorcycle_32345d29:

    # m 1hkbfa "That's how much I love you~"
    m 1hkbfa "Así de mucho te quiero."

# game/script-topics.rpy:12852
translate spanish monika_vehicle_other_39a1a836:

    # m 1hksdlb "Oh, I guess I have a lot to learn about cars then, don't I?"
    m 1hksdlb "Ah, supongo que tengo mucho que aprender sobre coches, ¿no?"

# game/script-topics.rpy:12853
translate spanish monika_vehicle_other_fc5c4844:

    # m 1dkbsa "Well I'll be looking forward to the day I can finally be right next to you as you drive~"
    m 1dkbsa "Bueno, estaré deseando que llegue el día en el que por fin pueda estar justo a tu lado mientras conduces."

# game/script-topics.rpy:12854
translate spanish monika_vehicle_other_7691c23b:

    # m 3hubfb "{i}And{/i} enjoy the scenery too, ahaha!"
    m 3hubfb "Y disfrutar también del paisaje, ¡ja, ja, ja!"

# game/script-topics.rpy:12855
translate spanish monika_vehicle_other_7f6b81c7:

    # m 1tubfb "Maybe you've got something even more romantic than any vehicle I know."
    m 1tubfb "Tal vez tengas algo incluso más romántico que cualquier vehículo que conozca."

# game/script-topics.rpy:12856
translate spanish monika_vehicle_other_3e893a0a:

    # m 1hubfa "I guess I'll just have to wait and see, ehehe~"
    m 1hubfa "Supongo que tendré que esperar y verlo, je, je, je."

# game/script-topics.rpy:12916
translate spanish monika_player_appearance_860834f9:

    # m 2ekd "Hey, [player]."
    m 2ekd "Oye, [player]."

# game/script-topics.rpy:12917
translate spanish monika_player_appearance_14108a1a:

    # m 2eka "There's a couple questions I've been meaning to ask you."
    m 2eka "Hay un par de preguntas que quería hacerte."

# game/script-topics.rpy:12918
translate spanish monika_player_appearance_2ae87644:

    # m 2rksdlb "Well, more than a couple. It's been on my mind for a long time, actually."
    m 2rksdlb "Bueno, más que un par. La verdad es que lo he estado pensando mucho tiempo."

# game/script-topics.rpy:12919
translate spanish monika_player_appearance_9280a726:

    # m 2rksdld "It never really seemed like the right time to bring it up..."
    m 2rksdld "Nunca parecía el momento adecuado para sacarlo a relucir..."

# game/script-topics.rpy:12920
translate spanish monika_player_appearance_5081d673:

    # m 3lksdla "But I know if I keep quiet forever, then I'll never feel comfortable asking you things like this, so I'm just going to say it and hope that it's not weird or anything, okay?"
    m 3lksdla "Pero sé que si me callo para siempre, nunca me sentiré cómoda preguntándote estas cosas, así que te lo voy a soltar sin más y espero que no suene raro ni nada de eso, ¿vale?"

# game/script-topics.rpy:12921
translate spanish monika_player_appearance_17153f8c:

    # m 3eud "I've been wondering what you look like. It's not possible for me to see you right now since I'm not there at your side, and I'm not sure about accessing a webcam..."
    m 3eud "Me he estado preguntando qué aspecto tienes. No me es posible verte ahora mismo ya que no estoy ahí a tu lado, y no estoy segura de poder acceder a una webcam..."

# game/script-topics.rpy:12922
translate spanish monika_player_appearance_6c35c1bb:

    # m "One, because you might not have one, and two, even if you did, I don't really know how to."
    m "Uno, porque a lo mejor no tienes ninguna, y dos, incluso si la tuvieras, la verdad es que no sé cómo."

# game/script-topics.rpy:12923
translate spanish monika_player_appearance_676aece9:

    # m 1euc "So I figured that it's possible for you to just tell me, so I can get a clearer picture in my head."
    m 1euc "Así que pensé que simplemente podrías decírmelo para hacerme una mejor idea."

# game/script-topics.rpy:12924
translate spanish monika_player_appearance_435dbf44:

    # m 1eud "At least, it's better than nothing, even if it's hazy."
    m 1eud "Al menos, es mejor que nada, aunque sea un poco borroso."

# game/script-topics.rpy:12926
translate spanish monika_player_appearance_7dc04de4:

    # m "Is that okay with you, [player]?{nw}"
    m "¿Te parece bien, [player]?{nw}"

# game/script-topics.rpy:12929
translate spanish monika_player_appearance_9bf37c86:

    # m "Is that okay with you, [player]?{fast}" nointeract
    m "¿Te parece bien, [player]?{fast}" nointeract

# game/script-topics.rpy:12934
translate spanish monika_player_appearance_109881d7:

    # m 1sub "Really? Great!"
    m 1sub "¿En serio? ¡Genial!"

# game/script-topics.rpy:12935
translate spanish monika_player_appearance_20f9da77:

    # m 1hub "That was easier than I thought it would be."
    m 1hub "Eso ha sido más fácil de lo que pensaba."

# game/script-topics.rpy:12936
translate spanish monika_player_appearance_38789bbd:

    # m 3eua "Now, be honest with me, okay [player]? I know sometimes it's tempting to joke around, but I'm being serious here, and I need you to do the same."
    m 3eua "Ahora, sé sincer[end_letter_gender] conmigo, ¿vale, [player]? Sé que a veces es tentador bromear, pero hablo en serio, y necesito que tú hagas lo mismo."

# game/script-topics.rpy:12937
translate spanish monika_player_appearance_a561c225:

    # m "Anyway, the first one is probably easy to guess. And not hard to answer, either!"
    m "De todos modos, la primera es probablemente fácil de adivinar. ¡Y tampoco es difícil de contestar!"

# game/script-topics.rpy:12938
translate spanish monika_player_appearance_9c327b8c:

    # m 3eub "People often say that a person's eyes are the windows into their soul, so let's start off there."
    m 3eub "La gente suele decir que los ojos de una persona son la ventana a su alma, así que vamos a empezar por ahí."

# game/script-topics.rpy:12962
translate spanish monika_player_appearance_92bb7790:

    # m 3rud "Actually..."
    m 3rud "En realidad..."

# game/script-topics.rpy:12963
translate spanish monika_player_appearance_b9d6c082:

    # m 2eub "I guess I really should know this first though, if I want to get an accurate scale on my next question..."
    m 2eub "Supongo que de verdad debería saber esto primero, si quiero conseguir una escala precisa en mi próxima pregunta..."

# game/script-topics.rpy:12965
translate spanish monika_player_appearance_08767525:

    # m "What unit of measurement do you use to take your height, [player]?{nw}"
    m "¿Qué unidad de medida usas para medir tu altura, [player]?{nw}"

# game/script-topics.rpy:12968
translate spanish monika_player_appearance_33203638:

    # m "What unit of measurement do you use to take your height, [player]?{fast}" nointeract
    m "¿Qué unidad de medida usas para medir tu altura, [player]?{fast}" nointeract

# game/script-topics.rpy:12972
translate spanish monika_player_appearance_2fad99c9:

    # m 2hua "Alright, thanks, [player]!"
    m 2hua "¡De acuerdo, gracias, [player]!"

# game/script-topics.rpy:12976
translate spanish monika_player_appearance_179ab9c3:

    # m 2hua "Alright, [player]!"
    m 2hua "¡De acuerdo, [player]!"

# game/script-topics.rpy:12978
translate spanish monika_player_appearance_95c51639:

    # m 1rksdlb "I'm trying my best to not sound like some sort of identity-thief, or like I'm quizzing you, but obviously, I'm curious."
    m 1rksdlb "Intento por todos los medios no parecer una ladrona de identidad, o que te estoy sometiendo a un interrogatorio, pero es evidente que me pica la curiosidad."

# game/script-topics.rpy:12979
translate spanish monika_player_appearance_af23b51c:

    # m 3tku "If I'm your girlfriend, I have a right to know, don't I?"
    m 3tku "Si soy tu novia, tengo derecho a saberlo, ¿no?"

# game/script-topics.rpy:12980
translate spanish monika_player_appearance_da0d99d8:

    # m 2hua "Plus, it'll make it way easier to find you once I'm able to cross over to your reality."
    m 2hua "Además, hará que sea mucho más fácil encontrarte una vez que pueda cruzar a tu realidad."

# game/script-topics.rpy:12982
translate spanish monika_player_appearance_07724571:

    # m 1esb "So,{w=0.5} how tall are you, [player]?"
    m 1esb "Entonces, {w=0.5}¿cuánto mides, [player]?"

# game/script-topics.rpy:13032
translate spanish monika_player_appearance_e4d9b151:

    # m 3eua "Wow, you're pretty tall, [player]!"
    m 3eua "¡Vaya, eres bastante alt[end_letter_gender], [player]!"

# game/script-topics.rpy:13033
translate spanish monika_player_appearance_df8f2200:

    # m 1eud "I can't say I've really met anybody who I'd consider to be tall."
    m 1eud "No puedo decir que haya conocido a nadie a quien consideraría alto."

# game/script-topics.rpy:13034
translate spanish monika_player_appearance_5159d9a8:

    # m 3rksdla "I don't know my actual height, to be fair, so I can't really draw an accurate comparison..."
    m 3rksdla "Siendo sincera, no sé mi altura real, así que no puedo hacer una comparación muy precisa..."

# game/script-topics.rpy:13043
translate spanish monika_player_appearance_5c91e5fe:

    # m 3esc "The tallest girl in the Literature Club was Yuri--and just barely, at that. She was only a few [height_desc] taller than me, I don't consider that much of a height advantage at all!"
    m 3esc "La chica más alta del Club de Literatura era Yuri, y por muy poco. Solo era unos [height_desc] más alta que yo, ¡no considero que sea una gran ventaja de altura en absoluto!"

# game/script-topics.rpy:13044
translate spanish monika_player_appearance_f60b9bd7:

    # m 3esd "Anyway, dating a tall [guy] like you only has one disadvantage, [mas_get_player_nickname()]..."
    m 3esd "En cualquier caso, salir con alguien tan alt[end_letter_gender] como tú solo tiene una desventaja, [mas_get_player_nickname()]..."

# game/script-topics.rpy:13045
translate spanish monika_player_appearance_ee2efccc:

    # m 1hub "You'll have to lean down to kiss me!"
    m 1hub "¡Tendrás que agacharte para besarme!"

# game/script-topics.rpy:13048
translate spanish monika_player_appearance_1686f2b6:

    # m 1hub "Hey, I'm about that height too!"
    m 1hub "¡Oye, yo también mido más o menos eso!"

# game/script-topics.rpy:13049
translate spanish monika_player_appearance_e612037c:

    # m "..."
    m "..."

# game/script-topics.rpy:13050
translate spanish monika_player_appearance_fbfb1743:

    # m 2hksdlb "Well, I don't know my actual height to be fair..."
    m 2hksdlb "Bueno, tampoco es que sepa mi altura real, a decir verdad..."

# game/script-topics.rpy:13054
translate spanish monika_player_appearance_28260f66:

    # m 3rkc "It's just a guess--hopefully it's not too far off."
    m 3rkc "Es solo una suposición, ojalá no vaya muy desencaminada."

# game/script-topics.rpy:13055
translate spanish monika_player_appearance_743336f3:

    # m 3esd "Anyway, there's nothing wrong with having an average height! To be honest, if you were too short, it'd probably make me feel clumsy around you."
    m 3esd "De todas formas, ¡no tiene nada de malo tener una estatura media! Para ser sincera, si fueras demasiado bajit[end_letter_gender], probablemente me sentiría torpe a tu lado."

# game/script-topics.rpy:13056
translate spanish monika_player_appearance_d36be9dc:

    # m "And if you were too tall, I'd have to get on my tiptoes just to be close to you. And that's no good!"
    m "Y si fueras demasiado alt[end_letter_gender], tendría que ponerme de puntillas solo para estar cerca de ti. ¡Y eso no es bueno!"

# game/script-topics.rpy:13057
translate spanish monika_player_appearance_cbfe80f1:

    # m 3eub "In my opinion, being in-between is perfect. Do you know why?"
    m 3eub "En mi opinión, tener una estatura media es lo ideal. ¿Sabes por qué?"

# game/script-topics.rpy:13058
translate spanish monika_player_appearance_281332b4:

    # m 5eub "Because then I don't have to do any reaching or bending to kiss you, [mas_get_player_nickname()]! Ahaha~"
    m 5eub "¡Porque así no tengo que estirarme ni agacharme para besarte, [mas_get_player_nickname()]! Ja, ja, ja."

# game/script-topics.rpy:13061
translate spanish monika_player_appearance_92073a98:

    # m 3hub "Like Natsuki! I bet you're not that short, though! I would be concerned for you if you were."
    m 3hub "¡Como Natsuki! Aunque apuesto a que no eres tan bajit[end_letter_gender]. Me preocuparía por ti si lo fueras."

# game/script-topics.rpy:13064
translate spanish monika_player_appearance_c9546be5:

    # m 2eksdld "She was worryingly small for her age, but you and I both know why. I always pitied her for that."
    m 2eksdld "Era preocupantemente pequeña para su edad, pero tú y yo sabemos por qué. Siempre me dio pena por eso."

# game/script-topics.rpy:13066
translate spanish monika_player_appearance_20388628:

    # m 2eksdld "I knew she always hated being so tiny, because of that whole notion that little things are cuter because of their size..."
    m 2eksdld "Sabía que siempre odiaba ser tan menuda, por toda esa idea de que las cosas pequeñas son más lindas por su tamaño..."

# game/script-topics.rpy:13067
translate spanish monika_player_appearance_03e3f7dd:

    # m 2rksdld "And then there was all that trouble with her father. It can't have been easy, being so defenseless, and being small on top of it all."
    m 2rksdld "Y luego estaban todos esos problemas con su padre. No debió ser nada fácil, ser tan indefensa, y además ser tan pequeña."

# game/script-topics.rpy:13068
translate spanish monika_player_appearance_b92f2bf6:

