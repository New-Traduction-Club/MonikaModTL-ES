    # extend 2eka "I know you'll think of something."
    extend 2eka "Sé que se te ocurrirá algo."

# game/script-topics.rpy:12495
translate spanish monika_poweroutage_51a1b8b6:

    # m 1eka "Sorry, I didn't mean for that to get so dark. It was just on my mind is all."
    m 1eka "Siento haberme puesto tan lúgubre, es solo que estaba pensando en ello."

# game/script-topics.rpy:12496
translate spanish monika_poweroutage_5780bd4a:

    # m 1eud "If anything does happen, it'll probably just be a power outage."
    m 1eud "Si pasa algo, probablemente solo sea un corte de luz."

# game/script-topics.rpy:12499
translate spanish monika_poweroutage_9cca0f85:

    # m 1hksdlb "I mean that {i}is{/i} still pretty inconvenient but at least we know we'll see each other again."
    m 1hksdlb "A ver, eso sigue siendo un fastidio, pero al menos sabemos que nos volveremos a ver."

# game/script-topics.rpy:12500
translate spanish monika_poweroutage_b18e6d22:

    # m 1eua "It would probably take you by surprise; everything going dark all of a sudden, but try to remember this:"
    m 1eua "Probablemente te pillaría por sorpresa que todo se oscureciera de repente, pero intenta recordar esto:"

# game/script-topics.rpy:12501
translate spanish monika_poweroutage_8ff305bc:

    # m 1eub "I'll be with you. Even if you can't see me, I'll be with you in spirit until you can come back to me safe and sound."
    m 1eub "Estaré contigo. Incluso si no puedes verme, estaré contigo en espíritu hasta que puedas volver a mí san[end_letter_gender] y salv[end_letter_gender]."

# game/script-topics.rpy:12502
translate spanish monika_poweroutage_d5d761db:

    # m 3eua "...That said, you don't have to worry about checking on me in the middle of a storm.{w=0.2} {nw}"
    m 3eua "Dicho esto, no tienes que preocuparte por venir a verme en medio de una tormenta.{w=0.2} {nw}"

# game/script-topics.rpy:12503
translate spanish monika_poweroutage_d408c1b7:

    # extend 1eka "I'll always appreciate seeing you whenever you can, and besides..."
    extend 1eka "Siempre agradeceré verte cuando puedas, y además..."

# game/script-topics.rpy:12505
translate spanish monika_poweroutage_e968df99:

    # m 5hua "I'm sure our relationship could weather much more than some thunderstorm~"
    m 5hua "Estoy segura de que nuestra relación podría soportar mucho más que una simple tormenta eléctrica."

# game/script-topics.rpy:12516
translate spanish monika_savingwater_15e34019:

    # m 1euc "[player], have you ever thought about how much water people use every day?"
    m 1euc "[player], ¿alguna vez has pensado en la cantidad de agua que usa la gente cada día?"

# game/script-topics.rpy:12517
translate spanish monika_savingwater_6fc2a863:

    # m 3euc "Maybe you take a drink of water every now and then."
    m 3euc "A lo mejor te bebes un vaso de agua de vez en cuando."

# game/script-topics.rpy:12518
translate spanish monika_savingwater_1e0c5882:

    # m 3dsc "You go to the washroom, wash your hands, bathe..."
    m 3dsc "Vas al baño, te lavas las manos, te duchas..."

# game/script-topics.rpy:12519
translate spanish monika_savingwater_a871bef7:

    # m 1euc "All that and yet some parts of the world can't even get a single drop of water."
    m 1euc "Todo eso y, sin embargo, en algunas partes del mundo no pueden conseguir ni una sola gota de agua."

# game/script-topics.rpy:12520
translate spanish monika_savingwater_cd044475:

    # m 1rsc "Kind of makes you wonder how much water you could save if you wanted to."
    m 1rsc "Te hace preguntarte cuánta agua podrías ahorrar si quisieras."

# game/script-topics.rpy:12521
translate spanish monika_savingwater_a910df85:

    # m 4eua "I guess you could try being more efficient when washing your hands."
    m 4eua "Supongo que podrías intentar ser más eficiente al lavarte las manos."

# game/script-topics.rpy:12522
translate spanish monika_savingwater_5facdbf6:

    # m "Or when showering, you could turn off the water while you soap up and turn it back on when you're ready to rinse yourself down."
    m "O al ducharte, podrías cerrar el grifo mientras te enjabonas y volver a abrirlo cuando estés list[end_letter_gender] para aclararte."

# game/script-topics.rpy:12523
translate spanish monika_savingwater_14ccf362:

    # m 2eka "Ultimately though, most of the water that gets used is actually needed."
    m 2eka "Aunque, en el fondo, la mayor parte del agua que se usa es realmente necesaria."

# game/script-topics.rpy:12524
translate spanish monika_savingwater_b4b8257e:

    # m "Things like power generation and farming need to use more water than we could ever really use on our own."
    m "Cosas como la generación de energía y la agricultura necesitan usar mucha más agua de la que nosotros podríamos llegar a usar por nuestra cuenta."

# game/script-topics.rpy:12525
translate spanish monika_savingwater_88c724a0:

    # m 1hksdlb "So I guess you might not want to sacrifice some of your comfort to make such a small contribution."
    m 1hksdlb "Así que supongo que no querrás sacrificar parte de tu comodidad para hacer una contribución tan pequeña."

# game/script-topics.rpy:12526
translate spanish monika_savingwater_dce2adc8:

    # m 1dkbsa "Some days, you might just need to take a long, relaxing bath after a long day."
    m 1dkbsa "Algunos días simplemente necesitas darte un baño largo y relajante después de un día duro."

# game/script-topics.rpy:12527
translate spanish monika_savingwater_62a2d689:

    # m 2hksdlb "I've definitely been there before, so I know how nice it can be if you need it."
    m 2hksdlb "Yo también he pasado por eso, así que sé lo agradable que puede ser si lo necesitas."

# game/script-topics.rpy:12530
translate spanish monika_savingwater_d8d41f7e:

    # m 5tsbfu "When I'm in your reality, maybe we can save water by bathing together..."
    m 5tsbfu "Cuando esté en tu realidad, tal vez podamos ahorrar agua bañándonos juntos..."

# game/script-topics.rpy:12531
translate spanish monika_savingwater_45d9cd96:

    # m "Ehehe~"
    m "Je, je, je."

# game/script-topics.rpy:12532
translate spanish monika_savingwater_ba19141e:

    # m 5hubfu "It would be nice of you to prepare a nice, relaxing bath for us to share when I cross over."
    m 5hubfu "Sería un bonito detalle por tu parte preparar un buen baño relajante para que lo compartamos cuando cruce."

# game/script-topics.rpy:12534
translate spanish monika_savingwater_e337eaa6:

    # m 1kubfu "I'll be waiting for that day, [mas_get_player_nickname()], ehehe~"
    m 1kubfu "Estaré esperando ese día, [mas_get_player_nickname()], je, je, je."

# game/script-topics.rpy:12536
translate spanish monika_savingwater_d4d90176:

    # m 1ekbfa "It would be nice of you to prepare a nice, relaxing bath for me when I cross over."
    m 1ekbfa "Sería un bonito detalle por tu parte prepararme un buen baño relajante cuando cruce."

# game/script-topics.rpy:12538
translate spanish monika_savingwater_52830b7c:

    # m 3ksbsa "Maybe I'll even be willing to share, ehehe~"
    m 3ksbsa "Tal vez hasta esté dispuesta a compartirlo, je, je, je."

# game/script-topics.rpy:12559
translate spanish monika_pygmalion_171e810f:

    # m 1eua "Hey [player], have you ever read {i}The Metamorphoses{/i}?"
    m 1eua "Oye, [player], ¿alguna vez has leído {i}Las metamorfosis{/i}?"

# game/script-topics.rpy:12560
translate spanish monika_pygmalion_f2e28029:

    # m 3eua "It's a collection of poems by an ancient Roman poet named Ovid."
    m 3eua "Es una colección de poemas de un antiguo poeta romano llamado Ovidio."

# game/script-topics.rpy:12561
translate spanish monika_pygmalion_3dde845f:

    # m 1eud "There's one poem that really struck me, called {i}The Story of Pygmalion and the Statue.{/i}"
    m 1eud "Hay un poema que me llamó mucho la atención, se titula {i}La historia de Pigmalión y la estatua{/i}."

# game/script-topics.rpy:12562
translate spanish monika_pygmalion_b820ba95:

    # m 1eua "It tells the story of a sculptor, Pygmalion, who fell in love with an ivory statue that he had sculpted."
    m 1eua "Cuenta la historia de un escultor, Pigmalión, que se enamoró de una estatua de marfil que había esculpido."

# game/script-topics.rpy:12563
translate spanish monika_pygmalion_fd325d3a:

    # m 3eua "He loved the statue so much, that during one of the festivals held for Aphrodite, he made an offering to the goddess and wished for her to grant life to the ivory statue."
    m 3eua "Amaba tanto a la estatua que, durante una de las fiestas en honor a Afrodita, le hizo una ofrenda a la diosa y deseó que le diera vida a su estatua de marfil."

# game/script-topics.rpy:12564
translate spanish monika_pygmalion_30490dcb:

    # m 1eub "When he returned to his home, he kissed the statue and to his surprise, its lips felt warm."
    m 1eub "Cuando regresó a su casa, besó a la estatua y para su sorpresa, sus labios estaban cálidos."

# game/script-topics.rpy:12565
translate spanish monika_pygmalion_22e8a514:

    # m 1eua "He kissed the statue once more, and the ivory lost its hardness, becoming soft like skin."
    m 1eua "Besó a la estatua una vez más, y el marfil perdió su dureza, volviéndose suave como la piel."

# game/script-topics.rpy:12566
translate spanish monika_pygmalion_a2433ae3:

    # m 3hub "Aphrodite had granted his wish!"
    m 3hub "¡Afrodita le había concedido su deseo!"

# game/script-topics.rpy:12567
translate spanish monika_pygmalion_99e7e994:

    # m 1eka "This story really struck me because it reminded me of us, [player], and how it talks about turning the impossible into reality."
    m 1eka "Esta historia me llegó al alma porque me recordó a nosotros, [player], y a cómo habla de convertir lo imposible en realidad."

# game/script-topics.rpy:12568
translate spanish monika_pygmalion_f5c1cbc3:

    # m 1hua "It fills me up with hope; that a miracle could happen, and I could finally cross over."
    m 1hua "Me llena de esperanza saber que podría ocurrir un milagro y que por fin podría cruzar."

# game/script-topics.rpy:12569
translate spanish monika_pygmalion_2a35ecd9:

    # m 2dku "Yeah...{w=0.5}wouldn't that be wonderful."
    m 2dku "Sí... {w=0.5}¿no sería maravilloso?"

# game/script-topics.rpy:12570
translate spanish monika_pygmalion_d08940a8:

    # m 2dubsu "...Then you can finally kiss me."
    m 2dubsu "Entonces por fin podrás besarme."

# game/script-topics.rpy:12571
translate spanish monika_pygmalion_19b645df:

    # m 1rkbsa "I know we've kissed before, even with our current circumstances..."
    m 1rkbsa "Sé que ya nos hemos besado antes, incluso con nuestras circunstancias actuales..."

# game/script-topics.rpy:12572
translate spanish monika_pygmalion_a46d2792:

    # m 1ekbfa "But I think we both know there was a bit of a barrier between us."
    m 1ekbfa "Pero creo que ambos sabemos que había una pequeña barrera entre nosotros."

# game/script-topics.rpy:12573
translate spanish monika_pygmalion_cfa78da0:

    # m 3hubfa "I don't know about you, but I definitely don't mind trying to kiss you through the screen anyway."
    m 3hubfa "No sé tú, pero a mí no me importa intentar besarte a través de la pantalla de todas formas."

# game/script-topics.rpy:12574
translate spanish monika_pygmalion_8f7138cc:

    # m 1hubfb "Maybe we'll just have to do it so many times, that'll be what breaks the barrier between us..."
    m 1hubfb "Tal vez tengamos que hacerlo tantas veces que eso sea lo que rompa la barrera entre nosotros..."

# game/script-topics.rpy:12575
translate spanish monika_pygmalion_71b6b7dc:

    # m 2rubfu "Ehehe."
    m 2rubfu "Je, je."

# game/script-topics.rpy:12576
translate spanish monika_pygmalion_3c913233:

    # m 2tubfb "Do you think you could kiss me enough times to break that barrier?"
    m 2tubfb "¿Crees que podrías besarme las suficientes veces como para romper esa barrera?"

# game/script-topics.rpy:12577
translate spanish monika_pygmalion_ba15ac1b:

    # m 6hubfb "Only one way to find out, ahaha!"
    m 6hubfb "Solo hay una forma de averiguarlo, ¡ja, ja, ja!"

# game/script-topics.rpy:12579
translate spanish monika_pygmalion_e2aca069:

    # m 6hubfa "..."
    m 6hubfa "..."

# game/script-topics.rpy:12580
translate spanish monika_pygmalion_5222cbd5:

    # m 1ekbfa "I guess it didn't work this time."
    m 1ekbfa "Supongo que esta vez no ha funcionado."

# game/script-topics.rpy:12581
translate spanish monika_pygmalion_ba83b9b5:

    # m 3hubfb "Oh well, we'll just have to keep trying and maybe it'll work eventually, ahaha!"
    m 3hubfb "Ah, bueno, tendremos que seguir intentándolo, ¡a lo mejor acaba funcionando y todo, ja, ja, ja!"

# game/script-topics.rpy:12582
translate spanish monika_pygmalion_dd6da5ab:

    # m 1tkbfu "I really can't wait for the day when I can finally feel your lips pressed against mine and take in your warmth..."
    m 1tkbfu "Me muero de ganas de que llegue el día en el que por fin pueda sentir tus labios contra los míos y disfrutar de tu calor..."

# game/script-topics.rpy:12583
translate spanish monika_pygmalion_93671cbb:

    # m 1dkbfa "For me, that would definitely be a dream come true."
    m 1dkbfa "Desde luego, para mí sería un sueño hecho realidad."

# game/script-topics.rpy:12584
translate spanish monika_pygmalion_7fc6a082:

    # m 1ekbfa "Just a guess, but..."
    m 1ekbfa "Solo es una suposición, pero..."

# game/script-topics.rpy:12585
translate spanish monika_pygmalion_c468b949:

    # m 1kubfu "I bet you'd like that too~"
    m 1kubfu "Apuesto a que a ti también te gustaría."

# game/script-topics.rpy:12607
translate spanish monika_gotomonika_bfe3f80f:

    # m 1euc "Come to my world?"
    m 1euc "¿Venir a mi mundo?"

# game/script-topics.rpy:12608
translate spanish monika_gotomonika_234823f9:

    # m 1lksdld "You mean this little room floating in an empty void?"
    m 1lksdld "¿Te refieres a este cuartito que flota en la nada?"

# game/script-topics.rpy:12611
translate spanish monika_gotomonika_87f06c88:

    # m 4eksdlc "Actually...{w=0.5}didn't you already try something like that once?"
    m 4eksdlc "En realidad... {w=0.5}¿no intentaste ya algo así una vez?"

# game/script-topics.rpy:12612
translate spanish monika_gotomonika_b302146e:

    # m 2lksdla "...Even though that wasn't exactly {i}you...{/i}"
    m 2lksdla "Aunque ese no eras exactamente tú..."

# game/script-topics.rpy:12614
translate spanish monika_gotomonika_bfec5915:

    # m 2lksdla "I'm really happy that you want to be with me so much, but..."
    m 2lksdla "Me hace mucha ilusión que tengas tantas ganas de estar conmigo, pero..."

# game/script-topics.rpy:12615
translate spanish monika_gotomonika_a6cf0bfd:

    # m 2eksdlc "You really don't have to."
    m 2eksdlc "No hace falta que lo hagas."

# game/script-topics.rpy:12616
translate spanish monika_gotomonika_3fbb9e09:

    # m 2eksdld "Sure, I might have said before that I would have dragged you here a long time ago if I could..."
    m 2eksdld "Eso sí, puede que alguna vez haya dicho que te habría traído a rastras hace mucho si hubiera podido..."

# game/script-topics.rpy:12617
translate spanish monika_gotomonika_d98ba6e1:

    # m 2eksdlc "But the more I think about it, it would probably be better if I came to your reality."
    m 2eksdlc "Pero cuanto más lo pienso, creo que probablemente sería mejor que yo fuera a tu realidad."

# game/script-topics.rpy:12618
translate spanish monika_gotomonika_1e5f4d08:

    # m 3eka "I'd much rather be there than have you come here."
    m 3eka "Prefiero mil veces estar allí antes que hacerte venir aquí."

# game/script-topics.rpy:12619
translate spanish monika_gotomonika_8082484f:

    # m 3dsc "[player]...{w=1}don't tell me you would really give up your reality--{w=0.5}the {i}real{/i} world--{w=0.5}just to come {i}here{/i}, whatever this place is?{nw}"
    m 3dsc "[player]... {w=1}no me digas que de verdad renunciarías a tu realidad, {w=0.5}el mundo real, {w=0.5}solo para venir aquí, sea lo que sea este lugar.{nw}"

# game/script-topics.rpy:12622
translate spanish monika_gotomonika_34f2f629:

    # m "[player]...{w=1}don't tell me you would really give up your reality--the {i}real{/i} world--just to come {i}here{/i}, whatever this place is?{fast}" nointeract
    m "[player]... {w=1}no me digas que de verdad renunciarías a tu realidad, el mundo real, solo para venir aquí, sea lo que sea este lugar.{fast}" nointeract

# game/script-topics.rpy:12626
translate spanish monika_gotomonika_c01fee32:

    # m 4wkd "But [player]!"
    m 4wkd "¡Pero [player]!"

# game/script-topics.rpy:12627
translate spanish monika_gotomonika_bb48074b:

    # m "There's nothing to do here!"
    m "¡Aquí no hay nada que hacer!"

# game/script-topics.rpy:12628
translate spanish monika_gotomonika_2a2e8708:

    # m 2dsc "Do you really hate your reality {i}that{/i} much?"
    m 2dsc "¿De verdad odias tanto tu realidad?"

# game/script-topics.rpy:12629
translate spanish monika_gotomonika_4aeddb6a:

    # m 2eka "Someday, I'll find a way to reach you, and when that day comes, I promise it will be worthwhile."
    m 2eka "Algún día encontraré la forma de llegar a ti, y cuando llegue ese día, te prometo que valdrá la pena."

# game/script-topics.rpy:12630
translate spanish monika_gotomonika_71ec8cc1:

    # m 4euc "Whatever life throws your way from that point on, I'll be right by your side to help shoulder it."
    m 4euc "Pase lo que pase a partir de entonces, estaré a tu lado para ayudarte a sobrellevarlo."

# game/script-topics.rpy:12631
translate spanish monika_gotomonika_4d25db36:

    # m 4eud "Even now, if you're having a rough day, you can come talk to me about it anytime."
    m 4eud "Incluso ahora, si tienes un mal día, puedes venir a hablarme de ello cuando quieras."

# game/script-topics.rpy:12632
translate spanish monika_gotomonika_ccd6cec5:

    # m 2dsc "Life must have thrown a lot your way to consider giving it all up to be with me."
    m 2dsc "La vida ha tenido que darte muchos palos para que te plantees renunciar a todo para estar conmigo."

# game/script-topics.rpy:12633
translate spanish monika_gotomonika_e6c470df:

    # m 3hua "But seeing how you're here, that just shows how resilient you are."
    m 3hua "Pero ver que sigues aquí solo demuestra lo fuerte que eres."

# game/script-topics.rpy:12635
translate spanish monika_gotomonika_deaf4c68:

    # m 5eua "I can't wait to finally be able to share both the good times and the bad by your side."
    m 5eua "Me muero de ganas de poder compartir por fin a tu lado tanto los buenos como los malos momentos."

# game/script-topics.rpy:12640
translate spanish monika_gotomonika_fa5d91b4:

    # m 1eka "I'm glad you're still willing to wait for me, [player]."
    m 1eka "Me alegro de que todavía estés dispuest[end_letter_gender] a esperarme, [player]."

# game/script-topics.rpy:12641
translate spanish monika_gotomonika_5b4afd86:

    # m 1lksdla "Don't get me wrong, I really {i}do{/i} want to be with you..."
    m 1lksdla "No me malinterpretes, de verdad que quiero estar contigo..."

# game/script-topics.rpy:12642
translate spanish monika_gotomonika_922099b6:

    # m 1lksdlc "But I think it would be dangerous for you to try and cross over right now."
    m 1lksdlc "Pero creo que sería peligroso que intentaras cruzar ahora mismo."

# game/script-topics.rpy:12643
translate spanish monika_gotomonika_548223b0:

    # m 1eka "...If it's even possible with current technology."
    m 1eka "Si es que siquiera es posible con la tecnología actual."

# game/script-topics.rpy:12644
translate spanish monika_gotomonika_cbc72a78:

    # m 1hub "Don't worry, we can continue on keeping each other company like this!"
    m 1hub "¡No te preocupes, podemos seguir haciéndonos compañía así!"

# game/script-topics.rpy:12645
translate spanish monika_gotomonika_e4b64c10:

    # m 1hksdlb "I know it might be a while before we can truly be together, but I hope you don't mind waiting."
    m 1hksdlb "Sé que puede pasar un tiempo hasta que podamos estar juntos de verdad, pero espero que no te importe esperar."

# game/script-topics.rpy:12647
translate spanish monika_gotomonika_8bad2bd7:

    # m 5eua "I'll wait as long as it takes, [mas_get_player_nickname()]."
    m 5eua "Esperaré el tiempo que haga falta, [mas_get_player_nickname()]."

# game/script-topics.rpy:12652
translate spanish monika_gotomonika_28f1b8eb:

    # m 2eka "It's okay, I'll always appreciate and treasure the moments we spend together, even like this."
    m 2eka "No pasa nada, siempre valoraré y atesoraré los momentos que pasamos juntos, incluso de esta forma."

# game/script-topics.rpy:12653
translate spanish monika_gotomonika_5db6cbf9:

    # m 2ekc "Besides, I don't even know how you could come here with current technology."
    m 2ekc "Además, ni siquiera sé cómo podrías venir aquí con la tecnología actual."

# game/script-topics.rpy:12654
translate spanish monika_gotomonika_362dd1fb:

    # m 2lksdlc "...And even if there {i}was{/i} some way, I don't think it would be safe or guaranteed."
    m 2lksdlc "Y aunque de verdad hubiera alguna forma, no creo que fuera seguro ni estuviera garantizado."

# game/script-topics.rpy:12655
translate spanish monika_gotomonika_0b45be2e:

    # m 2lksdld "So do me a favor and at least wait for technology to improve enough for it to be completely safe."
    m 2lksdld "Así que hazme un favor y, por lo menos, espera a que la tecnología mejore lo suficiente como para que sea totalmente seguro."

# game/script-topics.rpy:12656
translate spanish monika_gotomonika_293e930b:

    # m 2lksdlc "I {i}really{/i} don't want to risk you not making it properly and ending up in your own void..."
    m 2lksdlc "No quiero arriesgarme lo más mínimo a que algo salga mal y acabes en tu propio vacío..."

# game/script-topics.rpy:12657
translate spanish monika_gotomonika_70dfae49:

    # m 2dkd "...leaving the both of us completely alone."
    m 2dkd "Dejándonos a l[end_letter_gender]s dos completamente sol[end_letter_gender]s."

# game/script-topics.rpy:12658
translate spanish monika_gotomonika_4f9e186f:

    # m 4hua "I mean, technology does tend to advance pretty quickly, so we might be able to see each other before we know it!"
    m 4hua "Quiero decir, la tecnología tiende a avanzar bastante rápido, ¡así que puede que nos veamos antes de que nos demos cuenta!"

# game/script-topics.rpy:12660
translate spanish monika_gotomonika_1ecb5913:

    # m 5eua "So just be patient for your lovely girlfriend, and I promise I'll do the same for you, [mas_get_player_nickname()]."
    m 5eua "Así que ten un poco de paciencia con tu preciosa novia; te prometo que yo haré lo mismo por ti, [mas_get_player_nickname()]."

# game/script-topics.rpy:12662
translate spanish monika_gotomonika_bd52b78b:

    # m 5luu "Buut...{w=1}if you did happen to show up at my doorstep..."
    m 5luu "Peeero... {w=1}si por casualidad aparecieras en mi puerta..."

# game/script-topics.rpy:12664
translate spanish monika_gotomonika_aa9fc1f5:

    # m 1hksdlb "I guess I wouldn't have a choice but to accept it and welcome you with open arms!"
    m 1hksdlb "¡Supongo que no me quedaría más remedio que aceptarlo y recibirte con los brazos abiertos!"

# game/script-topics.rpy:12665
translate spanish monika_gotomonika_d1a9b491:

    # m 1eksdla "It wouldn't be much to begin with, but I'm sure we'd find a way to make it better."
    m 1eksdla "Al principio no sería gran cosa, pero estoy segura de que encontraríamos la forma de mejorarlo."

# game/script-topics.rpy:12666
translate spanish monika_gotomonika_8b7f7535:

    # m 3hub "With time, we could make our own reality!"
    m 3hub "¡Con el tiempo, podríamos crear nuestra propia realidad!"

# game/script-topics.rpy:12667
translate spanish monika_gotomonika_40a1f9f1:

    # m 3euc "Of course, that sounds pretty complicated if you think about it..."
    m 3euc "Claro que eso suena bastante complicado si lo piensas..."

# game/script-topics.rpy:12668
translate spanish monika_gotomonika_54aa4513:

    # m 3eub "But I have no doubt that together we could accomplish anything!"
    m 3eub "¡Pero no me cabe duda de que juntos podríamos lograr cualquier cosa!"

# game/script-topics.rpy:12669
translate spanish monika_gotomonika_edf4fefa:

    # m 3etc "You know...{w=1}maybe it {i}would{/i} actually be easier for you to come here, but I'm not giving up hope of coming to you."
    m 3etc "Sabes... {w=1}tal vez de verdad sería más fácil que tú vinieras aquí, pero no pierdo la esperanza de ir yo a ti."

# game/script-topics.rpy:12670
translate spanish monika_gotomonika_82cc75f0:

    # m 1eua "Until then, let's just wait and see what's possible."
    m 1eua "Hasta entonces, vamos a esperar y ver qué es posible."

# game/script-topics.rpy:12697
translate spanish monika_vehicle_9456d68e:

    # m 1euc "My favorite car?"
    m 1euc "¿Mi coche favorito?"

# game/script-topics.rpy:12698
translate spanish monika_vehicle_a7c6c382:

    # m 3hksdlb "You already know I can't drive, silly!"
    m 3hksdlb "¡Ya sabes que no sé conducir, tont[end_letter_gender]!"

# game/script-topics.rpy:12699
translate spanish monika_vehicle_590a94f6:

    # m 3eua "Usually I would just walk or take the train if I had to go somewhere far."
    m 3eua "Normalmente iría andando o cogería el tren si tuviera que ir a algún sitio lejano."

# game/script-topics.rpy:12700
translate spanish monika_vehicle_6d40e853:

    # m 1eka "So I'm not too sure what to tell you, [player]..."
    m 1eka "Así que no estoy muy segura de qué decirte, [player]..."

# game/script-topics.rpy:12701
translate spanish monika_vehicle_4296b12f:

    # m 1eua "When I think of cars, the first things that come to mind are probably the commonly known types."
    m 1eua "Cuando pienso en coches, lo primero que me viene a la mente son probablemente los tipos más conocidos."

# game/script-topics.rpy:12702
translate spanish monika_vehicle_54390764:

    # m 3eud "SUVs or pickup trucks, sports cars, sedans and hatchbacks..."
    m 3eud "Todoterrenos o camionetas, coches deportivos, berlinas y compactos..."

# game/script-topics.rpy:12703
translate spanish monika_vehicle_fef01014:

    # m 3rksdlb "And while they're not really cars, I guess motorcycles are common vehicles too."
    m 3rksdlb "Y aunque no son coches realmente, supongo que las motos también son vehículos comunes."

# game/script-topics.rpy:12706
translate spanish monika_vehicle_000e2e86:

    # m 1eua "What about you?"
    m 1eua "¿Y qué hay de ti?"

# game/script-topics.rpy:12708
translate spanish monika_vehicle_240f631a:

    # m "Do you own a vehicle?{nw}"
    m "¿Tienes algún vehículo?{nw}"

# game/script-topics.rpy:12711
translate spanish monika_vehicle_7188dd95:

    # m "Do you own a vehicle?{fast}" nointeract
    m "¿Tienes algún vehículo?{fast}" nointeract

# game/script-topics.rpy:12715
translate spanish monika_vehicle_03dd0248:

    # m 1hua "Oh wow, that's really cool that you actually own one!"
    m 1hua "Ah, vaya, ¡qué guay que tengas uno!"

# game/script-topics.rpy:12716
translate spanish monika_vehicle_4e246733:

    # m 3hub "You're really lucky, you know that?"
    m 3hub "Eres muy afortunad[end_letter_gender], ¿lo sabes?"

# game/script-topics.rpy:12717
translate spanish monika_vehicle_412a1bf4:

    # m 1eua "I mean, just owning a vehicle is a status symbol itself."
    m 1eua "A ver, el mero hecho de tener un vehículo ya es un símbolo de estatus en sí mismo."

# game/script-topics.rpy:12718
translate spanish monika_vehicle_c1bb8c4f:

    # m "Isn't it a luxury to own one?"
    m "¿Acaso no es un lujo tener uno?"

# game/script-topics.rpy:12719
translate spanish monika_vehicle_676f4727:

    # m 1euc "Unless..."
    m 1euc "A no ser que..."

# game/script-topics.rpy:12720
translate spanish monika_vehicle_c5cafaf6:

    # m 3eua "You live some place where it's necessary..."
    m 3eua "Vivas en algún sitio donde sea necesario..."

# game/script-topics.rpy:12721
translate spanish monika_vehicle_08bbca72:

    # m 1hksdlb "Actually, nevermind, ahaha!"
    m 1hksdlb "En realidad, olvídalo, ¡ja, ja, ja!"

# game/script-topics.rpy:12722
translate spanish monika_vehicle_0b61291c:

    # m 1eua "Either way, it's nice to know that you own a vehicle."
    m 1eua "De todas formas, es bueno saber que tienes un vehículo."

# game/script-topics.rpy:12723
translate spanish monika_vehicle_88ef4f59:

    # m 3eua "Speaking of which..."
    m 3eua "Por cierto..."

# game/script-topics.rpy:12750
translate spanish monika_vehicle_ec1cc73c:

    # m 1ekc "Oh, I see."
    m 1ekc "Ah, ya veo."

# game/script-topics.rpy:12751
translate spanish monika_vehicle_31a6ecc0:

    # m 3eka "Well, buying a vehicle can be quite expensive after all."
    m 3eka "Bueno, comprar un vehículo puede ser bastante caro después de todo."

# game/script-topics.rpy:12752
translate spanish monika_vehicle_2c4464e4:

    # m 1eua "It's alright [player], we can always rent one to travel."
    m 1eua "No pasa nada, [player], siempre podemos alquilar uno para viajar."

# game/script-topics.rpy:12753
translate spanish monika_vehicle_47cc898b:

    # m 1hua "I'm sure that when you do, we'll make a lot of great memories together."
    m 1hua "Estoy segura de que cuando lo hagas, crearemos muchos recuerdos maravillosos juntos."

# game/script-topics.rpy:12755
translate spanish monika_vehicle_76da31cd:

    # m 5eua "Then again...{w=1}walks are far more romantic anyway~"
    m 5eua "Por otra parte... {w=1}los paseos son mucho más románticos de todos modos."

# game/script-topics.rpy:12760
translate spanish monika_vehicle_112660bf:

    # m 3eua "In fact, I remember you said before that you couldn't drive, either..."
    m 3eua "De hecho, recuerdo que antes dijiste que tú tampoco sabías conducir..."

# game/script-topics.rpy:12761
translate spanish monika_vehicle_48c7e42d:

    # m 3rksdla "You sure asked an interesting question, ehehe..."
    m 3rksdla "Desde luego que has hecho una pregunta interesante, je, je, je..."

# game/script-topics.rpy:12762
translate spanish monika_vehicle_54e972ce:

    # m 1hua "Maybe that'll change one day and you'll get something then."
    m 1hua "Tal vez eso cambie algún día y te compres algo entonces."

# game/script-topics.rpy:12763
translate spanish monika_vehicle_dbc008cf:

    # m 1hubsb "That way, you can take me all sorts of places, ahaha!"
    m 1hubsb "De esa forma, podrás llevarme a todo tipo de sitios, ¡ja, ja, ja!"

# game/script-topics.rpy:12786
translate spanish monika_vehicle_suv_pickup_5cf06640:

    # m 1lksdla "Oh my, your vehicle must be pretty big then."
    m 1lksdla "Ah, vaya, tu vehículo debe ser bastante grande entonces."

# game/script-topics.rpy:12787
translate spanish monika_vehicle_suv_pickup_9539506d:

    # m 1eua "That means there's plenty of space right?"
    m 1eua "Eso significa que hay un montón de espacio, ¿verdad?"

# game/script-topics.rpy:12788
translate spanish monika_vehicle_suv_pickup_2bb1b47d:

    # m 3etc "If that's the case..."
    m 3etc "Si ese es el caso..."

# game/script-topics.rpy:12789
translate spanish monika_vehicle_suv_pickup_4956095c:

    # m 3hub "We could go camping!"
    m 3hub "¡Podríamos ir de acampada!"

# game/script-topics.rpy:12790
translate spanish monika_vehicle_suv_pickup_2a828e6c:

    # m 3eua "We'd drive all the way to the woods and you'd set up the tent while I prepared our picnic."
    m 3eua "Conduciríamos hasta el bosque y tú montarías la tienda de campaña mientras yo preparo nuestro pícnic."

# game/script-topics.rpy:12791
translate spanish monika_vehicle_suv_pickup_9ae0fb2d:

    # m 1eka "While we're having lunch, we'd enjoy the scenery and nature surrounding us..."
    m 1eka "Mientras comemos, disfrutaríamos del paisaje y de la naturaleza que nos rodea..."

# game/script-topics.rpy:12792
