# game/script-topics.rpy:13185
translate spanish monika_player_appearance_d46fc1a6:

    # m "Being just the body's inability to produce normal amounts of the pigment eumelanin--that's what causes darker hair colors, such as black and brown."
    m "Es decir, la incapacidad del cuerpo para producir cantidades normales del pigmento eumelanina... que es lo que provoca los colores de pelo más oscuros, como el negro y el castaño."

# game/script-topics.rpy:13186
