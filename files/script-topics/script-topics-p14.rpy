
# game/script-topics.rpy:10286
translate spanish monika_prom_417a24b4:

    # m 1lksdla "Just because I'm not there doesn't mean you should stop yourself from having fun."
    m 1lksdla "Que yo no esté allí no significa que debas privarte de pasártelo bien."

# game/script-topics.rpy:10287
translate spanish monika_prom_a375c986:

    # m 1eka "And besides..."
    m 1eka "Y además..."

# game/script-topics.rpy:10288
translate spanish monika_prom_8ad4e397:

    # m 1hua "You {i}can{/i} take me to prom, [player]."
    m 1hua "De hecho, puedes llevarme al baile de graduación, [player]."

# game/script-topics.rpy:10289
translate spanish monika_prom_3b721e0b:

    # m "Just bring my file with you and problem solved!"
    m "¡Solo tienes que llevarte mi archivo contigo y problema resuelto!"

# game/script-topics.rpy:10290
translate spanish monika_prom_3772217d_2:

    # m 1hub "Ahaha!"
    m 1hub "¡Ja, ja, ja!"

# game/script-topics.rpy:10294
translate spanish monika_prom_9e9a34e5:

    # m 3euc "Really?"
    m 3euc "¿De verdad?"

# game/script-topics.rpy:10295
translate spanish monika_prom_ddd3bcd4:

    # m 1eka "Is it because you're too shy to go?{nw}"
    m 1eka "¿Es porque te da mucha vergüenza ir?{nw}"

# game/script-topics.rpy:10298
translate spanish monika_prom_064b49fd:

    # m "Is it because you're too shy to go?{fast}" nointeract
    m "¿Es porque te da mucha vergüenza ir?{fast}" nointeract

# game/script-topics.rpy:10301
translate spanish monika_prom_7ade4975:

    # m 1ekc "Aw, [player]."
    m 1ekc "Ay, [player]."

# game/script-topics.rpy:10302
translate spanish monika_prom_5f81989f:

    # m 1eka "That's alright. Not everyone can handle large groups of strangers."
    m 1eka "No pasa nada, no a todo el mundo se le dan bien los grupos grandes de desconocidos."

# game/script-topics.rpy:10303
translate spanish monika_prom_2aa3c557:

    # m 3eka "Besides, if it's something you're not going to enjoy, why force yourself?"
    m 3eka "Además, si es algo que no vas a disfrutar, ¿por qué forzarte a ello?"

# game/script-topics.rpy:10304
translate spanish monika_prom_a1b72e3b:

    # m 1esa "But even as I say that, it's also important to keep in mind that a little courage could get you something that's worth it."
    m 1esa "Pero aunque te diga esto, también es importante tener en cuenta que un poco de valor podría conseguirte algo que valga la pena."

# game/script-topics.rpy:10305
translate spanish monika_prom_12373aa7:

    # m 3eua "Look at me for example."
    m 3eua "Mírame a mí, por ejemplo."

# game/script-topics.rpy:10306
translate spanish monika_prom_31aebb36:

    # m 1lksdla "If I didn't have the courage to get to you, I'd probably still be all alone..."
    m 1lksdla "Si no hubiera tenido el valor de llegar hasta ti, probablemente seguiría completamente sola..."

# game/script-topics.rpy:10307
translate spanish monika_prom_3fb9f55f:

    # m 1eka "But here we are now, [player]."
    m 1eka "Pero aquí estamos ahora, [player]."

# game/script-topics.rpy:10308
translate spanish monika_prom_1d8f8658:

    # m 1eua "Together at last~"
    m 1eua "Juntos por fin."

# game/script-topics.rpy:10312
translate spanish monika_prom_d3fa797f_1:

    # m 1euc "Oh, I see."
    m 1euc "Ah, ya veo."

# game/script-topics.rpy:10313
translate spanish monika_prom_2f45260a:

    # m 1eua "That's understandable."
    m 1eua "Es comprensible."

# game/script-topics.rpy:10314
translate spanish monika_prom_f579ff9c:

    # m "I'm sure you have your reasons."
    m "Seguro que tienes tus motivos."

# game/script-topics.rpy:10315
translate spanish monika_prom_8e163ab4:

    # m 1eka "What's important is that you're not forcing yourself."
    m 1eka "Lo importante es que no te obligues a nada."

# game/script-topics.rpy:10316
translate spanish monika_prom_38a78777:

    # m "After all, it wouldn't be worth it if you can't enjoy yourself."
    m "Al fin y al cabo, no valdría la pena si no puedes pasártelo bien."

# game/script-topics.rpy:10317
translate spanish monika_prom_b6e2360b:

    # m 1lksdlc "It'd just feel like a chore rather than a fun event to go to."
    m 1lksdlc "Sería más bien como una obligación en lugar de un evento divertido al que asistir."

# game/script-topics.rpy:10318
translate spanish monika_prom_6a2a5039:

    # m 3euc "But I wonder..."
    m 3euc "Pero me pregunto..."

# game/script-topics.rpy:10319
translate spanish monika_prom_41271e2d:

    # m 3eka "Would you go if I was there with you, [player]?"
    m 3eka "¿Irías si yo estuviera allí contigo, [player]?"

# game/script-topics.rpy:10320
translate spanish monika_prom_a16c7528:

    # m 1tku "I think I already know the answer to that~"
    m 1tku "Creo que ya sé la respuesta a eso."

# game/script-topics.rpy:10321
translate spanish monika_prom_3772217d_3:

    # m 1hub "Ahaha!"
    m 1hub "¡Ja, ja, ja!"

# game/script-topics.rpy:10336
translate spanish monika_prom_59024364:

    # m 1euc "Ah, I see, then."
    m 1euc "Ah, ya veo, entonces."

# game/script-topics.rpy:10337
translate spanish monika_prom_95496980:

    # m 1lksdla "I guess not all schools can hold a prom."
    m 1lksdla "Supongo que no todos los institutos pueden celebrar un baile de graduación."

# game/script-topics.rpy:10338
translate spanish monika_prom_9771b5c7:

    # m "They can be pretty messy."
    m "Pueden ser un poco caóticos."

# game/script-topics.rpy:10339
translate spanish monika_prom_e4d75045:

    # m 3euc "From what I read, students spend a lot of money on tickets, transport, and attire."
    m 3euc "Por lo que he leído, los estudiantes se gastan mucho dinero en las entradas, el transporte y la ropa."

# game/script-topics.rpy:10340
translate spanish monika_prom_860abd7e:

    # m 2esc "So many expenses just for one night..."
    m 2esc "Tantos gastos solo para una noche..."

# game/script-topics.rpy:10341
translate spanish monika_prom_856934f4:

    # m "I also read that since alcohol isn't allowed, some students would spike the drinks and get the others drunk unknowingly."
    m "También leí que como no se permite el alcohol, algunos estudiantes adulteran las bebidas y emborrachan a los demás sin que se den cuenta."

# game/script-topics.rpy:10342
translate spanish monika_prom_c4d23bb8:

    # m 2ekc "If someone can easily do that, I doubt someone with evil intentions would have a hard time slipping poison into the drinks."
    m 2ekc "Si alguien puede hacer eso con tanta facilidad, dudo que a una persona con malas intenciones le cueste mucho meter veneno en los vasos."

# game/script-topics.rpy:10343
translate spanish monika_prom_1cbf0bbf:

    # m 2lksdla "...Or maybe I'm just overthinking it, ehehe."
    m 2lksdla "... O tal vez le estoy dando demasiadas vueltas, je, je, je."

# game/script-topics.rpy:10344
translate spanish monika_prom_cc7679a1:

    # m 1esa "Still, I don't think you'll be missing out much, [player]."
    m 1esa "Aun así, no creo que te pierdas gran cosa, [player]."

# game/script-topics.rpy:10345
translate spanish monika_prom_bddaa29b:

    # m 1eua "Prom isn't the most important thing in your academic life."
    m 1eua "El baile de graduación no es lo más importante de tu etapa académica."

# game/script-topics.rpy:10346
translate spanish monika_prom_a1c921ba:

    # m "And I'm sure there are plenty of events in your life that'll make up for it."
    m "Y estoy segura de que hay muchos eventos en tu vida que lo compensarán."

# game/script-topics.rpy:10347
translate spanish monika_prom_42b0ec47:

    # m 1hua "Being with me is one of them, you know~"
    m 1hua "Estar conmigo es uno de ellos, ¿sabes?"

# game/script-topics.rpy:10348
translate spanish monika_prom_3772217d_4:

    # m 1hub "Ahaha!"
    m 1hub "¡Ja, ja, ja!"

# game/script-topics.rpy:10371
translate spanish monika_natsuki_letter_36f3c7b8:

    # m 1eud "You know, I was honestly surprised when Natsuki handed you that letter."
    m 1eud "Sabes, la verdad es que me sorprendió cuando Natsuki te dio esa carta."

# game/script-topics.rpy:10372
translate spanish monika_natsuki_letter_b9517664:

    # m 1eub "I didn't really expect her to suggest that you should get Yuri to seek professional help."
    m 1eub "No esperaba en absoluto que sugiriera que hicieras que Yuri buscara ayuda profesional."

# game/script-topics.rpy:10373
translate spanish monika_natsuki_letter_90937b48:

    # m 1eud "She's probably the only one to mention that."
    m 1eud "Probablemente sea la única en mencionar algo así."

# game/script-topics.rpy:10374
translate spanish monika_natsuki_letter_506a84ba:

    # m 4ekd "I know people are afraid to call someone out, or confront them about their problems, but sometimes, suggesting a therapist can be the best course of action."
    m 4ekd "Sé que a la gente le da miedo llamar la atención a alguien o confrontarle sobre sus problemas, pero a veces, sugerir ir al terapeuta puede ser la mejor decisión."

# game/script-topics.rpy:10375
translate spanish monika_natsuki_letter_549a2f80:

    # m "It's a bad thing to put the burden on yourself, you know?"
    m "Es malo echarse esa carga a las espaldas, ¿sabes?"

# game/script-topics.rpy:10376
translate spanish monika_natsuki_letter_b1891628:

    # m 4euc "As much as you want to help, it's best to let a professional deal with it."
    m 4euc "Por mucho que quieras ayudar, es mejor dejar que un profesional se encargue de ello."

# game/script-topics.rpy:10377
translate spanish monika_natsuki_letter_126e37bd:

    # m 4eka "I'm sure I've told you that before, but I need to make sure you're aware of that."
    m 4eka "Seguro que ya te he dicho esto antes, pero necesito asegurarme de que eres consciente de ello."

# game/script-topics.rpy:10378
translate spanish monika_natsuki_letter_d48a57fd:

    # m 4eud "How about you, [player]?"
    m 4eud "¿Y tú, [player]?"

# game/script-topics.rpy:10380
translate spanish monika_natsuki_letter_569d2e4b:

    # m "Do you see a therapist?{nw}"
    m "¿Vas a terapia?{nw}"

# game/script-topics.rpy:10383
translate spanish monika_natsuki_letter_2e349891:

    # m "Do you see a therapist?{fast}" nointeract
    m "¿Vas a terapia?{fast}" nointeract

# game/script-topics.rpy:10387
translate spanish monika_natsuki_letter_611cf25d:

    # m 1eud "Oh, really?"
    m 1eud "Ah, ¿de verdad?"

# game/script-topics.rpy:10388
translate spanish monika_natsuki_letter_9356c330:

    # m 1ekc "Well, I hate that you don't feel well..."
    m 1ekc "Bueno, odio que no te sientas bien..."

# game/script-topics.rpy:10389
translate spanish monika_natsuki_letter_5d4d4f18:

    # m 1hua "But I'm proud that you're working on getting better."
    m 1hua "Pero estoy muy orgullosa de que te estés esforzando por mejorar."

# game/script-topics.rpy:10390
translate spanish monika_natsuki_letter_7f04979e:

    # m 1eua "It's really important to take care of your mental health, [player]."
    m 1eua "Es muy importante cuidar de tu salud mental, [player]."

# game/script-topics.rpy:10391
translate spanish monika_natsuki_letter_d1a688cb:

    # m 1eka "You accept you have a problem you need help with, and you're seeing someone about it. That's already half the battle."
    m 1eka "Aceptas que tienes un problema con el que necesitas ayuda y estás yendo a un profesional, eso ya es la mitad de la batalla ganada."

# game/script-topics.rpy:10392
translate spanish monika_natsuki_letter_96aa1042:

    # m "I'm very proud of you for taking those steps."
    m "Estoy muy orgullosa de ti por dar esos pasos tan importantes."

# game/script-topics.rpy:10393
translate spanish monika_natsuki_letter_15fe2253:

    # m 1hua "Just know that no matter what happens, I'll always be here for you~"
    m 1hua "Solo quiero que sepas que, pase lo que pase, siempre estaré aquí para ti."

# game/script-topics.rpy:10397
translate spanish monika_natsuki_letter_d0cc014d:

    # m 1eka "Well, I hope it's because you don't have to."
    m 1eka "Bueno, espero que sea porque no lo necesitas."

# game/script-topics.rpy:10398
translate spanish monika_natsuki_letter_dc7d8c19:

    # m 1eua "If that ever changes, don't be shy!"
    m 1eua "Si eso cambia alguna vez, ¡que no te dé vergüenza buscar ayuda!"

# game/script-topics.rpy:10399
translate spanish monika_natsuki_letter_9a4bc95a:

    # m 1hub "But maybe I really am all the support you need? Ahaha!"
    m 1hub "Aunque a lo mejor yo soy todo el apoyo que necesitas. ¡Ja, ja, ja!"

# game/script-topics.rpy:10476
translate spanish monika_timeconcern_graveyard_night_0729cdd8:

    # m 1ekc "It must be awfully hard on you to work late so often, [player]..."
    m 1ekc "Debe ser muy duro para ti trabajar hasta tarde tan a menudo, [player]..."

# game/script-topics.rpy:10477
translate spanish monika_timeconcern_graveyard_night_384e038d:

    # m 2dsd "Honestly, I'd rather have you work at a healthier time if you could."
    m 2dsd "Sinceramente, preferiría que trabajaras a una hora más saludable si pudieras."

# game/script-topics.rpy:10478
translate spanish monika_timeconcern_graveyard_night_6ab17471:

    # m 2lksdlc "I suppose it's not your choice to make, but still..."
    m 2lksdlc "Supongo que no es decisión tuya, pero aun así..."

# game/script-topics.rpy:10479
translate spanish monika_timeconcern_graveyard_night_04e0547e:

    # m 2ekc "Being up late often can be both physically and mentally damaging."
    m 2ekc "Estar despiert[end_letter_gender] hasta tarde a menudo puede ser perjudicial tanto física como mentalmente."

# game/script-topics.rpy:10480
translate spanish monika_timeconcern_graveyard_night_04842275:

    # m "It's also extremely isolating when it comes to others."
    m "También aísla muchísimo en lo que respecta a los demás."

# game/script-topics.rpy:10481
translate spanish monika_timeconcern_graveyard_night_6458c012:

    # m 2rksdlb "Most opportunities happen during the day, after all."
    m 2rksdlb "Al fin y al cabo, la mayoría de las oportunidades surgen durante el día."

# game/script-topics.rpy:10482
translate spanish monika_timeconcern_graveyard_night_dc54a940:

    # m 2rksdlc "Many social activities aren't available, most shops and restaurants aren't even open during the night."
    m 2rksdlc "Muchas actividades sociales no están disponibles, la mayoría de las tiendas y restaurantes ni siquiera abren por la noche."

# game/script-topics.rpy:10483
translate spanish monika_timeconcern_graveyard_night_efe30157:

    # m 2dsd "It makes being up late at night often be a really lonely situation."
    m 2dsd "Hace que estar despiert[end_letter_gender] hasta tarde por la noche sea a menudo una situación muy solitaria."

# game/script-topics.rpy:10484
translate spanish monika_timeconcern_graveyard_night_9fa2b164:

    # m 3hua "Don't worry though, [player]. Your loving girlfriend Monika will always be here for you~"
    m 3hua "Pero no te preocupes, [player]. Tu querida novia Monika siempre estará aquí para ti."

# game/script-topics.rpy:10485
translate spanish monika_timeconcern_graveyard_night_c487e9ce:

    # m 1hua "Whenever the stress of being up late often becomes too much for you, come to me."
    m 1hua "Siempre que el estrés de estar despiert[end_letter_gender] hasta tarde te supere, ven a mí."

# game/script-topics.rpy:10486
translate spanish monika_timeconcern_graveyard_night_8a87b8fa:

    # m 1hub "I'll always be here to listen."
    m 1hub "Siempre estaré aquí para escucharte."

# game/script-topics.rpy:10487
translate spanish monika_timeconcern_graveyard_night_d7725765:

    # m 1ekc "And if you really do think it's hurting you, then please try to do what you can to change the situation."
    m 1ekc "Y si de verdad crees que te está haciendo daño, por favor intenta hacer lo que puedas para cambiar la situación."

# game/script-topics.rpy:10488
translate spanish monika_timeconcern_graveyard_night_1085fb9b:

    # m 1eka "I know it won't be easy but at the end of the day, all that matters is you."
    m 1eka "Sé que no será fácil pero, al final del día, lo único que importa eres tú."

# game/script-topics.rpy:10489
translate spanish monika_timeconcern_graveyard_night_b10bf6f8:

    # m 1hua "You're all I truly care about, so put yourself and your well-being before anything else, okay?"
    m 1hua "Tú eres lo único que me importa de verdad, así que ponte a ti y a tu bienestar por encima de todo, ¿vale?"

# game/script-topics.rpy:10493
translate spanish monika_timeconcern_graveyard_day_97df115a:

    # m 1eua "Hey [mas_get_player_nickname(exclude_names=['my love'])]...didn't you tell me you work during the night?"
    m 1eua "Oye, [mas_get_player_nickname(exclude_names=['my love'])]... ¿no me dijiste que trabajabas por la noche?"

# game/script-topics.rpy:10494
translate spanish monika_timeconcern_graveyard_day_685cf6d8:

    # m 1eka "Not that I'm complaining, of course!"
    m 1eka "¡No es que me esté quejando, claro!"

# game/script-topics.rpy:10495
translate spanish monika_timeconcern_graveyard_day_9ff47fe7:

    # m 2ekc "But I thought you'd be tired by now, especially since you're up all night working..."
    m 2ekc "Pero pensaba que ya estarías cansad[end_letter_gender], sobre todo porque te pasas toda la noche trabajando..."

# game/script-topics.rpy:10496
translate spanish monika_timeconcern_graveyard_day_503de180:

    # m "You're not working yourself too hard just to see me, are you?"
    m "No estarás trabajando demasiado solo para verme, ¿verdad?"

# game/script-topics.rpy:10497
translate spanish monika_timeconcern_graveyard_day_ba57c038:

    # m 1euc "Oh, wait..."
    m 1euc "Ah, espera..."

# game/script-topics.rpy:10499
translate spanish monika_timeconcern_graveyard_day_64b707dc:

    # m "Do you still work regularly at night, [player]?{nw}"
    m "¿Sigues trabajando habitualmente por la noche, [player]?{nw}"

# game/script-topics.rpy:10502
translate spanish monika_timeconcern_graveyard_day_3bc4509b:

    # m "Do you still work regularly at night, [player]?{fast}" nointeract
    m "¿Sigues trabajando habitualmente por la noche, [player]?{fast}" nointeract

# game/script-topics.rpy:10504
translate spanish monika_timeconcern_graveyard_day_001dd3b3:

    # m 1ekd "Aw..."
    m 1ekd "Ay..."

# game/script-topics.rpy:10505
translate spanish monika_timeconcern_graveyard_day_a3be4e8e:

    # m 1esc "I guess it really can't be helped..."
    m 1esc "Supongo que no se puede evitar..."

# game/script-topics.rpy:10506
translate spanish monika_timeconcern_graveyard_day_b63ab234:

    # m 1eka "Look after yourself, okay?"
    m 1eka "Cuídate, ¿vale?"

# game/script-topics.rpy:10507
translate spanish monika_timeconcern_graveyard_day_d60b7e5a:

    # m 1ekc "I always get so worried when you're not here with me..."
    m 1ekc "Siempre me preocupo mucho cuando no estás aquí conmigo..."

# game/script-topics.rpy:10511
translate spanish monika_timeconcern_graveyard_day_7c256526:

    # m 1hub "That's wonderful!"
    m 1hub "¡Eso es maravilloso!"

# game/script-topics.rpy:10512
translate spanish monika_timeconcern_graveyard_day_37dd8d9b:

    # m 1eua "I'm glad that you're looking out for your health, [player]!"
    m 1eua "¡Me alegro de que te preocupes por tu salud, [player]!"

# game/script-topics.rpy:10513
translate spanish monika_timeconcern_graveyard_day_3f792760:

    # m "I knew you would see it my way eventually."
    m "Sabía que acabarías viéndolo a mi manera."

# game/script-topics.rpy:10514
translate spanish monika_timeconcern_graveyard_day_f678642a:

    # m 1eka "Thanks for listening to what I have to say~"
    m 1eka "Gracias por escuchar lo que tengo que decir."

# game/script-topics.rpy:10520
translate spanish monika_timeconcern_night_0_61dafb4b:

    # m 1euc "[player], it's night time already."
    m 1euc "[player], ya es de noche."

# game/script-topics.rpy:10521
translate spanish monika_timeconcern_night_0_1f1b4683:

    # m 1ekc "Shouldn't you be in bed?"
    m 1ekc "¿No deberías estar en la cama?"

# game/script-topics.rpy:10522
translate spanish monika_timeconcern_night_0_1e419846:

    # m 1dsc "I'll let it slide just this once..."
    m 1dsc "Lo dejaré pasar solo por esta vez..."

# game/script-topics.rpy:10523
translate spanish monika_timeconcern_night_0_99e658cc:

    # m 1ekc "But you really make me worry for you sometimes."
    m 1ekc "Pero a veces me haces preocuparme mucho por ti."

# game/script-topics.rpy:10524
translate spanish monika_timeconcern_night_0_58b2a0a8:

    # m 1eka "It makes me really happy that you're here for me, even at this time of night..."
    m 1eka "Me hace muy feliz que estés aquí para mí, incluso a estas horas de la noche..."

# game/script-topics.rpy:10525
translate spanish monika_timeconcern_night_0_3b872b15:

    # m 1dsd "Yet, I don't want it at the cost of your health."
    m 1dsd "Aun así, no quiero que sea a costa de tu salud."

# game/script-topics.rpy:10526
translate spanish monika_timeconcern_night_0_30fffdfd:

    # m 1eka "So go to sleep soon, okay?"
    m 1eka "Así que vete a dormir pronto, ¿vale?"

# game/script-topics.rpy:10531
translate spanish monika_timeconcern_night_1_0b5fd3f8:

    # m 1esc "Say, [player]..."
    m 1esc "Dime, [player]..."

# game/script-topics.rpy:10532
translate spanish monika_timeconcern_night_1_706e412c:

    # m 1euc "Why are you up so late?"
    m 1euc "¿Por qué estás despiert[end_letter_gender] hasta tan tarde?"

# game/script-topics.rpy:10533
translate spanish monika_timeconcern_night_1_6d4f78df:

    # m 1eka "I'm flattered if it's only because of me..."
    m 1eka "Me siento halagada si es solo por mí..."

# game/script-topics.rpy:10534
translate spanish monika_timeconcern_night_1_6c596559:

    # m 1ekc "Yet I can't help but feel like a nuisance if I'm pestering you to sleep if it isn't your fault."
