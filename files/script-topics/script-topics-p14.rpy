translate spanish monika_dating_0c8eb7dd:

    # extend 3ekbfa "no matter how many heartbreaks you've been through, I'll always be here for you."
    extend 3ekbfa " no importa por cuántos desengaños hayas pasado, yo siempre estaré aquí para ti."

# game/script-topics.rpy:10984
translate spanish monika_dating_eea1f589:

    # m 5eubfa "Our soul searching is finally over, and I'll be yours forever, [player]."
    m 5eubfa "Nuestra búsqueda del alma gemela por fin ha terminado, y seré tuya para siempre, [player]."

