    # m 3hksdlb "Sorry, I lost track of what I was going to say next, ahaha!"
    m 3hksdlb "Lo siento, he perdido el hilo de lo que iba a decir después, ¡ja, ja, ja!"

# game/script-topics.rpy:10980
translate spanish monika_dating_6d7ce1d0:

    # m 1ekbla "I could go on about how wonderful you are, [player]~"
    m 1ekbla "Podría seguir hablando de lo maravillos[end_letter_gender] que eres, [player]."

# game/script-topics.rpy:10981
translate spanish monika_dating_be66d582:

    # m 1ekbsa "But just know this...{w=0.3}{nw}"
    m 1ekbsa "Pero que sepas esto...{w=0.3}{nw}"

