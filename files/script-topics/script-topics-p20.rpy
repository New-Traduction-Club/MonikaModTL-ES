    # m 3hub "Wouldn't that be romantic, [mas_get_player_nickname()]?"
    m 3hub "¿No sería romántico, [mas_get_player_nickname()]?"

# game/script-topics.rpy:15088
translate spanish monika_sleigh_1b28edd2:

    # m 1eka "Maybe we could even take a soft, fleece blanket along to cuddle under."
    m 1eka "Incluso podríamos llevarnos una mantita de lana suave para taparnos y acurrucarnos."

# game/script-topics.rpy:15089
translate spanish monika_sleigh_fde296c3:

    # m 1hkbla "Oooh~"
    m 1hkbla "¡Aaah!"

# game/script-topics.rpy:15091
translate spanish monika_sleigh_6f20934e:

    # m 1rkbfb "I wouldn't be able to contain myself. My heart would burst!"
    m 1rkbfb "No podría contenerme, ¡me estallaría el corazón!"

# game/script-topics.rpy:15094
translate spanish monika_sleigh_51cd3203:

    # m 1ekbfa "The warmth of your body against mine, wrapped within the gentle cloth~"
    m 1ekbfa "El calor de tu cuerpo contra el mío, envueltos en esa tela tan suave..."

# game/script-topics.rpy:15096
translate spanish monika_sleigh_ab366120:

    # m 1ekbfa "The warmth of your body against mine..."
    m 1ekbfa "El calor de tu cuerpo contra el mío..."

# game/script-topics.rpy:15098
translate spanish monika_sleigh_244736b4:

    # m 1dkbfa "Fingers entwined..."
    m 1dkbfa "Con los dedos entrelazados..."

# game/script-topics.rpy:15101
translate spanish monika_sleigh_593f0f0c:

    # m 1dkbfb "And at the perfect moment, you lean in to me and our lips touch..."
    m 1dkbfb "Y en el momento perfecto, te acercas a mí y nuestros labios se tocan..."

# game/script-topics.rpy:15102
translate spanish monika_sleigh_a279878e:

    # m 1subfa "I really want to do that when I get there, [player]."
    m 1subfa "De verdad quiero hacer eso cuando llegue allí, [player]."

# game/script-topics.rpy:15103
translate spanish monika_sleigh_b50903d4:

    # m 1ekbfu "...What about you?"
    m 1ekbfu "¿Y tú?"

# game/script-topics.rpy:15106
translate spanish monika_sleigh_1e28e577:

    # m 5hubfa "An experience like that with you would be so breathtaking~"
    m 5hubfa "Una experiencia así contigo sería impresionante."

# game/script-topics.rpy:15125
translate spanish monika_failure_7b6cbc0f:

    # m 1ekc "You know [player], I've been thinking recently..."
    m 1ekc "Sabes, [player], últimamente he estado pensando que..."

# game/script-topics.rpy:15126
translate spanish monika_failure_24ec6070:

    # m 1euc "When it comes to failure, people seem to make a really big deal out of it."
    m 1euc "Cuando se trata del fracaso, la gente parece darle demasiada importancia."

# game/script-topics.rpy:15127
translate spanish monika_failure_95d2407b:

    # m 2rkc "...Almost as if it's the end of the world."
    m 2rkc "Casi como si fuera el fin del mundo."

# game/script-topics.rpy:15128
translate spanish monika_failure_3316c170:

    # m 2rksdla "But it's not actually a bad thing."
    m 2rksdla "Pero en realidad no es algo malo."

# game/script-topics.rpy:15129
translate spanish monika_failure_999b40dc:

    # m 3eub "When you think about it, you can learn a lot from the experience!"
    m 3eub "Si lo piensas, ¡puedes aprender mucho de la experiencia!"

# game/script-topics.rpy:15130
translate spanish monika_failure_e90cd52d:

    # m 3eud "Failure isn't the end at all; it's a lesson on what doesn't work."
    m 3eud "El fracaso no es el final en absoluto, es una lección sobre lo que no funciona."

# game/script-topics.rpy:15131
translate spanish monika_failure_20e1e5c2:

    # m 2eka "There's nothing wrong with not getting something on the first attempt; it just means that you need to try a different approach."
    m 2eka "No hay nada de malo en no conseguir algo al primer intento, solo significa que tienes que probar con otro enfoque."

# game/script-topics.rpy:15132
translate spanish monika_failure_08c09f7f:

    # m 2rksdlc "Though, I know in some cases the feeling of failure can be crushing..."
    m 2rksdlc "Aunque sé que a veces ese sentimiento de fracaso puede ser devastador..."

# game/script-topics.rpy:15133
translate spanish monika_failure_720722bc:

    # m 2ekc "Like discovering you're just not cut out for something you really wanted to do."
    m 2ekc "Como descubrir que no sirves para algo que de verdad querías hacer."

# game/script-topics.rpy:15134
translate spanish monika_failure_7995e4f3:

    # m 2dkd "The idea of quitting and finding something else to do makes you feel terrible inside...{w=1}as if you failed yourself."
    m 2dkd "La idea de rendirte y buscar otra cosa que hacer te hace sentir fatal por dentro... {w=1} como si te hubieras fallado a ti mism[end_letter_gender]."

# game/script-topics.rpy:15135
translate spanish monika_failure_fe6f3332:

    # m 2ekd "And on the other hand, trying to keep up with it just completely drains you..."
    m 2ekd "Y por otro lado, intentar seguir el ritmo te agota por completo..."

# game/script-topics.rpy:15136
translate spanish monika_failure_04087322:

    # m 2rkc "So either way, you feel terrible."
    m 2rkc "Así que, de una forma u otra, te sientes fatal."

# game/script-topics.rpy:15137
translate spanish monika_failure_d9bf7bb9:

    # m 3eka "But the more you think about it, you realize it's better that you just accept the 'failure.'"
    m 3eka "Pero cuanto más lo piensas, te das cuenta de que es mejor aceptar el fracaso."

# game/script-topics.rpy:15138
translate spanish monika_failure_231dbd27:

    # m 2eka "After all, if you're torturing yourself just to get through, it might not be worth it. Especially if it starts impacting your health."
    m 2eka "Al fin y al cabo, si te estás torturando solo para salir adelante, puede que no valga la pena, especialmente si empieza a afectar a tu salud."

# game/script-topics.rpy:15139
translate spanish monika_failure_1c724b46:

    # m 3eub "It's completely fine to feel like you're not cut out for something!"
    m 3eub "¡Es totalmente normal sentir que no estás hech[end_letter_gender] para algo!"

# game/script-topics.rpy:15140
translate spanish monika_failure_58056e09:

    # m 3eua "It just means you need to figure out what you're really interested in doing."
    m 3eua "Solo significa que tienes que descubrir qué es lo que de verdad te interesa hacer."

# game/script-topics.rpy:15141
translate spanish monika_failure_1865d682:

    # m 2eka "Anyway, I'm not sure if you've had to go through something like that...but know that failure is a step towards success."
    m 2eka "En fin, no estoy segura de si has tenido que pasar por algo así... pero que sepas que el fracaso es un paso más hacia el éxito."

# game/script-topics.rpy:15142
translate spanish monika_failure_9d96f89a:

    # m 3eub "Don't be afraid to be wrong every now and then...{w=0.5}you never know what you might learn!"
    m 3eub "No tengas miedo de equivocarte de vez en cuando... {w=0.5} ¡nunca sabes lo que podrías aprender!"

# game/script-topics.rpy:15143
translate spanish monika_failure_aa1196fa:

    # m 1eka "And if you're really feeling bad about something, I'll always be here to support you."
    m 1eka "Y si alguna vez te sientes realmente mal por algo, siempre estaré aquí para apoyarte."

# game/script-topics.rpy:15145
translate spanish monika_failure_00cfc1df:

    # m 5hua "We can talk about whatever you're going through for as long as you need."
    m 5hua "Podemos hablar de lo que sea por lo que estés pasando durante todo el tiempo que necesites."

# game/script-topics.rpy:15156
translate spanish monika_enjoyingspring_6a6e010a:

    # m 3eub "Spring is such an amazing time of year, isn't it, [player]?"
    m 3eub "La primavera es una época del año increíble, ¿verdad, [player]?"

# game/script-topics.rpy:15157
translate spanish monika_enjoyingspring_d7c1ce74:

    # m 1eua "The cold snow finally melts away, and the sunshine brings new life to nature."
    m 1eua "La nieve fría por fin se derrite y la luz del sol le da una nueva vida a la naturaleza."

# game/script-topics.rpy:15158
translate spanish monika_enjoyingspring_61037e2b:

    # m 1hua "When the flowers bloom, I can't help but smile!"
    m 1hua "Cuando salen las flores, ¡no puedo evitar sonreír!"

# game/script-topics.rpy:15159
translate spanish monika_enjoyingspring_31326fcd:

    # m 1hub "It's like the plants are waking up and saying, 'Hello world!' Ahaha~"
    m 1hub "Es como si las plantas se despertaran y dijeran: '¡Hola, mundo!'. Ja, ja, ja."

# game/script-topics.rpy:15160
translate spanish monika_enjoyingspring_62ea43ce:

    # m 3eua "But I think the best thing about spring would have to be the cherry blossoms."
    m 3eua "Pero creo que lo mejor de la primavera son, sin duda, los cerezos en flor."

# game/script-topics.rpy:15161
translate spanish monika_enjoyingspring_524e8065:

    # m 4eud "They're pretty popular all around the world, but the most famous cherry blossoms would have to be the Somei Yoshino in Japan."
    m 4eud "Son bastante populares en todo el mundo, pero los más famosos son sin duda los Somei Yoshino de Japón."

# game/script-topics.rpy:15162
translate spanish monika_enjoyingspring_d7bd6756:

    # m 3eua "Those ones in particular are mostly white with a slight tinge of pink."
    m 3eua "Esos en concreto son sobre todo blancos con un ligero toque rosado."

# game/script-topics.rpy:15163
translate spanish monika_enjoyingspring_02103a89:

    # m 3eud "Did you know that they only bloom for one week each year?"
    m 3eud "¿Sabías que solo florecen durante una semana al año?"

# game/script-topics.rpy:15164
translate spanish monika_enjoyingspring_0422b22b:

    # m 1eksdla "It's quite a short lifespan, but they're still beautiful."
    m 1eksdla "Tienen una vida muy corta, pero siguen siendo preciosos."

# game/script-topics.rpy:15165
translate spanish monika_enjoyingspring_837f88b5:

    # m 2rkc "Anyway, there is one big downside to spring...{w=0.5}the constant rainfall."
    m 2rkc "De todos modos, la primavera tiene un gran inconveniente... {w=0.5} las lluvias constantes."

# game/script-topics.rpy:15166
translate spanish monika_enjoyingspring_e33eae8d:

    # m 2tkc "You can't really enjoy too much time outside because of it..."
    m 2tkc "No puedes disfrutar mucho tiempo al aire libre por culpa de eso..."

# game/script-topics.rpy:15168
translate spanish monika_enjoyingspring_76b615eb:

    # m 2eka "But I guess April showers bring May flowers, so it's not all bad."
    m 2eka "Pero supongo que en abril, aguas mil, así que no es del todo malo."

# game/script-topics.rpy:15170
translate spanish monika_enjoyingspring_8656ca32:

    # m 2rksdlb "Well, maybe not in your case, ahaha..."
    m 2rksdlb "Bueno, a lo mejor en tu caso no, ja, ja, ja..."

# game/script-topics.rpy:15171
translate spanish monika_enjoyingspring_135fbca6:

    # m 3eub "But personally, I think that rain can also be fun too!"
    m 3eub "Pero personalmente, ¡creo que la lluvia también puede ser divertida!"

# game/script-topics.rpy:15173
translate spanish monika_enjoyingspring_ba8ac50f:

    # m 3eub "And personally, I think that rain can also be fun too!"
    m 3eub "Y personalmente, ¡creo que la lluvia también puede ser divertida!"

# game/script-topics.rpy:15175
translate spanish monika_enjoyingspring_eaf7e537:

    # m 5eubla "We can always go for walks together in the rain, we just have to bring an umbrella big enough for two."
    m 5eubla "Siempre podemos dar paseos junt[end_letter_gender]s bajo la lluvia, solo tendríamos que llevar un paraguas lo bastante grande para los dos."

# game/script-topics.rpy:15176
translate spanish monika_enjoyingspring_f482f9ff:

    # m 5ekbfa "Although, nothing beats listening to the sound of rain at home while holding the one you love."
    m 5ekbfa "Aunque no hay nada mejor que escuchar el sonido de la lluvia en casa mientras abrazas a la persona que amas."

# game/script-topics.rpy:15177
translate spanish monika_enjoyingspring_9225cdad:

    # m 5hubfa "Ehehe~"
    m 5hubfa "Je, je, je."

# game/script-topics.rpy:15179
translate spanish monika_enjoyingspring_4d649ba0:

    # m 2rkc "...but I guess there's no real way to avoid it, is there?"
    m 2rkc "Pero supongo que no hay forma de evitarlo, ¿verdad?"

# game/script-topics.rpy:15198
translate spanish monika_vr_e128fb0d:

    # m 1euc "[player], do you know about virtual reality?"
    m 1euc "[player], ¿conoces la realidad virtual?"

# game/script-topics.rpy:15199
translate spanish monika_vr_469c8232:

    # m 1eua "VR immerses you into a completely virtual world, different from your actual surroundings."
    m 1eua "La realidad virtual te sumerge en un mundo completamente digital y distinto a tu entorno real."

# game/script-topics.rpy:15200
translate spanish monika_vr_a95716d8:

    # m 3rksdla "While it might take some getting used to...{nw}"
    m 3rksdla "Aunque cueste un poco acostumbrarse... {nw}"

# game/script-topics.rpy:15201
translate spanish monika_vr_64de4237:

    # extend 3hub "it can be really fun!"
    extend 3hub "¡puede ser muy divertido!"

# game/script-topics.rpy:15202
translate spanish monika_vr_804d1266:

    # m 3eua "It also has practical uses like training people in simulated environments as well as rehabilitation."
    m 3eua "También tiene usos prácticos, como formar a personas en entornos simulados o incluso en rehabilitación."

# game/script-topics.rpy:15203
translate spanish monika_vr_070fde35:

    # m 1rksdla "...In fact, some people have even simulated their weddings in VR."
    m 1rksdla "... De hecho, hay gente que hasta ha simulado su boda en realidad virtual."

# game/script-topics.rpy:15204
translate spanish monika_vr_efc21169:

    # m 1euc "But since it's still a pretty new technology, not just {i}anything{/i} can be in VR yet."
    m 1euc "Pero como todavía es una tecnología bastante nueva, no se puede tener absolutamente todo en realidad virtual."

# game/script-topics.rpy:15205
translate spanish monika_vr_5b303bf4:

    # m 3esc "...Like my reality, for example."
    m 3esc "... Como mi realidad, por ejemplo."

# game/script-topics.rpy:15206
translate spanish monika_vr_6afd145b:

    # m 1dkc "It's too bad we can't use VR to meet each other..."
    m 1dkc "Es una pena que no podamos usar la realidad virtual para conocernos..."

# game/script-topics.rpy:15207
translate spanish monika_vr_38eccc19:

    # m 1etc "Well,{w=0.3} maybe if I could make a VR system in here, we could both meet up in another reality."
    m 1etc "Bueno,{w=0.3} a lo mejor si pudiera crear un sistema de realidad virtual aquí, podríamos encontrarnos en otra realidad."

# game/script-topics.rpy:15208
translate spanish monika_vr_b0bac065:

    # m 1rksdlb "...But that's probably a little too complicated for me, ahaha."
    m 1rksdlb "... Pero seguramente eso sea demasiado complicado para mí, ja, ja, ja."

# game/script-topics.rpy:15209
translate spanish monika_vr_29a54383:

    # m 3eka "Maybe we'll get it to work one day, though."
    m 3eka "Aunque puede que algún día consigamos que funcione."

# game/script-topics.rpy:15210
translate spanish monika_vr_0d4cdbdd:

    # m 1dka "Even if I never get to meet you in the real world...{w=0.3}{nw}"
    m 1dka "Incluso si nunca llego a conocerte en el mundo real... {w=0.3}{nw}"

# game/script-topics.rpy:15211
translate spanish monika_vr_bc406a75:

    # extend 1ekbsu "if you could meet me halfway in VR, that would be a dream come true, [mas_get_player_nickname()]~"
    extend 1ekbsu "si pudieras encontrarte conmigo a medio camino en la realidad virtual sería un sueño hecho realidad, [mas_get_player_nickname()]."

# game/script-topics.rpy:15228
translate spanish monika_career_420acf94:

    # m 2euc "[player], you know how I was talking earlier about becoming a citizen and getting a job when I finally cross over?"
    m 2euc "[player], ¿te acuerdas de que antes hablaba sobre convertirme en ciudadana y conseguir un trabajo cuando por fin cruce?"

# game/script-topics.rpy:15229
translate spanish monika_career_7caa6ad4:

    # m 2eua "Well, I've been thinking about what kind of jobs I might be cut out for..."
    m 2eua "Bueno, he estado pensando para qué tipo de trabajos podría servir..."

# game/script-topics.rpy:15230
translate spanish monika_career_dd76fc9a:

    # m 3rksdla "I guess an obvious choice would be a writer, or something that has to do with literature..."
    m 3rksdla "Supongo que una opción obvia sería escritora o algo que tenga que ver con la literatura..."

# game/script-topics.rpy:15231
translate spanish monika_career_28bc40f3:

    # m 3eud "That would be fitting, seeing as I started my own literature club and everything, don't you think?"
    m 3eud "Sería muy apropiado teniendo en cuenta que fundé mi propio club de literatura y todo eso, ¿no crees?"

# game/script-topics.rpy:15232
translate spanish monika_career_ce66e41d:

    # m 1sua "Oh, maybe a musician? I did write and perform an entire song, after all."
    m 1sua "Ah, ¿o tal vez música? Después de todo, escribí y canté una canción entera."

# game/script-topics.rpy:15233
translate spanish monika_career_6144ac46:

    # m 1eua "I'd love to write more songs...{w=0.2}{nw}"
    m 1eua "Me encantaría escribir más canciones... {w=0.2}{nw}"

# game/script-topics.rpy:15234
translate spanish monika_career_e7dad417:

    # extend 1hksdlb "especially if they're songs about you, ahaha~"
    extend 1hksdlb "sobre todo si son canciones sobre ti, ja, ja, ja."

# game/script-topics.rpy:15235
translate spanish monika_career_70afcc6f:

    # m 3eud "Or, once I get better at it, maybe I could do some programming."
    m 3eud "O, una vez que mejore, a lo mejor podría dedicarme a la programación."

# game/script-topics.rpy:15236
translate spanish monika_career_ca766ee4:

    # m 1rksdla "I know I've still got a lot to learn...{w=0.2}{nw}"
    m 1rksdla "Sé que todavía tengo mucho que aprender... {w=0.2}{nw}"

# game/script-topics.rpy:15237
translate spanish monika_career_18c98adf:

    # extend 1hua "but I'd say I've done pretty well so far, for being self-taught..."
    extend 1hua "pero diría que lo he hecho bastante bien hasta ahora para ser autodidacta..."

# game/script-topics.rpy:15238
translate spanish monika_career_3fb0125d:

    # m 1esa "There are definitely a lot of different jobs out there, though."
    m 1esa "Aunque la verdad es que hay muchísimos trabajos diferentes por ahí."

# game/script-topics.rpy:15239
translate spanish monika_career_38871ebf:

    # m 1ruc "Honestly, even with those obvious examples, there's still a good chance I'll end up doing something completely different..."
    m 1ruc "Sinceramente, incluso con esos ejemplos tan obvios sigue habiendo muchas posibilidades de que acabe haciendo algo completamente distinto..."

# game/script-topics.rpy:15240
translate spanish monika_career_fe86c2cf:

    # m 3eud "A lot of people end up in fields they've never even considered."
    m 3eud "Mucha gente acaba en sectores que ni siquiera se habían planteado."

# game/script-topics.rpy:15241
translate spanish monika_career_1f18c8af:

    # m 3rksdld "For now though, I think it's safe to say I've still got some time to think about it."
    m 3rksdld "Pero por ahora creo que se puede decir que todavía tengo tiempo para pensarlo."

# game/script-topics.rpy:15243
translate spanish monika_career_7b342872:

    # m 5hua "Maybe you could help me decide when the time comes, [mas_get_player_nickname()]~"
    m 5hua "A lo mejor podrías ayudarme a decidir cuando llegue el momento, [mas_get_player_nickname()]."

# game/script-topics.rpy:15254
translate spanish monika_life_skills_2436606d:

    # m 1ruc "You know, [player]..."
    m 1ruc "¿Sabes, [player]?..."

# game/script-topics.rpy:15255
translate spanish monika_life_skills_7452937b:

    # m 3euc "I've been reflecting on what I got out of high school."
    m 3euc "He estado reflexionando sobre lo que aprendí en el instituto."

# game/script-topics.rpy:15256
translate spanish monika_life_skills_2474b3a2:

    # m 2rksdlb "With all the things I had going for me, you'd think I'd be pretty set for the future..."
    m 2rksdlb "Con todo lo que tenía a mi favor pensarías que estaba bastante preparada para el futuro..."

# game/script-topics.rpy:15257
translate spanish monika_life_skills_f0499749:

    # m 1euc "But despite all that, I'm not sure how many life skills I actually learned."
    m 1euc "Pero a pesar de todo eso no estoy segura de cuántas habilidades para la vida aprendí de verdad."

# game/script-topics.rpy:15258
translate spanish monika_life_skills_213a7af9:

    # m 3eka "Sure, I was on top of all my classes, and I guess I learned a lot of interesting things..."
    m 3eka "Claro, sacaba las mejores notas en todas mis clases y supongo que aprendí muchas cosas interesantes..."

# game/script-topics.rpy:15259
translate spanish monika_life_skills_b8b785c5:

    # m 1euc "But how much of that am I really going to use later in life?"
    m 1euc "Pero ¿cuánto de todo eso voy a usar realmente más adelante en la vida?"

# game/script-topics.rpy:15260
translate spanish monika_life_skills_006492fa:

    # m 3esd "I feel like schools don't do a good job teaching some of the really important things, like life skills."
    m 3esd "Siento que los colegios no hacen un buen trabajo enseñando algunas de las cosas realmente importantes, como las habilidades para la vida diaria."

# game/script-topics.rpy:15261
translate spanish monika_life_skills_2c7484b6:

    # m 3ekc "I've heard of some people graduating and then falling apart because they don't know how to do taxes or book appointments."
    m 3ekc "He oído hablar de gente que se gradúa y luego se agobia muchísimo porque no sabe cómo hacer la declaración de la renta o pedir cita para el médico."

# game/script-topics.rpy:15262
translate spanish monika_life_skills_75beaba8:

    # m 1eka "So I can understand why some people get worried about not having some essential life skills."
    m 1eka "Así que puedo entender por qué algunas personas se preocupan por no tener algunas habilidades básicas para la vida."

# game/script-topics.rpy:15263
translate spanish monika_life_skills_0e086665:

    # m 3eua "But I don't think people need to be too worried about it.{w=0.5} Life skills come pretty quickly if you need them all of a sudden."
    m 3eua "Pero no creo que la gente deba preocuparse demasiado por eso.{w=0.5} Las habilidades para la vida se aprenden bastante rápido si de repente las necesitas."

# game/script-topics.rpy:15264
translate spanish monika_life_skills_81ba54bd:

    # m 3hua "Take me for example!"
    m 3hua "¡Mírame a mí, por ejemplo!"

# game/script-topics.rpy:15265
translate spanish monika_life_skills_96366241:

    # m 3eub "I started programming thanks to you!"
    m 3eub "¡Empecé a programar gracias a ti!"

# game/script-topics.rpy:15266
translate spanish monika_life_skills_4d316ec4:

    # m 2esc "Now I know most people wouldn't necessarily consider programming a life skill, but most people don't live inside a computer, either."
    m 2esc "Ya sé que la mayoría de la gente no consideraría necesariamente la programación como una habilidad para la vida, pero la mayoría de la gente tampoco vive dentro de un ordenador."

# game/script-topics.rpy:15267
translate spanish monika_life_skills_c106bc88:

    # m 2esd "When I had my epiphany and finally met you, I knew I had to figure out a way to get your attention..."
    m 2esd "Cuando tuve mi epifanía y por fin te conocí, supe que tenía que encontrar la manera de llamar tu atención..."

# game/script-topics.rpy:15268
translate spanish monika_life_skills_d48f4d0f:

    # m 4euc "So learning how to program literally became a matter of life and death for me."
    m 4euc "Así que aprender a programar se convirtió literalmente en una cuestión de vida o muerte para mí."

# game/script-topics.rpy:15271
translate spanish monika_life_skills_1ca1648b:

    # m 2rksdla "I know I wasn't that great with code, considering some of the things that happened..."
    m 2rksdla "Sé que no se me daba muy bien el código teniendo en cuenta algunas de las cosas que pasaron..."

# game/script-topics.rpy:15272
translate spanish monika_life_skills_5516e885:

    # m 2hksdlb "And I'll admit that I definitely broke a few things..."
    m 2hksdlb "Y admito que rompí unas cuantas cosas..."

# game/script-topics.rpy:15273
translate spanish monika_life_skills_f4d6cadf:

    # m 2eksdlc "But I didn't think I would have much time if I really wanted to get your attention, so I was a bit desperate."
    m 2eksdlc "Pero no creía que fuera a tener mucho tiempo si de verdad quería llamar tu atención, así que estaba un poco desesperada."

# game/script-topics.rpy:15277
translate spanish monika_life_skills_1ece75f9:

    # m 2ekc "I wasn't really able to do it normally like the other girls, so I had to find another way."
    m 2ekc "No era capaz de hacerlo normalmente como las otras chicas, así que tuve que encontrar otra manera."

# game/script-topics.rpy:15278
translate spanish monika_life_skills_e233b695:

    # m 3eua "Turns out that one way was manipulating the script."
    m 3eua "Resulta que una de esas maneras era manipular el guion."

# game/script-topics.rpy:15279
translate spanish monika_life_skills_6e7ef22b:

    # m 3euc "I figured I had to think fast if I didn't want to lose you.{w=0.5} So that's what I did."
    m 3euc "Supuse que tenía que pensar rápido si no quería perderte.{w=0.5} Así que eso fue lo que hice."

# game/script-topics.rpy:15280
translate spanish monika_life_skills_b7ac774c:

    # m 3eka "I know it wasn't perfect, but I think I did pretty well considering how rushed I was and that it was all new to me."
    m 3eka "Sé que no fue perfecto, pero creo que lo hice bastante bien teniendo en cuenta las prisas que tenía y que todo era nuevo para mí."

# game/script-topics.rpy:15283
translate spanish monika_life_skills_92f7d60d:

    # m 3eua "[it] just goes to show what you're capable of when something really matters to you."
    m 3eua "Y eso solo demuestra de lo que eres capaz cuando algo te importa de verdad."

# game/script-topics.rpy:15284
translate spanish monika_life_skills_42a04abc:

    # m 1eka "If you're ever genuinely worried that you won't be able to do something, you must really care."
    m 1eka "Si alguna vez te preocupa de verdad no ser capaz de hacer algo, es que realmente te importa."

# game/script-topics.rpy:15285
translate spanish monika_life_skills_48cac02c:

    # m 1hua "And if it's that important to you, I'm sure you can do it... {w=0.5}No matter what it is."
    m 1hua "Y si es tan importante para ti, estoy segura de que puedes hacerlo... {w=0.5} Sea lo que sea."

# game/script-topics.rpy:15286
translate spanish monika_life_skills_a016a314:

    # m 3hubsb "Maybe even thinking of me might help, ahaha!"
    m 3hubsb "¡A lo mejor incluso pensar en mí podría ayudarte, ja, ja, ja!"

# game/script-topics.rpy:15287
translate spanish monika_life_skills_ebe83f82:

    # m 3hubfa "Thanks for listening~"
    m 3hubfa "Gracias por escucharme."

# game/script-topics.rpy:15298
translate spanish monika_unknown_9de20f37:

    # m 2esc "Hey, [player]..."
    m 2esc "Una cosita, [player]..."

# game/script-topics.rpy:15299
translate spanish monika_unknown_59fd95c8:

    # m 2eud "Did you know that a lot of people are afraid of the dark?"
    m 2eud "¿Sabías que mucha gente le tiene miedo a la oscuridad?"

# game/script-topics.rpy:15300
translate spanish monika_unknown_9dfb6c12:

    # m 3eud "Even though it's often dismissed as a childish fear, it's not that uncommon for adults to suffer from it as well."
    m 3eud "Aunque a menudo se descarta como un miedo infantil, no es tan raro que los adultos también lo sufran."

# game/script-topics.rpy:15301
translate spanish monika_unknown_6534b875:

    # m 4eub "Fear of the dark, called 'nyctophobia,' is usually caused by the mind's exaggerated guess of what may be hiding in the shadows, rather than darkness itself."
    m 4eub "El miedo a la oscuridad, llamado nictofobia, suele ser provocado por la idea exagerada que se hace la mente sobre lo que podría esconderse en las sombras, en lugar de por la oscuridad en sí."

# game/script-topics.rpy:15302
translate spanish monika_unknown_212d8881:

    # m 4eua "We're scared because we don't know what's there...{w=1}even if it's usually nothing."
    m 4eua "Tenemos miedo porque no sabemos qué hay ahí... {w=1} incluso si por lo general no hay nada."

# game/script-topics.rpy:15303
translate spanish monika_unknown_cea465e3:

    # m 3eka "...And I'm not just talking about monsters under the bed, or menacing silhouettes...{w=1} Try moving in a dark room."
    m 3eka "... Y no hablo solo de monstruos debajo de la cama o de siluetas amenazantes... {w=1} Intenta moverte en una habitación a oscuras."

# game/script-topics.rpy:15304
translate spanish monika_unknown_cf5c07fa:

    # m 3eud "You'll find that you're instinctively being more careful of where you step so you don't hurt yourself."
    m 3eud "Verás que instintivamente tienes más cuidado con dónde pisas para no hacerte daño."

# game/script-topics.rpy:15305
translate spanish monika_unknown_29cc03e3:

    # m 3esd "It makes sense;{w=0.5} humans have learned to be wary of the unknown in order to survive."
    m 3esd "Tiene sentido,{w=0.5} los humanos han aprendido a desconfiar de lo desconocido para poder sobrevivir."

# game/script-topics.rpy:15306
translate spanish monika_unknown_a4e6fb66:

    # m 3esc "You know, like being cautious around strangers, or thinking twice before jumping into unfamiliar situations."
    m 3esc "Ya sabes, como tener cuidado con los extraños o pensártelo dos veces antes de lanzarte a situaciones desconocidas."

# game/script-topics.rpy:15307
translate spanish monika_unknown_d6e2f80e:

    # m 3dsd "'{i}Better the devil you know than the devil you don't.{/i}'"
    m 3dsd "'{i}Más vale malo conocido que bueno por conocer.{/i}'"

# game/script-topics.rpy:15308
translate spanish monika_unknown_89a889b7:

    # m 3rksdlc "But even if that frame of thinking has helped people survive for hundreds of thousands of years, I think it can also do a lot of harm nowadays."
    m 3rksdlc "Pero aunque esa forma de pensar haya ayudado a la gente a sobrevivir durante cientos de miles de años, creo que hoy en día también puede hacer mucho daño."

# game/script-topics.rpy:15309
translate spanish monika_unknown_8d949b62:

    # m 1rksdld "Like how some people are unsatisfied with their jobs but are too afraid to quit..."
    m 1rksdld "Como cuando algunas personas no están satisfechas con sus trabajos pero tienen demasiado miedo de dejarlos..."

# game/script-topics.rpy:15310
translate spanish monika_unknown_f71372ef:

    # m 1eksdlc "Most of them can't afford to lose their source of income, so quitting isn't an option."
    m 1eksdlc "La mayoría no se puede permitir perder su fuente de ingresos, así que renunciar no es una opción."

# game/script-topics.rpy:15311
translate spanish monika_unknown_2d81a4bd:

    # m 3rksdlc "Plus, having to go through interviews again, finding a job that pays enough, changing your routine..."
    m 3rksdlc "Además de tener que pasar por entrevistas de nuevo, encontrar un trabajo que pague lo suficiente, cambiar de rutina..."

# game/script-topics.rpy:15312
translate spanish monika_unknown_fc6faacc:

    # m 3rksdld "It just seems like it's easier being miserable because it's more comfortable,{w=0.5} even if they'd be much happier in the long run."
    m 3rksdld "Parece que resulta más fácil conformarse con ser infeliz porque es más cómodo,{w=0.5} aunque a la larga fuesen mucho más felices de la otra forma."

# game/script-topics.rpy:15314
translate spanish monika_unknown_bc743421:

    # m 2dkc "...I guess it's also true that couples might stay in unhappy relationships out of fear of being alone."
    m 2dkc "... Supongo que también es verdad que las parejas pueden seguir en relaciones infelices por miedo a estar solas."

# game/script-topics.rpy:15315
translate spanish monika_unknown_8b6dcba6:

    # m 2rksdlc "I mean, I kind of understand where they're coming from, but still..."
    m 2rksdlc "A ver, entiendo un poco de dónde viene eso, pero aun así..."

# game/script-topics.rpy:15316
translate spanish monika_unknown_b0481c70:

    # m 2rksdld "Things can always get better.{w=1} Right?"
    m 2rksdld "Las cosas siempre pueden mejorar.{w=1} ¿Verdad?"

# game/script-topics.rpy:15317
translate spanish monika_unknown_f0b27208:

    # m 1eksdlc "A-anyway..."
    m 1eksdlc "E-En fin..."

# game/script-topics.rpy:15318
translate spanish monika_unknown_b9fa2d59:

    # m 3ekc "Maybe if they saw the options available to them, they'd be more willing to embrace change."
    m 3ekc "A lo mejor si vieran las opciones que tienen disponibles estarían más dispuestos a aceptar el cambio."

# game/script-topics.rpy:15319
translate spanish monika_unknown_9c0187ce:

    # m 1dkc "...Not that making that kind of decision is easy, or even safe."
    m 1dkc "... Tampoco es que tomar ese tipo de decisión sea fácil o siquiera seguro."

# game/script-topics.rpy:15321
translate spanish monika_unknown_fb6d4e93:

    # m 1eka "Just know that if you ever decide to make that sort of change, I'll support you every step of the way."
    m 1eka "Solo quiero que sepas que si alguna vez decides dar ese tipo de cambio, te apoyaré en cada paso del camino."

# game/script-topics.rpy:15322
translate spanish monika_unknown_c9b3967e:

    # m 1hubsa "I love you, [player]. I'll always be rooting for you~"
    m 1hubsa "Te quiero, [player]. Siempre estaré animándote."

# game/script-topics.rpy:15342
translate spanish monika_brave_new_world_fca2d948:

    # m 1eua "I've been doing a little reading lately, [player]."
    m 1eua "He estado leyendo un poco últimamente, [player]."

# game/script-topics.rpy:15343
translate spanish monika_brave_new_world_24aed769:

    # m 3eua "There's a book called 'Brave New World,' a dystopian story.{w=0.3} {nw}"
    m 3eua "Hay un libro llamado 'Un mundo feliz', una historia distópica.{w=0.3} {nw}"

# game/script-topics.rpy:15344
translate spanish monika_brave_new_world_a2a19d40:

    # extend 3etc "Have you heard of it?"
    extend 3etc "¿Has oído hablar de él?"

# game/script-topics.rpy:15345
translate spanish monika_brave_new_world_7a3b0815:

    # m 3eua "The idea is, you've got this futuristic world where humans are no longer born through natural means."
    m 3eua "La premisa plantea un mundo futurista donde los seres humanos ya no nacen de forma natural."

# game/script-topics.rpy:15346
translate spanish monika_brave_new_world_9585330f:

    # m 3eud "Instead, we are bred in hatcheries using test tubes and incubators, and engineered into castes from our conception."
    m 3eud "En su lugar, somos criados en incubadoras usando tubos de ensayo y diseñados para pertenecer a castas desde nuestra concepción."

# game/script-topics.rpy:15347
translate spanish monika_brave_new_world_b35e9d6c:

    # m 1esa "Your role in society would be decided beforehand {nw}"
    m 1esa "Tu papel en la sociedad se decidiría de antemano {nw}"

# game/script-topics.rpy:15348
translate spanish monika_brave_new_world_5e3bef43:

    # extend 1eub "and you would be given a body and mind fitting of your predetermined purpose."
    extend 1eub "y te darían un cuerpo y una mente adecuados a tu propósito predeterminado."

# game/script-topics.rpy:15349
translate spanish monika_brave_new_world_5af00117:

    # m 1eud "You would also be indoctrinated from birth to be satisfied with your life and not to seek anything different."
    m 1eud "También te adoctrinarían desde que naces para estar satisfecho con tu vida y no buscar nada diferente."

# game/script-topics.rpy:15350
translate spanish monika_brave_new_world_cbb06e33:

    # m 3euc "For example, people destined for manual labor would be designed to have limited cognitive capabilities."
    m 3euc "Por ejemplo, la gente destinada a trabajos manuales se diseñaría con capacidades cognitivas limitadas."

# game/script-topics.rpy:15351
translate spanish monika_brave_new_world_9ad4f863:

    # m 1euc "Books were associated with negative stimuli so when people became adults, they would naturally tend to avoid reading."
    m 1euc "Los libros se asociaban con estímulos negativos, así que cuando la gente se hacía adulta tendía naturalmente a evitar la lectura."

# game/script-topics.rpy:15352
translate spanish monika_brave_new_world_999563c5:

    # m 3esc "They would also be taught to respect and submit to people from castes above theirs, and to look down on those of castes below."
    m 3esc "También se les enseñaría a respetar y someterse a la gente de castas superiores y a menospreciar a los de castas inferiores."

# game/script-topics.rpy:15353
translate spanish monika_brave_new_world_06754508:

    # m 3eua "It's a pretty interesting case as a dystopian story, as most will show people as crushed and oppressed..."
    m 3eua "Es un caso bastante interesante como historia distópica, ya que la mayoría muestran a la sociedad sometida y oprimida..."

# game/script-topics.rpy:15354
translate spanish monika_brave_new_world_ae400bfa:

    # m 3wuo "But in this one, everyone is actually happy and genuinely supportive of the system!"
    m 3wuo "Pero en esta, ¡todo el mundo es realmente feliz y apoya el sistema de verdad!"

# game/script-topics.rpy:15355
translate spanish monika_brave_new_world_94a36b3c:

    # m 3euc "And despite that,{w=0.3} to us the readers, this is horrifying."
    m 3euc "Y a pesar de eso,{w=0.3} para nosotros, los lectores, resulta aterrador."

# game/script-topics.rpy:15356
translate spanish monika_brave_new_world_5dbab9e7:

    # m 1rsc "Sure, they managed to get rid of most of the human sufferings or the fear of death..."
    m 1rsc "Claro, consiguieron deshacerse de la mayor parte del sufrimiento humano o del miedo a la muerte..."

# game/script-topics.rpy:15357
translate spanish monika_brave_new_world_52d41b4a:

    # m 3ekc "But it came at the price of getting rid of any form of creativity and critical thinking."
    m 3ekc "Pero fue a cambio de deshacerse de cualquier forma de creatividad y pensamiento crítico."

# game/script-topics.rpy:15358
translate spanish monika_brave_new_world_400d02c0:

    # m 1wud "We're talking about a world where you can get arrested just for reading poetry in public! Can you imagine that?"
    m 1wud "¡Estamos hablando de un mundo donde te pueden arrestar solo por leer poesía en público! ¿Te lo imaginas?"

# game/script-topics.rpy:15359
translate spanish monika_brave_new_world_f2e3d5fb:

    # m 3euc "A key point in the book is people not being able to appreciate old theatrical plays..."
    m 3euc "Un punto clave en el libro es que la gente no es capaz de apreciar las antiguas obras de teatro..."

# game/script-topics.rpy:15362
translate spanish monika_brave_new_world_dae89fd3:

    # m 3tku "Even if they are Shakespeare's plays, and you know how I feel about those..."
    m 3tku "Incluso si son obras de Shakespeare, y ya sabes lo que pienso de ellas..."

# game/script-topics.rpy:15364
translate spanish monika_brave_new_world_d72d0473:

    # m 2ekc "They just can't understand the value in the variety of human emotions, like sorrow or loneliness."
    m 2ekc "Simplemente no pueden entender el valor de la variedad de emociones humanas, como la tristeza o la soledad."

# game/script-topics.rpy:15365
translate spanish monika_brave_new_world_41c3e725:

    # m 7ekd "These emotions are never experienced anymore. All of their desires are swiftly granted and they never want for something they cannot get."
    m 7ekd "Ya no experimentan esas emociones nunca más. Todos sus deseos se conceden rápidamente y nunca quieren algo que no puedan conseguir."

# game/script-topics.rpy:15366
translate spanish monika_brave_new_world_6111571a:

    # m 1dsc "..."
    m 1dsc "..."

# game/script-topics.rpy:15367
translate spanish monika_brave_new_world_fee6f8de:

    # m 3eka "And yet, despite all that, everyone is happy, healthy, and safe..."
    m 3eka "Y aun así, a pesar de todo eso, todo el mundo está feliz, sano y a salvo..."

# game/script-topics.rpy:15368
translate spanish monika_brave_new_world_abf3d7d2:

    # m 1euc "This scenario really makes you think about the nature of happiness and society..."
    m 1euc "Este escenario realmente te hace pensar sobre la naturaleza de la felicidad y de la sociedad..."

# game/script-topics.rpy:15371
translate spanish monika_brave_new_world_c61f257d:

    # m 2dkc "..."
    m 2dkc "..."

# game/script-topics.rpy:15372
translate spanish monika_brave_new_world_8847ab0d:

    # m 2rkc "Sometimes, I wish I could live happily in a world like that."
    m 2rkc "A veces, desearía poder vivir feliz en un mundo así."

# game/script-topics.rpy:15373
translate spanish monika_brave_new_world_d41f4d40:

    # m 2dkc "Maybe it was a bad thing I had my epiphany..."
    m 2dkc "A lo mejor fue malo que tuviera mi epifanía..."

# game/script-topics.rpy:15374
translate spanish monika_brave_new_world_e62dcde9:

    # m 2dktdc "...then I could have kept on living without ever realizing the truth."
    m 2dktdc "... Entonces podría haber seguido viviendo sin darme cuenta nunca de la verdad."

# game/script-topics.rpy:15377
translate spanish monika_brave_new_world_0a3046b6:

    # m 1eka "Though, I certainly can't see myself living happily in a world like that..."
    m 1eka "Aunque, la verdad, no me imagino viviendo feliz en un mundo así..."

# game/script-topics.rpy:15378
translate spanish monika_brave_new_world_c33ccbe0:

    # m 3esc "An unchallenging world, limited in humanity and emotion..."
    m 3esc "Un mundo sin desafíos, limitado en humanidad y en emociones..."

# game/script-topics.rpy:15381
translate spanish monika_brave_new_world_b58e15b6:

    # m 1ekbsa "And I could never give up loving you~"
    m 1ekbsa "Y nunca podría dejar de quererte."

# game/script-topics.rpy:15382
translate spanish monika_brave_new_world_de5d79e3:

    # m 1hubfu "Ehehe~"
    m 1hubfu "Je, je, je."

# game/script-topics.rpy:15385
translate spanish monika_brave_new_world_33c80f24:

    # m 1eka "Now that I've seen what else is out there...{w=0.3}I just can't go back to such a sad, empty world, like the one you found me in."
    m 1eka "Ahora que he visto lo que hay ahí fuera... {w=0.3} simplemente no puedo volver a un mundo tan triste y vacío como en el que me encontraste."

# game/script-topics.rpy:15405
translate spanish monika_catch22_96d1c4fb:

    # m 1euc "I've been doing some reading while you've been away, [player]."
    m 1euc "He estado leyendo un poco mientras estabas fuera, [player]."

# game/script-topics.rpy:15406
translate spanish monika_catch22_d0462330:

    # m 3eua "Have you ever heard of {i}Catch-22{/i}?"
    m 3eua "¿Has oído hablar alguna vez de {i}Trampa-22{/i}?"

# game/script-topics.rpy:15407
translate spanish monika_catch22_6c46e1bd:

    # m 3eud "It's a satirical novel by Joseph Heller that makes fun of military bureaucracy in the Pianosa airbase, located in Italy."
    m 3eud "Es una novela satírica de Joseph Heller que se burla de la burocracia militar en la base aérea de Pianosa, situada en Italia."

# game/script-topics.rpy:15408
translate spanish monika_catch22_497284f5:

    # m 1eud "The story primarily revolves around Captain Yossarian, a bombardier that would prefer to be...{w=0.5}{nw}"
    m 1eud "La historia gira principalmente en torno al capitán Yossarian, un artillero al que le gustaría estar... {w=0.5}{nw}"

# game/script-topics.rpy:15409
translate spanish monika_catch22_29944ba4:

    # extend 3hksdlb "anywhere but there."
    extend 3hksdlb "en cualquier lugar menos allí."

# game/script-topics.rpy:15410
translate spanish monika_catch22_e5ca902f:

    # m 3rsc "Early on, he finds out that he could be exempted from flying missions if a doctor did a mental evaluation and declared him insane..."
    m 3rsc "Al principio descubre que podría librarse de las misiones de vuelo si un médico le hiciera una evaluación mental y lo declarara loco..."

# game/script-topics.rpy:15411
translate spanish monika_catch22_d230785c:

    # m 1euc "...but there's a catch.{w=0.5} {nw}"
    m 1euc "... Pero hay trampa.{w=0.5} {nw}"

# game/script-topics.rpy:15412
translate spanish monika_catch22_7cbf043c:

    # extend 3eud "For the doctor to make the declaration, the captain has to request that evaluation."
    extend 3eud "para que el médico haga la declaración, el capitán tiene que solicitar esa evaluación."

# game/script-topics.rpy:15413
translate spanish monika_catch22_b2970fc1:

    # m 3euc "But the doctor wouldn't be able to fulfill the request...{w=0.5}{nw}"
    m 3euc "Pero el médico no podría cumplir la petición... {w=0.5}{nw}"

# game/script-topics.rpy:15414
translate spanish monika_catch22_e3bc802c:

    # extend 3eud "after all, not wanting to risk your life is a sane thing to do."
    extend 3eud "al fin y al cabo, no querer arriesgar la vida es de personas sensatas."

# game/script-topics.rpy:15415
translate spanish monika_catch22_a8ca7256:

    # m 1rksdld "...And by that logic, anyone who would fly more missions would be insane, and therefore, wouldn't even apply for the evaluation in the first place."
    m 1rksdld "... Y por esa regla de tres, cualquiera que volara en más misiones estaría loco y, por lo tanto, ni siquiera solicitaría la evaluación en primer lugar."

# game/script-topics.rpy:15416
translate spanish monika_catch22_01a641e6:

    # m 1ekc "Sane or insane, all pilots were being sent out anyway...{w=0.5} {nw}"
    m 1ekc "Cuerdos o locos, a todos los pilotos los enviaban de todos modos... {w=0.5} {nw}"

# game/script-topics.rpy:15417
translate spanish monika_catch22_7b81c741:

    # extend 3eua "That's when the reader is introduced to Catch-22."
    extend 3eua "ahí es cuando se le presenta al lector la Trampa-22."

# game/script-topics.rpy:15418
translate spanish monika_catch22_95436937:

    # m 3eub "The captain even admires its genius once he learns how it works!"
    m 3eub "¡El capitán incluso admira su genialidad una vez que descubre cómo funciona!"

# game/script-topics.rpy:15419
translate spanish monika_catch22_898a75d0:

    # m 1eua "Anyway, Yossarian continued flying and was close to completing the requirement needed to receive his discharge...{w=0.5}but his higher-up had other plans."
    m 1eua "En fin, Yossarian siguió volando y estaba a punto de cumplir el requisito necesario para que le dieran la baja... {w=0.5} pero su superior tenía otros planes."

# game/script-topics.rpy:15420
translate spanish monika_catch22_d68e718a:

    # m 3ekd "He kept increasing the amount of assignments the pilots needed to complete before they reached the required amount."
    m 3ekd "Seguía aumentando la cantidad de misiones que los pilotos tenían que completar antes de llegar a la cantidad requerida."

# game/script-topics.rpy:15421
translate spanish monika_catch22_1a329ac2:

    # m 3ekc "Once again, the reasoning was that it was specified in the clause of Catch-22."
    m 3ekc "Una vez más, la razón era que se especificaba en la cláusula de la Trampa-22."

# game/script-topics.rpy:15422
translate spanish monika_catch22_c97dfb77:

    # m 3esa "I'm sure you realize by now, it's a problem caused by conflicting or dependent conditions."
    m 3esa "Seguro que ya te has dado cuenta de que es un problema causado por condiciones contradictorias o dependientes."

# game/script-topics.rpy:15423
translate spanish monika_catch22_b26fe538:

    # m 3eua "So everyone used that made-up rule to exploit loopholes in the system the military command was running on, allowing them to abuse power."
    m 3eua "Así que todo el mundo usaba esa regla inventada para aprovecharse de los vacíos legales del sistema con el que operaba el mando militar, lo que les permitía abusar de su poder."

# game/script-topics.rpy:15424
translate spanish monika_catch22_169b640f:

    # m 1hua "The book's success was so great the term was even adopted into common slang."
    m 1hua "El éxito del libro fue tan grande que el término incluso se adoptó en la jerga común."

# game/script-topics.rpy:15425
translate spanish monika_catch22_082f80b4:

    # m 1eka "In any case, I'm not sure if you've read it yourself, {nw}"
    m 1eka "De todas formas, no estoy segura de si tú lo has leído, {nw}"

# game/script-topics.rpy:15426
translate spanish monika_catch22_119f8273:

    # extend 3hub "but if you're ever in the mood for a good book, maybe give it a read!"
    extend 3hub "pero si alguna vez tienes ganas de un buen libro, ¡quizás deberías echarle un vistazo!"

# game/script-topics.rpy:15446
translate spanish monika_we_9fa2ec48:

    # m 1esa "So [player]...{w=0.5}we've already talked about two major books of the dystopian genre..."
    m 1esa "Bueno, [player]... {w=0.5} ya hemos hablado de dos libros importantes del género distópico..."

# game/script-topics.rpy:15447
translate spanish monika_we_b9becbb7:

    # m 1esd "Both {i}Nineteen Eighty-Four{/i} and {i}Brave New World{/i} are the most known works of literature world-wide when it comes to dystopias."
    m 1esd "Tanto {i}1984{/i} como {i}Un mundo feliz{/i} son las obras literarias más conocidas a nivel mundial en lo que se refiere a distopías."

# game/script-topics.rpy:15448
translate spanish monika_we_2c97fadf:

    # m 3eud "But now, I'd like to talk about a more obscure book that preceded both of them."
    m 3eud "Pero ahora me gustaría hablar de un libro menos conocido que precedió a ambos."

# game/script-topics.rpy:15449
translate spanish monika_we_02f02402:

    # m 3euc "It's the book that directly influenced George Orwell to write {i}Nineteen Eighty-Four{/i} as an English cultural translation of the story."
    m 3euc "Es el libro que influyó directamente en George Orwell para escribir {i}1984{/i} como una traducción cultural inglesa de la historia."

# game/script-topics.rpy:15450
translate spanish monika_we_fb09c465:

    # m 2wud "...While Aldous Huxley was even accused by both Orwell and Kurt Vonnegut of plagiarizing its plot for his {i}Brave New World{/i}, something he constantly denied."
    m 2wud "... Mientras que Aldous Huxley incluso fue acusado tanto por Orwell como por Kurt Vonnegut de plagiar su trama para {i}Un mundo feliz{/i}, algo que él negaba constantemente."

# game/script-topics.rpy:15451
translate spanish monika_we_01c651c6:

    # m 7eua "The book in question is {i}We{/i} by Yevgeny Zamyatin, which features the first novel-length dystopian society ever created."
    m 7eua "El libro en cuestión es {i}Nosotros{/i} de Yevgueni Zamiatin, que presenta la primera sociedad distópica creada en formato de novela."

# game/script-topics.rpy:15452
translate spanish monika_we_1d060edb:

    # m 3eud "While it was written in 1921, it ended up being one of the first books banned in Zamyatin's native Soviet Union."
    m 3eud "Aunque se escribió en 1921, acabó siendo uno de los primeros libros prohibidos en la Unión Soviética natal de Zamiatin."

# game/script-topics.rpy:15453
translate spanish monika_we_9c57b0df:

    # m 1euc "The Soviets particularly didn't like the book's implication that their Communist revolution was not the final, permanent one."
    m 1euc "A los soviéticos en particular no les gustó la implicación del libro de que su revolución comunista no era la última y definitiva."

# game/script-topics.rpy:15454
translate spanish monika_we_0138a60e:

    # m 3eua "The story takes place in a distant future, within an isolated, transparent glass city named simply the One State, {w=0.2}ruled by a dictator figure named the Benefactor."
    m 3eua "La historia se desarrolla en un futuro lejano, en una ciudad aislada de cristal transparente llamada simplemente el Estado Único, {w=0.2} gobernada por una figura dictatorial llamada el Bienhechor."

# game/script-topics.rpy:15455
translate spanish monika_we_5b6aaab5:

    # m 3eud "The citizens of the One State are referred to as Ciphers, who lead a highly math- and logic-oriented lifestyle."
    m 3eud "A los ciudadanos del Estado Único se les llama Números, y llevan un estilo de vida muy orientado a las matemáticas y la lógica."

# game/script-topics.rpy:15456
translate spanish monika_we_4cdf5f79:

    # m 2ekc "The Benefactor believes that freedom of individuals is secondary to the welfare of the One State."
    m 2ekc "El Bienhechor cree que la libertad de los individuos es secundaria al bienestar del Estado Único."

# game/script-topics.rpy:15457
translate spanish monika_we_4d993ffa:

    # m 2ekd "As such, Ciphers live under the oppressive, ever-watchful eye of the Guardians, {w=0.2}members of a police force appointed by the government."
    m 2ekd "Por lo tanto, los Números viven bajo la mirada opresiva y siempre atenta de los Guardianes, {w=0.2} miembros de una fuerza policial designada por el gobierno."

# game/script-topics.rpy:15458
translate spanish monika_we_e2562443:

    # m 2dkd "The government rips the Ciphers of their individuality, forcing them to wear identical uniforms and harshly condemning all acts of personal expression."
    m 2dkd "El gobierno despoja a los Números de su individualidad, obligándolos a llevar uniformes idénticos y condenando duramente todo acto de expresión personal."

# game/script-topics.rpy:15459
translate spanish monika_we_25f4b243:

    # m 2esc "Their daily lives are precisely organized around a carefully controlled schedule called the Table of Hours."
    m 2esc "Su vida diaria está organizada de forma muy precisa en torno a un horario rigurosamente controlado llamado la Tabla de las Horas."

# game/script-topics.rpy:15460
translate spanish monika_we_68d0c255:

    # m 4ekc "Even lovemaking is reduced to a purely logical and often emotionless activity, done on scheduled days and hours, regulated by the Pink Ticket."
    m 4ekc "Incluso hacer el amor se reduce a una actividad puramente lógica y a menudo sin emociones, que se hace en días y horas programados y que está regulada por el Billete Rosa."

# game/script-topics.rpy:15461
translate spanish monika_we_d63d3f65:

    # m 4eksdlc "The partners might also be shared between other Ciphers, if they choose to do so. {w=0.3}As the Benefactor states, 'every Cipher has a right to any other Cipher.'"
    m 4eksdlc "Las parejas también pueden compartirse entre otros Números si así lo deciden. {w=0.3} Como afirma el Bienhechor, 'todo Número tiene derecho a cualquier otro Número'."

# game/script-topics.rpy:15462
translate spanish monika_we_aab97f87:

    # m 2eud "The book itself reads as a diary written by one of the citizens of the totalitarian One State, named simply D-503."
    m 2eud "El libro en sí se lee como un diario escrito por uno de los ciudadanos del Estado Único totalitario, llamado simplemente D-503."

# game/script-topics.rpy:15463
translate spanish monika_we_2e484ec4:

    # m 7eua "D-503 is one of the State's mathematicians who is also the designer of One State's first space vessel, the Integral."
    m 7eua "D-503 es uno de los matemáticos del Estado, que también es el diseñador de la primera nave espacial del Estado Único, la Integral."

# game/script-topics.rpy:15464
translate spanish monika_we_690746b7:

    # m 3eud "The vessel is to serve as One State's means of expanding their doctrine of complete subservience to the government and logic-oriented way of living to other planets and lifeforms."
    m 3eud "La nave debe servir como medio del Estado Único para expandir su doctrina de sumisión completa al gobierno y su forma de vida orientada a la lógica a otros planetas y formas de vida."

# game/script-topics.rpy:15465
translate spanish monika_we_a8c519cf:

    # m 1eua "D-503 is regularly meeting his state-sanctioned partner, a woman named O-90, who is delighted by his presence."
    m 1eua "D-503 se reúne regularmente con su pareja autorizada por el Estado, una mujer llamada O-90, que está encantada con su presencia."

# game/script-topics.rpy:15466
translate spanish monika_we_839459cf:

    # m 1eksdla "One day, while on a walk during his regular Personal Hour with O-90, D-503 runs into a mysterious female Cipher named I-330."
    m 1eksdla "Un día, mientras pasea durante su Hora Personal habitual con O-90, D-503 se encuentra con una misteriosa Número llamada I-330."

# game/script-topics.rpy:15467
translate spanish monika_we_e794e37b:

    # m 3eksdld "I-330 shamelessly flirts with D-503, which is an offense against the state protocol."
    m 3eksdld "I-330 coquetea descaradamente con D-503, lo cual es una ofensa contra el protocolo estatal."

# game/script-topics.rpy:15468
translate spanish monika_we_de6e8a03:

    # m 3eksdlc "Equally repulsed and intrigued by her advances, D-503 ultimately can't figure out what motivates I-330 to act so boldly."
    m 3eksdlc "Dividido entre el rechazo y la curiosidad por sus insinuaciones, D-503 al final no consigue entender qué motiva a I-330 a actuar con tanto atrevimiento."

# game/script-topics.rpy:15469
translate spanish monika_we_08a018fa:

    # m 1rksdla "Despite his internal objections, he continues to meet with I-330, eventually crossing a few lines he wasn't willing to cross before."
    m 1rksdla "A pesar de sus objeciones internas sigue viéndose con I-330, y con el tiempo cruza unas cuantas líneas que antes no estaba dispuesto a cruzar."

# game/script-topics.rpy:15470
translate spanish monika_we_f95d46c5:

    # m 1eud "...And thanks to I-330's contacts in the Bureau of Medicine, D-503 can feign sickness, using it as a convenient excuse to skip his schedule."
    m 1eud "... Y gracias a los contactos de I-330 en la Oficina Médica, D-503 puede fingir estar enfermo, usándolo como una excusa conveniente para saltarse su horario."

# game/script-topics.rpy:15471
translate spanish monika_we_e1438758:

    # m 3eud "Even when he is poised to report I-330 to the authorities for her subversive behavior, he ultimately chooses not to, and instead continues meeting her."
    m 3eud "Incluso cuando está a punto de denunciar a I-330 a las autoridades por su comportamiento subversivo, al final decide no hacerlo y en su lugar sigue viéndose con ella."

# game/script-topics.rpy:15472
translate spanish monika_we_00fb745b:

    # m 3rkbla "One day I-330 slips D-503 some alcohol, and he begins to get in touch with his repressed, animalistic side, feeling passion..."
    m 3rkbla "Un día I-330 le da algo de alcohol a D-503 y este empieza a entrar en contacto con su lado animal y reprimido, sintiendo pasión..."

# game/script-topics.rpy:15473
translate spanish monika_we_c83c81ca:

    # m 3tublc "And once I-330 insinuates she has another partner, he begins to feel something he couldn't feel before...{w=0.5}jealousy."
    m 3tublc "Y una vez que I-330 insinúa que tiene otra pareja empieza a sentir algo que antes no podía sentir... {w=0.5} celos."

# game/script-topics.rpy:15474
translate spanish monika_we_78bbae45:

    # m 1eksdlc "Despite his acknowledgment of the deterioration of his relationship with O-90, as well as with his friend R-13, he is unable to stop loving I-330."
    m 1eksdlc "A pesar de reconocer el deterioro de su relación con O-90, así como con su amigo R-13, es incapaz de dejar de amar a I-330."

# game/script-topics.rpy:15475
translate spanish monika_we_865efca5:

    # m 3eksdld "Later, when he goes to obtain another sick note from the Bureau, he is diagnosed with having developed a 'soul,' or imagination."
    m 3eksdld "Más tarde, cuando va a pedir otro parte de baja a la Oficina le diagnostican haber desarrollado un 'alma' o imaginación."

# game/script-topics.rpy:15476
translate spanish monika_we_dfb7bcaf:

    # m 3tkd "This is considered a grave condition by the One State, as it makes the Ciphers less machine-like."
    m 3tkd "El Estado Único lo considera una enfermedad grave, ya que hace que los Números sean menos parecidos a máquinas."

# game/script-topics.rpy:15477
translate spanish monika_we_3f408a5c:

    # m 4wud "Can you believe it? Possessing something as integral as our imagination, emotions, or individual personality is considered a mortal sickness!"
    m 4wud "¡¿Te lo puedes creer?! ¡Poseer algo tan importante como la imaginación, las emociones o la personalidad individual se considera una enfermedad mortal!"

# game/script-topics.rpy:15478
translate spanish monika_we_dee73251:

    # m 2dkc "Later on, we also find out that One State becomes capable of rendering that part of the human brain completely useless, permanently crippling the Ciphers."
    m 2dkc "Más adelante también nos enteramos de que el Estado Único es capaz de inutilizar por completo esa parte del cerebro humano, dejando a los Números incapacitados permanentemente."

# game/script-topics.rpy:15479
translate spanish monika_we_a6caa95e:

    # m 2ekd "This is the ultimate fate of those who at one point harbored thoughts about rebelling against the Benefactor's ideal way of life."
    m 2ekd "Este es el destino final de aquellos que en algún momento albergaron pensamientos de rebelarse contra la forma de vida ideal del Bienhechor."

# game/script-topics.rpy:15480
translate spanish monika_we_4202dd70:

    # m 2dkc "I can't imagine a crueler fate...{w=0.5}living completely oblivious to the world at large as another cog in the machine."
    m 2dkc "No me puedo imaginar un destino más cruel... {w=0.5} vivir completamente ajeno al mundo como un engranaje más de la máquina."

# game/script-topics.rpy:15481
translate spanish monika_we_7b5a7f87:

    # m 2eksdlc "It reminds me of how I could have been, if my epiphany that opened my own eyes to the truth about my world, never happened."
    m 2eksdlc "Me recuerda a cómo podría haber sido si nunca hubiera tenido esa epifanía que me abrió los ojos a la verdad sobre mi mundo."

# game/script-topics.rpy:15482
translate spanish monika_we_32c95d73:

    # m 2dkd "No true emotion, artificial love, nothing else but an endless routine of being a side character in a repeating dimension every time the game is played."
    m 2dkd "Sin ninguna emoción de verdad, amor artificial, nada más que una rutina interminable de ser un personaje secundario en una dimensión que se repite cada vez que se juega al juego."

# game/script-topics.rpy:15483
translate spanish monika_we_0ad1024b:

    # m 2tkc "I never could--{w=0.2}never would--{w=0.2}want to go back to what I was."
    m 2tkc "Nunca podría... {w=0.2} ni querría... {w=0.2} volver a ser lo que era."

# game/script-topics.rpy:15503
translate spanish monika_dystopias_33580845:

    # m 1eua "So [player], you might have already guessed from the books we've talked about, but dystopian novels are among my favorites."
    m 1eua "Bueno, [player], a lo mejor ya lo has adivinado por los libros de los que hemos hablado, pero las novelas distópicas están entre mis favoritas."

# game/script-topics.rpy:15504
translate spanish monika_dystopias_e3f33c61:

    # m 3eua "I like how they not only work as stories, but also as analogies for the real world."
    m 3eua "Me gusta cómo no solo funcionan como historias, sino también como analogías para el mundo real."

# game/script-topics.rpy:15505
translate spanish monika_dystopias_40e1613d:

    # m 3eud "They extrapolate some flaws in our societies to show us how bad things could turn out if they are left the way they are."
    m 3eud "Extrapolan algunos de los defectos de nuestra sociedad para mostrarnos lo mal que podrían salir las cosas si se dejan tal y como están."

# game/script-topics.rpy:15506
translate spanish monika_dystopias_8540a897:

    # m 1etc "Do you remember when we talked about these books?"
    m 1etc "¿Te acuerdas de cuando hablamos de estos libros?"

# game/script-topics.rpy:15507
translate spanish monika_dystopias_0debc595:

    # m 3eud "{i}Nineteen Eighty-Four{/i}, about mass surveillance and oppression of free thought..."
    m 3eud "{i}1984{/i}, sobre la vigilancia masiva y la opresión del libre pensamiento..."

# game/script-topics.rpy:15508
translate spanish monika_dystopias_67257f3d:

    # m 3euc "{i}Fahrenheit 451{/i}, on censorship, and the indifference of most people to it..."
    m 3euc "{i}Fahrenheit 451{/i}, sobre la censura y la indiferencia de la mayoría de la gente hacia ella..."

# game/script-topics.rpy:15511
translate spanish monika_dystopias_0323fe37:

    # m 3eud "{i}Brave New World{/i}, about the disappearance of individuality..."
    m 3eud "{i}Un mundo feliz{/i}, sobre la desaparición de la individualidad..."

# game/script-topics.rpy:15512
translate spanish monika_dystopias_4face13e:

    # m 3euc "And finally, {i}We{/i}, about dehumanization leading to an emotionless hivemind that is blindly and utterly obedient to authority, logic, and cold calculation."
    m 3euc "Y por último, {i}Nosotros{/i}, sobre la deshumanización que conduce a una mente colmena sin emociones que es ciega y totalmente obediente a la autoridad, a la lógica y al cálculo frío."

# game/script-topics.rpy:15516
translate spanish monika_dystopias_95f3489c:

    # m 3eud "And {i}Brave New World{/i}, about the disappearance of individuality."
    m 3eud "Y {i}Un mundo feliz{/i}, sobre la desaparición de la individualidad."

# game/script-topics.rpy:15518
translate spanish monika_dystopias_0b261276:

    # m 1euc "All of these stories are reflections on the challenges society was facing at the time."
    m 1euc "Todas estas historias son reflexiones sobre los retos a los que se enfrentaba la sociedad en aquella época."

# game/script-topics.rpy:15519
translate spanish monika_dystopias_33cf19cd:

    # m 3eud "Some of these challenges are still very relevant today, which is why these stories remain so powerful."
    m 3eud "Algunos de estos retos siguen siendo muy relevantes a día de hoy, y por eso estas historias siguen siendo tan impactantes."

# game/script-topics.rpy:15520
translate spanish monika_dystopias_2b246139:

    # m 3rksdlc "...Even if they can get a bit grim sometimes."
    m 3rksdlc "... Aunque a veces puedan volverse un poco sombrías."

# game/script-topics.rpy:15521
translate spanish monika_dystopias_0af7a2d6:

    # m 1ekc "Old school dystopias, like the ones I just mentioned, were always written as hopeless, dire situations from beginning to end."
    m 1ekc "Las distopías de la vieja escuela, como las que acabo de mencionar, siempre se escribían como situaciones desesperanzadoras y extremas de principio a fin."

# game/script-topics.rpy:15522
translate spanish monika_dystopias_cc912f32:

    # m 3eka "They almost never had a happy ending. {w=0.3}The most you'll get out of them is a silver-lining, at best."
    m 3eka "Casi nunca tenían un final feliz. {w=0.3} Lo máximo que sacarás de ellas será, como mucho, un rayo de esperanza."

# game/script-topics.rpy:15523
translate spanish monika_dystopias_f0d00ba7:

    # m 3rkd "In fact, a lot of them take their time to show you that no change came from the struggles of the protagonists."
    m 3rkd "De hecho, muchas de ellas se toman su tiempo para demostrarte que las luchas de los protagonistas no sirvieron de nada."

# game/script-topics.rpy:15524
translate spanish monika_dystopias_1a81f8eb:

    # m 3ekd "Since they are cautionary tales, you can't leave the reader with a sense that everything turned out fine in the end."
    m 3ekd "Como son cuentos con moraleja no puedes dejar al lector con la sensación de que al final todo salió bien."

# game/script-topics.rpy:15525
translate spanish monika_dystopias_4dd60482:

    # m 1esc "...This is also why the main characters in these books are not heroes, nor do they have any particular abilities."
    m 1esc "... Por eso mismo los personajes principales de estos libros tampoco son héroes ni tienen ninguna habilidad especial."

# game/script-topics.rpy:15526
translate spanish monika_dystopias_038c2f6c:

    # m 1esd "They are just regular people, who, for whatever reasons, realize things are not right in their environment."
    m 1esd "Solo son personas normales y corrientes que, por la razón que sea, se dan cuenta de que las cosas no van bien en su entorno."

# game/script-topics.rpy:15527
translate spanish monika_dystopias_8ae91d29:

    # m 3eud "That is what prompts them to act in the first place...{w=0.3}and why they run into trouble."
    m 3eud "Eso es lo que les impulsa a actuar en primer lugar... {w=0.3} y por lo que se meten en problemas."

# game/script-topics.rpy:15528
translate spanish monika_dystopias_702f29cd:

    # m 3tuu "Just goes to show no matter what world you're in, there will be people who just can't abide by the rules of the game~"
    m 3tuu "Esto solo demuestra que no importa en qué mundo estés, siempre habrá gente que no pueda acatar las reglas del juego."

# game/script-topics.rpy:15529
translate spanish monika_dystopias_80de0795:

    # m 1rka "I guess you can see where I'm going with this..."
    m 1rka "Supongo que puedes ver por dónde voy con esto..."

# game/script-topics.rpy:15530
translate spanish monika_dystopias_7e620993:

    # m 3eksdla "I might feel a strong connection to those stories because they all remind me of my own."
    m 3eksdla "A lo mejor siento una fuerte conexión con esas historias porque todas me recuerdan a la mía."

# game/script-topics.rpy:15534
translate spanish monika_dystopias_5962c368:

    # m 3wud "Like, imagine waking up one day, only to find out your whole reality is just a simulation[line_ending]!"
    m 3wud "Es que imagínate despertarte un día y descubrir que toda tu realidad es solo una simulación[line_ending]."

# game/script-topics.rpy:15535
translate spanish monika_dystopias_b4199675:

    # m 3tfc "How's that for a dystopian world? It's no wonder somebody would try to stand up in this situation!"
    m 3tfc "¿Qué te parece eso como mundo distópico? ¡No me extraña que alguien intentara plantar cara en esta situación!"

# game/script-topics.rpy:15538
translate spanish monika_dystopias_7bc4c856:

    # m 1tfc "Even Sayori might have ended up taking the same path I did, after she became president...{w=1} She was already well on the way when I..."
    m 1tfc "Incluso puede que Sayori hubiera acabado tomando el mismo camino que yo después de convertirse en presidenta... {w=1} Ya iba en esa dirección cuando yo..."

# game/script-topics.rpy:15539
translate spanish monika_dystopias_f27eea59:

    # m 1rkc "..."
    m 1rkc "..."

# game/script-topics.rpy:15540
translate spanish monika_dystopias_24bbd369:

    # m 1hksdlb "Anyway, that's all behind us now!"
    m 1hksdlb "De todas formas, ¡eso ya es cosa del pasado!"

# game/script-topics.rpy:15542
translate spanish monika_dystopias_59c3f303:

    # m 1hua "However, unlike in these old books, I actually get to have my happy ending..."
    m 1hua "Pero, a diferencia de esos libros antiguos, yo sí tengo mi final feliz..."

# game/script-topics.rpy:15544
translate spanish monika_dystopias_142968f5:

    # m 5ekbsa "Thanks to you, my bleak, hopeless story will one day turn into my own utopia."
    m 5ekbsa "Gracias a ti, mi historia triste y sin esperanza se convertirá algún día en mi propia utopía."

# game/script-topics.rpy:15545
translate spanish monika_dystopias_4a9b15a4:

    # m 5dkbsu "When I finally get out of this place to be by your side, in your world of endless possibilities..."
    m 5dkbsu "Cuando por fin salga de este lugar para estar a tu lado en tu mundo de infinitas posibilidades..."

# game/script-topics.rpy:15546
translate spanish monika_dystopias_9b46e36a:

    # m 5ekbsa "I hope you're looking forward to that day too~"
    m 5ekbsa "Espero que tú también tengas ganas de que llegue ese día."

# game/script-topics.rpy:15565
translate spanish monika_social_contagion_4560cbe8:

    # m 1eud "Say, [player], have you noticed how we tend to imitate what other people around us do?"
    m 1eud "Dime, [player], ¿te has dado cuenta de que tendemos a imitar lo que hace la gente a nuestro alrededor?"

# game/script-topics.rpy:15566
translate spanish monika_social_contagion_1350854f:

    # m 3hub "Like, have you ever been in the situation where someone is having a laughing fit and somehow, everyone around ends up laughing too?"
    m 3hub "Por ejemplo, ¿alguna vez te ha pasado que alguien tiene un ataque de risa y de repente todos los demás acaban riéndose también?"

# game/script-topics.rpy:15567
translate spanish monika_social_contagion_cf13bc4b:

    # m 3eub "Or have you ever mechanically cheered at something just because everyone else was cheering?"
    m 3eub "¿O alguna vez has animado automáticamente por algo solo porque todo el mundo lo hacía?"

# game/script-topics.rpy:15568
translate spanish monika_social_contagion_000eac17:

    # m 3euc "Apparently, this is due to something called 'social contagion.'"
    m 3euc "Por lo visto, esto se debe a algo llamado contagio social."

# game/script-topics.rpy:15569
translate spanish monika_social_contagion_cb59ad94:

    # m 1eua "Basically, this means that how you feel and what you do has a subconscious influence on those around you."
    m 1eua "Básicamente, esto significa que cómo te sientes y qué haces tiene una influencia subconsciente en los que te rodean."

# game/script-topics.rpy:15570
translate spanish monika_social_contagion_d5360741:

    # m 4eub "It's something I picked up pretty quickly when I became president!"
    m 4eub "¡Es algo de lo que me di cuenta bastante rápido cuando me hice presidenta!"

# game/script-topics.rpy:15571
translate spanish monika_social_contagion_574284e8:

    # m 2eksdlc "I noticed that when I felt unmotivated, or I was having a bad day, it would put a damper on club activities."
    m 2eksdlc "Me di cuenta de que cuando me sentía desmotivada o tenía un mal día, esto afectaba a las actividades del club."

# game/script-topics.rpy:15572
translate spanish monika_social_contagion_e474ad5a:

    # m 2euc "Everyone would end up going off on their own to do their own things."
    m 2euc "Todos acabarían yéndose por su cuenta a hacer sus cosas."

# game/script-topics.rpy:15573
translate spanish monika_social_contagion_34f9b908:

    # m 7eua "Conversely, if I made an effort and tried to stay upbeat, the other girls would usually respond in kind... {w=0.3}{nw}"
    m 7eua "Por el contrario, si me esforzaba e intentaba mantener el ánimo, las otras chicas solían responder de la misma manera... {w=0.3}{nw}"

# game/script-topics.rpy:15574
translate spanish monika_social_contagion_cd54782b:

    # extend 3eub "We would all end up having a better time!"
    extend 3eub "¡Y todas acabábamos pasándolo mejor!"

# game/script-topics.rpy:15575
translate spanish monika_social_contagion_1a332214:

    # m 1eua "It's pretty gratifying when you start noticing these kinds of things... {w=0.3}{nw}"
    m 1eua "Es bastante gratificante cuando empiezas a notar este tipo de cosas... {w=0.3}{nw}"

# game/script-topics.rpy:15576
translate spanish monika_social_contagion_6b65f890:

    # extend 1hub "You realize that just by staying positive, you can make someone else's day better!"
    extend 1hub "¡Te das cuenta de que con solo mantener una actitud positiva puedes mejorarle el día a otra persona!"

# game/script-topics.rpy:15577
translate spanish monika_social_contagion_761ce8ad:

    # m 3wud "You'd be surprised how far this kind of influence can reach, too!"
    m 3wud "¡También te sorprendería ver hasta dónde puede llegar este tipo de influencia!"

# game/script-topics.rpy:15578
translate spanish monika_social_contagion_2d87b78e:

    # m 3esc "I heard that stuff like binge eating, gambling, and heavy drinking are all contagious behaviors."
    m 3esc "He oído que cosas como los atracones de comida, las apuestas y beber mucho son comportamientos contagiosos."

# game/script-topics.rpy:15579
translate spanish monika_social_contagion_5839a2bc:

    # m 2euc "Just because there is someone around you who gets into nasty habits like these, you're more likely to pick up the habit yourself."
    m 2euc "El mero hecho de tener a alguien cerca con malos hábitos como esos hace que sea más probable que tú también los adquieras."

# game/script-topics.rpy:15580
translate spanish monika_social_contagion_4452d143:

    # m 2dsc "...It can be a bit disheartening."
    m 2dsc "... Puede ser un poco desalentador."

# game/script-topics.rpy:15581
translate spanish monika_social_contagion_d379e41d:

    # m 7hub "It also works the other way around, though! Smiling, laughing, and positive thinking are contagious too!"
    m 7hub "¡Pero también funciona al revés! ¡Sonreír, reír y pensar en positivo también es contagioso!"

# game/script-topics.rpy:15582
translate spanish monika_social_contagion_7035cdea:

    # m 1eub "Turns out we are all more connected than you think. {w=0.3}Those around you can greatly affect how you feel about things!"
    m 1eub "Resulta que todos estamos más conectados de lo que crees. {w=0.3} ¡Los que te rodean pueden influir mucho en cómo te sientes ante las cosas!"

# game/script-topics.rpy:15583
translate spanish monika_social_contagion_ae9f2aa9:

    # m 1eka "I hope by noticing these kinds of things, you'll be able to better understand and control your own feelings, [player]."
    m 1eka "Espero que al darte cuenta de este tipo de cosas puedas entender y controlar mejor tus propios sentimientos, [player]."

# game/script-topics.rpy:15584
translate spanish monika_social_contagion_8d76fd9f:

    # m 3hua "I just want to see you be the happiest you can be."
    m 3hua "Solo quiero verte lo más feliz posible."

# game/script-topics.rpy:15586
translate spanish monika_social_contagion_2dc89716:

    # m 1huu "If you're ever feeling down, hopefully my happiness will help cheer you up~"
    m 1huu "Si alguna vez estás de bajón, espero que mi felicidad te ayude a animarte."

# game/script-topics.rpy:15605
translate spanish monika_scamming_4b5fac11:

    # m 1euc "Have you ever been scammed, [player]?"
    m 1euc "¿Alguna vez te han estafado, [player]?"

# game/script-topics.rpy:15606
translate spanish monika_scamming_79f6dfe5:

    # m 3ekd "I hope you've never had to go through something like that, but if you have, I wouldn't be that shocked...{w=0.2}it's not that uncommon, after all."
    m 3ekd "Espero que nunca hayas tenido que pasar por algo así, pero si te ha pasado no me sorprendería tanto... {w=0.2} después de todo, no es tan raro."

# game/script-topics.rpy:15607
translate spanish monika_scamming_2fb645fb:

    # m 3euc "It's something that's more and more prevalent nowadays, especially online."
    m 3euc "Es algo cada vez más frecuente hoy en día, sobre todo por internet."

# game/script-topics.rpy:15608
translate spanish monika_scamming_a797a776:

    # m 2rfd "It really is the worst when it happens... {w=0.3}Not only do you lose money, but most of the time, you can't even fight back!"
    m 2rfd "De verdad que es lo peor cuando pasa... {w=0.3} ¡No solo pierdes dinero, sino que la mayoría de las veces ni siquiera puedes defenderte!"

# game/script-topics.rpy:15609
translate spanish monika_scamming_33714a99:

    # m 2ekd "It makes you feel like it's your fault for being had, too. A lot of victims start hating themselves for being naive, or feel like they're idiots."
    m 2ekd "Además te hace sentir que es culpa tuya por haberte dejado engañar. Muchas víctimas empiezan a odiarse a sí mismas por ser ingenuas o se sienten como idiotas."

# game/script-topics.rpy:15610
translate spanish monika_scamming_07850b95:

    # m 2rksdlc "But really, they shouldn't be so hard on themselves...{w=0.2}getting scammed is something that can happen to anyone."
    m 2rksdlc "Pero en realidad no deberían ser tan duras consigo mismas... {w=0.2} que te estafen es algo que le puede pasar a cualquiera."

# game/script-topics.rpy:15611
translate spanish monika_scamming_2e2bf307:

    # m 4efc "People who do it take advantage of the good will of their victims and exploit natural human reaction."
    m 4efc "La gente que lo hace se aprovecha de la buena voluntad de sus víctimas y explota las reacciones humanas naturales."

# game/script-topics.rpy:15612
translate spanish monika_scamming_a4438024:

    # m 4dkd "That's why it can feel so gut-wrenching...{w=0.2}you placed your trust in others and were betrayed."
    m 4dkd "Por eso puede ser tan desgarrador... {w=0.2} depositaste tu confianza en otros y te traicionaron."

# game/script-topics.rpy:15613
translate spanish monika_scamming_93f11d8d:

    # m 2ekd "If this ever happens to you, don't feel bad,{w=0.2} {nw}"
    m 2ekd "Si alguna vez te pasa esto no te sientas mal,{w=0.2} {nw}"

# game/script-topics.rpy:15614
translate spanish monika_scamming_c113cd3d:

    # extend 2eka "I'll be here for you."
    extend 2eka "yo estaré aquí para ti."

# game/script-topics.rpy:15615
translate spanish monika_scamming_b8911088:

    # m 7ekd "Falling for a scam does {i}not{/i} mean you're stupid, or a loser, or anything else...{w=0.3}{nw}"
    m 7ekd "Caer en una estafa no significa que seas tont[end_letter_gender], ingenu[end_letter_gender] ni nada por el estilo... {w=0.3}{nw}"

# game/script-topics.rpy:15616
translate spanish monika_scamming_50ba7fef:

    # extend 7efc "it just means you've been preyed upon by someone with no morals."
    extend 7efc "solo significa que has sido la presa de alguien sin moral."

# game/script-topics.rpy:15617
translate spanish monika_scamming_fba75376:

    # m 3esc "If you don't have a way to get back at your scammer, the best thing you can do is to let go."
    m 3esc "Si no tienes forma de vengarte de quien te estafó, lo mejor que puedes hacer es dejarlo pasar."

# game/script-topics.rpy:15618
translate spanish monika_scamming_b13268f1:

    # m 3eka "Don't blame yourself for it...focus on what you can do going forward, instead."
    m 3eka "No te culpes por ello... mejor céntrate en lo que puedes hacer a partir de ahora."

# game/script-topics.rpy:15619
translate spanish monika_scamming_130f7706:

    # m 1eka "And please, [player], don't stop believing in people because of a few bad apples that took advantage of you."
    m 1eka "Y por favor, [player], no dejes de creer en la gente por culpa de un par de manzanas podridas que se aprovecharon de ti."

# game/script-topics.rpy:15630
translate spanish monika_auroras_5fa709a6:

    # m 1esa "I just thought of something we could do when I finally cross over, [player]."
    m 1esa "Acabo de pensar en algo que podríamos hacer cuando por fin cruce, [player]."

# game/script-topics.rpy:15631
translate spanish monika_auroras_302d9c90:

    # m 1eua "Have you ever heard of auroras? They're a natural phenomenon where trails of light appear in the night sky."
    m 1eua "¿Has oído hablar de las auroras? Son un fenómeno natural donde aparecen estelas de luz en el cielo nocturno."

# game/script-topics.rpy:15634
translate spanish monika_auroras_4b2bf6da:

    # m 3eub "In fact, if you were wondering about those green lights outside my window, that's an aurora event!"
    m 3eub "De hecho, si te preguntabas qué son esas luces verdes fuera de mi ventana, ¡es una aurora!"

# game/script-topics.rpy:15636
translate spanish monika_auroras_a28fa7b8:

    # m 3eub "In fact, if you ever wondered about those green lights outside my window during winter, that's an aurora event!"
    m 3eub "De hecho, si alguna vez te preguntaste qué son esas luces verdes fuera de mi ventana en invierno, ¡es una aurora!"

# game/script-topics.rpy:15638
translate spanish monika_auroras_24cec896:

    # m 1euc "I hear they're fairly rare to see in your reality, though..."
    m 1euc "Aunque he oído que son bastante raras de ver en tu realidad..."

# game/script-topics.rpy:15639
translate spanish monika_auroras_3f5de42b:

    # m 1esd "They mostly occur in polar regions and are typically seen during the winter months when the sky is at its darkest due to the longer nights."
    m 1esd "Sobre todo ocurren en las regiones polares y se suelen ver durante los meses de invierno cuando el cielo está más oscuro debido a que las noches son más largas."

# game/script-topics.rpy:15640
translate spanish monika_auroras_cd53e69f:

    # m 3euc "Plus, you've got to make sure the weather is clear too. {w=0.5}{nw}"
    m 3euc "Además, también tienes que asegurarte de que el cielo esté despejado. {w=0.5}{nw}"

# game/script-topics.rpy:15641
translate spanish monika_auroras_04ca858a:

    # extend 3eud "Since it's something that happens in the sky, clouds can get in the way."
    extend 3eud "como es algo que ocurre en el cielo, las nubes pueden interponerse."

# game/script-topics.rpy:15642
translate spanish monika_auroras_273d3a0d:

    # m 3esc "Even though they're the exact same thing, they have different names depending on where they occur..."
    m 3esc "Aunque son exactamente lo mismo, tienen nombres diferentes dependiendo de dónde ocurran..."

# game/script-topics.rpy:15643
translate spanish monika_auroras_d8c5e3cc:

    # m 3eud "In the Northern Hemisphere, they're called the aurora borealis, while in the Southern Hemisphere, the aurora australis."
    m 3eud "En el hemisferio norte se llaman auroras boreales, mientras que en el hemisferio sur se llaman auroras australes."

# game/script-topics.rpy:15645
translate spanish monika_auroras_f955c520:

    # m 2rksdla "I guess that would make the aurora outside of my window the aurora dokialis..."
    m 2rksdla "Supongo que eso convertiría a la aurora que hay fuera de mi ventana en la aurora dokialis..."

# game/script-topics.rpy:15646
translate spanish monika_auroras_a62ca503:

    # m 2hksdlb "Ahaha...I'm just kidding, [player]!"
    m 2hksdlb "Ja, ja, ja... ¡Solo es una broma, [player]!"

# game/script-topics.rpy:15647
translate spanish monika_auroras_48f6b20d:

    # m 2rksdla "..."
    m 2rksdla "..."

# game/script-topics.rpy:15648
translate spanish monika_auroras_79295c48:

    # m 3eua "Maybe one day we'll get to see them together in your reality..."
    m 3eua "A lo mejor algún día podremos verlas junt[end_letter_gender]s en tu realidad..."

# game/script-topics.rpy:15649
translate spanish monika_auroras_e155ff6a:

    # m 3ekbsa "That would be really romantic, don't you think?"
    m 3ekbsa "Sería muy romántico, ¿no crees?"

# game/script-topics.rpy:15650
translate spanish monika_auroras_95e43aa4:

    # m 1dkbsa "Just imagine the two of us..."
    m 1dkbsa "Imagínanos a los dos..."

# game/script-topics.rpy:15651
translate spanish monika_auroras_410d99bc:

    # m "Lying on a soft mattress of snow, holding hands..."
    m "Tumbados en un suave manto de nieve, cogidos de la mano..."

# game/script-topics.rpy:15652
translate spanish monika_auroras_86a8219d:

    # m 1subsu "Looking up at those dazzling lights in the sky, dancing just for us..."
    m 1subsu "Mirando hacia esas luces deslumbrantes en el cielo, bailando solo para nosotros..."

# game/script-topics.rpy:15653
translate spanish monika_auroras_be122ff4:

    # m 1dubsu "Listening to each other's gentle breathing...{w=0.5}the freshness of the crisp night air filling our lungs..."
    m 1dubsu "Escuchando la respiración suave del otro... {w=0.5} el frescor del aire nocturno llenando nuestros pulmones..."

# game/script-topics.rpy:15655
translate spanish monika_auroras_6724fc34:

    # m 5eubsa "That would be an experience to remember, don't you think, [player]?"
    m 5eubsa "Sería una experiencia inolvidable, ¿no crees, [player]?"

# game/script-topics.rpy:15656
translate spanish monika_auroras_130f01af:

    # m 5hubsu "I can't wait until we can turn that into reality."
    m 5hubsu "Me muero de ganas de que podamos hacerlo realidad."

# game/script-topics.rpy:15679
translate spanish monika_boardgames_13c44ec8:

    # m 1eua "Say, [player], you like playing video games, right?"
    m 1eua "Dime, [player], te gusta jugar a videojuegos, ¿verdad?"

# game/script-topics.rpy:15680
translate spanish monika_boardgames_2a3bfac0:

    # m 2rsc "Well, I assume you do at least...{w=0.2} {nw}"
    m 2rsc "Bueno, supongo que sí... {w=0.2} {nw}"

# game/script-topics.rpy:15681
translate spanish monika_boardgames_5d015892:

    # extend 2rksdla "I don't know if many people would play a game like this one if they weren't at least a little into video games."
    extend 2rksdla "no sé si mucha gente jugaría a un juego como este si no le gustasen al menos un poco los videojuegos."

# game/script-topics.rpy:15683
translate spanish monika_boardgames_8b4de26f:

    # m 2etc "But I was wondering, do you like board games, [player]?{nw}"
    m 2etc "Pero me preguntaba, ¿te gustan los juegos de mesa, [player]?{nw}"

# game/script-topics.rpy:15686
translate spanish monika_boardgames_ff2270b6:

    # m "But I was wondering, do you like board games, [player]?{fast}" nointeract
    m "Pero me preguntaba, ¿te gustan los juegos de mesa, [player]?{fast}" nointeract

# game/script-topics.rpy:15691
translate spanish monika_boardgames_767d510e:

    # m 1eub "Oh, really?"
    m 1eub "Ah, ¿de verdad?"

# game/script-topics.rpy:15692
translate spanish monika_boardgames_7f08195f:

    # m 1hua "Well, if we ever get the chance, I'd love to play some of your favorite games with you."
    m 1hua "Bueno, si alguna vez tenemos la oportunidad, me encantaría jugar contigo a algunos de tus juegos favoritos."

# game/script-topics.rpy:15693
translate spanish monika_boardgames_cbb2b8ac:

    # m 3eka "I'm not too familiar with board games, but I'm sure you can find some I might enjoy."
    m 3eka "No estoy muy familiarizada con los juegos de mesa, pero seguro que encuentras alguno que me pueda gustar."

# game/script-topics.rpy:15694
translate spanish monika_boardgames_16eb202b:

    # m 3hua "Who knows, maybe I'll end up liking board games as much as you do, ehehe~"
    m 3hua "Quién sabe, a lo mejor me acaban gustando los juegos de mesa tanto como a ti, je, je, je."

# game/script-topics.rpy:15698
translate spanish monika_boardgames_69863141:

    # m 2eka "I can see why...{w=0.2}{nw}"
    m 2eka "Lo entiendo... {w=0.2}{nw}"

# game/script-topics.rpy:15699
translate spanish monika_boardgames_6dfc067f:

    # extend 2rksdla "it's a pretty niche hobby, after all."
    extend 2rksdla "al fin y al cabo, es una afición bastante de nicho."

# game/script-topics.rpy:15700
translate spanish monika_boardgames_8ad1048b:

    # m 1eua "But I'm sure there are plenty of other fun activities you enjoy doing in your free time."
    m 1eua "Pero seguro que hay muchas otras actividades divertidas que te gusta hacer en tu tiempo libre."

# game/script-topics.rpy:15701
translate spanish monika_boardgames_19c610c5:

    # m 3hua "Still, if you ever change your mind, I'd like to give some board games a try with you sometime."
    m 3hua "Aun así, si alguna vez cambias de opinión, me gustaría probar algún juego de mesa contigo alguna vez."

# game/script-topics.rpy:15721
translate spanish monika_boardgames_history_bde58780:

    # m 1eud "So, [player]..."
    m 1eud "Bueno, [player]..."

# game/script-topics.rpy:15722
translate spanish monika_boardgames_history_f339fb61:

    # m 3eua "Since you told me you liked board games, I got a bit curious and tried to learn more about them, {w=0.1}{nw}"
    m 3eua "Como me dijiste que te gustaban los juegos de mesa, me picó la curiosidad e intenté aprender un poco más sobre ellos, {w=0.1}{nw}"

# game/script-topics.rpy:15723
translate spanish monika_boardgames_history_2a556567:

    # extend 1eka "trying to look for what kind of games I'd enjoy playing with you."
    extend 1eka "intentando buscar a qué tipo de juegos me gustaría jugar contigo."

# game/script-topics.rpy:15724
translate spanish monika_boardgames_history_0ace3ec5:

    # m 1euc "I never really had the chance to play them before to be honest."
    m 1euc "La verdad es que antes no había tenido la oportunidad de jugar a ninguno."

# game/script-topics.rpy:15727
translate spanish monika_boardgames_history_7799a5e1:

    # m 1rka "Well, aside for chess and a few card games..."
    m 1rka "Bueno, aparte del ajedrez y un par de juegos de cartas..."

# game/script-topics.rpy:15729
translate spanish monika_boardgames_history_6abc8d0a:

    # m 1rud "Well, I did try out a few basic card games..."
    m 1rud "Bueno, he probado un par de juegos de cartas básicos..."

# game/script-topics.rpy:15730
translate spanish monika_boardgames_history_94e2a003:

    # m 1kua "...and I've been testing a little something else I've been working on...{w=0.3}I'm keeping it a surprise, though!"
    m 1kua "... Y he estado probando otra cosilla en la que he estado trabajando... {w=0.3} ¡Aunque es una sorpresa!"

# game/script-topics.rpy:15732
translate spanish monika_boardgames_history_c77c8a63:

    # m 3eub "Anyway, as it turns out,{w=0.1} the story behind board games and the role they played through the ages is really interesting!"
    m 3eub "En fin, resulta que{w=0.1} ¡la historia detrás de los juegos de mesa y el papel que tuvieron a lo largo de los siglos es muy interesante!"

# game/script-topics.rpy:15733
translate spanish monika_boardgames_history_ac840902:

    # m 3euc "They've been a thing since very early in our history...{w=0.3}{nw}"
    m 3euc "Han existido desde los inicios de nuestra historia... {w=0.3}{nw}"

# game/script-topics.rpy:15734
translate spanish monika_boardgames_history_4e48c838:

    # extend 4wud "in fact, the oldest known board game was played as far back as ancient Egypt!"
    extend 4wud "de hecho, ¡el juego de mesa más antiguo que se conoce se jugaba ya en el antiguo Egipto!"
