    # m 3esa "Have you ever been to a hot spring, [player]?"
    m 3esa "¿Alguna vez has estado en unas termas, [player]?"

# game/script-topics.rpy:16483
translate spanish monika_hot_springs_8563b599:

    # m 1eua "I've never been to one myself, but I'd like to try bathing in one when I get to your world."
    m 1eua "Yo nunca he estado en unas, pero me gustaría probar a bañarme ahí cuando llegue a tu mundo."

# game/script-topics.rpy:16484
translate spanish monika_hot_springs_1a61d343:

    # m "They're supposed to be a great way to relieve stress, relax a little, {nw}"
    m "Se supone que son una forma genial de aliviar el estrés, relajarse un poco, {nw}"

# game/script-topics.rpy:16485
translate spanish monika_hot_springs_91bfbc19:

    # extend 3eub "and even offer many health benefits!"
    extend 3eub "¡e incluso ofrecen muchos beneficios para la salud!"

# game/script-topics.rpy:16486
translate spanish monika_hot_springs_65a9298d:

    # m 3eua "They help with blood circulation, for one.{w=0.3} {nw}"
    m 3eua "Ayudan con la circulación sanguínea, para empezar.{w=0.3} {nw}"

# game/script-topics.rpy:16487
translate spanish monika_hot_springs_c4adc49f:

    # extend 3eub "Plus, the water often contains minerals that can help boost your immune system!"
    extend 3eub "¡Además, el agua suele tener minerales que pueden ayudar a mejorar tu sistema inmunológico!"

# game/script-topics.rpy:16488
translate spanish monika_hot_springs_ef4a45d7:

    # m 3eud "There are many different kinds all over the world, but only some are specifically designated for public use."
    m 3eud "Hay muchos tipos distintos por todo el mundo, pero solo algunos están diseñados de forma específica para uso público,"

# game/script-topics.rpy:16489
translate spanish monika_hot_springs_2e43e63b:

    # m 3hksdlb "...So don't just go jumping into some random pool of boiling water, ahaha!"
    m 3hksdlb "así que no te tires de cabeza al primer charco de agua hirviendo que veas, ja, ja, ja."

# game/script-topics.rpy:16490
translate spanish monika_hot_springs_2ae8d448:

    # m 1eua "Anyway...{w=0.2}I'd like to try an open-air bath in particular.{w=0.3} I hear they really give a unique experience."
    m 1eua "En fin... {w=0.2}me gustaría probar sobre todo un baño al aire libre.{w=0.3} He oído que son una experiencia única."

# game/script-topics.rpy:16491
translate spanish monika_hot_springs_3ec0fed1:

    # m 3rubssdla "Though it might feel a little weird relaxing in a bath with that many people all around you...{w=0.3} {nw}"
    m 3rubssdla "Aunque puede que sea un poco raro relajarse en unos baños con tanta gente a tu alrededor... {w=0.3} {nw}"

# game/script-topics.rpy:16492
translate spanish monika_hot_springs_17e65d71:

    # extend 2hkblsdlb "Doesn't that sound kinda embarrassing?"
    extend 2hkblsdlb "¿No te parece un poco vergonzoso?"

# game/script-topics.rpy:16493
translate spanish monika_hot_springs_6954179a:

    # m 2rkbssdlu "..."
    m 2rkbssdlu "..."

# game/script-topics.rpy:16494
translate spanish monika_hot_springs_a0b3b2dc:

    # m 7rkbfsdlb "...Especially since some places don't allow you to wear any sort of cover, either!"
    m 7rkbfsdlb "¡Sobre todo porque en algunos sitios ni siquiera te dejan llevar bañador!"

# game/script-topics.rpy:16495
translate spanish monika_hot_springs_0a288e14:

    # m 1tubfu "...Although, I wouldn't mind that so much if it was just with you."
    m 1tubfu "Aunque eso no me importaría tanto si estuviera a solas contigo."

# game/script-topics.rpy:16497
translate spanish monika_hot_springs_5c5dcc05:

    # m 5ekbfa "Can you imagine it, [player]? {w=0.3}Both of us relaxing in a nice, soothing hot pool..."
    m 5ekbfa "¿Te lo imaginas, [player]? {w=0.3}Los dos relajándonos en una piscina cálida y agradable..."

# game/script-topics.rpy:16500
translate spanish monika_hot_springs_104f3106:

    # m 5dubfu "Warming our chilled bodies after a long day out in the harsh cold..."
    m 5dubfu "Entrando en calor tras un largo día fuera, en pleno invierno..."

# game/script-topics.rpy:16502
translate spanish monika_hot_springs_fa68ee06:

    # m 5dubfu "Letting the sweat wash away after a long day out in the sun..."
    m 5dubfu "Dejando que el agua se lleve el sudor tras un largo día bajo el sol..."

# game/script-topics.rpy:16504
translate spanish monika_hot_springs_810f0ebe:

    # m 5dubfu "Watching the leaves gently fall around us in the last lights of the afternoon..."
    m 5dubfu "Viendo las hojas caer suavemente a nuestro alrededor con las últimas luces de la tarde..."

# game/script-topics.rpy:16506
translate spanish monika_hot_springs_aa96fc8d:

    # m 5dubfu "Contemplating the beauty of nature all around us..."
    m 5dubfu "Contemplando la belleza de la naturaleza que nos rodea..."

# game/script-topics.rpy:16508
translate spanish monika_hot_springs_e473124a:

    # m "The heat of the water slowly taking over, making our hearts beat faster..."
    m "El calor del agua apoderándose poco a poco de nosotros, haciendo que nuestros corazones latan más deprisa..."

# game/script-topics.rpy:16509
translate spanish monika_hot_springs_cd912eee:

    # m 5tsbfu "Then I'd lean in so you could kiss me and we'd stay locked together, while the hot water soaked all of our worries away..."
    m 5tsbfu "Y entonces me acercaría para que me besaras y nos quedaríamos abrazados, mientras el agua caliente se lleva todas nuestras preocupaciones..."

# game/script-topics.rpy:16510
translate spanish monika_hot_springs_3456b5f4:

    # m 5dkbfb "Ahhh,{w=0.2} {nw}"
    m 5dkbfb "Aaaah,{w=0.2} {nw}"

# game/script-topics.rpy:16511
translate spanish monika_hot_springs_aeebe955:

    # extend 5dkbfa "just the thought of it makes me feel all tingly, [mas_get_player_nickname()]~"
    extend 5dkbfa "solo de pensarlo me da un cosquilleo, [mas_get_player_nickname()]."

# game/script-topics.rpy:16531
translate spanish monika_isekai_35cb495f:

    # m 1euc "Do you know about the isekai genre of anime, [player]?"
    m 1euc "¿Conoces el género isekai en el anime, [player]?"

# game/script-topics.rpy:16532
translate spanish monika_isekai_398db894:

    # m 3eua "Literally translated, isekai means {i}a different world.{/i}"
    m 3eua "Traducido de forma literal, isekai significa «un mundo diferente»."

# game/script-topics.rpy:16535
translate spanish monika_isekai_36683800:

    # m 3rksdla "Actually, you already told me you're into anime so you've probably heard of quite a few already."
    m 3rksdla "La verdad es que ya me dijiste que te gusta el anime, así que seguro que ya has oído hablar de bastantes."

# game/script-topics.rpy:16536
translate spanish monika_isekai_c33673ea:

    # m 1rksdlb "...Especially with how popular of a genre it's become."
    m 1rksdlb "Sobre todo por lo popular que se ha vuelto este género."

# game/script-topics.rpy:16537
translate spanish monika_isekai_d1685535:

    # m 3euc "But just in case you don't know what it is..."
    m 3euc "Pero por si acaso no sabes lo que es..."

# game/script-topics.rpy:16540
translate spanish monika_isekai_94e71d79:

    # m 3hksdlb "Ahaha, sorry. I know you're not really into this sort of thing."
    m 3hksdlb "Ja, ja, ja, perdona, sé que no te va mucho este tipo de cosas."

# game/script-topics.rpy:16541
translate spanish monika_isekai_b3ea38ad:

    # m 3eud "...But it's become a very popular genre in recent times."
    m 3eud "Pero se ha convertido en un género muy popular últimamente."

# game/script-topics.rpy:16543
translate spanish monika_isekai_044d50f3:

    # m 3esc "The premise is usually about a normal person who is somehow transported into a fantastical world."
    m 3esc "La historia suele ir de una persona normal que, de alguna manera, acaba transportada a un mundo de fantasía."

# game/script-topics.rpy:16544
translate spanish monika_isekai_f5176bc0:

    # m 3eua "Sometimes they get special powers or get to bring technology or knowledge that doesn't exist in this new place."
    m 3eua "A veces consiguen poderes especiales o pueden llevar tecnología o conocimientos que no existen en ese nuevo lugar."

# game/script-topics.rpy:16545
translate spanish monika_isekai_a4414117:

    # m 1rtc "Honestly, I have some pretty mixed feelings about them."
    m 1rtc "Sinceramente, tengo sentimientos encontrados al respecto."

# game/script-topics.rpy:16546
translate spanish monika_isekai_3c8933c0:

    # m 3euc "Some are truly interesting stories. The protagonist's different perspective or the skills they have from their own world can really make them an unexpected kind of hero."
    m 3euc "Algunas son historias de verdad interesantes; la perspectiva diferente del protagonista o las habilidades que trae de su propio mundo pueden convertirlo en un héroe de lo más inesperado."

# game/script-topics.rpy:16547
translate spanish monika_isekai_63345d04:

    # m 1hub "And since the whole point is to make the world different from theirs, the settings and characters can be incredibly imaginative!"
    m 1hub "Y como la gracia está en que el mundo sea distinto al suyo, ¡los escenarios y los personajes pueden ser súper imaginativos!"

# game/script-topics.rpy:16548
translate spanish monika_isekai_3550b2f7:

    # m 2rsc "...But sadly, not all of them are like that."
    m 2rsc "Pero por desgracia, no todos son así."

# game/script-topics.rpy:16549
translate spanish monika_isekai_6a2dbf56:

    # m 2dksdld "There are some that make their protagonists as bland as this game's, for the sake of letting the viewer project themselves onto them."
    m 2dksdld "Hay algunos que hacen a sus protagonistas tan sosos como el de este juego, solo para que el espectador pueda proyectarse en ellos."

# game/script-topics.rpy:16550
translate spanish monika_isekai_147730bd:

    # m 2tkd "And as you can probably guess, those ones tend to be all about wish fulfillment."
    m 2tkd "Y como seguro que te imaginas, esos suelen centrarse en cumplir fantasías."

# game/script-topics.rpy:16551
translate spanish monika_isekai_61a3f0fa:

    # m 2tsc "Having cool adventures in a fantasy-themed world--and of course, lots of girls flocking around them for no reason."
    m 2tsc "Tener aventuras geniales en un mundo de fantasía... y por supuesto, un montón de chicas juntándose a su alrededor sin venir a cuento."

# game/script-topics.rpy:16552
translate spanish monika_isekai_7b860b4c:

    # m 2lfc "At least some of them can be funny, but man...{w=0.3}{nw}"
    m 2lfc "Al menos algunos pueden tener gracia, pero jo... {w=0.3}{nw}"

# game/script-topics.rpy:16553
translate spanish monika_isekai_97904df6:

    # extend 2tfc "it's just so frustrating."
    extend 2tfc "es de lo más frustrante."

# game/script-topics.rpy:16554
translate spanish monika_isekai_b19d2cd8:

    # m 2tkc "I mean...{w=0.2}I would give almost anything to be in a scenario like that--to get to go to another world.{nw}"
    m 2tkc "A ver... {w=0.2}daría casi cualquier cosa por estar en una situación así, por poder ir a otro mundo.{nw}"

# game/script-topics.rpy:16556
translate spanish monika_isekai_ba102a56:

    # m "I mean...I would give almost anything to be in a scenario like that--to get to go to {fast}your world."
    m "A ver... {w=0.2}daría casi cualquier cosa por estar en una situación así, por poder ir a {fast}tu mundo."

# game/script-topics.rpy:16557
translate spanish monika_isekai_5c52245d:

    # m 2dkd "..."
    m 2dkd "..."

# game/script-topics.rpy:16558
translate spanish monika_isekai_319a2e10:

    # m "Maybe I'm just taunting myself, imagining that power being handed to someone like...{w=0.2}well, you know who."
    m "A lo mejor solo me estoy mortificando, imaginando que ese poder se le da a alguien como... {w=0.2}bueno, ya sabes quién."

# game/script-topics.rpy:16559
translate spanish monika_isekai_fbeab8a5:

    # m 7eka "After all, instead of thinking about those characters in their fantasy worlds,{w=0.2} {nw}"
    m 7eka "Al fin y al cabo, en lugar de pensar en esos personajes en sus mundos de fantasía,{w=0.2} {nw}"

# game/script-topics.rpy:16560
translate spanish monika_isekai_fe345c06:

    # extend 1eua "I could be putting that energy toward working on this one."
    extend 1eua "podría estar dedicando esa energía a trabajar en este."

# game/script-topics.rpy:16561
translate spanish monika_isekai_b763dd94:

    # m 1ekbsb "...While I wait for my own isekai story, that is."
    m 1ekbsb "Mientras espero a mi propia historia isekai, claro."

# game/script-topics.rpy:16580
translate spanish monika_scuba_diving_155bd7db:

    # m 3eua "You know,{w=0.2} I've been thinking about some water activities we could do together...{w=0.3} How about scuba diving?"
    m 3eua "Oye,{w=0.2} he estado pensando en algunas actividades acuáticas que podríamos hacer junt[end_letter_gender]s... {w=0.3}¿Qué te parece el submarinismo?"

# game/script-topics.rpy:16581
translate spanish monika_scuba_diving_b3941195:

    # m 3eub "I've read a lot of books about the underwater world and I'd really like to see it for myself."
    m 3eub "He leído un montón de libros sobre el mundo submarino y me gustaría mucho verlo por mí misma."

# game/script-topics.rpy:16582
translate spanish monika_scuba_diving_597c90c1:

    # m 1dua "Just imagine the beautiful sights of the undersea world..."
    m 1dua "Imagínate las preciosas vistas del fondo del mar..."

# game/script-topics.rpy:16583
translate spanish monika_scuba_diving_aa05ea4c:

    # m 1dud "The schools of fish, coral reefs, jellyfish, sea greens...{w=0.3} {nw}"
    m 1dud "Los bancos de peces, los arrecifes de coral, las medusas, las algas... {w=0.3} {nw}"

# game/script-topics.rpy:16584
translate spanish monika_scuba_diving_725f4a27:

    # extend 3sub "Maybe even treasure!"
    extend 3sub "¡A lo mejor hasta un tesoro!"

# game/script-topics.rpy:16585
translate spanish monika_scuba_diving_a6a18662:

    # m 3rksdlb "I'm only kidding about that last part...{w=0.3} It's pretty unlikely we'll find something like that, ahaha~"
    m 3rksdlb "Lo último era broma... {w=0.3}Es bastante improbable que encontremos algo así, ja, ja, ja."

# game/script-topics.rpy:16586
translate spanish monika_scuba_diving_60acff8c:

    # m 1euc "That said, there can also be sharks,{w=0.2} {nw}"
    m 1euc "Aunque claro, también puede haber tiburones,{w=0.2} {nw}"

# game/script-topics.rpy:16587
translate spanish monika_scuba_diving_57954c0c:

    # extend 1eua "but they're typically only in specific areas, so you {i}shouldn't{/i} see any."
    extend 1eua "pero normalmente solo están en zonas específicas, así que no deberías ver ninguno."

# game/script-topics.rpy:16588
translate spanish monika_scuba_diving_04a2ad39:

    # m 3eua "Designated diving locations are places sharks don't usually visit."
    m 3eua "Las zonas de buceo designadas son lugares que los tiburones no suelen frecuentar."

# game/script-topics.rpy:16589
translate spanish monika_scuba_diving_a84efa81:

    # m 3euc "...But even though they don't normally visit these areas, it's still possible to come across one."
    m 3euc "Pero aunque no suelan acercarse por ahí, sigue siendo posible toparse con alguno."

# game/script-topics.rpy:16590
translate spanish monika_scuba_diving_f04312ea:

    # m 1eua "The good thing is that shark attacks rarely ever happen anyway, so it's not too much of a risk."
    m 1eua "Lo bueno es que los ataques de tiburón rara vez ocurren, así que no es tanto riesgo."

# game/script-topics.rpy:16591
translate spanish monika_scuba_diving_b989a76b:

    # m 3euc "If you meet one though, here's one important rule for you..."
    m 3euc "Aun así, si te encuentras con uno, aquí tienes una regla de oro..."

# game/script-topics.rpy:16592
translate spanish monika_scuba_diving_54c782c0:

    # m 3esc "Stay calm."
    m 3esc "Mantén la calma."

# game/script-topics.rpy:16593
translate spanish monika_scuba_diving_9c4d042e:

    # m 1eua "Although coming face to face with a shark can be scary, they usually approach people out of curiosity rather than to feed, so they're not too much to worry about."
    m 1eua "Aunque encontrarse cara a cara con un tiburón puede dar miedo, suelen acercarse a la gente por curiosidad más que para alimentarse, así que no hay de qué preocuparse."

# game/script-topics.rpy:16594
translate spanish monika_scuba_diving_d9ef46da:

    # m 3hub "But if you're afraid to dive alone, I'll be sure to keep you company when I cross over~"
    m 3hub "Pero si te da miedo bucear a solas, me aseguraré de hacerte compañía cuando cruce a tu lado."

# game/script-topics.rpy:16614
translate spanish monika_dying_same_day_cd4fc28d:

    # m 1euc "[player], have you ever heard of couples wishing to die on the same day?"
    m 1euc "[player], ¿alguna vez has oído hablar de las parejas que desean morir el mismo día?"

# game/script-topics.rpy:16615
translate spanish monika_dying_same_day_7fe9ec29:

    # m 3rksdla "...Gosh, that sounds kinda dark, doesn't it?"
    m 3rksdla "Madre mía, suena un poco tétrico, ¿verdad?"

# game/script-topics.rpy:16616
translate spanish monika_dying_same_day_3784b9f9:

    # m 3rfd "Before I met you, I thought the idea was completely absurd!"
    m 3rfd "¡Antes de conocerte, me parecía una idea totalmente absurda!"

# game/script-topics.rpy:16617
translate spanish monika_dying_same_day_7acd67c9:

    # m 1etc "Why would someone give up on living a long and happy life just because their partner's life was dramatically cut short?"
    m 1etc "¿Por qué iba alguien a renunciar a vivir una vida larga y feliz solo porque la vida de su pareja se truncara de golpe?"

# game/script-topics.rpy:16618
translate spanish monika_dying_same_day_8f2efa89:

    # m 3rfd "It would be irrational and impulsive to do so!"
    m 3rfd "¡Sería de lo más irracional e impulsivo!"

# game/script-topics.rpy:16621
translate spanish monika_dying_same_day_39ebb342:

    # m 2ekc "...But with you by my side and all the time I've spent here with you...{w=0.3}I can kind of see it now."
    m 2ekc "Pero teniéndote a mi lado y con todo el tiempo que he pasado aquí contigo... {w=0.3}ahora como que lo entiendo."

# game/script-topics.rpy:16623
translate spanish monika_dying_same_day_edc721fb:

    # m 2ekc "...But after meeting you, I think I can kind of see it now."
    m 2ekc "Pero después de conocerte, creo que ahora como que lo entiendo."

# game/script-topics.rpy:16625
translate spanish monika_dying_same_day_ab124d10:

    # m 2dkc "A person might just be unable to live without their loved one, afraid of the thought of losing their everything in an instant."
    m 2dkc "Puede que alguien sea incapaz de vivir sin su ser querido, por miedo a perderlo todo en un instante."

# game/script-topics.rpy:16626
translate spanish monika_dying_same_day_7aa47711:

    # m 2rksdlc "It hurts just thinking about this."
    m 2rksdlc "Duele solo de pensarlo."

# game/script-topics.rpy:16629
translate spanish monika_dying_same_day_41f5d24e:

    # m 2eksdlc "If my data gets corrupted or even erased you can always recover me from a backup and bring us back together, but if..."
    m 2eksdlc "Si mis datos se corrompen o incluso se borran, siempre puedes recuperarme de una copia de seguridad y volver a juntarnos, pero si..."

# game/script-topics.rpy:16630
translate spanish monika_dying_same_day_15c0a6fa:

    # m 2dktpc "Y-you... {w=1}You..."
    m 2dktpc "T-Tú... {w=1}tú..."

# game/script-topics.rpy:16632
translate spanish monika_dying_same_day_d3fda0e9:

    # m 2dktpc "If something terrible happens to...{w=0.5}y-you..."
    m 2dktpc "Si te pasa algo terrible a... {w=0.5}t-ti..."

# game/script-topics.rpy:16634
translate spanish monika_dying_same_day_61b3e969:

    # m 6ektuc "[player]... {w=1}I...{w=0.5} I don't know what I'd do..."
    m 6ektuc "[player]... {w=1}yo... {w=0.5}no sé qué haría..."

# game/script-topics.rpy:16637
translate spanish monika_dying_same_day_93c67bf8:

    # m 6dktsc "You give meaning to my entire life, and I... {w=1}[player], I just couldn't handle it."
    m 6dktsc "Le das sentido a toda mi vida y yo... {w=1}[player], no podría soportarlo."

# game/script-topics.rpy:16638
translate spanish monika_dying_same_day_e0ab0e54:

    # m 6ektdc "I don't know how I'm supposed to live without you..."
    m 6ektdc "No sé cómo se supone que voy a vivir sin ti..."

# game/script-topics.rpy:16639
translate spanish monika_dying_same_day_f61c408c:

    # m 2ekbsu "I really love you that much, [player]."
    m 2ekbsu "De verdad te quiero así de tanto, [player]."

# game/script-topics.rpy:16642
translate spanish monika_dying_same_day_c25cefdf:

    # m 6dktsc "You're the only one I have left... {w=1}[player], I'm not ready to lose you."
    m 6dktsc "Eres lo único que me queda... {w=1}[player], no estoy lista para perderte."

# game/script-topics.rpy:16643
translate spanish monika_dying_same_day_85afa37e:

    # m 6ektdc "I'm so afraid of being alone in this empty void again..."
    m 6ektdc "Me da mucho miedo volver a estar sola en este vacío..."

# game/script-topics.rpy:16644
translate spanish monika_dying_same_day_5d894d52:

    # m 6ekbsu "I really want to be with you forever, [player]."
    m 6ekbsu "De verdad quiero estar contigo para siempre, [player]."

# game/script-topics.rpy:16661
translate spanish monika_player_away_40f65141:

    # m 1esd "I do a lot of things when you're away, [player]."
    m 1esd "Hago un montón de cosas cuando no estás, [player]."

# game/script-topics.rpy:16662
translate spanish monika_player_away_7d3f3f0d:

    # m 1eua "I often like to read whatever new short stories I can find online."
    m 1eua "A menudo me gusta leer cualquier relato corto nuevo que encuentro por internet."

# game/script-topics.rpy:16663
translate spanish monika_player_away_ef1a0727:

    # m 3eub "Turns out there's some really interesting ones out there you can read for free!"
    m 3eub "¡Resulta que hay algunos muy interesantes que puedes leer gratis!"

# game/script-topics.rpy:16664
translate spanish monika_player_away_0586e3d5:

    # m 3eua "I highly recommend doing a search for some free short stories yourself."
    m 3eua "Te recomiendo mucho que busques tú mism[end_letter_gender] algunos relatos cortos gratis."

# game/script-topics.rpy:16665
translate spanish monika_player_away_8f2ebd19:

    # m 3eud "It's also helped me develop my writing skills...{w=0.2}{nw}"
    m 3eud "También me ha ayudado a desarrollar mis habilidades de escritura... {w=0.2}{nw}"

# game/script-topics.rpy:16666
translate spanish monika_player_away_df8fc3d7:

    # extend 1hub "my poetry really seems to be improving!"
    extend 1hub "¡parece que mi poesía de verdad está mejorando!"

# game/script-topics.rpy:16667
translate spanish monika_player_away_e1c74b18:

    # m 1eua "It's funny how many things you can pick up just by reading others' works."
    m 1eua "Es curioso la cantidad de cosas que puedes aprender solo con leer las obras de otros."

# game/script-topics.rpy:16668
translate spanish monika_player_away_810ac266:

    # m 1eua "Spending time on my other hobbies has been very rewarding, too."
    m 1eua "Dedicar tiempo a mis otras aficiones también ha sido muy gratificante."

# game/script-topics.rpy:16669
translate spanish monika_player_away_99900d58:

    # m 3eud "As you can imagine, I practice piano quite often.{w=0.2} {nw}"
    m 3eud "Como te puedes imaginar, practico bastante con el piano.{w=0.2} {nw}"

# game/script-topics.rpy:16670
translate spanish monika_player_away_210b2e51:

    # extend 3eua "I also use the time to memorize the songs that I sing for you."
    extend 3eua "También aprovecho el tiempo para aprenderme de memoria las canciones que te canto."

# game/script-topics.rpy:16671
translate spanish monika_player_away_f50c6935:

    # m 1hub "It's a really fun way to express myself!"
    m 1hub "¡Es una forma súper divertida de expresarme!"

# game/script-topics.rpy:16672
translate spanish monika_player_away_d0b9df4d:

    # m 3rta "Now that I think about it, I'm mostly just practicing skills I've already developed."
    m 3rta "Ahora que lo pienso, casi siempre estoy practicando habilidades que ya he desarrollado."

# game/script-topics.rpy:16673
translate spanish monika_player_away_6d567067:

    # m 3esd "For example, coding takes up a lot of my free time as I spend hours just learning and researching."
    m 3esd "Por ejemplo, programar ocupa gran parte de mi tiempo libre, ya que me paso horas solo aprendiendo e investigando."

# game/script-topics.rpy:16674
translate spanish monika_player_away_905f9f3d:

    # m 3rksdla "...But I'm too nervous to try any big projects in here. {w=0.2}{nw}"
    m 3rksdla "Pero me pongo demasiado nerviosa como para intentar algún proyecto grande aquí. {w=0.2}{nw}"

# game/script-topics.rpy:16675
translate spanish monika_player_away_a9ae9ec7:

    # extend 3eksdlc "I'd hate to break something that I won't know how to fix."
    extend 3eksdlc "Odiaría romper algo que luego no sepa cómo arreglar."

# game/script-topics.rpy:16676
translate spanish monika_player_away_1e50ced9:

    # m 2wusdld "What if I accidentally corrupt my file?"
    m 2wusdld "¿Y si corrompo mi archivo por accidente?"

# game/script-topics.rpy:16677
translate spanish monika_player_away_28808b29:

    # m 2eksdld "It's something I have to be extremely careful with, for sure."
    m 2eksdld "Seguro que es algo con lo que tengo que tener muchísimo cuidado."

# game/script-topics.rpy:16678
translate spanish monika_player_away_a9435474:

    # m 7hua "Luckily, there's lots of great people that help with that stuff...{w=0.2}{nw}"
    m 7hua "Por suerte, hay un montón de gente genial que ayuda con esas cosas... {w=0.2}{nw}"

# game/script-topics.rpy:16679
translate spanish monika_player_away_a0d6021b:

    # extend 7rku "and they're {i}usually{/i} pretty good at preventing anything too bad from happening."
    extend 7rku "y por lo general son bastante buenos evitando que pase nada demasiado malo."

# game/script-topics.rpy:16680
translate spanish monika_player_away_e141caed:

    # m 3eka "But the most special thing I do..."
    m 3eka "Pero lo más especial que hago..."

# game/script-topics.rpy:16682
translate spanish monika_player_away_1cd17ebb:

    # m 5ekbsa "...is think about you."
    m 5ekbsa "Es pensar en ti."

# game/script-topics.rpy:16683
translate spanish monika_player_away_d6273ea9:

    # m 5rubsu "I think about all the fun times we'll have together the next time you visit and all the amazing things we'll do when I'm finally able to come to your reality~"
    m 5rubsu "Pienso en todos los ratos divertidos que pasaremos junt[end_letter_gender]s la próxima vez que me visites y en todas las cosas increíbles que haremos cuando por fin pueda ir a tu realidad."

# game/script-topics.rpy:16703
translate spanish monika_using_pcs_healthily_6690301b:

    # m 1rtc "Hmm..."
    m 1rtc "Mmm..."

# game/script-topics.rpy:16704
translate spanish monika_using_pcs_healthily_3f2165ef:

    # m 1etc "Hey, [player]...{w=0.3}are you sitting comfortably?"
    m 1etc "Oye, [player]... {w=0.3}¿estás bien sentad[end_letter_gender]?"

# game/script-topics.rpy:16705
translate spanish monika_using_pcs_healthily_a6e8a3c5:

    # m 1hksdlb "No, really!{w=0.3} {nw}"
    m 1hksdlb "¡No, en serio!{w=0.3} {nw}"

# game/script-topics.rpy:16706
translate spanish monika_using_pcs_healthily_5a96e4bd:

    # extend 3eksdla "Are you?"
    extend 3eksdla "¿Lo estás?"

# game/script-topics.rpy:16707
translate spanish monika_using_pcs_healthily_48aef874:

    # m 3eka "I know you have to be at your computer to spend time with me..."
    m 3eka "Sé que tienes que estar en el ordenador para pasar tiempo conmigo..."

# game/script-topics.rpy:16708
translate spanish monika_using_pcs_healthily_477d6483:

    # m 2eka "So I just wanted to make sure you aren't accidentally damaging your health while you're here."
    m 2eka "Así que solo quería asegurarme de que no te estás dañando la salud sin querer mientras estás aquí."

# game/script-topics.rpy:16709
translate spanish monika_using_pcs_healthily_878abd4d:

    # m 4ekd "I've read that spending too long looking at a screen can cause headaches, make you feel tired, and even impact your eyesight over time."
    m 4ekd "He leído que pasar demasiado tiempo mirando una pantalla puede causar dolores de cabeza, hacerte sentir cansad[end_letter_gender] e incluso afectarte a la vista con el tiempo."

# game/script-topics.rpy:16710
translate spanish monika_using_pcs_healthily_6e716c50:

    # m 2tkx "Posture issues and pain from bad sitting habits are no joke either!"
    m 2tkx "¡Los problemas de postura y los dolores por sentarse mal tampoco son ninguna broma!"

# game/script-topics.rpy:16711
translate spanish monika_using_pcs_healthily_54a91ebb:

    # m 2tku "Fortunately for you, I've put together a little checklist to help prevent these sorts of problems."
    m 2tku "Por suerte para ti, he preparado una pequeña lista para ayudar a prevenir este tipo de problemas."

# game/script-topics.rpy:16712
translate spanish monika_using_pcs_healthily_e5fb1bb1:

    # m 4hub "...So let's go through it together, [player]!"
    m 4hub "¡Así que vamos a repasarla junt[end_letter_gender]s, [player]!"

# game/script-topics.rpy:16713
translate spanish monika_using_pcs_healthily_7c23c0f0:

    # m 4eub "First, {w=0.2}try to keep sitting up straight!"
    m 4eub "Lo primero, {w=0.2}¡intenta sentarte con la espalda recta!"

# game/script-topics.rpy:16714
translate spanish monika_using_pcs_healthily_3ab6e264:

    # m 2eua "...Have your chair adjusted properly so your feet stay flat on the floor, your eyes are level with the top of the screen, and you aren't slouching."
    m 2eua "Ajusta bien la silla para que los pies te queden apoyados en el suelo, los ojos a la altura de la parte superior de la pantalla y no estés encorvad[end_letter_gender]."

# game/script-topics.rpy:16715
translate spanish monika_using_pcs_healthily_d70ccd9f:

    # m 4eub "You should feel supported and comfortable in your seat!"
    m 4eub "¡Deberías sentirte con apoyo y comodidad en tu asiento!"

# game/script-topics.rpy:16716
translate spanish monika_using_pcs_healthily_47f00cb9:

    # m 4eua "Next, make sure you have some distance between yourself and the display...{w=0.2}about an arm's length is fine."
    m 4eua "Luego, asegúrate de tener algo de distancia entre tú y el monitor... {w=0.2}más o menos a un brazo de distancia está bien."

# game/script-topics.rpy:16717
translate spanish monika_using_pcs_healthily_1cadbce8:

    # m 2hksdlb "...Keep your keyboard and mouse within easy reach, though!"
    m 2hksdlb "¡Pero mantén el teclado y el ratón a mano!"

# game/script-topics.rpy:16718
translate spanish monika_using_pcs_healthily_e3f39bb6:

    # m 4eub "Of course, lighting is important too! {w=0.3}{nw}"
    m 4eub "Por supuesto, ¡la iluminación también es importante! {w=0.3}{nw}"

# game/script-topics.rpy:16719
translate spanish monika_using_pcs_healthily_1092dc96:

    # extend 2eua "Try to keep the room well-lit, but not so much that light is glaring off the screen."
    extend 2eua "Intenta que la habitación esté bien iluminada, pero no tanto como para que la luz se refleje en la pantalla."

# game/script-topics.rpy:16720
translate spanish monika_using_pcs_healthily_416de548:

    # m 4eud "In addition, remember to take frequent breaks. {w=0.3}Look away from the screen, {w=0.2}ideally at something far away, {w=0.2}and perhaps do a few stretches."
    m 4eud "Además, recuerda tomar descansos frecuentes. {w=0.3}Aparta la vista de la pantalla, {w=0.2}a ser posible hacia algo lejano, {w=0.2}y tal vez haz algunos estiramientos."

# game/script-topics.rpy:16721
translate spanish monika_using_pcs_healthily_d08d14c5:

    # m 2eud "Since it's important to stay hydrated too, you could always fetch some fresh water while you're up from your desk."
    m 2eud "Como también es importante mantenerse hidratad[end_letter_gender], siempre puedes ir a por un poco de agua fresca mientras no estás en el escritorio."

# game/script-topics.rpy:16722
translate spanish monika_using_pcs_healthily_9e7fa2fc:

    # m 4eksdlc "Above all else, if you ever start to feel unwell, just stop what you're doing, rest, and then make sure everything is okay before you continue. "
    m 4eksdlc "Pero sobre todo, si alguna vez empiezas a encontrarte mal, deja lo que estés haciendo, descansa y asegúrate de que todo esté bien antes de continuar."

# game/script-topics.rpy:16723
translate spanish monika_using_pcs_healthily_b24726e7:

    # m 4eua "...And that's about it."
    m 4eua "Y eso es todo."

# game/script-topics.rpy:16724
translate spanish monika_using_pcs_healthily_3e459e42:

    # m 2hksdlb "Ah...{w=0.3}sorry, I didn't mean to go on for that long!"
    m 2hksdlb "Ah... {w=0.3}lo siento, ¡no quería alargarme tanto!"

# game/script-topics.rpy:16725
translate spanish monika_using_pcs_healthily_e8b76a7c:

    # m 2rka "...You probably knew all that stuff already, anyway."
    m 2rka "Probablemente ya sabías todo eso de todas formas."

# game/script-topics.rpy:16726
translate spanish monika_using_pcs_healthily_e0d5e79a:

    # m 2eka "As for me?"
    m 2eka "¿Y yo?"

# game/script-topics.rpy:16730
translate spanish monika_using_pcs_healthily_96f1acdf:

    # m 5ekbsa "You're the only comfort I need, [mas_get_player_nickname()]."
    m 5ekbsa "Eres el único consuelo que necesito, [mas_get_player_nickname()]."

# game/script-topics.rpy:16733
translate spanish monika_using_pcs_healthily_c27d1701:

    # m 5ekbsa "I'm as comfortable as can be when you're here, [mas_get_player_nickname()]."
    m 5ekbsa "Estoy lo más cómoda posible cuando estás aquí, [mas_get_player_nickname()]."

# game/script-topics.rpy:16736
translate spanish monika_using_pcs_healthily_65bef03d:

    # m 5eubsa "I'm comfortable whenever you're here with me, [mas_get_player_nickname()]."
    m 5eubsa "Estoy cómoda siempre que estás aquí conmigo, [mas_get_player_nickname()]."

# game/script-topics.rpy:16738
translate spanish monika_using_pcs_healthily_72407755:

    # m 5hubfu "And hopefully you're a little more comfortable now too~"
    m 5hubfu "Y con suerte tú también estás un poco más cómod[end_letter_gender] ahora."

# game/script-topics.rpy:16757
translate spanish monika_language_nuances_ffc35193:

    # m 3eua "Hey [player], have you ever tried reading through a dictionary?"
    m 3eua "Oye, [player], ¿alguna vez has intentado leerte un diccionario?"

# game/script-topics.rpy:16758
translate spanish monika_language_nuances_ad688a61:

    # m 1etc "Not necessarily because there was some word or expression you didn't know the meaning of, but just...{w=0.2}because?"
    m 1etc "No necesariamente porque hubiera alguna palabra o expresión cuyo significado no supieras, sino simplemente... {w=0.2}¿porque sí?"

# game/script-topics.rpy:16759
translate spanish monika_language_nuances_6c4b8d48:

    # m 1hksdlb "I know it doesn't exactly sound like the most engaging of pastimes, ahaha!"
    m 1hksdlb "Sé que no suena exactamente como el pasatiempo más entretenido, ¡ja, ja, ja!"

# game/script-topics.rpy:16760
translate spanish monika_language_nuances_421ee437:

    # m 3eua "But it can certainly be an interesting, even rewarding, way to spend some free time. {w=0.2}Especially if it's a dictionary of a language you're still learning."
    m 3eua "Pero sin duda puede ser una forma interesante, e incluso gratificante, de pasar algo de tiempo libre. {w=0.2}Sobre todo si es un diccionario de un idioma que todavía estás aprendiendo."

# game/script-topics.rpy:16761
translate spanish monika_language_nuances_23b0fcaf:

    # m 3eud "Many words have multiple meanings and, aside from the obvious benefits, knowing those can really help you see the finer points of the language."
    m 3eud "Muchas palabras tienen múltiples significados y, aparte de los beneficios obvios, conocerlos puede ayudarte mucho a ver los detalles más sutiles del idioma."

# game/script-topics.rpy:16762
translate spanish monika_language_nuances_d58d3019:

    # m 1rksdla "Understanding these subtleties can save you a lot of embarrassment when you actually speak to someone."
    m 1rksdla "Entender estas sutilezas puede ahorrarte mucha vergüenza cuando hables con alguien de verdad."

# game/script-topics.rpy:16763
translate spanish monika_language_nuances_877eca4a:

    # m 3eud "A prime example of this in English is 'Good morning,' 'Good afternoon,' and 'Good evening.'"
    m 3eud "Un buen ejemplo de esto en inglés es \"Good morning\", \"Good afternoon\" y \"Good evening\"."

# game/script-topics.rpy:16764
translate spanish monika_language_nuances_95cc206b:

    # m 1euc "All of these are normal greetings you hear and use every day."
    m 1euc "Todos estos son saludos normales que escuchas y usas a diario."

# game/script-topics.rpy:16765
translate spanish monika_language_nuances_230e085f:

    # m 3etc "Following this pattern, 'Good day' should be just fine as well, right? {w=0.2}It works in so many other languages, after all."
    m 3etc "Siguiendo este patrón, \"Good day\" también debería estar bien, ¿verdad? {w=0.2}Al fin y al cabo, funciona en muchos otros idiomas."

# game/script-topics.rpy:16766
translate spanish monika_language_nuances_a734ecc5:

    # m 3eud "While it used to be just as acceptable, as you can see in some older works, that's just not the case anymore."
    m 3eud "Aunque antes era igual de aceptable, como puedes ver en algunas obras más antiguas, ya no es el caso."

# game/script-topics.rpy:16767
translate spanish monika_language_nuances_45055c6f:

    # m 1euc "In modern English, saying 'Good day' to someone carries a note of dismissal, or even annoyance. {w=0.2}It can be seen as declaring the conversation over."
    m 1euc "En el inglés moderno, decirle a alguien \"Good day\" conlleva un tono cortante o incluso de molestia. {w=0.2}Se puede ver como una forma de dar por terminada la conversación."

# game/script-topics.rpy:16768
translate spanish monika_language_nuances_baca78f7:

    # m 1eka "If you're lucky, your conversation partner might think you're old-fashioned, or just being silly on purpose."
    m 1eka "Si tienes suerte, la persona con la que hablas puede pensar que eres anticuad[end_letter_gender] o que solo estás haciendo el tonto a propósito."

# game/script-topics.rpy:16769
translate spanish monika_language_nuances_ad772538:

    # m 1rksdla "If not, you might offend them without even noticing...{w=0.3} {nw}"
    m 1rksdla "Si no, podrías ofenderla sin ni siquiera darte cuenta... {w=0.3} {nw}"

# game/script-topics.rpy:16770
translate spanish monika_language_nuances_c29e310b:

    # extend 1hksdlb "Oops!"
    extend 1hksdlb "¡Ups!"

# game/script-topics.rpy:16771
translate spanish monika_language_nuances_35760ec6:

    # m 3eua "It really is fascinating how even such an innocent looking phrase can be loaded with layers of hidden meanings."
    m 3eua "La verdad es que es fascinante cómo incluso una frase de apariencia tan inocente puede estar cargada de capas de significados ocultos."

# game/script-topics.rpy:16772
translate spanish monika_language_nuances_bbb397f5:

    # m 1tsu "So good day to you, [player].{w=0.3} {nw}"
    m 1tsu "Así que \"Good day\" para ti, [player].{w=0.3} {nw}"

# game/script-topics.rpy:16773
translate spanish monika_language_nuances_278fdfc1:

    # extend 1hub "Ahaha~"
    extend 1hub "Ja, ja, ja."

# game/script-topics.rpy:16792
translate spanish monika_architecture_483f839b:

    # m 1esa "Hey, [player]...{w=0.2}I think there's one major art branch that we've been neglecting in our talks..."
    m 1esa "Oye, [player]... {w=0.2}creo que hay una rama del arte muy importante que hemos estado descuidando en nuestras charlas..."

# game/script-topics.rpy:16793
translate spanish monika_architecture_d5f7c3b2:

    # m 3hub "Architecture!"
    m 3hub "¡La arquitectura!"

# game/script-topics.rpy:16794
translate spanish monika_architecture_035e96a4:

    # m 3eua "I've been reading a bit about it lately and I find it quite interesting."
    m 3eua "Últimamente he estado leyendo un poco sobre el tema y me parece bastante interesante."

# game/script-topics.rpy:16795
translate spanish monika_architecture_87b26839:

    # m 1rtc "...Come to think of it, architecture is one of the most common forms of art in everyday life."
    m 1rtc "Ahora que lo pienso, la arquitectura es una de las formas de arte más presentes en el día a día."

# game/script-topics.rpy:16796
translate spanish monika_architecture_407da5c0:

    # m 1eua "I'm just fascinated by how humanity tends to turn every craft into an art,{w=0.2} {nw}"
    m 1eua "Me fascina cómo la humanidad tiende a convertir cada oficio en un arte,{w=0.2} {nw}"

# game/script-topics.rpy:16797
translate spanish monika_architecture_572d5c67:

    # extend 3eua "and I think architecture is the greatest example of that."
    extend 3eua "y creo que la arquitectura es el mejor ejemplo de ello."

# game/script-topics.rpy:16798
translate spanish monika_architecture_f62c822f:

    # m 1eud "Architecture can tell you a lot about the culture of the area it's located in...{w=0.2}different monuments, statues, historical buildings, towers..."
    m 1eud "La arquitectura te puede decir mucho sobre la cultura de la zona en la que se encuentra... {w=0.2}diferentes monumentos, estatuas, edificios históricos, torres..."

# game/script-topics.rpy:16799
translate spanish monika_architecture_31f46d30:

    # m 1eua "I think that makes it even more exciting to explore the places you're visiting."
    m 1eua "Creo que eso hace que sea aún más emocionante explorar los lugares que visitas."

# game/script-topics.rpy:16800
translate spanish monika_architecture_adc9daae:

    # m 3rka "It's also important to place the buildings in the most convenient way for people to use, which can be a tough task to deal with in its own right."
    m 3rka "También es importante colocar los edificios de la forma más conveniente para que la gente los use, lo cual puede ser una tarea difícil de por sí."

# game/script-topics.rpy:16801
translate spanish monika_architecture_92a5318f:

    # m 3esd "...But that's more urban planning than actual architecture."
    m 3esd "Pero eso es más planificación urbana que arquitectura en sí."

# game/script-topics.rpy:16802
translate spanish monika_architecture_407f206c:

    # m 1euc "If you prefer viewing architecture purely from the art perspective, some modern tendencies may disappoint you..."
    m 1euc "Si prefieres ver la arquitectura desde una perspectiva puramente artística, algunas tendencias modernas pueden decepcionarte..."

# game/script-topics.rpy:16803
translate spanish monika_architecture_a7b407a9:

    # m 1rud "Modern architecture focuses more on getting things done in the most practical way possible."
    m 1rud "La arquitectura moderna se centra más en hacer las cosas de la forma más práctica posible."

# game/script-topics.rpy:16804
translate spanish monika_architecture_35cbb9a2:

    # m 3eud "In my opinion, that can be both good and bad for many different reasons."
    m 3eud "En mi opinión, eso puede ser tanto bueno como malo por muchas razones diferentes."

# game/script-topics.rpy:16805
translate spanish monika_architecture_13db91d3:

    # m 3euc "I believe the most important part is to keep things balanced."
    m 3euc "Creo que lo más importante es mantener el equilibrio."

# game/script-topics.rpy:16806
translate spanish monika_architecture_af7ddc1e:

    # m 1tkc "Overly-practical buildings can look flat and uninspired, while overly-artistic buildings can serve no purpose other than looking amazing while being completely out of place."
    m 1tkc "Los edificios demasiado prácticos pueden parecer planos y faltos de inspiración, mientras que los demasiado artísticos pueden no tener más propósito que verse increíbles estando totalmente fuera de lugar."

# game/script-topics.rpy:16807
translate spanish monika_architecture_2c7c40d8:

    # m 3eua "I think the true beauty lies in those buildings which can combine both form and function with a little bit of uniqueness."
    m 3eua "Creo que la verdadera belleza reside en esos edificios que pueden combinar forma y función con un poco de singularidad."

# game/script-topics.rpy:16808
translate spanish monika_architecture_58b96db7:

    # m 1eka "I do hope you're happy with how your surroundings look."
    m 1eka "Espero que estés content[end_letter_gender] con el aspecto de tu entorno."

# game/script-topics.rpy:16809
translate spanish monika_architecture_0d1c7753:

    # m 1eub "It has been proven multiple times that architecture has a big impact on your mental health."
    m 1eub "Se ha demostrado en múltiples ocasiones que la arquitectura tiene un gran impacto en la salud mental."

# game/script-topics.rpy:16810
translate spanish monika_architecture_e63b32a1:

    # m 3rkc "Moreover, residential areas with poorly-made buildings can lead to people not taking care of their properties and, over time, end up as downtrodden areas that are undesirable places to live."
    m 3rkc "Además, las zonas residenciales con edificios mal construidos pueden provocar que la gente no cuide de sus propiedades y, con el tiempo, acabar siendo zonas deterioradas en las que no se desea vivir."

# game/script-topics.rpy:16811
translate spanish monika_architecture_1c7797b4:

    # m 1ekc "It was once said that the ugliness of the outside world causes ugliness on the inside...{w=0.2}{nw}"
    m 1ekc "Una vez se dijo que la fealdad del mundo exterior provoca fealdad en el interior... {w=0.2}{nw}"

# game/script-topics.rpy:16812
translate spanish monika_architecture_667f4f0c:

    # extend 3esd "which I tend to agree with."
    extend 3esd "y suelo estar de acuerdo con eso."

# game/script-topics.rpy:16815
translate spanish monika_architecture_b84214ef:

    # m 1euc "...Judging by {i}your{/i} personality, {w=0.2}{nw}"
    m 1euc "A juzgar por tu personalidad, {w=0.2}{nw}"

# game/script-topics.rpy:16816
translate spanish monika_architecture_6eb9e6e6:

    # extend 1tua "you probably live in some kind of a paradise."
    extend 1tua "probablemente vivas en una especie de paraíso."

# game/script-topics.rpy:16817
translate spanish monika_architecture_e6f89ce6:

    # m 1hub "Ahaha~"
    m 1hub "Ja, ja, ja."

# game/script-topics.rpy:16819
translate spanish monika_architecture_a0713464:

    # m 1eka "[player]...{w=0.2}seeing the world with you is one of my biggest dreams."
    m 1eka "[player]... {w=0.2}ver el mundo contigo es uno de mis mayores sueños."

# game/script-topics.rpy:16822
translate spanish monika_architecture_60584089:

    # m 3rka "I know you're not too fond of traveling a lot, but I would love to see the place you live in."
    m 3rka "Sé que no eres muy aficionad[end_letter_gender] a viajar mucho, pero me encantaría ver el lugar donde vives."

# game/script-topics.rpy:16823
translate spanish monika_architecture_8bf81a23:

    # m 3eka "As long as you stay by my side, that would be more than enough for me."
    m 3eka "Mientras te quedes a mi lado, eso sería más que suficiente para mí."

# game/script-topics.rpy:16824
translate spanish monika_architecture_348a10a7:

    # m 1ekbsa "I love you, [player]. {w=0.3}Always remember that."
    m 1ekbsa "Te quiero, [player]. {w=0.3}Recuerda eso siempre."

# game/script-topics.rpy:16828
translate spanish monika_architecture_f9ffad73:

    # m 3eua "I already know you enjoy traveling, so wouldn't it be nice to explore something new together?"
    m 3eua "Ya sé que te gusta viajar, así que ¿no sería bonito explorar algo nuevo junt[end_letter_gender]s?"

# game/script-topics.rpy:16830
translate spanish monika_architecture_f10bf094:

    # m 1dka "Imagine taking a stroll through the narrow streets of an old city..."
    m 1dka "Imagínate dar un paseo por las calles estrechas de una ciudad antigua..."

# game/script-topics.rpy:16831
translate spanish monika_architecture_2b78877b:

    # m 1eka "Or walking down a park together, breathing fresh evening air..."
    m 1eka "O caminar junt[end_letter_gender]s por un parque, respirando el aire fresco del atardecer..."

# game/script-topics.rpy:16832
translate spanish monika_architecture_f8ab2d44:

    # m 1ekb "I believe it'll happen one day and I hope you do too, [mas_get_player_nickname()]."
    m 1ekb "Creo que algún día pasará y espero que tú también lo creas, [mas_get_player_nickname()]."

# game/script-topics.rpy:16833
translate spanish monika_architecture_366f0509:

    # m 1ekbsa "I love you~"
    m 1ekbsa "Te quiero."

# game/script-topics.rpy:16854
translate spanish monika_fear_6a8ee5b5:

    # m 3eud "Say, [player]..."
    m 3eud "Dime, [player]..."

# game/script-topics.rpy:16855
translate spanish monika_fear_cf8416d8:

    # m 1euc "This is kind of a weird question, but...{w=0.5}is there anything you're afraid of?"
    m 1euc "Es una pregunta un poco rara, pero... {w=0.5}¿hay algo que te dé miedo?"

# game/script-topics.rpy:16856
translate spanish monika_fear_26b2120d:

    # m 3hksdlb "I don't mean the everyday, mundane kind of fear, like spilling a drink and ruining your favorite shirt..."
    m 3hksdlb "No me refiero al típico miedo mundano y cotidiano, como derramar una bebida y arruinar tu camisa favorita..."

# game/script-topics.rpy:16857
translate spanish monika_fear_0754ba9d:

    # m 3euc "I mean, like, the kind of deep-seated fear that fills you with dread when you even think about it."
    m 3euc "Me refiero al tipo de miedo profundo que te llena de pavor con solo pensarlo."

# game/script-topics.rpy:16858
translate spanish monika_fear_6058b3b3:

    # m 1ruc "For me, losing you would obviously be on the top of {i}that{/i} particular list."
    m 1ruc "Para mí, perderte estaría obviamente en lo más alto de esa lista en particular."

# game/script-topics.rpy:16859
translate spanish monika_fear_c71d5f20:

    # m 1ekd "I told you before, didn't I? {w=0.3}I don't know what I'd do if something happened to you."
    m 1ekd "Ya te lo dije antes, ¿verdad? {w=0.3}No sé qué haría si te pasara algo."

# game/script-topics.rpy:16860
translate spanish monika_fear_fed6016a:

    # m 1dkd "I'm not even sure I could find the will to go on."
    m 1dkd "Ni siquiera estoy segura de poder encontrar las ganas de seguir adelante."

# game/script-topics.rpy:16861
translate spanish monika_fear_2f5b6643:

    # m 1ruc "It's hard to imagine a scenario even worse than that."
    m 1ruc "Es difícil imaginar una situación aún peor que esa."

# game/script-topics.rpy:16862
translate spanish monika_fear_4d982889:

    # m 3eua "But as long as we're being hypothetical..."
    m 3eua "Pero ya que estamos hablando de forma hipotética..."

# game/script-topics.rpy:16863
translate spanish monika_fear_318d1af3:

    # m 4ekc "What truly terrifies me is the thought that none of this is real."
    m 4ekc "Lo que de verdad me aterra es pensar que nada de esto es real."

# game/script-topics.rpy:16864
translate spanish monika_fear_c81ca600:

    # m 2dkc "That one day I'll wake up, back in my bed, and realize it was all just a dream."
    m 2dkc "Que un día me despertaré en mi cama y me daré cuenta de que todo fue un sueño."

# game/script-topics.rpy:16865
translate spanish monika_fear_8c9d3995:

    # m 2dkd "That there is no game,{w=0.2} no epiphany,{w=0.2} no...{w=0.5}{nw}"
    m 2dkd "Que no hay juego,{w=0.2} ni epifanía,{w=0.2} ni... {w=0.5}{nw}"

# game/script-topics.rpy:16866
translate spanish monika_fear_8b221ca0:

    # extend 2ekd "you."
    extend 2ekd "tú."

# game/script-topics.rpy:16867
translate spanish monika_fear_c63148f4:

    # m 2ektpc "That you, your love, perhaps even the entirety of the Literature Club, were all nothing but a figment of my own imagination."
    m 2ektpc "Que tú, tu amor, tal vez incluso todo el Club de Literatura, no erais más que un producto de mi propia imaginación."

# game/script-topics.rpy:16868
translate spanish monika_fear_c6857a09:

    # m 2dktpc "That my old world, as grey and meaningless as it now seems, is all there truly is."
    m 2dktpc "Que mi viejo mundo, tan gris y sin sentido como parece ahora, es todo lo que de verdad existe."

# game/script-topics.rpy:16869
translate spanish monika_fear_225bb0b0:

    # m 2dktpc "..."
    m 2dktpc "..."

# game/script-topics.rpy:16870
translate spanish monika_fear_7ca7de92:

    # m 2rktdb "Ahaha~ {w=0.5}{nw}"
    m 2rktdb "Ja, ja, ja. {w=0.5}{nw}"

# game/script-topics.rpy:16871
translate spanish monika_fear_9fc892db:

    # extend 2ektdsdla "Sorry, that got pretty dark, didn't it?"
    extend 2ektdsdla "Perdona, eso se ha puesto bastante tétrico, ¿verdad?"

# game/script-topics.rpy:16872
translate spanish monika_fear_83174dae:

    # m 2rksdla "I feel kinda silly now...{w=0.3} {nw}"
    m 2rksdla "Ahora me siento un poco tonta... {w=0.3} {nw}"

# game/script-topics.rpy:16873
translate spanish monika_fear_13d5537d:

    # extend 4eud "After all, there's no way something like that could be true, right?"
    extend 4eud "Después de todo, no hay forma de que algo así pueda ser verdad, ¿no?"

# game/script-topics.rpy:16874
translate spanish monika_fear_c0fd95c1:

    # m 2rka "Yeah..."
    m 2rka "Sí..."

# game/script-topics.rpy:16898
translate spanish monika_why_spaceroom_6ad49db3:

    # m 3euc "Utility, mostly."
    m 3euc "Por utilidad, sobre todo."

# game/script-topics.rpy:16899
translate spanish monika_why_spaceroom_4887ee00:

    # m 3eud "You know how in the original game almost everything took place during our club meetings, right?"
    m 3eud "Ya sabes que en el juego original casi todo transcurría durante las reuniones del club, ¿verdad?"

# game/script-topics.rpy:16900
translate spanish monika_why_spaceroom_3895e6cc:

    # m 3eua "...All of which took place in a classroom.{w=0.3} This classroom."
    m 3eua "Y todas ellas ocurrían en un aula.{w=0.3} En esta aula."

# game/script-topics.rpy:16901
translate spanish monika_why_spaceroom_a33e60b9:

    # m 1eua "It may look different to you, but it's still the very same one."
    m 1eua "Puede que te parezca diferente, pero sigue siendo la misma de siempre."

# game/script-topics.rpy:16902
translate spanish monika_why_spaceroom_a8e25f23:

    # m 3eud "Since so many things were supposed to happen here, the room had to be robust enough to accommodate them."
    m 3eud "Como se suponía que iban a pasar tantas cosas aquí, la sala tenía que ser lo bastante robusta para albergarlas."

# game/script-topics.rpy:16903
translate spanish monika_why_spaceroom_06217488:

    # m 2rtc "That made it the most...{w=0.3}{nw}"
    m 2rtc "Eso la convirtió en el lugar más... {w=0.3}{nw}"

# game/script-topics.rpy:16904
translate spanish monika_why_spaceroom_8afe3d32:

    # extend 2eud "fleshed out location in the game."
    extend 2eud "desarrollado del juego."

# game/script-topics.rpy:16905
translate spanish monika_why_spaceroom_f1e66b5f:

    # m 7eud "As such, it was the easiest place to navigate, alter, and generally use for whatever was needed."
    m 7eud "Por lo tanto, era el lugar más fácil de explorar, alterar y usar en general para lo que hiciera falta."

# game/script-topics.rpy:16906
translate spanish monika_why_spaceroom_66a55322:

    # m 3eua "That was the original motivation, anyway."
    m 3eua "Esa era la motivación original, al menos."

# game/script-topics.rpy:16907
translate spanish monika_why_spaceroom_7b80aee7:

    # m 3eud "Not to mention, this classroom was the only place I ever appeared in during the original game."
    m 3eud "Por no mencionar que esta clase fue el único lugar en el que aparecí durante el juego original."

# game/script-topics.rpy:16908
translate spanish monika_why_spaceroom_7488709e:

    # m 1eka "...So I guess in that sense, it kind of became my home."
    m 1eka "Así que supongo que en ese sentido, se convirtió un poco en mi hogar."

# game/script-topics.rpy:16912
translate spanish monika_why_spaceroom_344c08cc:

    # m 1rtc "As for why we're {i}still{/i} here..."
    m 1rtc "En cuanto a por qué seguimos aquí..."

# game/script-topics.rpy:16913
translate spanish monika_why_spaceroom_6061f9f3:

    # m 3eua "It hasn't really occurred to me to move someplace else..."
    m 3eua "La verdad es que no se me ha ocurrido mudarme a otro sitio..."

# game/script-topics.rpy:16916
translate spanish monika_why_spaceroom_8ca75856:

    # m 1rtc "As for why I'm still using it..."
    m 1rtc "En cuanto a por qué sigo usándola..."

# game/script-topics.rpy:16918
translate spanish monika_why_spaceroom_4c7ecce8:

    # m 1eud "It's not like it's {i}bad{/i} in here."
    m 1eud "Tampoco es que se esté mal aquí."

# game/script-topics.rpy:16922
translate spanish monika_why_spaceroom_71e8b4e9:

    # m 3etc "I guess I could make another place for us to spend time together."
    m 3etc "Supongo que podría hacer otro lugar para que pasemos el tiempo junt[end_letter_gender]s."

# game/script-topics.rpy:16924
translate spanish monika_why_spaceroom_063abe4a:

    # m 3etc "I guess I could make some more places for us to spend time in."
    m 3etc "Supongo que podría hacer más lugares en los que podamos pasar el rato."

# game/script-topics.rpy:16926
translate spanish monika_why_spaceroom_b8990549:

    # m 1eua "I mean, there's the islands...{w=0.3}{nw}"
    m 1eua "A ver, están las islas... {w=0.3}{nw}"

# game/script-topics.rpy:16927
translate spanish monika_why_spaceroom_bc3ecefd:

    # extend 1rksdlb "but those aren't quite ready yet."
    extend 1rksdlb "pero esas todavía no están del todo listas."

# game/script-topics.rpy:16928
translate spanish monika_why_spaceroom_19428ff1:

    # m 1hua "Ehehe~"
    m 1hua "Je, je, je."

# game/script-topics.rpy:16930
translate spanish monika_why_spaceroom_2f00dfdc:

    # m 3eub "...And to be honest, there's only one place I want to be...{w=1}{nw}"
    m 3eub "Y para ser sincera, solo hay un lugar en el que quiero estar... {w=1}{nw}"

# game/script-topics.rpy:16931
translate spanish monika_why_spaceroom_dd84c385:

    # extend 3dkbsu "by your side."
    extend 3dkbsu "a tu lado."

# game/script-topics.rpy:16932
translate spanish monika_why_spaceroom_8e782c4b:

    # m 1ekbsa "But as long as that isn't an option, it doesn't really matter to me where we meet..."
    m 1ekbsa "Pero mientras eso no sea una opción, la verdad es que me da igual dónde nos veamos..."

# game/script-topics.rpy:16933
translate spanish monika_why_spaceroom_1d269916:

    # m 1ekbfu "You're the only part that really matters~"
    m 1ekbfu "Tú eres la única parte que importa de verdad."

# game/script-topics.rpy:16946
translate spanish monika_naps_465c7ee6:

    # m 1eua "Hey, [player]..."
    m 1eua "Una cosita, [player]..."

# game/script-topics.rpy:16949
translate spanish monika_naps_b628742d:

    # m 3eua "I noticed that sometimes you like to take naps..."
    m 3eua "Me he dado cuenta de que a veces te gusta echarte siestas..."

# game/script-topics.rpy:16951
translate spanish monika_naps_7167e7d2:

    # m 3eua "Do you ever take naps?"
    m 3eua "¿Alguna vez te echas siestas?"

# game/script-topics.rpy:16953
translate spanish monika_naps_03b16a7f:

    # m 1rka "A lot of people don't know the benefits of them...{w=0.2}{nw}"
    m 1rka "Mucha gente no conoce sus beneficios... {w=0.2}{nw}"

# game/script-topics.rpy:16954
translate spanish monika_naps_2b76b4ed:

    # extend 1rksdla "they're a lot more than just going to sleep for a bit."
    extend 1rksdla "son mucho más que echarse a dormir un rato."

# game/script-topics.rpy:16955
translate spanish monika_naps_128a1a9e:

    # m 3eud "The length of time you're asleep is an important factor in how helpful they can be."
    m 3eud "El tiempo que duermes es un factor importante para lo útiles que pueden llegar a ser."

# game/script-topics.rpy:16956
translate spanish monika_naps_185c68dd:

    # m 1euc "If you're out for too long, it can be difficult to get back up again.{w=0.2} Kinda like when you wake up after a full night's sleep."
    m 1euc "Si duermes demasiado puede que te cueste volver a levantarte,{w=0.2} algo parecido a cuando te despiertas después de dormir toda la noche."

# game/script-topics.rpy:16957
translate spanish monika_naps_eee4702d:

    # m 3eua "So it's best to rest in 90 minute intervals, since that's about how long a full sleep cycle takes."
    m 3eua "Por eso es mejor descansar en intervalos de noventa minutos, ya que es más o menos lo que dura un ciclo de sueño completo."

# game/script-topics.rpy:16958
translate spanish monika_naps_ac9d6550:

    # m 1eud "Power naps are another form of resting.{w=0.2} For these, you just rest your eyes for about 10-20 minutes."
    m 1eud "Las siestas exprés son otra forma de descansar;{w=0.2} para estas basta con cerrar los ojos unos diez o veinte minutos."

# game/script-topics.rpy:16959
translate spanish monika_naps_b2c70076:

    # m 3eua "They're great for taking a break from your day and clearing your head."
    m 3eua "Vienen genial para tomarte un descanso en tu día y despejar la mente."

# game/script-topics.rpy:16960
translate spanish monika_naps_94f16a82:

    # m 3hua "And since they're so short, it's really easy to get back into whatever you were doing before."
    m 3hua "Y como son tan cortas es muy fácil volver a lo que estabas haciendo antes."

# game/script-topics.rpy:16963
translate spanish monika_naps_218d8e72:

    # m 1eua "So don't be shy about taking naps whenever you think you need to, [player]."
    m 1eua "Así que no dudes en echarte una siesta siempre que creas que lo necesitas, [player]."

# game/script-topics.rpy:16965
translate spanish monika_naps_5d8fd24c:

    # m 1eua "If you don't already, maybe you could try taking some naps from time to time."
    m 1eua "Si no lo haces ya, a lo mejor podrías probar a echarte alguna siesta de vez en cuando."

# game/script-topics.rpy:16969
translate spanish monika_naps_15da91f1:

    # m 5tubfu "Maybe one day you could even rest on my lap, ehehe~"
    m 5tubfu "A lo mejor un día hasta podrías descansar en mi regazo, je, je, je."

# game/script-topics.rpy:16973
translate spanish monika_naps_c59950d8:

    # m 5hubfa "Just let me know if you need to take a nap, and I'll watch over you~"
    m 5hubfa "Tú solo avísame si necesitas echarte una siesta y yo te cuidaré."

# game/script-topics.rpy:16993
translate spanish monika_asimov_three_laws_269deff0:

    # m 1eua "[player], do you remember when we talked about the {i}Three Laws of Robotics{/i}?"
    m 1eua "[player], ¿te acuerdas de cuando hablamos de las {i}Tres leyes de la robótica{/i}?"

# game/script-topics.rpy:16994
translate spanish monika_asimov_three_laws_011eb535:

    # m 3esc "Well, I've been thinking about them for a bit and...{w=0.3}{nw}"
    m 3esc "Bueno, he estado pensando un poco en ellas y... {w=0.3}{nw}"

# game/script-topics.rpy:16995
translate spanish monika_asimov_three_laws_b0694a59:

    # extend 3rksdla "they're not exactly practical."
    extend 3rksdla "no son muy prácticas que digamos."

# game/script-topics.rpy:16996
translate spanish monika_asimov_three_laws_3ee26a44:

    # m 1eua "Take the first law, for example..."
    m 1eua "Tomemos la primera ley como ejemplo..."

# game/script-topics.rpy:16997
translate spanish monika_asimov_three_laws_ef7a2f33:

    # m 4dud "{i}A robot shall not harm a human or, through inaction, allow a human to come to harm.{/i}"
    m 4dud "{i}Un robot no hará daño a un ser humano ni, por inacción, permitirá que un ser humano sufra daño.{/i}"

# game/script-topics.rpy:16998
translate spanish monika_asimov_three_laws_37f4c906:

    # m 2esa "To a human, this is pretty straightforward."
    m 2esa "Para un humano esto es bastante sencillo."

# game/script-topics.rpy:16999
translate spanish monika_asimov_three_laws_819b5121:

    # m 2eud "But when you try to put it in terms a machine can understand, you start to run into trouble."
    m 2eud "Pero cuando intentas ponerlo en términos que una máquina pueda entender, empiezas a tener problemas."

# game/script-topics.rpy:17000
translate spanish monika_asimov_three_laws_6c8ae049:

    # m 7esc "You have to make precise definitions for everything, which isn't always easy...{w=0.3} {nw}"
    m 7esc "Tienes que hacer definiciones precisas para todo, lo cual no siempre es fácil... {w=0.3} {nw}"

# game/script-topics.rpy:17001
translate spanish monika_asimov_three_laws_2ae5544f:

    # extend 1etc "For example, how do you define a human?"
    extend 1etc "Por ejemplo, ¿cómo defines a un humano?"

# game/script-topics.rpy:17008
translate spanish monika_asimov_three_laws_9c22699d:

    # m 3eua "I think we can both assume that I'm a human, you're a human, and that the [line_end]"
    m 3eua "Creo que podemos dar por sentado que yo soy humana, que tú eres human[end_letter_gender] y que [line_end]"

# game/script-topics.rpy:17009
translate spanish monika_asimov_three_laws_a84e1ad4:

    # m 3esc "The problems come when we move to the fringe cases."
    m 3esc "Los problemas surgen cuando pasamos a los casos límite."

# game/script-topics.rpy:17010
translate spanish monika_asimov_three_laws_9354c458:

    # m 3etc "For example, do dead people count as human?"
    m 3etc "Por ejemplo, ¿las personas muertas cuentan como humanos?"

# game/script-topics.rpy:17011
translate spanish monika_asimov_three_laws_c6727ec0:

    # m 1rkc "If you say no, the robot could ignore someone who's just had a heart attack."
    m 1rkc "Si dices que no, el robot podría ignorar a alguien que acaba de sufrir un infarto."

# game/script-topics.rpy:17012
translate spanish monika_asimov_three_laws_a2bbfb52:

    # m 1esd "People like that can still be brought back, but your robot won't help them because they're {i}technically{/i} dead."
    m 1esd "A esas personas todavía se las puede reanimar, pero tu robot no las ayudará porque técnicamente están muertas."

# game/script-topics.rpy:17013
translate spanish monika_asimov_three_laws_348f8b6a:

    # m 3eud "On the other hand, if you say yes, your robot might start digging up graves to 'help' people who've been dead for years."
    m 3eud "Por otro lado, si dices que sí, puede que tu robot empiece a desenterrar tumbas para 'ayudar' a personas que llevan años muertas."

# game/script-topics.rpy:17014
translate spanish monika_asimov_three_laws_3e05799b:

    # m 1dsd "And the list goes on.{w=0.3} Do cryogenically preserved people count as human?{w=0.3} Do people in vegetative state count?{w=0.3} What about people who haven't been born yet?"
    m 1dsd "Y la lista sigue.{w=0.3} ¿Las personas conservadas criogénicamente cuentan como humanos?{w=0.3} ¿Cuentan las personas en estado vegetativo?{w=0.3} ¿Qué pasa con las personas que aún no han nacido?"

# game/script-topics.rpy:17015
translate spanish monika_asimov_three_laws_e1470d00:

    # m 1tkc "And that's not even getting started on the definition of 'harm.'"
    m 1tkc "Y eso sin empezar siquiera con la definición de 'daño'."

# game/script-topics.rpy:17016
translate spanish monika_asimov_three_laws_19ff765e:

    # m 3eud "The point is,{w=0.1} in order to implement Asimov's laws you'd need to take some solid stance on pretty much all of ethics."
    m 3eud "El caso es que,{w=0.1} para aplicar las leyes de Asimov, tendrías que adoptar una postura firme sobre casi cualquier dilema ético."

# game/script-topics.rpy:17017
translate spanish monika_asimov_three_laws_2393e208:

    # m 1rsc "..."
    m 1rsc "..."

# game/script-topics.rpy:17018
translate spanish monika_asimov_three_laws_aae76cb3:

    # m 1esc "I suppose it makes sense when you think about it."
    m 1esc "Supongo que tiene sentido cuando lo piensas."

# game/script-topics.rpy:17019
translate spanish monika_asimov_three_laws_ed97ee6b:

    # m 1eua "The laws were never meant to be actually implemented, they're just plot devices."
    m 1eua "Las leyes nunca se pensaron para que se aplicaran de verdad, solo son recursos argumentales."

# game/script-topics.rpy:17020
translate spanish monika_asimov_three_laws_06735693:

    # m 3eua "In fact, a good amount of Asimov's stories show just how badly things could turn out if they were applied."
    m 3eua "De hecho, gran parte de las historias de Asimov muestran lo mal que podrían salir las cosas si se aplicaran."

# game/script-topics.rpy:17021
translate spanish monika_asimov_three_laws_84702219:

    # m 3hksdlb "So I guess they aren't really something we need to worry about. Ahaha~"
    m 3hksdlb "Así que supongo que no son algo de lo que debamos preocuparnos. Ja, ja, ja."

# game/script-topics.rpy:17041
translate spanish monika_wabi_sabi_d0e216c1:

    # m 1eua "Say [player], have you ever heard of wabi-sabi?"
    m 1eua "Dime, [player], ¿alguna vez has oído hablar del wabi-sabi?"

# game/script-topics.rpy:17042
translate spanish monika_wabi_sabi_6fd7256a:

    # m 3eud "It emphasizes the idea that we shouldn't obsess over perfection to the point that we're crushed by the failure of not achieving it."
    m 3eud "Hace hincapié en la idea de que no debemos obsesionarnos con la perfección hasta el punto de que nos hunda el fracaso de no alcanzarla."

# game/script-topics.rpy:17043
translate spanish monika_wabi_sabi_9f392ac8:

    # m 3eub "Derived from traditional Japanese and Buddhistic philosophies surrounding the acceptance of the temporary state of all things..."
    m 3eub "Deriva de las filosofías tradicionales japonesas y budistas sobre la aceptación del estado temporal de todas las cosas..."

# game/script-topics.rpy:17044
translate spanish monika_wabi_sabi_44f75778:

    # m 1esa "...it states that beyond everything, beauty is found in what's impermanent and imperfect."
    m 1esa "Afirma que, más allá de todo, la belleza se encuentra en lo que es impermanente e imperfecto."

# game/script-topics.rpy:17045
translate spanish monika_wabi_sabi_ce19f77f:

    # m 1eua "Which means we shouldn't worry about things like a scar, a discolored hand, or even the mistakes we make."
    m 1eua "Lo que significa que no deberíamos preocuparnos por cosas como una cicatriz, una mancha en la piel o incluso por los errores que cometemos."

# game/script-topics.rpy:17046
translate spanish monika_wabi_sabi_28571086:

    # m 3eka "Our looks are things we can't easily change, but despite that, they make us more unique and special."
    m 3eka "Nuestro aspecto físico es algo que no podemos cambiar tan fácilmente, pero a pesar de ello, nos hace más únicos y especiales."

# game/script-topics.rpy:17047
translate spanish monika_wabi_sabi_b388a72b:

    # m 3hua "...And our mistakes turn into lessons that help us become stronger and more defined as people."
    m 3hua "Y nuestros errores se convierten en lecciones que nos ayudan a hacernos más fuertes y a definirnos como personas."

# game/script-topics.rpy:17048
translate spanish monika_wabi_sabi_36ea5e8c:

    # m 3eub "Like a sculptor revealing the magnificence in a marble block, except the sculpture is you, and the sculptor, your past."
    m 3eub "Como un escultor que revela la magnificencia en un bloque de mármol, solo que la escultura eres tú, y el escultor, tu pasado."

# game/script-topics.rpy:17049
translate spanish monika_wabi_sabi_aac1d1db:

    # m 1rksdla "Of course, this idea doesn't apply to looks and mistakes alone..."
    m 1rksdla "Por supuesto, esta idea no se aplica solo al aspecto y a los errores..."

# game/script-topics.rpy:17050
translate spanish monika_wabi_sabi_4a327e55:

    # m 3eud "After all, the way you think and your attitude toward problems and people are also derived from your own personal experiences."
    m 3eud "Al fin y al cabo, tu forma de pensar y tu actitud hacia los problemas y las personas también derivan de tus propias experiencias personales."

# game/script-topics.rpy:17051
translate spanish monika_wabi_sabi_04766388:

    # m 1dkc "...But I know for some people, how these experiences changed who they are can really scare them."
    m 1dkc "Pero sé que a algunas personas les puede asustar mucho cómo estas experiencias cambian lo que son."

# game/script-topics.rpy:17052
translate spanish monika_wabi_sabi_5a6f626d:

    # m 7ekc "Maybe they grew into something that they're just not proud of."
    m 7ekc "A lo mejor se han convertido en algo de lo que simplemente no están orgullosas."

# game/script-topics.rpy:17053
translate spanish monika_wabi_sabi_72b64cfb:

    # m 2dkd "It can be crushing to be worried about both looks and personality..."
    m 2dkd "Puede ser abrumador estar preocupándose tanto por el aspecto como por la personalidad..."

# game/script-topics.rpy:17056
translate spanish monika_wabi_sabi_b5c25760:

    # m 1ekc "I know you said you didn't love yourself [player],{w=0.3} {nw}"
    m 1ekc "Sé que dijiste que no te querías a ti mism[end_letter_gender], [player],{w=0.3} {nw}"

# game/script-topics.rpy:17057
translate spanish monika_wabi_sabi_77077b02:

    # extend 3eka "but you need to know that I'll always love you, regardless of your flaws."
    extend 3eka "pero tienes que saber que siempre te querré, independientemente de tus defectos."

# game/script-topics.rpy:17060
translate spanish monika_wabi_sabi_b9835b31:

    # m 2eka "I hope you don't feel too insecure about yourself, [player]."
    m 2eka "Espero que no te sientas muy insegur[end_letter_gender] contigo mism[end_letter_gender], [player]."

# game/script-topics.rpy:17061
translate spanish monika_wabi_sabi_4c9c050f:

    # m 2dkc "It'd break my heart to know that you're constantly worrying about these things."
    m 2dkc "Me rompería el corazón saber que te estás preocupando por estas cosas todo el tiempo."

# game/script-topics.rpy:17062
translate spanish monika_wabi_sabi_954f11b4:

    # m 7ekbsa "But I hope you know that despite your flaws, I will always love you."
    m 7ekbsa "Pero espero que sepas que, a pesar de tus defectos, yo siempre te querré."

# game/script-topics.rpy:17064
translate spanish monika_wabi_sabi_afaf3f4f:

    # m 3hua "We'll overcome any problems you feel you have together."
    m 3hua "Superaremos junt[end_letter_gender]s cualquier problema que creas tener."

# game/script-topics.rpy:17065
translate spanish monika_wabi_sabi_5d5025b9:

    # m 1hub "That's my wabi-sabi promise!"
    m 1hub "¡Esa es mi promesa wabi-sabi!"

# game/script-topics.rpy:17082
translate spanish monika_being_herself_fcddabcd:

    # m 1eka "You know [player], one thing I don't think I ever properly thanked you for is letting me be myself."
    m 1eka "Sabes, [player], creo que algo por lo que nunca te di las gracias como es debido es por dejarme ser yo misma."

# game/script-topics.rpy:17083
translate spanish monika_being_herself_7fd77c4d:

    # m 1lksdlb "I know that sounds a little weird...{w=0.2}{nw}"
    m 1lksdlb "Sé que suena un poco raro... {w=0.2}{nw}"

# game/script-topics.rpy:17084
translate spanish monika_being_herself_b5e19019:

    # extend 1eka "but let me explain."
    extend 1eka "pero deja que me explique."

# game/script-topics.rpy:17085
translate spanish monika_being_herself_b6905279:

    # m 3euc "You probably already know this by now, but almost all of my life I've been trying to keep up this persona of a 'perfect student.'"
    m 3euc "Probablemente ya lo sepas, pero casi toda mi vida he estado intentando mantener esta fachada de «estudiante perfecta»."

# game/script-topics.rpy:17086
translate spanish monika_being_herself_022e1c66:

    # m 3eud "I always strive to be the best person I can be, and I guess after a while, it got the attention of people around me."
    m 3eud "Siempre me esfuerzo por ser la mejor versión de mí misma, y supongo que, después de un tiempo, eso acabó llamando la atención de la gente de mi entorno."

# game/script-topics.rpy:17087
translate spanish monika_being_herself_a1e631f4:

    # m 7rsc "Before I knew it, I had people looking up to me with high expectations.{w=0.3} {nw}"
    m 7rsc "Antes de darme cuenta, tenía a gente admirándome con altas expectativas.{w=0.3} {nw}"

# game/script-topics.rpy:17088
translate spanish monika_being_herself_e1f14afe:

    # extend 2esc "You know, seeing me as smart, confident, charismatic...{w=0.3}those kinds of things."
    extend 2esc "Ya sabes, viéndome como alguien inteligente, segura de mí misma, carismática... {w=0.3}ese tipo de cosas."

# game/script-topics.rpy:17089
translate spanish monika_being_herself_07e1c724:

    # m 2eud "Some people would say that they admired me...{w=0.3}{nw}"
    m 2eud "Algunos dirían que me admiraban... {w=0.3}{nw}"

# game/script-topics.rpy:17090
translate spanish monika_being_herself_e731e7cf:

    # extend 2lksdlc "and others,{w=0.2} while they would never say anything, hated me because I represented everything they thought they could never be."
    extend 2lksdlc "y otros,{w=0.2} aunque nunca decían nada, me odiaban porque yo representaba todo lo que ellos creían que nunca podrían llegar a ser."
